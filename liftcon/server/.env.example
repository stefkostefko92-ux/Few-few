# Копие на сървъра: /opt/few-few/shared/liftcon/.env (chmod 600). Тук — само имената, без стойности.
ALLOWED_ORIGIN=https://liftcon.it
# Brevo (Transactional API) — известието за всяка заявка от формата.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=LiftCon
MAIL_TO=info@liftcon.it
LOG_LEVEL=info
# База (Docker Compose я създава; DATABASE_URL се сглобява в docker-compose.yml).
POSTGRES_PASSWORD=
# Панелът /admin: `openssl rand -hex 32` за всяко от двете. SEAL_KEY НЕ се сменя (шифрова 2FA тайните) — в бекъпа на тайните.
JWT_SECRET=
SEAL_KEY=
# Първият MASTER (само ако няма потребители); паролата се сменя задължително при първия вход.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_INITIAL_PASSWORD=
