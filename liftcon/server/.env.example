# На сървъра: /opt/few-few/shared/liftcon/.env (chmod 600) — deploy.sh го създава и генерира тайните сам.
# Тук — само имената, без стойности (за ръчна настройка или справка).
ALLOWED_ORIGIN=https://liftcon.it
# Brevo (Transactional API) — известието за всяка заявка от формата. По желание: настройва се и от панела
# (/admin/impostazioni — ключът се пази шифрован в базата); тук остава само като резерва.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=LiftCon
MAIL_TO=info@liftcon.it
LOG_LEVEL=info
# Генерират се от deploy.sh, ако са празни (openssl rand). SEAL_KEY НЕ се сменя (шифрова 2FA тайните) —
# пазете копие на .env. DATABASE_URL се сглобява в docker-compose.yml.
POSTGRES_PASSWORD=
JWT_SECRET=
SEAL_KEY=
# Първият администратор не е тук: deploy.sh пита за имейл и парола в терминала.
