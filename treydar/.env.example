# === Трейдъра — конфигурация (копирай в .env; НИКОГА не комитвай .env) ===
# API ключове от Binance. ЗАДЪЛЖИТЕЛНО: ключът да е САМО с права "Enable Spot Trading" + четене.
# ИЗКЛЮЧИ "Enable Withdrawals". Включи IP allowlist (restrict access to trusted IPs).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet vs реален Binance. По подразбиране testnet (фалшиви пари).
# Реален Binance = BINANCE_TESTNET=false. За testnet ключове: https://testnet.binance.vision
BINANCE_TESTNET=true

# Реални поръчки. dry-run (false) само логва какво БИ направил, без да праща поръчки.
# За да търгуваш реално ТРЯБВА да е точно "true" (всичко друго = dry-run).
TRADING_LIVE=false

# Двойно потвърждение за реални пари на РЕАЛЕН Binance (не testnet).
# Изисква се САМО когато BINANCE_TESTNET=false И TRADING_LIVE=true.
# Стойност трябва да е точно: РАЗБИРАМ-РИСКА
I_UNDERSTAND_THE_RISK=

# --- Пазар и стратегия ---
SYMBOL=BTC/USDT
TIMEFRAME=1h
# Стратегия: "trend" (препоръчано — EMA cross + тренд филтър + RSI + ATR стоп) или "sma".
STRATEGY=trend
# trend параметри
EMA_FAST=12
EMA_SLOW=26
EMA_TREND=200          # дълъг тренд филтър: влизаме само НАД него
RSI_PERIOD=14
RSI_OVERBOUGHT=75      # не влизаме, ако RSI ≥ това (прегрят)
ATR_PERIOD=14
ATR_MULT=2.5           # стоп = вход − ATR × mult (адаптивен към волатилността)
USE_TRAILING=false     # true = качва стопа нагоре при движение в твоя полза
ADX_PERIOD=14
ADX_MIN=0             # 0 = изключен режим-филтър; ~20-25 = търгувай само в силен тренд (пази от chop)

# --- Честотни спирачки (психология → правила срещу over-/revenge trading) ---
MAX_TRADES_PER_DAY=0   # 0 = без лимит; напр. 3 = макс 3 входа на ден
COOLDOWN_MINUTES=0     # пауза след ГУБЕЩА сделка (напр. 120 = 2ч без нов вход)

# --- Портфейл (за `npm run portfolio` и бъдещ мулти-символен режим) ---
SYMBOLS=               # напр. "BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT" (празно → default кошница)
MAX_CONCURRENT=3       # макс едновременни позиции
MAX_PORTFOLIO_RISK_PCT=2  # таван на общия риск в отворени позиции
MAX_GROUP_RISK_PCT=1   # таван на риска в една КОРЕЛИРАНА група (не трупай еднакви залози)
CORR_THRESHOLD=0.7     # |корелация| ≥ това → един и същи „залог“ (напр. BTC/ETH)
# sma параметри (само ако STRATEGY=sma)
SMA_FAST=20
SMA_SLOW=50

# --- Риск-лимити (спазват се твърдо) ---
# Риск на сделка като % от капитала (разстоянието до стопа определя размера). 0.5 = 0.5%.
RISK_PCT_PER_TRADE=0.5
# Stop-loss като % под входа (за пример-стратегията).
STOP_LOSS_PCT=2
# Take-profit като % над входа (0 = без TP, само стоп/сигнал за изход).
TAKE_PROFIT_PCT=4
# Дневен лимит на загубата (% от капитала). При достигане: спира нови входове за деня.
DAILY_LOSS_LIMIT_PCT=3
# Глобален max drawdown (% от исторически връх на капитала). При достигане: KILL-SWITCH.
MAX_DRAWDOWN_PCT=15
# Макс дял на капитала в една позиция (%). Таван върху размера.
MAX_POSITION_PCT=25

# Интервал на цикъла в секунди (колко често ботът мисли). За 1h свещи 60s е предостатъчно.
LOOP_SECONDS=60
