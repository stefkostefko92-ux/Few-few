{
  "manifest_version": 3,
  "name": "Few-Few AdBlocker",
  "version": "2.2.0",
  "description": "Блокира всякакъв вид реклами навсякъде - YouTube видео реклами, банери, popup-и, тракери, cookie банери и anti-adblock. С авто-обновяване на филтрите и Carbon Stealth интерфейс.",
  "default_locale": "bg",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Few-Few AdBlocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["cookies.js"],
      "css": ["cookies.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["antiadblock.js"],
      "css": ["antiadblock.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["picker.js"],
      "css": ["picker.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["youtube_main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["youtube_skip.js"],
      "css": ["youtube.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/ad_rules.json"
      },
      {
        "id": "youtube_rules",
        "enabled": true,
        "path": "rules/youtube_rules.json"
      }
    ]
  }
}
