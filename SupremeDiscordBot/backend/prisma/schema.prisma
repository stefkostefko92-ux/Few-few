// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String     @id // Discord user ID
  username      String
  discriminator String     @default("0")
  avatar        String?
  // v3.1 — имейл от Discord OAuth (scope `email`). Пази се ЕДИНСТВЕНО за
  // транзакционни известия по абонамента (изтичащ пробен период, провалено
  // плащане, фактура). Основание по GDPR: чл. 6(1)(б) — необходимост за
  // изпълнение на договора за услугата, НЕ съгласие и НЕ маркетинг (маркетинг
  // би искал отделно основание/opt-in). Nullable: Discord може да не върне
  // имейл (потребител без потвърден имейл / отказан scope).
  email         String?
  globalRole    GlobalRole @default(USER)
  isBlacklisted Boolean    @default(false)
  language      String     @default("en") // v2.1: preferred UI language (en, bg, it, de, es, fr, pt, ru, pl, tr)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  serverMembers   ServerMember[]
  sessions        Session[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  tickets         Ticket[]       @relation("TicketCreator")
  assignedTickets Ticket[]       @relation("TicketAssignee")
  applications    Application[]
  apiKeys         ApiKey[]

  @@map("users")
}

enum GlobalRole {
  MAIN_OWNER
  SUPER_USER
  SUPPORT_STAFF
  USER
}

// Хранилището на express сесиите (connect-pg-simple). Таблицата се СЪЗДАВА от
// самата библиотека (`createTableIfMissing: true`) и от initial миграцията, но
// не съществуваше в тази схема — а Prisma смята схемата за истината. Първият
// `prisma migrate dev` щеше да я обяви за дрейф и да генерира DROP TABLE:
// всички влезли потребители изхвърчат, и то не от бъг, а от рутинна миграция.
// Моделът е тук ЕДИНСТВЕНО за да я знае Prisma — приложението никога не пише
// през него (пише express-session).
model ExpressSession {
  // `@db.VarChar` НЕ е украса: таблицата се създава от `connect-pg-simple`
  // (виж migration v40), който я декларира като `character varying`. Без този
  // атрибут Prisma очаква TEXT и `migrate diff` вечно докладва разлика.
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_express_sessions_expire")
  @@map("express_sessions")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVERS (GUILDS)
// ─────────────────────────────────────────────────────────────────────────────

model Server {
  id                    String    @id // Discord guild ID
  name                  String
  icon                  String?
  ownerId               String
  isPremium             Boolean   @default(false)
  premiumSince          DateTime?
  // ─── v3.0 Tiers ──────────────────────────────────────────────────────────
  // Effective billing tier for THIS server's own subscription:
  //   free | premium | whitelabel | agency5 | agency10
  // For servers covered by an Agency plan, `plan` stays "free" and the effective
  // tier is resolved from the linked Agency at runtime (see lib/premium.js).
  // `isPremium` is kept in sync (true when plan != free) for backward-compat.
  plan                  String    @default("free")
  billingInterval       String? // "month" | "year" (own Stripe subscription)
  planSource            String? // "stripe" | "discord" | "manual" | "trial"
  // v2.0 Trial system
  trialUsed             Boolean   @default(false) // Each server gets one 14-day trial
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  // v2.1 Localization
  language              String    @default("en") // Server-wide bot UI language
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripeStatus          String? // active, canceled, past_due, trialing
  // C3 — Dunning guard: маркер кога абонаментът е влязъл в past_due. Scheduler
  // сваля isPremium=false ако past_due е по-старо от 14 дни (виж jobs/dunning.js).
  // Изчиства се при връщане към active/trialing.
  pastDueSince          DateTime?
  // v40 — ДОСТЪП ДО КРАЙНИЯ СРОК (решение на собственика, 07.08.2026).
  // Клиент, който ОТМЕНИ абонамента си, ползва услугата до края на платения
  // период — той вече е платил за него. Stripe праща customer.subscription.deleted
  // в момента на отмяната (при незабавна отмяна) или в края на периода, затова
  // моментът на събитието НЕ е моментът на отнемане. Тук пазим докога е платено.
  //
  // НЕ важи при refund/chargeback: там парите се връщат, значи достъпът пада
  // веднага и това поле се занулява.
  accessUntil           DateTime?
  // Тарифата, за която е платено — пази се отделно, защото `plan` пада на
  // "free" в момента на отмяната. Без нея гратисният период би върнал „premium“
  // на клиент, платил whitelabel, т.е. тихо отнета функция, за която има пари.
  gracePlan             String?
  // White-label custom bot token (White-label / Agency tiers)
  customBotToken        String?
  customBotName         String?
  customBotAvatar       String?
  // ─── v3.0 Discord native monetization (Premium Apps entitlements) ─────────
  // When a server is upgraded via Discord's own subscription SKUs, we record
  // the entitlement so ENTITLEMENT_DELETE can revoke access. SKU → plan mapping
  // lives in lib/premium.js (skuToPlan). Mutually exclusive with a Stripe sub.
  discordEntitlementId  String?   @unique
  discordSkuId          String?
  // ─── v3.0 Agency (multi-server) membership ───────────────────────────────
  // Non-null when this server's tier is provided by an Agency seat.
  agencyId              String?
  // Settings
  logChannelId          String?
  archiveChannelId      String?
  // Round-Robin ticket assignment (Premium)
  roundRobinEnabled     Boolean   @default(false)
  roundRobinRoleId      String? // Discord role to cycle through
  roundRobinIndex       Int       @default(0)
  // AI auto-replies (Premium)
  aiRepliesEnabled      Boolean   @default(false)
  aiRepliesPrompt       String? // Custom system prompt (max 1000 chars)
  // Archive retention (null = forever/Premium, 30 = Base default)
  archiveRetentionDays  Int?      @default(30)
  // Soft-delete marker when bot is kicked from Discord guild.
  // Keeps Stripe/payment/audit history intact. Cleared on re-join.
  botRemovedAt          DateTime?
  // ─── v1.6 appy.bot-style server-level features ───────────────────────────
  welcomerEnabled       Boolean   @default(false)
  welcomerChannelId     String?
  welcomerMessage       String?   @db.Text // Supports {user}, {server}, {server.members}, {date}
  welcomerEmbedColor    String?   @default("#00e5ff")
  welcomerDmEnabled     Boolean   @default(false)
  welcomerDmMessage     String?   @db.Text
  autoroleIds           String[]  @default([]) // Roles given to new members
  autoroleBotIds        String[]  @default([]) // Roles given to bots on join
  stickyMessagesEnabled Boolean   @default(false)
  // v45 — „лепкави роли": ролите на напусналия се пазят и се връщат при
  // повторно присъединяване. ИЗРИЧНО opt-in (default false): автоматичното
  // връщане на роли е решение със сигурностна тежест — напуснал модератор,
  // който се върне, иначе би си върнал достъпа сам. Опасните роли не се
  // връщат никога (виж roleAssignabilityReason в бота).
  stickyRolesEnabled    Boolean   @default(false)

  // Server event logging (member/voice/moderation activity) — per-server opt-in
  eventLogEnabled    Boolean  @default(false)
  eventLogChannelId  String?
  // v38 — „messages" НЕ е по подразбиране. Тя е единствената категория, която
  // чете съдържание на съобщения извън тикет каналите, тоест единствената, която
  // ползва привилегирования MessageContent intent за нещо различно от тикет
  // транскрипта. Да се включва мълчаливо заедно с общия ключ значи сървър да
  // започне да записва чужди разговори без отделно решение на администратора.
  // Заварените сървъри не се пипат — default важи само за нови редове.
  eventLogCategories String[] @default(["voice", "members", "moderation"])
  // v37 — по избор СВОЙ канал за всяка категория: { "voice": "123", "members": "456" }.
  // Липсваща категория пада обратно към общия eventLogChannelId, така че
  // заварените конфигурации продължават да работят без промяна.
  eventLogChannels   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members              ServerMember[]
  panels               Panel[]
  forms                Form[]
  tickets              Ticket[]
  applications         Application[]
  verificationPanels   VerificationPanel[]
  auditLogs            AuditLog[]
  paymentLogs          PaymentLog[]
  kbArticles           KbArticle[]
  reactionRoleMessages ReactionRoleMessage[]
  agency               Agency?               @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([trialEndsAt])
  // v40 — метлата за изтекъл гратис сканира точно по тази колона.
  @@index([accessUntil])
  @@map("servers")
  memberRoleSnapshots MemberRoleSnapshot[]
}

// ─────────────────────────────────────────────────────────────────────────────
// v3.0 — AGENCY (multi-server plan)
// ─────────────────────────────────────────────────────────────────────────────
// One subscription (Stripe or Discord) that grants the White-label tier to up
// to `seatLimit` servers. The owner assigns/removes servers up to the seat cap.
// Access is provisioned ONLY through a verified Stripe webhook / Discord
// entitlement — never from a client redirect (see conventions in CLAUDE.md).
model Agency {
  id                   String    @id @default(cuid())
  ownerUserId          String // Discord user id of the agency owner
  plan                 String // "agency5" | "agency10"
  seatLimit            Int // 5 or 10
  billingInterval      String? // "month" | "year"
  planSource           String    @default("stripe") // "stripe" | "discord" | "manual"
  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripeStatus         String? // active, canceled, past_due, trialing
  pastDueSince         DateTime?
  // v40 — същата семантика като при Server: отмяна → местата живеят до края на
  // платения период; refund/chargeback → падат веднага (полето се занулява).
  accessUntil          DateTime?
  // Discord native monetization
  discordEntitlementId String?   @unique
  discordSkuId         String?
  active               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  servers     Server[]
  paymentLogs PaymentLog[]

  @@index([ownerUserId])
  @@index([accessUntil])
  @@map("agencies")
}

/// v45 — снимка на Discord ролите на напуснал член, за да му бъдат върнати
/// при повторно присъединяване („лепкави роли").
///
/// ВАЖНО: тук НЯМА външен ключ към `User`. Членът на Discord сървър почти
/// никога не е наш потребител в таблото — външен ключ би провалял записа за
/// всеки, който не е влизал при нас (точно дефектът, който събаряше
/// регистрацията на сървъри през `AuditLog.actorId`).
model MemberRoleSnapshot {
  id         String   @id @default(cuid())
  serverId   String
  userId     String   // Discord ID — нарочно БЕЗ релация към User
  roleIds    String[] @default([])
  capturedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([capturedAt]) // ретенцията чисти старите снимки по този индекс
  @@map("member_role_snapshots")
}

model ServerMember {
  id         String     @id @default(cuid())
  serverId   String
  userId     String
  serverRole ServerRole @default(MEMBER)
  joinedAt   DateTime   @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("server_members")
}

enum ServerRole {
  ADMIN
  MODERATOR
  MEMBER
}

// ─────────────────────────────────────────────────────────────────────────────
// PANELS (Visual button panels for tickets)
// ─────────────────────────────────────────────────────────────────────────────

model Panel {
  id                        String         @id @default(cuid())
  serverId                  String
  name                      String
  title                     String
  description               String?
  color                     String         @default("#5865F2")
  thumbnailUrl              String?
  imageUrl                  String?
  // Discord IDs after panel is spawned
  channelId                 String?
  messageId                 String?
  // v37 — позиция в ГРУПОВО съобщение (няколко панела, общ messageId).
  // Без нея редакцията подреждаше по createdAt и разбъркваше избрания от
  // потребителя ред. NULL за самостоятелните панели.
  groupOrder                Int?
  // Как изглежда групата: DROPDOWN (едно слято меню) | BUTTONS (общи бутони)
  // | STACK (отделен блок за всеки панел). Пази се, за да не разпадне
  // редакцията слятото меню обратно на блокове.
  groupMode                 String?
  // Ticket settings
  categoryId                String? // Discord category for new tickets (legacy, use categoryOpenId)
  supportRoleIds            String[] // Roles that can see tickets
  maxOpenPerUser            Int            @default(1)
  namingTemplate            String         @default("ticket-{username}")
  // ─── TicketTool-style v1.5 additions ─────────────────────────────────────────
  categoryOpenId            String? // Category for open tickets (preferred over categoryId)
  categoryClosedId          String? // Category tickets move to after "Close"
  logChannelId              String? // Separate from transcript: logs open/close/claim events
  transcriptChannelId       String? // Where HTML transcripts post on delete
  channelNamePrefix         String         @default("ticket") // e.g. "ticket-0001-username"
  ticketCounter             Int            @default(0) // Auto-increment, ATOMIC on open
  counterPadding            Int            @default(4) // "0001", "00001", etc.
  welcomeMessage            String?        @db.Text // Supports {user}, {ticket.count}, etc.
  welcomeEmbedColor         String         @default("#00e5ff")
  closeAskEnabled           Boolean        @default(true) // Two-step close
  closeAskMessage           String?        @db.Text // "Are you sure?" embed text
  dmOnOpen                  Boolean        @default(false)
  dmOnOpenMessage           String?        @db.Text
  dmOnClose                 Boolean        @default(false)
  dmOnCloseMessage          String?        @db.Text
  observerRoleIds           String[]       @default([]) // Can see ticket but can't talk
  maxOpenPerUserPanel       Int? // Per-panel limit (null = unlimited)
  buttonStyle               String         @default("BUTTON") // BUTTON | DROPDOWN | THREAD
  inactivityCloseHours      Int? // Auto-close after N hours (Premium)
  autoCloseOnLeave          Boolean        @default(false) // Close ticket when creator leaves guild
  feedbackEnabled           Boolean        @default(false) // DM rating prompt after close
  // ─── v1.7 Verification gate ──────────────────────────────────────────────
  requireVerifiedRoleIds    String[]       @default([]) // User must have ALL these roles to open ticket
  verificationDeniedMessage String?        @db.Text // Custom "you need X role" message
  // ─── v30 Ticket priority ──────────────────────────────────────────────────
  // Applied to every ticket created from this panel unless overridden later.
  defaultPriority           TicketPriority @default(NORMAL)
  // ─── v31 SLA tracking (Premium) ──────────────────────────────────────────
  // Minutes; null = SLA disabled for that dimension. Gated by "panel.sla" in
  // lib/premium.js (see validatePremiumFields in routes/panels.js).
  slaFirstResponseMinutes   Int?
  slaResolutionMinutes      Int?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  server  Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  buttons PanelButton[]
  tickets Ticket[]

  @@index([serverId])
  @@map("panels")
}

model PanelButton {
  id      String  @id @default(cuid())
  panelId String
  label   String
  emoji   String?
  style   String  @default("PRIMARY") // PRIMARY, SECONDARY, SUCCESS, DANGER
  // What happens when clicked
  formId  String? // If set, opens a form instead of creating a ticket directly

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  form  Form? @relation(fields: [formId], references: [id], onDelete: SetNull)

  @@map("panel_buttons")
}

// ─────────────────────────────────────────────────────────────────────────────
// VERIFICATION PANELS (v1.7 — anti-bot gate)
// ─────────────────────────────────────────────────────────────────────────────

model VerificationPanel {
  id                String   @id @default(cuid())
  serverId          String
  name              String // internal/admin name
  title             String // embed title
  description       String?  @db.Text
  color             String   @default("#00e5ff")
  imageUrl          String?
  thumbnailUrl      String?
  // Where the panel is spawned in Discord
  channelId         String?
  messageId         String?
  // Verification method
  type              String   @default("BUTTON") // BUTTON | MATH | REACTION
  buttonLabel       String   @default("Verify")
  buttonEmoji       String?
  buttonStyle       String   @default("SUCCESS") // PRIMARY | SECONDARY | SUCCESS | DANGER
  successMessage    String?  @db.Text // "You're verified!"
  failureMessage    String?  @db.Text // "Wrong answer. Try again."
  // Math captcha difficulty — defines number range
  mathDifficulty    String   @default("EASY") // EASY (1-10), MEDIUM (1-50), HARD (1-100)
  // Roles applied on success
  grantRoleIds      String[] @default([]) // Given on successful verification
  removeRoleIds     String[] @default([]) // Removed on successful verification
  // Anti-bot: minimum account age
  minAccountAgeDays Int? // Block accounts younger than this
  // Logging
  logChannelId      String?
  dmOnSuccess       Boolean  @default(false)
  dmSuccessMessage  String?  @db.Text
  // Analytics
  successCount      Int      @default(0)
  failCount         Int      @default(0)
  // Attempt limits — prevent brute-forcing MATH captcha
  maxAttempts       Int      @default(5) // Attempts before cooldown
  cooldownMinutes   Int      @default(10) // Cooldown after maxAttempts

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  server   Server                @relation(fields: [serverId], references: [id], onDelete: Cascade)
  attempts VerificationAttempt[]

  @@index([serverId])
  @@map("verification_panels")
}

model VerificationAttempt {
  id                  String   @id @default(cuid())
  verificationPanelId String
  userId              String
  success             Boolean  @default(false)
  answer              String? // What the user entered (for MATH)
  ip                  String? // Bot interaction doesn't give IP, stays null
  createdAt           DateTime @default(now())

  panel VerificationPanel @relation(fields: [verificationPanelId], references: [id], onDelete: Cascade)

  @@index([verificationPanelId, userId, createdAt])
  @@map("verification_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// FORMS (Logic-branching questionnaires)
// ─────────────────────────────────────────────────────────────────────────────

model Form {
  id                  String    @id @default(cuid())
  serverId            String
  name                String
  description         String?
  isApplication       Boolean   @default(false) // true = application form, false = ticket intake form
  // Where to send the filled form
  reviewChannelId     String? // Channel to post the review embed
  // ─── Appy.bot-style application features ───
  acceptRoleIds       String[]  @default([]) // Roles granted on accept
  denyRoleIds         String[]  @default([]) // Roles granted on deny (e.g. "verified no")
  removeRoleIds       String[]  @default([]) // Roles removed on accept (e.g. "pending")
  managerRoleIds      String[]  @default([]) // Roles allowed to review (beyond Manage Server)
  pingRoleIds         String[]  @default([]) // Roles pinged when new submission arrives
  acceptMessage       String?   @db.Text // DM to applicant on accept (markdown)
  denyMessage         String?   @db.Text // DM to applicant on deny (markdown)
  cooldownSeconds     Int?      @default(0) // Per-user cooldown between submissions
  maxSubmissions      Int? // Total cap per user (null = unlimited)
  closedAt            DateTime? // Applications closed — rejects new submissions
  requireVerification Boolean   @default(false) // Captcha-style "solve to submit"
  transcriptChannelId String? // Where to post application transcript on approve/deny
  discussCategoryId   String? // v34 — Discord category where discuss channels open (null = auto-pick)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  server       Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  questions    FormQuestion[]
  applications Application[]
  panelButtons PanelButton[]
  cooldowns    FormCooldown[]

  @@index([serverId])
  @@map("forms")
}

model FormCooldown {
  id              String   @id @default(cuid())
  formId          String
  userId          String
  lastSubmittedAt DateTime @default(now())
  submissionCount Int      @default(1)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
  @@index([formId, userId])
  @@map("form_cooldowns")
}

model FormQuestion {
  id                String       @id @default(cuid())
  formId            String
  order             Int
  label             String
  placeholder       String?
  type              QuestionType @default(SHORT_TEXT)
  required          Boolean      @default(true)
  minLength         Int?
  maxLength         Int?
  // Logic branching
  choices           String[] // For SELECT type
  branches          Json? // { "choice_value": next_question_id }
  // Appy.bot-style validation
  validationRegex   String? // e.g. "^\\d{4}$" for 4-digit codes
  validationMessage String? // Shown to user on validation failure

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_questions")
}

enum QuestionType {
  SHORT_TEXT
  PARAGRAPH
  SELECT
  MULTI_SELECT
  NUMBER
}

// ─────────────────────────────────────────────────────────────────────────────
// TICKETS
// ─────────────────────────────────────────────────────────────────────────────

model Ticket {
  id                      String         @id @default(cuid())
  serverId                String
  panelId                 String?
  creatorId               String
  assigneeId              String?
  status                  TicketStatus   @default(OPEN)
  // v30 — staff-set urgency, independent of status. Defaults from
  // Panel.defaultPriority at creation time; changed via /ticket priority.
  priority                TicketPriority @default(NORMAL)
  // ─── v31 SLA tracking (Premium) ────────────────────────────────────────
  // Set once, on the first non-creator message (see routes/bot.js). Null
  // means "no staff reply yet" — used by the breach scheduler job.
  firstResponseAt         DateTime?
  // Marks that a breach (first-response OR resolution) was already notified,
  // so the scheduler doesn't re-notify every 10 minutes.
  slaBreachedAt           DateTime? // first-response пробив (v44: отделен от resolution)
  slaResolutionBreachedAt DateTime? // resolution пробив — двата вида са НЕЗАВИСИМИ аларми
  // Discord IDs
  channelId               String? // Thread or channel ID
  // Linked application (escalation)
  applicationId           String?        @unique
  // Archive
  archiveUrl              String?
  archiveHtml             String? // Full HTML transcript
  // Unguessable token required to view the public archive page — cuids are
  // not secrets and transcript HTML contains PII.
  archiveToken            String?
  closedAt                DateTime?
  closeReason             String?
  // ─── v1.5 TicketTool-style additions ─────────────────────────────────────────
  number                  Int? // Auto-increment per panel (ticket-0042)
  reopenedAt              DateTime?
  reopenCount             Int            @default(0)
  renamedFrom             String? // Original channel name if renamed
  feedbackRating          Int? // 1-5 stars after close
  feedbackComment         String?        @db.Text
  feedbackAt              DateTime?
  lastActivityAt          DateTime       @default(now()) // For inactivity auto-close
  inactivityNotifiedAt    DateTime? // Prevents spam of "about to close" warnings
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  server      Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  panel       Panel?          @relation(fields: [panelId], references: [id], onDelete: SetNull)
  creator     User            @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]

  @@index([serverId, status])
  @@index([creatorId])
  // v46 — изтриването на акаунт (чл. 17) занулява assigneeId през SET NULL;
  // без индекс това е сканиране на най-голямата таблица при всяко изтриване.
  @@index([assigneeId])
  @@index([serverId, priority])
  // Ботът търси тикет по канал при ВСЯКО съобщение в тикет-канал — индексът
  // съществуваше само в SQL миграция, значи `prisma migrate dev` щеше да го
  // изтрие като „дрейф“ и да върне пълно сканиране в най-горещия път.
  @@index([channelId])
  // Списъци и експорти подреждат по createdAt (и курсорът в export.js стъпва
  // на него) — без индекс всяка страница сортира цялата таблица на сървъра.
  @@index([serverId, createdAt])
  // Гейтът „максимум N отворени тикета на този панел за този потребител“
  // (`routes/bot.js` при СЪЗДАВАНЕ на тикет — горещият път) филтрира по трите
  // колони наведнъж. Без индекс това е скан по всички тикети на панела при
  // всяко отваряне. Редът е по селективност: panelId стеснява най-много,
  // creatorId свежда до шепа редове, status довършва брояча без връщане към
  // таблицата. (Скоростника, одит кръг 2, 07.08.2026)
  @@index([panelId, creatorId, status])
  @@index([panelId, number])
  @@index([status, lastActivityAt])
  @@map("tickets")
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
  ARCHIVED
}

// v30 — staff-facing urgency label for tickets/panels (Ticket Tool parity).
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model TicketMessage {
  id              String    @id @default(cuid())
  ticketId        String
  authorId        String
  authorTag       String
  content         String
  attachments     String[]
  createdAt       DateTime  @default(now())
  // ─── v36 Одитна следа на редакции/изтривания ──────────────────────────
  // Discord ID-то на съобщението. БЕЗ него редакция или изтриване нямаше как
  // да се свърже със записания ред — затова транскриптът показваше вечно
  // първоначалния текст и не знаеше, че съобщение е изтрито.
  messageId       String?
  // Първоначалният текст, запазен при ПЪРВАТА редакция (после не се пипа —
  // транскриптът трябва да показва какво е било казано, не последната версия).
  originalContent String?
  editedAt        DateTime?
  deletedAt       DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Application {
  id              String            @id @default(cuid())
  serverId        String
  formId          String
  userId          String
  status          ApplicationStatus @default(PENDING)
  // Filled answers: { question_id: answer }
  answers         Json
  // Discord review message
  reviewMessageId String?
  reviewChannelId String?
  // Escalation to ticket
  ticket          Ticket?
  reviewerId      String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  form   Form   @relation(fields: [formId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([serverId, status])
  @@index([userId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  INTERVIEW
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  serverId  String?
  actorId   String? // Nullable to support SYSTEM actions (bot join/leave)
  actorTag  String? // Human-readable tag when no actorId (e.g. "SYSTEM")
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([serverId])
  @@index([action]) // v44: мониторинг заявката LIKE 'JOB_OK_%' GROUP BY action
  // v46 — чл. 15 експортът търси субекта И като АКТЬОР, И като ОБЕКТ:
  //   where: { OR: [{ actorId }, { targetId }] }
  // Без тези два индекса заявката сканира ЦЯЛАТА таблица, а тя расте с всяко
  // действие в продукта. Postgres НЕ индексира външните ключове сам.
  @@index([actorId])
  @@index([targetId])
  // Ретенцията трие по възраст, а админският изглед подрежда по време.
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// STRIPE / PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model PaymentLog {
  id              String   @id @default(cuid())
  // Точно ЕДНО от двете е попълнено: плащането е или на сървър, или на агенция.
  // Prisma не може да изрази „ровно едно", затова инвариантът се пази в кода
  // (единствените писачи са webhook-ите в routes/stripe.js и ръчният запис в
  // routes/admin.js) и се проверява от тест.
  serverId        String?
  agencyId        String?
  stripeInvoiceId String?  @unique
  amount          Int // in cents
  currency        String   @default("eur") // F6 — продуктът таксува в евро (ЕС)
  status          String // paid, open, void, uncollectible
  description     String?
  createdAt       DateTime @default(now())

  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([agencyId])
  @@map("payment_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// STRIPE WEBHOOK IDEMPOTENCY (F1+F2)
// ─────────────────────────────────────────────────────────────────────────────
// Маркер за вече обработено Stripe събитие. Записва се в СЪЩАТА транзакция
// като бизнес-ефекта, ключиран по event.id (PK). Втора доставка на същото
// събитие хвърля P2002 → транзакцията се отказва → ефектът не се дублира.
model ProcessedStripeEvent {
  id        String   @id // Stripe event.id (evt_...)
  type      String // event.type, за одит/диагностика
  createdAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// v1.8 — POLLS
// ─────────────────────────────────────────────────────────────────────────────

model Poll {
  id          String    @id @default(cuid())
  serverId    String
  creatorId   String
  channelId   String
  messageId   String?
  question    String
  options     String[]  @default([])
  multiChoice Boolean   @default(false)
  anonymous   Boolean   @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  votes PollVote[]

  // Дашбордът чете анкетите на сървър, а планировчикът търси падежиралите —
  // моделът нямаше НИТО ЕДИН индекс, тоест и двете бяха пълно сканиране.
  @@index([serverId])
  @@index([closesAt, closedAt])
  @@map("polls")
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  option    Int
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, option])
  @@index([pollId])
  @@map("poll_votes")
}

// ─────────────────────────────────────────────────────────────────────────────
// v1.8 — GIVEAWAYS
// ─────────────────────────────────────────────────────────────────────────────

model Giveaway {
  id              String    @id @default(cuid())
  serverId        String
  creatorId       String
  channelId       String
  messageId       String?
  prize           String
  description     String?   @db.Text
  winnerCount     Int       @default(1)
  endsAt          DateTime
  endedAt         DateTime?
  winnerIds       String[]  @default([])
  requiredRoleIds String[]  @default([])
  createdAt       DateTime  @default(now())

  entries GiveawayEntry[]

  @@index([endsAt, endedAt])
  @@map("giveaways")
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  createdAt  DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@map("giveaway_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// v1.8 — SCHEDULED MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model ScheduledMessage {
  id               String    @id @default(cuid())
  serverId         String
  channelId        String
  content          String    @db.Text
  embedTitle       String?
  embedDescription String?   @db.Text
  embedColor       String    @default("#00e5ff")
  sendAt           DateTime
  recurrence       String? // daily | weekly | monthly | null(one-shot)
  sentAt           DateTime?
  nextAt           DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())

  @@index([sendAt, sentAt])
  @@index([nextAt])
  @@map("scheduled_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// v1.8 — STICKY MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model StickyMessage {
  id               String   @id @default(cuid())
  serverId         String
  channelId        String   @unique
  content          String   @db.Text
  embedTitle       String?
  embedColor       String   @default("#00e5ff")
  currentMessageId String?
  enabled          Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("sticky_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.9 — CANNED RESPONSES (/tag) — #1 staff request (Ticket Tool parity)
// ─────────────────────────────────────────────────────────────────────────────
// No `serverId` relation field on Server on purpose (same pattern as
// StickyMessage/ScheduledMessage above) — the bot always scopes reads/writes
// by serverId itself; a formal relation isn't needed for the query patterns here.

model CannedResponse {
  id         String   @id @default(cuid())
  serverId   String
  name       String // kebab-case, ≤32 chars — validated bot-side before create
  content    String   @db.Text // ≤1500 chars — validated bot-side before create
  usageCount Int      @default(0)
  createdBy  String // Discord user id
  createdAt  DateTime @default(now())

  @@unique([serverId, name])
  @@index([serverId])
  @@map("canned_responses")
}

// ─────────────────────────────────────────────────────────────────────────────
// v1.8 — WEBHOOKS (event integrations)
// ─────────────────────────────────────────────────────────────────────────────

model Webhook {
  id             String    @id @default(cuid())
  serverId       String
  name           String
  url            String    @db.Text
  secret         String?   @db.Text
  enabled        Boolean   @default(true)
  events         String[]  @default([])
  lastDeliveryAt DateTime?
  lastStatus     Int?
  failCount      Int       @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([serverId, enabled])
  @@map("webhooks")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.1 — API KEYS (public API access)
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  serverId     String // Scoped to single server — prevents cross-server reads
  name         String
  keyHash      String    @unique // SHA-256 hash; plaintext shown only at creation
  keyPrefix    String // First 8 chars for identification (e.g. "bp_live_abc123xx")
  scopes       String[]  @default([]) // ["tickets:read", "tickets:write", "forms:read", ...]
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  requestCount Int       @default(0)
  createdBy    String? // v2.1 — Discord user ID who created the key (same as userId usually)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serverId, revokedAt])
  @@index([keyHash])
  @@map("api_keys")
}

// ═════════════════════════════════════════════════════════════════════════════
// v32 — KNOWLEDGE BASE (staff-written articles, auto-suggested on new tickets)
// ═════════════════════════════════════════════════════════════════════════════
// The Ticket Tool differentiator: staff write short articles with keywords;
// the bot suggests the best match as an embed on new tickets (see
// lib/kbMatch.js for the pure scoring function + routes/bot_v18.js for the
// bot-secret suggest/feedback endpoints). Count is gated by plan (see
// BASE_LIMITS.kbArticles / PREMIUM_LIMITS.kbArticles in lib/premium.js).
model KbArticle {
  id              String   @id @default(cuid())
  serverId        String
  title           String // ≤120 chars — validated in routes/kb.js
  content         String   @db.Text // ≤4000 chars
  keywords        String[] @default([]) // up to 10, lowercase — validated in routes/kb.js
  enabled         Boolean  @default(true)
  usageCount      Int      @default(0) // Incremented each time the bot suggests this article
  helpfulCount    Int      @default(0) // kb_fb:{id}:1 votes
  notHelpfulCount Int      @default(0) // kb_fb:{id}:0 votes
  createdBy       String // Discord user id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("kb_articles")
}

// ═════════════════════════════════════════════════════════════════════════════
// v2.1 — DAILY METRICS SNAPSHOTS (for analytics 2.0 time-series)
// ═════════════════════════════════════════════════════════════════════════════

model DailyMetric {
  id                   String   @id @default(cuid())
  serverId             String
  date                 DateTime @db.Date // One row per server per day
  ticketsOpened        Int      @default(0)
  ticketsClosed        Int      @default(0)
  ticketsEscalated     Int      @default(0)
  formsSubmitted       Int      @default(0)
  applicationsApproved Int      @default(0)
  applicationsDenied   Int      @default(0)
  verificationsSuccess Int      @default(0)
  verificationsFailure Int      @default(0)
  avgResponseTimeSec   Int? // First-reply time median
  avgResolutionTimeSec Int? // Open → close time median
  createdAt            DateTime @default(now())

  @@unique([serverId, date])
  @@index([serverId, date])
  @@map("daily_metrics")
}

// ═════════════════════════════════════════════════════════════════════════════
// v33 — REACTION ROLES (react → get a role)
// ═════════════════════════════════════════════════════════════════════════════
// Едно съобщение (embed) с N двойки emoji → роля. Ботът слуша
// messageReactionAdd/Remove и дава/маха ролята. `exclusive` = radio режим:
// максимум една роля от съобщението — нов реакт маха предишния.

model ReactionRoleMessage {
  id          String   @id @default(cuid())
  serverId    String
  title       String
  description String?
  color       String   @default("#5865F2")
  exclusive   Boolean  @default(false)
  // Попълват се при spawn в Discord (null = още не е публикувано)
  channelId   String?
  messageId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pairs  ReactionRolePair[]
  server Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("reaction_role_messages")
}

model ReactionRolePair {
  id     String  @id @default(cuid())
  rrmId  String
  // Unicode emoji ("🎮") или custom emoji идентификатор ("name:123456789")
  emoji  String
  roleId String
  label  String?

  rrm ReactionRoleMessage @relation(fields: [rrmId], references: [id], onDelete: Cascade)

  @@unique([rrmId, emoji])
  @@map("reaction_role_pairs")
}
