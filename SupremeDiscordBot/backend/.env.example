# ═══════════════════════════════════════════════════════════════════════════════
# Supreme Bot — Backend Environment Configuration
# Copy this file to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose: use service name "postgres" not "localhost"
DATABASE_URL="postgresql://bot:CHANGE_THIS_PASSWORD@postgres:5432/discordbot"

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING"

# AES-256-GCM key for encrypting bot tokens in DB — REQUIRED
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="PASTE_64_HEX_CHARS_HERE"

# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# From: https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# Must match exactly what's registered in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI="https://YOUR_DOMAIN.COM/api/auth/callback"

# ─── Access Control ───────────────────────────────────────────────────────────
# Your personal Discord User ID — grants permanent Main Owner dashboard access
# Get it: Discord → Settings → Advanced → Developer Mode → right-click your name
MAIN_OWNER_ID="YOUR_DISCORD_USER_ID"

# ─── Internal API Security ────────────────────────────────────────────────────
# Shared secret between backend and bot — generate randomly, keep secret
# Generate: openssl rand -base64 32
API_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# ─── Service URLs ─────────────────────────────────────────────────────────────
# Public URL of the frontend (no trailing slash)
FRONTEND_URL="https://YOUR_DOMAIN.COM"
# Docker internal URL of the bot's HTTP server
BOT_API_URL="http://bot:3001"
PORT=3000
NODE_ENV="production"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# From Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Your recurring monthly Premium price ID
STRIPE_PRICE_ID="price_..."
# Free trial length in days (set to 0 to disable)
STRIPE_TRIAL_DAYS=14

# ─── Google Gemini (optional) ─────────────────────────────────────────────────────
# Required only for the AI auto-reply Premium feature (Gemini Flash, free tier).
# ВНИМАНИЕ: на безплатния tier Google може да ползва подадено съдържание за
# подобряване на услугите си (отразено в Privacy Policy §5).
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Модел (по избор; default gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# ─── Discord bot token ───────────────────────────────────────────────────────
# Same token as bot/.env BOT_TOKEN — used for round-robin role-member lookups
BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Used by the public status page cache health check
REDIS_URL="redis://redis:6379"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Production error monitoring — get DSN from https://sentry.io
SENTRY_DSN=""
