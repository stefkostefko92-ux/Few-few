# ═══════════════════════════════════════════════════════════════════════════════
# Supreme Bot — Backend Environment Configuration
# Copy this file to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose: use service name "postgres" not "localhost"
DATABASE_URL="postgresql://bot:CHANGE_THIS_PASSWORD@postgres:5432/discordbot"

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING"

# AES-256-GCM key for encrypting bot tokens in DB — REQUIRED
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="PASTE_64_HEX_CHARS_HERE"

# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# From: https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# Must match exactly what's registered in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI="https://YOUR_DOMAIN.COM/api/auth/callback"

# ─── Access Control ───────────────────────────────────────────────────────────
# Your personal Discord User ID — grants permanent Main Owner dashboard access
# Get it: Discord → Settings → Advanced → Developer Mode → right-click your name
MAIN_OWNER_ID="YOUR_DISCORD_USER_ID"

# ─── Internal API Security ────────────────────────────────────────────────────
# Shared secret between backend and bot — generate randomly, keep secret
# Generate: openssl rand -base64 32
# Used by every backend → bot internal call, including the transactional DM
# notices (trial expiry, failed payment) via POST /internal/dm-user.
# NO new secret is needed for those — same channel, same header (x-bot-secret).
API_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# ─── Service URLs ─────────────────────────────────────────────────────────────
# Public URL of the frontend (no trailing slash)
FRONTEND_URL="https://YOUR_DOMAIN.COM"
# Docker internal URL of the bot's HTTP server
BOT_API_URL="http://bot:3001"
PORT=3000
NODE_ENV="production"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# From Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Цените на ВСЯКА платена тарифа × период. Пусни `scripts/stripe-setup.sh` и
# копирай стойностите от изхода му — скриптът ги създава с tax_behavior=inclusive
# (цените са с включен ДДС, както ги обявяваме).
#
# ЗАДЪЛЖИТЕЛНИ, ако STRIPE_SECRET_KEY е попълнен. Липсваща цена НЕ спира старта,
# но е по-опасна от изключен Stripe: checkout за останалите тарифи работи, а
# webhook-ът не разпознава платената цена и пада на резервния план „premium“ —
# клиент плаща Agency 10 (39,99 €) и получава Premium. Стартът изброява липсите
# в лога; не пускай в продукция с червен ред. (Одит 07.08.2026)
#
# Всяка променлива приема и СПИСЪК, разделен със запетаи: при ценова промяна
# новата цена е ПЪРВА (ползва се за checkout), а старите остават, за да се
# разпознават при подновяване на заварените абонати.
STRIPE_PRICE_PREMIUM_MONTH="price_..."
STRIPE_PRICE_PREMIUM_YEAR="price_..."
STRIPE_PRICE_WHITELABEL_MONTH="price_..."
STRIPE_PRICE_WHITELABEL_YEAR="price_..."
STRIPE_PRICE_AGENCY5_MONTH="price_..."
STRIPE_PRICE_AGENCY5_YEAR="price_..."
STRIPE_PRICE_AGENCY10_MONTH="price_..."
STRIPE_PRICE_AGENCY10_YEAR="price_..."
# Billing Portal конфигурация от scripts/stripe-setup.sh (bpc_...). БЕЗ нея
# порталът излиза без subscription_update → клиентът НЯМА път за ъпгрейд,
# а кодът му обещава „Change plans from the billing portal". (одит 09.08.2026)
STRIPE_PORTAL_CONFIGURATION_ID=
# Наследена единична цена (историческите 9,99 € ВКЛЮЧВАХА white-label). Остави я
# празна при нова инсталация — попълва се само ако имаш заварени абонати по нея.
STRIPE_PRICE_ID=""
# Free trial length in days (set to 0 to disable)
STRIPE_TRIAL_DAYS=14

# ─── Discord монетизация (по избор) ───────────────────────────────────────────
# SKU идентификатори от Discord Developer Portal → Monetization. Попълни ги само
# ако продаваш и през Discord Premium Apps; без тях entitlement webhook-ите не
# могат да вържат покупката към тарифа.
# DISCORD_SKU_PREMIUM=""
# DISCORD_SKU_WHITELABEL=""
# DISCORD_SKU_AGENCY=""

# ─── Google Gemini (optional) ─────────────────────────────────────────────────────
# Required only for the AI auto-reply Premium feature (Gemini Flash, free tier).
# ВНИМАНИЕ: на безплатния tier Google може да ползва подадено съдържание за
# подобряване на услугите си (отразено в Privacy Policy §5).
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Модел (по избор; default gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# ─── Discord bot token ───────────────────────────────────────────────────────
# Same token as bot/.env BOT_TOKEN — used for round-robin role-member lookups
BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Used by the public status page cache health check
# Redis изисква парола (docker-compose пуска `--requirepass`). Формата е
# redis://:<парола>@redis:6379 — двоеточието преди паролата НЕ е грешка:
# потребителското име е празно. Паролата е СЪЩАТА като REDIS_PASSWORD в
# SupremeDiscordBot/.env.
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Production error monitoring — get DSN from https://sentry.io
SENTRY_DSN=""

# ─── top.gg (по избор, при листване) ──────────
# Webhook secret от top.gg → Edit bot → Webhooks (Authorization поле)
TOPGG_WEBHOOK_AUTH=""
