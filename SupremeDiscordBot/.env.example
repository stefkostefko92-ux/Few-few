# ═══════════════════════════════════════════════════════════════════════════════
# Supreme Bot — Docker Compose Environment
# Copy to .env and set strong values before deploying.
# This file ONLY contains variables used by docker-compose.yml itself
# (for postgres setup). Service-specific config lives in backend/.env, bot/.env,
# frontend/.env.
# ═══════════════════════════════════════════════════════════════════════════════

POSTGRES_DB=discordbot
POSTGRES_USER=bot
# Generate a strong one: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
