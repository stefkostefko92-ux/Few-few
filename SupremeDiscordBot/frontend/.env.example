# ═══════════════════════════════════════════════════════════════════════════════
# Supreme Bot — Frontend Environment Configuration
# Copy this file to .env and fill in all values before building.
# ═══════════════════════════════════════════════════════════════════════════════

# API path — /api is proxied by nginx to the backend (no change needed)
VITE_API_URL="/api"

# Your Discord Application Client ID (shown in bot invite links)
VITE_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"

# ─── Legal pages ──────────────────────────────────────────────────────────────
# These values appear in /terms, /privacy, /cookies, and /eula pages
VITE_COMPANY_NAME="YourCompanyName"
VITE_COMPANY_COUNTRY="Bulgaria"
VITE_CONTACT_EMAIL="legal@yourdomain.com"

# Link to your Discord support server (shown in sidebar and legal pages)
VITE_SUPPORT_URL="https://discord.gg/YOUR_INVITE_CODE"

# ─── Observability (optional) ─────────────────────────────────────────────────
# Frontend error monitoring — leave blank to disable. Get a DSN from sentry.io.
# When set, the Sentry ingest origin must also be allowed by the nginx CSP
# connect-src (already configured for *.sentry.io / *.ingest.sentry.io).
VITE_SENTRY_DSN=""
