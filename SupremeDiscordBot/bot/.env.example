# ═══════════════════════════════════════════════════════════════════════════════
# Supreme Bot — Bot Environment Configuration
# Copy this file to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Discord Bot ──────────────────────────────────────────────────────────────
# From: https://discord.com/developers/applications → Bot → Token
# NEVER commit this to git
BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"

# ─── Backend API ──────────────────────────────────────────────────────────────
# Docker internal URL — use service name "backend", not localhost
API_URL="http://backend:3000/api"
# Must match API_SECRET in backend/.env exactly
API_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# ─── Internal HTTP Server ─────────────────────────────────────────────────────
BOT_API_PORT=3001

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the frontend (no trailing slash)
FRONTEND_URL="https://YOUR_DOMAIN.COM"
# Base URL for archive links sent in Discord embeds
ARCHIVE_BASE_URL="https://YOUR_DOMAIN.COM"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Docker internal URL — form sessions survive bot restarts
# Redis изисква парола (docker-compose пуска `--requirepass`). Формата е
# redis://:<парола>@redis:6379 — двоеточието преди паролата НЕ е грешка:
# потребителското име е празно. Паролата е СЪЩАТА като REDIS_PASSWORD в
# SupremeDiscordBot/.env.
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"

# ─── Environment ──────────────────────────────────────────────────────────────
# Used by Sentry to tag events correctly
NODE_ENV="production"

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=""

# ─── Незадължителни адреси (имат подразбиране към продукционния домейн) ───────
# Четат се от БОТА (help, setup, guildCreate, friendlyError) — не от backend-а.
# Държат се тук нарочно: променлива, документирана в грешния пакет, е точно
# толкова безполезна, колкото и сгрешено име. (Одит етап 13, 12.08.2026)
# DASHBOARD_URL=""
# SUPPORT_URL=""
# STATUS_URL=""

