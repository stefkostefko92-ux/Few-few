# Carbon Stealth POS — лицензионен магазин. Копирай като .env и попълни.
# Тайните живеят САМО на сървъра (права 600), никога в репото.

STRIPE_SECRET_KEY="sk_live_..."          # Stripe → Developers → API keys (ползвай restricted key)
STRIPE_WEBHOOK_SECRET="whsec_..."        # Stripe → Webhooks → endpoint /api/webhook
BASE_URL="https://pos.carbonstealth.eu"  # публичният адрес на магазина

# Подписване на офлайн лицензите (npm run keys:generate)
LICENSE_PRIVATE_KEY_FILE="./data/license-signing.key"

# Откъде се сваля инсталаторът (едно от двете):
DOWNLOAD_FILE="./data/Carbon Stealth POS Setup 1.0.0.exe"
# DOWNLOAD_URL="https://..."

STORE_DB="./data/store.db"
PORT=8790
