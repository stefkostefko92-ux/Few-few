# Carbon Stealth POS — пример за конфигурация. Копирай като .env и попълни.
# Тайните живеят САМО на сървъра (права 600), никога в репото.

# SQLite база (offline-first: касата работи и без интернет)
DATABASE_URL="file:./cspos.db"

# Таен ключ за сесиите (генерирай: openssl rand -hex 32)
SESSION_SECRET="смени-ме-задължително"
