# Мастилко — променливи на средата (тайните живеят САМО на сървъра, mode 600)

# Google Gemini API ключ (https://aistudio.google.com/apikey)
# Без ключ сайтът работи изцяло — само AI подсказките са изключени.
# ВАЖНО (ЕС): условията на Gemini API изискват Paid tier, когато услугата се
# предлага на потребители в ЕИП — включи billing по Gemini API ключа преди
# продукция (Flash остава евтин; безплатната квота пак важи на paid tier).
GEMINI_API_KEY=

# Модел по подразбиране (безплатният Flash)
GEMINI_MODEL=gemini-2.5-flash
