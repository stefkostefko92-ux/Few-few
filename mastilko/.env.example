# Мастилко — променливи на средата (тайните живеят САМО на сървъра, mode 600)

# Google Gemini API ключ (безплатен tier: https://aistudio.google.com/apikey)
# Без ключ сайтът работи изцяло — само AI подсказките са изключени.
# Решение на собственика (2026-07): ползва се БЕЗПЛАТНИЯТ tier. Затова:
# - /poveritelnost изрично казва, че Google може да ползва заявките за
#   подобряване на продуктите си (вкл. преглед от хора) — не отслабвай текста;
# - до всеки AI бутон стои „не включвай лични данни“;
# - остатъчен риск: условията на Gemini API предвиждат Paid tier за ЕИП —
#   Google може да ограничи ключа.
GEMINI_API_KEY=

# Модел по подразбиране (безплатният Flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Админ панел (/admin) за рекламните банери ────────────────────────────────
# Таен ключ за подписване на админ сесията (мин. 32 знака). Генерирай с:
#   openssl rand -base64 48
# (base64 не съдържа „$“, затова е безопасен в .env — за разлика от bcrypt.)
SESSION_SECRET=

# Админите НЕ са тук — bcrypt хешовете съдържат „$“ и зареждачите на .env ги
# развалят. Живеят в data/admins.json. Добави админ с:
#   node scripts/hash-admin.mjs <потребител> <парола>
# (на сървъра: MASTILKO_DATA_DIR=/opt/mastilko/data node scripts/hash-admin.mjs …)

# Папка за данните на банерите и админите (JSON). На сървъра сочи писваема
# директория извън read-only корена; по подразбиране <cwd>/data.
# MASTILKO_DATA_DIR=/opt/mastilko/data
