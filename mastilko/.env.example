# Мастилко — променливи на средата (тайните живеят САМО на сървъра, mode 600)

# Google Gemini API ключ (безплатен tier: https://aistudio.google.com/apikey)
# Без ключ сайтът работи изцяло — само AI подсказките са изключени.
GEMINI_API_KEY=

# Модел по подразбиране (безплатният Flash)
GEMINI_MODEL=gemini-2.5-flash
