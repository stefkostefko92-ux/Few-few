# Базов адрес на API-то на Помагам. За локална разработка сочи към твоя backend,
# напр. http://192.168.1.10:4400 (IP на машината в локалната мрежа, не localhost,
# за да е достъпен от телефона). По подразбиране се ползва стойността от app.json.
EXPO_PUBLIC_API_BASE_URL=https://api.pomagam.carbonstealth.eu
