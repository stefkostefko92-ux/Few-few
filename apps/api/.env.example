# Помагам API — примерна конфигурация. Копирай в .env и попълни.
NODE_ENV=development
PORT=4400

# PostgreSQL (виж docker-compose.yml — порт 5437)
DATABASE_URL=postgresql://pomagam:CHANGE_ME@localhost:5437/pomagam

# Папка за качените медийни файлове (на VPS: напр. /opt/pomagam/media)
MEDIA_DIR=./media
# Лимит на размер за едно качване (MB)
MEDIA_MAX_MB=60

# CORS whitelist — разделени със запетая; никога „*" на production
CORS_ORIGINS=https://pomagam.carbonstealth.eu

# --- Админ авторизация (Етап 3) ---
# Таен ключ за подписване на сесиите (поне 16 символа). Генерирай свой.
JWT_SECRET=CHANGE_ME_ATLEAST_16_CHARS
# Живот на сесията в часове
JWT_TTL_HOURS=12
# Домейн на бисквитката (празно на localhost)
# COOKIE_DOMAIN=pomagam.carbonstealth.eu
# Secure бисквитки (по подразбиране включени на production)
# COOKIE_SECURE=true
# Първоначален админ — създава се от `npm run seed`, ако са зададени
# ADMIN_EMAIL=admin@pomagam.carbonstealth.eu
# ADMIN_PASSWORD=CHANGE_ME

# --- Опашка и имейл (Етап 4) ---
# Redis за BullMQ (виж docker-compose.yml — порт 6383)
REDIS_URL=redis://localhost:6383
# Brevo SMTP — нужни за worker процеса (`npm run worker`)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Помагам Бобов дол <noreply@pomagam.carbonstealth.eu>"
# Получател в общината — по подразбиране деловодството на Бобов дол
EMAIL_TO_MUNICIPALITY=delovodstvo@bobovdol.egov.bg
# Таван на общия размер на прикачените файлове към имейла (MB)
EMAIL_ATTACH_MAX_MB=8
