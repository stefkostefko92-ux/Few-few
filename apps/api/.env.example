# Помагам API — примерна конфигурация. Копирай в .env и попълни.
NODE_ENV=development
PORT=4400

# PostgreSQL (виж docker-compose.yml — порт 5437)
DATABASE_URL=postgresql://pomagam:CHANGE_ME@localhost:5437/pomagam

# Папка за качените медийни файлове (на VPS: напр. /opt/pomagam/media)
MEDIA_DIR=./media
# Лимит на размер за едно качване (MB)
MEDIA_MAX_MB=60

# CORS whitelist — разделени със запетая; никога „*" на production
CORS_ORIGINS=https://pomagam.carbonstealth.eu

# --- Следните се ползват от по-късни етапи (auth, опашка, имейл) ---
# REDIS_URL=redis://localhost:6383
# JWT_SECRET=CHANGE_ME
# COOKIE_DOMAIN=pomagam.carbonstealth.eu
# SIGNED_URL_TTL_HOURS=72
# RETENTION_MONTHS=12
# Brevo SMTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# EMAIL_FROM="Помагам Бобов дол <noreply@pomagam.carbonstealth.eu>"
# EMAIL_TO_MUNICIPALITY=delovodstvo@bobovdol.egov.bg
