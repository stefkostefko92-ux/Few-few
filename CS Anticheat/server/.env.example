# CS Anticheat backend — пример за конфигурация.
# Копирай като .env и попълни. НИКОГА не комитвай истинския .env.

PORT=8787

# HMAC споделена тайна между скенера (CSAC_SECRET) и backend-а.
# Задължителна в продукция. Генерирай: openssl rand -hex 32
CSAC_SECRET=

# Публичен URL на панела (за линкове в Discord/докладите).
CSAC_PUBLIC_URL=http://localhost:8787

# Discord webhook за alert-и (по избор).
CSAC_DISCORD_WEBHOOK=

# От коя присъда нагоре да алармираме: clean | suspicious | detected
CSAC_ALERT_MIN=suspicious

# Токен за достъп до списъка с доклади (по избор; ако празно — списъкът е отворен).
CSAC_PANEL_TOKEN=

# Къде да се пазят докладите (MVP: JSON файлове).
CSAC_DATA_DIR=
