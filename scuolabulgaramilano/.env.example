# Copia in .env e modifica i valori. Per il deploy puoi anche usare ./deploy.sh
# che crea questo file automaticamente.

# ----- Database (file SQLite su disco) -----
DATABASE_URL="file:/app/data/app.db"

# ----- Accesso admin (li imposti tu) -----
ADMIN_EMAIL="admin@scuolabulgaramilano.it"
# Imposta la password in chiaro: viene convertita in hash bcrypt all'avvio.
ADMIN_PASSWORD="cambiami-con-una-password-robusta"
# In alternativa, fornisci direttamente un hash bcrypt (npm run hash -- "password")
# e lascia vuoto ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=""

# ----- Sicurezza sessioni -----
# Facoltativo: se vuoto, viene generato e salvato automaticamente nel volume dati.
# Per generarne uno manualmente:  openssl rand -base64 32
AUTH_SECRET=""

# ----- Upload immagini -----
UPLOADS_DIR="/app/data/uploads"

# ----- Notifiche email (facoltative) -----
# Se compilate, ogni richiesta dal modulo invia un'email. Altrimenti le
# richieste restano comunque consultabili nel pannello admin.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
LEADS_NOTIFY_TO=""

# ----- Sito -----
SITE_URL="https://www.scuolabulgaramilano.it"
NODE_ENV="production"
