# ----- Database (SQLite file on disk) -----
DATABASE_URL="file:./data/app.db"

# ----- Admin login (you set these) -----
ADMIN_EMAIL="admin@scuolabulgaramilano.it"
# Generate a hash:  npm run hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=""
# For a quick first run you may instead set a plaintext password (less secure):
# ADMIN_PASSWORD="change-me"

# Secret used to sign admin session cookies (min 16 chars, keep private).
# Generate one:  openssl rand -base64 32
AUTH_SECRET=""

# ----- Uploads -----
# Where uploaded images are stored on disk (mounted as a volume in Docker).
UPLOADS_DIR="./data/uploads"

# ----- Site -----
SITE_URL="https://www.scuolabulgaramilano.it"
NODE_ENV="production"
