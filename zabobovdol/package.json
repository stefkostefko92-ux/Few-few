    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:business": "tsx prisma/seed-business.ts",
    "db:seed:howto": "tsx prisma/seed-howto.ts",
    "db:seed:safety": "tsx prisma/seed-safety.ts",
    "db:seed:basics": "tsx prisma/seed-basics.ts",
    "db:seed:phone": "tsx prisma/seed-phone-basics.ts",
    "db:seed:settings": "tsx prisma/seed-set-settings.ts",
    "db:seed:internet": "tsx prisma/seed-set-internet.ts",
    "db:seed:apps": "tsx prisma/seed-set-apps.ts",
    "db:seed:daily": "tsx prisma/seed-set-daily.ts",
    "db:seed:keyboard": "tsx prisma/seed-set-keyboard.ts",
    "db:seed:health": "tsx prisma/seed-set-health.ts",
    "db:seed:shop": "tsx prisma/seed-set-shop.ts",
    "db:seed:more": "tsx prisma/seed-set-more.ts",
    "db:seed:banners": "tsx prisma/seed-banners.ts",
    "db:seed:community": "tsx prisma/seed-community.ts",
    "db:seed:transport": "tsx prisma/seed-transport.ts",
    "db:seed:extra": "tsx prisma/seed-set-extra.ts",
    "db:seed:all": "npm run db:seed && npm run db:seed:business && npm run db:seed:howto && npm run db:seed:safety && npm run db:seed:basics && npm run db:seed:phone && npm run db:seed:settings && npm run db:seed:internet && npm run db:seed:apps && npm run db:seed:daily && npm run db:seed:keyboard && npm run db:seed:health && npm run db:seed:shop && npm run db:seed:more && npm run db:seed:banners && npm run db:seed:community && npm run db:seed:transport && npm run db:seed:extra",
