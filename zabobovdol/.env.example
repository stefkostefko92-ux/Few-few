# --- База данни (PostgreSQL) ---
# При Docker Compose тази стойност вече е зададена в docker-compose.yml.
DATABASE_URL="postgresql://zabobovdol:zabobovdol@localhost:5432/zabobovdol?schema=public"

# --- Публичен адрес на сайта (без наклонена черта в края) ---
NEXT_PUBLIC_SITE_URL="https://zabobovdol.carbonstealth.eu"

# --- Сигурност на сесиите ---
# Генерирай дълъг случаен низ, напр.: openssl rand -base64 48
AUTH_SECRET="ПРОМЕНИ_МЕ_дълъг_случаен_низ"

# --- Първоначален администратор (използва се само при db:seed) ---
ADMIN_EMAIL="admin@carbonstealth.eu"
ADMIN_PASSWORD="ПРОМЕНИ_МЕ_силна_парола"
ADMIN_NAME="Администратор"

# --- AI чатбот (по избор, изключен по подразбиране) ---
# Когато си готов да включиш Claude, сложи ключ и смени CHAT_PROVIDER на "anthropic".
CHAT_PROVIDER="rules"          # "rules" (без AI) или "anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Сигнали до общината (препращане по имейл) ---
# Получател на сигналите (институция). По подразбиране е общината.
MUNICIPALITY_EMAIL="obshtina@bobovdol.egov.bg"
# SMTP за изпращане на имейли. Без тези настройки сигналите само се записват
# в базата и се препращат ръчно от админ панела.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # "true" за порт 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@carbonstealth.eu"

# --- Внасяне на новини от общината (като чернови за ръчно одобрение) ---
# Адрес на новините на общината (RSS канал или HTML списък).
MUNICIPALITY_NEWS_URL="https://bobovdol.egov.bg/wps/portal/municipality-bobovdol/actual/news"
# Таен токен за автоматично внасяне по график (cron):
#   curl "https://zabobovdol.carbonstealth.eu/api/ingest-news?token=ТАЙНА"
INGEST_TOKEN=""

# --- Автоматичен криптиран бекъп на базата ---
# Публичният ти age ключ. С него бекъпите се КРИПТИРАТ. Restore е възможен
# само с частния ключ, който държиш офлайн (виж scripts/README-backup.md).
# Генериране на ключ:  age-keygen -o backup-key.txt
AGE_RECIPIENT=""               # напр. age1qz...  (само публичният ключ!)
# Час за ежедневен бекъп (локално време според BACKUP_TZ):
BACKUP_TIME="00:00"
BACKUP_TZ="Europe/Sofia"
# Колко най-нови дневни копия да се пазят (31 ≈ последния месец):
BACKUP_RETENTION_DAYS="31"
# Да прави ли едно копие веднага при стартиране на контейнера:
BACKUP_ON_START="true"
# Алтернатива на age (по избор): GPG_RECIPIENT="твоя@имейл"
