# --- База данни (PostgreSQL) ---
# При Docker Compose тази стойност вече е зададена в docker-compose.yml.
DATABASE_URL="postgresql://zabobovdol:zabobovdol@localhost:5432/zabobovdol?schema=public"
# За продукция (Docker): сменете САМО паролата (потребител/име на база може да
# останат). Скриптът scripts/setup-env.sh я генерира автоматично.
POSTGRES_USER="zabobovdol"
POSTGRES_PASSWORD=""
POSTGRES_DB="zabobovdol"

# --- Публичен адрес на сайта (без наклонена черта в края) ---
NEXT_PUBLIC_SITE_URL="https://zabobovdol.carbonstealth.eu"

# --- Портове на хоста (само ако 80/443 са заети от друг сайт на сървъра) ---
# По подразбиране сайтът заема 80 (и 443 при HTTPS). На споделен сървър, където
# вече има друг nginx/панел на 80/443, ползвайте локален порт зад него:
#   HTTP_BIND="127.0.0.1"   HTTP_PORT="8080"
# и насочете домейна от съществуващото reverse proxy към http://127.0.0.1:8080.
HTTP_BIND="0.0.0.0"
HTTP_PORT="80"
HTTPS_PORT="443"

# --- Сигурност на сесиите ---
# Задължително поне 32 знака. Генерирай напр.: openssl rand -base64 48
# (примерната стойност по-долу се отхвърля от приложението — сменете я.)
AUTH_SECRET="ПРОМЕНИ_МЕ_дълъг_случаен_низ_поне_32_знака"

# --- Първоначален администратор (използва се само при db:seed) ---
# Сийдът отказва създаване със слаба/примерна парола (мин. 10 знака).
ADMIN_EMAIL="admin@carbonstealth.eu"
ADMIN_PASSWORD="СМЕНИ_МЕ_силна_парола_мин_10"
ADMIN_NAME="Администратор"

# --- AI чатбот (по избор, изключен по подразбиране) ---
# Когато си готов да включиш Claude, сложи ключ и смени CHAT_PROVIDER на "anthropic".
CHAT_PROVIDER="rules"          # "rules" (без AI) или "anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Сигнали до общината (препращане по имейл) ---
# Получател на сигналите (институция). По подразбиране е общината.
MUNICIPALITY_EMAIL="obshtina@bobovdol.egov.bg"
# SMTP за изпращане на имейли. Без тези настройки сигналите само се записват
# в базата и се препращат ръчно от админ панела.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # "true" за порт 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@carbonstealth.eu"

# --- Внасяне на новини от общината (като чернови за ръчно одобрение) ---
# Адрес на новините на общината (RSS канал или HTML списък).
MUNICIPALITY_NEWS_URL="https://bobovdol.egov.bg/wps/portal/municipality-bobovdol/actual/news"
# Таен токен за автоматично внасяне по график (cron). Подавайте го през
# заглавие (не в URL-а, за да не влиза в логовете). Същият токен обновява и
# данните за прозрачност (обществени поръчки) от СИГМА:
#   curl -H "Authorization: Bearer ТАЙНА" https://zabobovdol.carbonstealth.eu/api/ingest-news
#   curl -H "Authorization: Bearer ТАЙНА" https://zabobovdol.carbonstealth.eu/api/ingest-transparency
INGEST_TOKEN=""

# --- Брояч на посетителите (началния екран) ---
# Стартова стойност на брояча (задава се само при първоначално сийдване;
# реалният брояч после нараства от истинските посетители и не се нулира).
VISITOR_START="243"

# --- Автоматичен криптиран бекъп на базата ---
# Публичният ти age ключ. С него бекъпите се КРИПТИРАТ. Restore е възможен
# само с частния ключ, който държиш офлайн (виж scripts/README-backup.md).
# Генериране на ключ:  age-keygen -o backup-key.txt
AGE_RECIPIENT=""               # напр. age1qz...  (само публичният ключ!)
# Час за ежедневен бекъп (локално време според BACKUP_TZ):
BACKUP_TIME="00:00"
BACKUP_TZ="Europe/Sofia"
# Колко най-нови дневни копия да се пазят (31 ≈ последния месец):
BACKUP_RETENTION_DAYS="31"
# Да прави ли едно копие веднага при стартиране на контейнера:
BACKUP_ON_START="true"
# Алтернатива на age (по избор): GPG_RECIPIENT="твоя@имейл"

# --- Качване на снимки (галерия) ---
# Папка за качените снимки. В Docker е /app/uploads (том). Локално по подразбиране ./uploads
UPLOAD_DIR=""

# --- Анонимна статистика (по избор, Plausible) ---
# Без бисквитки и без лични данни. Оставете празно, за да е изключена (нищо
# външно не се зарежда). Прилага се при билд (rebuild след промяна).
# При самостоятелен (self-hosted) Plausible задайте и NEXT_PUBLIC_PLAUSIBLE_SRC
# и добавете домейна в CSP (next.config.mjs).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC=""
