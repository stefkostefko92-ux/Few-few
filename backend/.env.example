# Copy to .env for local development.
#
# Leave both unset to run fully in-memory (no infra needed) — `npm run dev`
# then uses the in-memory repository, ledger, and a no-op leaderboard.

# Postgres (Prisma). When set, the server persists to Postgres.
DATABASE_URL="postgresql://kagura:kagura@localhost:5432/kagura"

# Redis. When set, the global leaderboard uses Redis sorted sets.
REDIS_URL="redis://localhost:6379"

# HTTP port (default 3000)
# PORT=3000
