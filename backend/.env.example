# Copy to .env for local development.
#
# Leave both unset to run fully in-memory (no infra needed) — `npm run dev`
# then uses the in-memory repository, ledger, and a no-op leaderboard.

# Postgres (Prisma). When set, the server persists to Postgres.
DATABASE_URL="postgresql://kagura:kagura@localhost:5432/kagura"

# Redis. When set, the global leaderboard uses Redis sorted sets.
REDIS_URL="redis://localhost:6379"

# JWT signing secret (HS256). REQUIRED in production; the server falls back to an
# insecure dev secret (with a warning) if unset. Use a long random value.
JWT_SECRET="change-me-to-a-long-random-string"

# IAP secrets (§8). Receipt secret signs sandbox receipts; webhook secret is the
# HMAC key for the RevenueCat-style /iap/webhook. Replace in production.
IAP_RECEIPT_SECRET="change-me-receipt"
IAP_WEBHOOK_SECRET="change-me-webhook"

# Admin API key for /admin/liveops (§6.2 live config tuning). Omit to disable
# the admin surface. Use a long random value.
ADMIN_API_KEY="change-me-admin-key"

# DEV ONLY: set to "true" to expose /iap/dev-receipt for the web demo. Never in prod.
# ENABLE_DEV_RECEIPTS="true"

# Comma-separated CORS origins for an external web-shop/demo (§8.1).
# CORS_ORIGINS="http://localhost:5173"

# HTTP port (default 3000)
# PORT=3000
