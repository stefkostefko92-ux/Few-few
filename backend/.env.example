# Copy to .env for local development.
#
# Leave both unset to run fully in-memory (no infra needed) — `npm run dev`
# then uses the in-memory repository, ledger, and a no-op leaderboard.
#
# In production (NODE_ENV=production) the server validates this config at boot
# and REFUSES TO START if DATABASE_URL is missing or any secret is unset/left at
# a dev default (see src/config/env.ts). See DEPLOYMENT.md.

# Deployment mode. Set to "production" on real servers (enables fail-fast config
# validation, secure cookies, and HSTS). Defaults to development.
# NODE_ENV="production"

# Postgres (Prisma). REQUIRED in production. When set, the server persists to
# Postgres. Tune the pool via the URL, e.g. ...?connection_limit=20
DATABASE_URL="postgresql://kagura:kagura@localhost:5432/kagura"

# Redis. When set, the global leaderboard uses Redis sorted sets.
REDIS_URL="redis://localhost:6379"

# JWT signing secret (HS256). REQUIRED in production; the server falls back to an
# insecure dev secret (with a warning) if unset. Use a long random value.
JWT_SECRET="change-me-to-a-long-random-string"

# IAP secrets (§8). Receipt secret signs sandbox receipts; webhook secret is the
# HMAC key for the RevenueCat-style /iap/webhook. Replace in production.
IAP_RECEIPT_SECRET="change-me-receipt"
IAP_WEBHOOK_SECRET="change-me-webhook"

# Admin API key for /admin/liveops (§6.2 live config tuning). Omit to disable
# the admin surface. Use a long random value.
ADMIN_API_KEY="change-me-admin-key"

# DEV ONLY: set to "true" to expose /iap/dev-receipt for the web demo. The prod
# config validator hard-rejects this when NODE_ENV=production.
# ENABLE_DEV_RECEIPTS="true"

# IAP receipt validator. "stub" = sandbox HMAC (dev only); "revenuecat" = real
# server-side verification via the RevenueCat REST API (fronts Apple + Google).
# IAP_PROVIDER="revenuecat"
# REVENUECAT_API_KEY="rcat-..."

# If you keep the sandbox stub (IAP_PROVIDER unset/stub), production boot fails
# unless you explicitly opt in here (never for real-money builds). Configuring a
# real provider above clears this requirement.
# ALLOW_STUB_RECEIPTS="true"

# Comma-separated CORS origins for an external web-shop/demo (§8.1). Must be
# exact https origins in prod; never "*".
# CORS_ORIGINS="http://localhost:5173"

# Trust proxy hop count when behind a load balancer / ingress, so req.ip is the
# real client for rate limiting (0 = don't trust any proxy).
# TRUST_PROXY="1"

# HTTP port (default 3000)
# PORT=3000
