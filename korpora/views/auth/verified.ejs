<%# Неуспехът казва какво е станало: вече потвърден имейл или сменен адрес не са „грешка“ — човекът просто влиза. %>
<% const spent = !result.ok && result.state ? result.state : null; -%>
<% const titleKey = result.ok ? (result.kind === 'changed' ? 'auth.emailChangedTitle' : 'auth.verifiedTitle') : spent === 'verified' ? 'auth.alreadyVerifiedTitle' : spent === 'changed' ? 'auth.alreadyChangedTitle' : 'auth.verifyFailedTitle'; -%>
<%- include('_top', { titleKey }) %>
<h1><%= t(titleKey) %></h1>
<% if (result.ok) { %>
<p><%= t(result.kind === 'changed' ? 'auth.emailChangedText' : 'auth.verifiedText') %></p>
<a class="btn btn-primary btn-wide" href="/login"><%= t('auth.toLogin') %></a>
<% } else if (spent) { %>
<p><%= t(spent === 'verified' ? 'auth.alreadyVerifiedText' : 'auth.alreadyChangedText') %></p>
<a class="btn btn-primary btn-wide" href="/login"><%= t('auth.toLogin') %></a>
<% } else { %>
<p><%= t('auth.verifyFailedText') %></p>
<a class="btn btn-primary btn-wide" href="/login"><%= t('auth.toLogin') %></a>
<div class="auth-links"><a href="/forgot"><%= t('auth.forgotLink') %></a></div>
<% } %>
<%- include('_bottom') %>
