<%# Съобщенията за празно или грешно поле — на езика на страницата и под самото поле (public/js/forms.js), не в балончето на браузъра. %>
<script src="/static/js/forms.js?v=<%= v %>" defer data-required="<%= t('form.required') %>" data-check="<%= t('form.check') %>" data-choose="<%= t('form.choose') %>" data-email="<%= t('auth.errors.email') %>" data-short="<%= t('form.tooShort') %>" data-long="<%= t('form.tooLong') %>" data-invalid="<%= t('form.invalid') %>"></script>
