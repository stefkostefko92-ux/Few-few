<%- include('sprite') %>
<a class="skip" href="#main"><%= t('common.skip') %></a>
<header class="site-bar">
  <div class="wrap">
    <a class="brand" href="<%= paths[locale] %>"><%- include('mark') %><span>Korpora</span></a><span class="beta-tag"><%= t('landing.beta.tag') %></span>
    <% if (typeof sections !== 'undefined' && sections) { %>
    <nav class="site-nav" aria-label="<%= t('landing.nav.label') %>">
      <a href="#how"><%= t('landing.nav.how') %></a>
      <a href="#drilling"><%= t('landing.nav.drilling') %></a>
      <a href="#kinds"><%= t('landing.nav.kinds') %></a>
      <a href="#machine"><%= t('landing.nav.machine') %></a>
      <a href="#prices"><%= t('landing.nav.prices') %></a>
      <a href="#faq"><%= t('landing.nav.faq') %></a>
    </nav>
    <% } %>
    <div class="site-bar-end">
      <nav class="langs" aria-label="<%= t('common.language') %>">
        <% for (const alt of alternates) { %><a href="<%= alt.path %>" hreflang="<%= alt.locale %>" lang="<%= alt.locale %>" aria-current="<%= alt.locale === locale ? 'true' : 'false' %>"><%= alt.locale.toUpperCase() %></a><% } %>
      </nav>
      <a class="login" href="/login?lang=<%= locale %>"><%= t('landing.nav.login') %></a>
      <a class="btn btn-primary btn-small" href="/register?lang=<%= locale %>"><%= t('landing.cta.start') %></a>
    </div>
  </div>
</header>
