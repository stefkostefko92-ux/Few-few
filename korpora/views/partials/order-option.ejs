<%# всяка фраза остава цяла („12 месеца“, „ранно начало“) — в тясна колона редът се пренася само след запетаята %>
<span class="nowrap"><%= order.option === 'lifetime' ? t('plan.lifetime') : t('plan.months', { n: order.months }) %></span><br><small class="muted"><span class="nowrap"><%= t(order.buyerType === 'CONSUMER' ? 'plan.buyer.consumerShort' : 'plan.buyer.businessShort') %></span><% if (order.earlyStartRequestedAt) { %>, <span class="nowrap"><%= t('plan.early.short') %></span><% } %></small>
