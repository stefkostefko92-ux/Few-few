<%- include('sprite') %>
<a class="skip" href="#main"><%= t('common.skip') %></a>
<header class="bar">
  <a class="brand" href="/app"><%- include('mark') %><span>Korpora</span></a>
  <% if (currentUser && mfaPassed) { %>
  <nav class="bar-nav" aria-label="<%= t('nav.main') %>">
    <a href="/app" aria-current="<%= path.startsWith('/app') ? 'page' : 'false' %>"><%= t('nav.projects') %></a>
    <a href="/account" aria-current="<%= path.startsWith('/account') ? 'page' : 'false' %>"><%= t('nav.account') %></a>
    <% if (isStaff(currentUser.role)) { %><a href="/admin" aria-current="<%= path.startsWith('/admin') ? 'page' : 'false' %>"><%= t('nav.admin') %></a><% } %>
  </nav>
  <% } %>
  <div class="bar-end">
    <% if (headerPlan && headerPlan.state !== 'staff') { %>
      <a class="chip <%= headerPlan.state === 'expired' ? 'chip-bad' : headerPlan.state === 'pending' ? 'chip-warn' : headerPlan.plan === 'TRIAL' && headerPlan.daysLeft <= 5 ? 'chip-warn' : 'chip-ok' %>" href="/account/plan">
        <%- include('icon', { name: headerPlan.state === 'expired' ? 'lock' : 'receipt' }) %>
        <% if (headerPlan.state === 'expired') { %><%= t('plan.chip.expired') %><% } else if (headerPlan.state === 'pending') { %><%= t('plan.chip.pending') %><% } else if (headerPlan.plan === 'LIFETIME') { %><%= t('plan.chip.lifetime') %><% } else { %><%= t(headerPlan.plan === 'TRIAL' ? 'plan.chip.trialDays' : 'plan.chip.premiumDays', { n: headerPlan.daysLeft }) %><% } %>
      </a>
    <% } %>
    <%- include('langs') %>
    <% if (currentUser) { %>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-quiet btn-small" type="submit"><%- include('icon', { name: 'logout' }) %><span><%= t('nav.logout') %></span></button>
    </form>
    <% } %>
  </div>
</header>
