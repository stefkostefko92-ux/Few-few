<footer class="site-foot">
  <div class="wrap">
    <div>
      <a class="brand" href="<%= paths[locale] %>"><%- include('logo', { h: 52 }) %></a>
      <p><%= t('landing.foot.about') %></p>
      <p><%= t('company.legalName') %>, <%= t('company.legalForm') %>, <span class="nowrap"><%= t('company.eikLabel') %> <%= company.eik %></span>, <span class="nowrap"><%= t('company.vatLabel') %> <%= company.vat %></span><br><%= t('company.street') %>, <%= company.postalCode %> <%= t('company.city') %>, <%= t('company.region') %>, <%= t('company.country') %>, <%= t('company.phoneLabel') %>&nbsp;<a class="nowrap" href="<%= company.phoneHref %>"><%= company.phone %></a></p>
    </div>
    <nav class="foot-legal" aria-label="<%= t('legal.nav') %>">
      <a href="<%= legalPath(locale, 'privacy') %>"><%= t('legal.privacyTitle') %></a>
      <a href="<%= legalPath(locale, 'terms') %>"><%= t('legal.termsTitle') %></a>
      <a href="/static/editor/THIRD-PARTY-LICENSES.txt" hreflang="en"><%= t('legal.openSource') %></a>
      <a href="mailto:<%= contact %>"><%= contact %></a>
    </nav>
    <div class="foot-end">
      <div class="langs" role="group" aria-label="<%= t('common.language') %>">
        <% for (const alt of alternates) { %><a href="<%= alt.path %>" hreflang="<%= alt.locale %>" lang="<%= alt.locale %>" aria-current="<%= alt.locale === locale ? 'true' : 'false' %>"><%= alt.locale.toUpperCase() %></a><% } %>
      </div>
      <p class="credit">Created and Designed by <a href="https://carbonstealth.eu" target="_blank" rel="noopener">Carbon Stealth VCC</a></p>
    </div>
  </div>
</footer>
