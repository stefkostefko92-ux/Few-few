<%- include('../partials/head', { title: t(titleKey) + ' — Korpora', styles: ['app'], noindex: true }) %>
<body class="auth">
<%- include('../partials/sprite') %>
<main class="auth-main" id="main">
  <div class="auth-card">
    <div class="auth-head">
      <a class="brand" href="<%= paths[locale] %>"><%- include('../partials/logo', { h: 46 }) %></a>
      <%- include('../partials/langs') %>
    </div>
    <p class="status-code"><%= status %></p>
    <h1><%= t(titleKey) %></h1>
    <p><%= t(messageKey, typeof errorParams !== 'undefined' ? errorParams : {}) %></p>
    <% if (typeof details !== 'undefined' && details.length) { %>
    <ul class="error-details" lang="bg"><% for (const d of details) { %><li><%= d %></li><% } %></ul>
    <% } %>
    <%# Вписаният отива към проектите; който не е влязъл — към началото и входа, не към страница, която го връща на входа. %>
    <% const signedIn = typeof currentUser !== 'undefined' && currentUser; %>
    <div class="auth-links">
      <% if (typeof back !== 'undefined') { %><a href="<%= back.href %>"><%= t(back.key) %></a><% } %>
      <a href="<%= paths[locale] %>"><%= t('error.toHome') %></a>
      <% if (signedIn) { %><a href="/app"><%= t('error.toProjects') %></a><% } else { %><a href="/login"><%= t('auth.toLogin') %></a><% } %>
    </div>
  </div>
  <%- include('../partials/auth-aside') %>
</main>
<%- include('../partials/app-footer') %>
</body>
</html>
