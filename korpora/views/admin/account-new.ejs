<%- include('../partials/page-top', { title: t('admin.new.title'), styles: ['app', 'app-admin-tables'] }) %>
<div class="page-head"><h1><%= t('admin.new.title') %></h1></div>
<%- include('../partials/admin-nav') %>
<%- include('../partials/flash') %>
<section class="section">
  <form method="post" action="/admin/accounts-new" class="form" data-plan-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <div class="field"><label for="n-name"><%= t('auth.name') %></label><input id="n-name" name="name" type="text" required minlength="2" maxlength="80"></div>
      <div class="field"><label for="n-email"><%= t('auth.email') %></label><input id="n-email" name="email" type="email" required maxlength="254" autocomplete="off"></div>
    </div>
    <div class="form-row">
      <div class="field"><label for="n-role"><%= t('admin.account.role') %></label><select id="n-role" name="role"><% for (const r of roles) { %><option value="<%= r %>"><%= t('role.' + r) %></option><% } %></select></div>
      <div class="field"><label for="n-locale"><%= t('account.language') %></label><select id="n-locale" name="locale"><% for (const l of locales) { %><option value="<%= l %>" lang="<%= l %>"><%= localeLabel[l] %></option><% } %></select></div>
    </div>
    <div class="form-row">
      <div class="field"><label for="n-plan"><%= t('admin.col.plan') %></label><select id="n-plan" name="plan" data-plan-select><option value="TRIAL"><%= t('plan.name.TRIAL') %></option><option value="PREMIUM"><%= t('plan.name.PREMIUM') %></option><option value="LIFETIME"><%= t('plan.name.LIFETIME') %></option></select></div>
      <div class="field" data-for-plan="TRIAL"><label for="n-days"><%= t('admin.account.trialDays') %></label><input id="n-days" name="trialDays" type="number" min="<%= limits.trialDays.min %>" max="<%= limits.trialDays.max %>" value="<%= trialDays %>"></div>
      <div class="field" data-for-plan="PREMIUM"><label for="n-months"><%= t('admin.account.months') %></label><input id="n-months" name="months" type="number" min="<%= limits.months.min %>" max="<%= limits.months.max %>" value="12"></div>
    </div>
    <div class="field"><label for="n-pw"><%= t('admin.new.password') %></label><input id="n-pw" name="password" type="password" minlength="<%= passwordMin %>" maxlength="<%= passwordMax %>" autocomplete="new-password" aria-describedby="n-pw-hint"><p class="hint" id="n-pw-hint"><%= t('admin.new.passwordHint', { hours: t('common.hours', { n: inviteHours }), days: t('common.days', { n: unverifiedDays }) }) %></p></div>
    <div class="actions"><button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'plus' }) %><%= t('admin.new.create') %></button></div>
  </form>
</section>
<%- include('../partials/page-bottom') %>
