<%- include('../partials/page-top', { title: t('app.title') }) %>
<div class="page-head">
  <h1><%= t('app.title') %></h1>
  <p class="muted"><%= t('app.lead') %></p>
</div>
<%- include('../partials/flash') %>

<% if (!plan.canCreate) { %>
<section class="notice <%= plan.blockedBy === 'unverified' ? 'notice-warn' : 'notice-bad' %>" aria-labelledby="notice-title">
  <%- include('../partials/icon', { name: plan.blockedBy === 'unverified' ? 'mail' : 'lock' }) %>
  <div>
    <h2 id="notice-title"><%= t(plan.blockedBy === 'unverified' ? 'app.unverifiedTitle' : 'app.expiredTitle') %></h2>
    <p><%= t(plan.blockedBy === 'unverified' ? 'app.unverifiedText' : 'app.expiredText') %></p>
    <% if (plan.blockedBy === 'unverified') { %>
      <form method="post" action="/account/verify/resend"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small" type="submit"><%= t('app.resend') %></button></form>
    <% } else { %>
      <a class="btn btn-primary btn-small" href="/account/plan"><%= t('app.seePlans') %></a>
    <% } %>
  </div>
</section>
<% } %>

<%# Изтекъл план или непотвърден имейл: формата не се показва — съобщението отгоре води към плана. %>
<% if (plan.canCreate) { %>
<section class="newproj" aria-labelledby="new-title">
  <h2 id="new-title"><%= t('app.newTitle') %></h2>
  <form method="post" action="/app/projects" class="newproj-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="type"><%= t('app.type') %></label>
      <select id="type" name="type" required>
        <% let group = null; for (const ty of types) { if (ty.group !== group) { if (group !== null) { %></optgroup><% } group = ty.group; %><optgroup label="<%= ty.group %>"><% } %>
          <option value="<%= ty.id %>"><%= ty.label %></option>
        <% } if (group !== null) { %></optgroup><% } %>
      </select>
    </div>
    <div class="field">
      <label for="pname"><%= t('app.name') %></label>
      <input id="pname" name="name" type="text" maxlength="80" placeholder="<%= t('app.namePlaceholder') %>">
    </div>
    <button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'plus' }) %><%= t('app.create') %></button>
  </form>
</section>
<% } %>

<section aria-labelledby="list-title">
  <h2 id="list-title"><%= t('app.listTitle', { n: projects.length }) %></h2>
  <% if (!projects.length) { %>
    <p class="empty"><%= t(plan.canCreate ? 'app.empty' : 'app.emptyLocked') %></p>
  <% } else { %>
  <ul class="projlist">
    <% for (const p of projects) { %>
    <li class="proj">
      <a class="proj-main" href="/app/p/<%= p.id %>">
        <span class="proj-name"><%= p.name %></span>
        <span class="proj-meta"><%= t('furniture.' + p.summary.type) %><% if (p.summary.dims) { %>, <span class="mono"><%= p.summary.dims %></span><% } %></span>
      </a>
      <span class="proj-time"><%= t('app.updated', { when: fmt.relative(p.updatedAt) }) %></span>
      <div class="proj-actions">
        <a class="btn btn-small" href="/app/p/<%= p.id %>/export/project.zip"><%- include('../partials/icon', { name: 'download' }) %><span><%= t('app.download') %></span></a>
        <% if (plan.canCreate) { %>
        <form method="post" action="/app/p/<%= p.id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small btn-quiet" type="submit"><%- include('../partials/icon', { name: 'copy' }) %><span><%= t('app.duplicate') %></span></button></form>
        <% } %>
        <form method="post" action="/app/p/<%= p.id %>/delete" data-confirm="<%= t('app.deleteConfirm', { name: p.name }) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small btn-quiet" type="submit"><%- include('../partials/icon', { name: 'trash' }) %><span><%= t('app.delete') %></span></button></form>
      </div>
    </li>
    <% } %>
  </ul>
  <% } %>
</section>
<%- include('../partials/page-bottom') %>
