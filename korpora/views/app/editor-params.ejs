<%# Полетата за размерите на вида — същите елементи като editor/params-html.js (tests/editor-rail.test.ts), със стойностите на проекта. %>
<% for (const p of fields) { if (p.kind === 'range') { %><div class="field"><label for="p-<%= p.key %>"><%= p.label %><%= p.unit ? ', ' + p.unit : '' %></label>
<input type="number" id="p-<%= p.key %>" data-field="<%= p.key %>" min="<%= p.min %>" max="<%= p.max %>" step="<%= p.step %>" inputmode="numeric" value="<%= p.value %>">
<input type="range" data-field="<%= p.key %>" min="<%= p.min %>" max="<%= p.max %>" step="<%= p.step %>" aria-label="<%= p.label %>, плъзгач" value="<%= p.value %>"></div><% } else { %><span class="lbl" id="l-<%= p.key %>"><%= p.label %></span><div class="seg" role="radiogroup" aria-labelledby="l-<%= p.key %>"><% for (const o of p.options) { %><label><input type="radio" name="<%= p.key %>" value="<%= o.value %>" data-field="<%= p.key %>"<%= o.value === p.value ? ' checked' : '' %>><span><%= o.label %></span></label><% } %></div><% } } %>
