[Unit]
# Всеки ден в 02:30 UTC (изрично UTC — без местното лятно часово време), извън 03:00 на другите бекъпи на
# машината. Persistent=true наваксва пропуснато пускане, ако сървърът е бил спрян.
Description=Korpora — дневен шифрован бекъп на базата (02:30 UTC)
Documentation=file:///opt/few-few/current/korpora/DEPLOY.md

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
RandomizedDelaySec=10min
AccuracySec=1min
Unit=korpora-backup.service

[Install]
WantedBy=timers.target
