{
  "name": "car-monitor",
  "private": true,
  "version": "0.0.0",
  "description": "Car Monitor — платформа за прозрачност и интелигентност на пазара на автомобили (по патерна на СИГМА).",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/check-node.mjs && pnpm install && pnpm --filter @car-monitor/web run db:setup",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "import": "node apps/etl/scripts/import.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  }
}
