# Piuma — примерни променливи. Реалните живеят САМО на сървъра (mode 600), никога в репото.
#
# ЕДИН файл, ДВА режима. `docker-compose.yml` чете този `.env` за интерполация и сам
# сглобява DATABASE_URL/REDIS_URL/TRUST_PROXY към услугите в мрежата на Compose — затова
# в продукция долните три реда от раздел „локална разработка" НЕ важат, дори да ги
# попълниш. При `npm run dev` е обратното: там няма Compose, значи важат точно те.

# ── Общо за двата режима ─────────────────────────────────────────────────────
NODE_ENV=production
PUBLIC_BASE_URL=https://piuma.carbonstealth.eu

# Instagram Platform API (Instagram Login) — Meta App → Instagram → API setup
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://piuma.carbonstealth.eu/auth/instagram/callback
IG_GRAPH_VERSION=v24.0
IG_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

# 32 байта в hex (64 знака): openssl rand -hex 32 — криптира IG токени, TOTP тайни и
# агентски ключове в покой. СМЯНАТА ѝ прави всички съхранени тайни нечетими.
TOKEN_ENC_KEY=

# Име на издателя в приложението за еднократни кодове
TOTP_ISSUER=Piuma

# По избор — без него генерирането на чернови е изключено; публикуването и панелът работят
ANTHROPIC_API_KEY=

# ── Само за продукция (docker compose) ───────────────────────────────────────
# Паролата на вградената PostgreSQL: openssl rand -base64 32 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=
# Портът на хоста, на който nginx-ът на хоста праща (вързан за 127.0.0.1).
HTTP_PORT=4310

# ── Само за локална разработка (npm run dev, без Compose) ────────────────────
# TRUST_PROXY нарочно го няма: стойността по подразбиране в `config.ts` е `loopback`
# (вярно за разработка), а Compose подава своята. Сложиш ли го тук, той става и
# интерполационна стойност за Compose и мълчаливо отменя правилната.
PORT=4310
DATABASE_URL=postgresql://piuma:CHANGE_ME@127.0.0.1:5432/piuma
REDIS_URL=redis://127.0.0.1:6379/3

# Само за `npm run owner:create` (еднократно, от шела — не ги оставяй във файла):
# OWNER_EMAIL=admin@carbonstealth.eu  OWNER_NAME="Собственик"  OWNER_PASSWORD='…по фирмения шаблон…'
