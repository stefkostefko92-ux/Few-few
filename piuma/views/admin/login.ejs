<%- include('../partials/head') %>
<div class="login">
  <div class="brand"><%- icon('piuma', { class: 'ic-lg' }) %><span class="wordmark">Piuma</span></div>
  <p class="sub center mb-2"><%= t('app.tagline') %></p>
  <h1><%= t('auth.loginTitle') %></h1>
  <% if (error) { %><div class="flash error"><%- icon('status-failed') %><span><%= error %></span></div><% } %>
  <form method="post" action="/admin/login" class="stack" autocomplete="on">
    <input type="hidden" name="next" value="<%= next %>">
    <label><%= t('auth.email') %><input type="email" name="email" required autocomplete="username" autofocus></label>
    <label><%= t('auth.password') %><input type="password" name="password" required autocomplete="current-password" minlength="12"></label>
    <button class="btn primary w-full" type="submit"><%- icon('logout') %> <%= t('auth.signIn') %></button>
  </form>
  <%- include('../partials/lang') %>
</div>
<%- include('../partials/foot') %>
