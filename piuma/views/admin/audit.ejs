<%- include('../partials/shell-start', { active: 'audit' }) %>
<div class="topbar">
  <div>
    <div class="title"><h1><%= t('audit.title') %></h1><span class="chip"><%= ui.num(total) %></span></div>
    <p class="sub"><%= t('audit.subtitle') %></p>
  </div>
  <a class="btn" href="/admin/audit?verify=1&action=<%= actionFilter %>"><%- icon('shield') %> <%= t('audit.verify') %></a>
</div>
<% if (chain) { %><div class="flash <%= chain.ok ? 'ok' : 'error' %>"><%- icon(chain.ok ? 'status-approved' : 'severity-high') %><span><%= chain.ok ? t('audit.chainOk', { count: ui.num(chain.count) }) : t('audit.chainBroken', { index: chain.brokenAt }) %></span></div><% } %>
<form method="get" action="/admin/audit" class="filters">
  <label><%= t('audit.actionPrefix') %><input name="action" value="<%= actionFilter %>" placeholder="post. · auth. · apikey."></label>
  <button class="btn" type="submit"><%- icon('filter') %> <%= t('common.filter') %></button>
</form>
<div class="table-wrap">
<table><thead><tr><th class="num">#</th><th><%= t('common.when') %></th><th><%= t('audit.who') %></th><th><%= t('audit.action') %></th><th><%= t('audit.target') %></th><th><%= t('common.detail') %></th><th>IP</th></tr></thead><tbody>
<% rows.forEach((r) => { %>
  <% const who = ui.actor(r.actorType); %>
  <tr><td class="num muted"><%= r.id %></td><td class="muted when"><%= ui.dateTime(r.at) %></td><td><span class="chip <%= who.tone %>"><%- icon(who.icon, { class: 'ic-sm' }) %> <%= t(who.key) %></span><span class="sub-line"><%= r.actorLabel %></span></td><td class="mono"><%= r.action %></td><td class="mono"><%= r.targetType ? r.targetType + ' ' + (r.targetId || '') : '' %></td><td class="mono"><%= r.detail ? JSON.stringify(r.detail) : '' %></td><td class="mono muted"><%= r.ip || '' %></td></tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="7"><div class="empty"><%- icon('empty', { class: 'ic-xl' }) %><strong><%= t('audit.empty') %></strong><%= t('audit.emptyHint') %></div></td></tr><% } %>
</tbody></table>
</div>
<% if (pages > 1) { %><div class="pager"><span class="muted"><%= t('common.page') %></span><% for (let i = 1; i <= pages; i += 1) { %><a class="btn small <%= i === page ? 'primary' : 'ghost' %>" href="/admin/audit?action=<%= actionFilter %>&page=<%= i %>"><%= i %></a><% } %></div><% } %>
<%- include('../partials/shell-end') %>
