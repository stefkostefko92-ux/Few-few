<%- include('../partials/shell-start', { active: 'profile' }) %>
<div class="topbar"><div><h1><%= t('profile.title') %></h1><p class="sub"><%= t('profile.subtitle') %></p></div></div>
<div class="grid2">
  <section class="panel">
    <h2><%- icon('shield') %> <%= t('profile.twoFactor') %></h2>
    <% if (user.totpEnabledAt) { %>
      <p class="sub"><%= t('profile.enabledSince', { date: ui.date(user.totpEnabledAt) }) %></p>
      <form method="post" action="/admin/profile/2fa/disable" class="stack" data-confirm="<%= t('profile.disable2faConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><%= t('profile.confirmWithPassword') %><input type="password" name="password" required autocomplete="current-password"></label>
        <button class="btn danger" type="submit"><%- icon('status-disabled') %> <%= t('profile.disable2fa') %></button>
      </form>
    <% } else if (setup) { %>
      <p class="sub"><%= t('profile.scanHint') %></p>
      <p><img src="<%= setup.qrDataUrl %>" alt="<%= t('profile.qrAlt') %>" width="220" height="220"></p>
      <p class="muted"><%= t('profile.manualEntry') %> <span class="mono"><%= setup.secret %></span></p>
      <form method="post" action="/admin/profile/2fa/confirm" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><%= t('profile.codeFromApp') %><input type="text" name="code" inputmode="numeric" required autocomplete="one-time-code"></label>
        <button class="btn primary" type="submit"><%- icon('approve') %> <%= t('profile.enable') %></button>
      </form>
    <% } else { %>
      <p class="sub"><%= t('profile.disabled') %></p>
      <form method="post" action="/admin/profile/2fa/start">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn primary" type="submit"><%- icon('shield') %> <%= t('profile.enable2fa') %></button>
      </form>
    <% } %>
  </section>
  <section class="panel">
    <h2><%- icon('brands') %> <%= t('profile.language') %></h2>
    <p class="sub mb-2"><%= t('profile.languageHint') %></p>
    <div class="row">
      <% locales.forEach((code) => { %>
        <a class="btn <%= code === locale ? 'primary' : 'ghost' %>" href="<%= langUrl(code) %>" hreflang="<%= code %>" lang="<%= code %>"><%= localeLabel[code] %></a>
      <% }) %>
    </div>

    <h2><%- icon('key') %> <%= t('profile.changePassword') %></h2>
    <form method="post" action="/admin/profile/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><%= t('profile.currentPassword') %><input type="password" name="current" required autocomplete="current-password"></label>
      <label><%= t('profile.newPassword') %> <span class="hint"><%= t('profile.newPasswordHint') %></span><input type="password" name="next" required minlength="12" autocomplete="new-password"></label>
      <button class="btn" type="submit"><%- icon('key') %> <%= t('profile.changeButton') %></button>
    </form>
    <p class="sub"><%= t('profile.endsSessions') %></p>
  </section>
</div>
<%- include('../partials/shell-end') %>
