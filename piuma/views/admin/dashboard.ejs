<%- include('../partials/shell-start', { active: 'dashboard' }) %>
<div class="topbar">
  <div>
    <h1><%= t('dash.title') %></h1>
    <p class="sub"><%= t('dash.subtitle') %></p>
  </div>
  <div class="row">
    <% if (can('autopilot:run')) { %><form method="post" action="/admin/insights/sync" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost" type="submit"><%- icon('refresh') %> <%= t('dash.syncInsights') %></button></form><% } %>
    <% if (can('posts:create')) { %><a class="btn primary" href="/admin/posts/new"><%- icon('compose') %> <%= t('posts.newDraft') %></a><% } %>
  </div>
</div>

<div class="cards">
  <a class="card" href="/admin/posts?status=DRAFT"><div class="l"><%- icon('status-draft', { class: 'ic-sm' }) %> <%= t('dash.drafts') %></div><div class="n"><%= ui.num(counts.DRAFT || 0) %></div></a>
  <a class="card" href="/admin/posts?status=APPROVED"><div class="l"><%- icon('status-approved', { class: 'ic-sm' }) %> <%= t('dash.approved') %></div><div class="n"><%= ui.num(counts.APPROVED || 0) %></div></a>
  <a class="card" href="/admin/posts?status=SCHEDULED"><div class="l"><%- icon('status-scheduled', { class: 'ic-sm' }) %> <%= t('dash.scheduled') %></div><div class="n"><%= ui.num(counts.SCHEDULED || 0) %></div></a>
  <a class="card" href="/admin/posts?status=PUBLISHED"><div class="l"><%- icon('status-published', { class: 'ic-sm' }) %> <%= t('dash.publishedWeek') %></div><div class="n"><%= ui.num(publishedWeek) %></div></a>
  <a class="card" href="/admin/posts?status=FAILED"><div class="l"><%- icon('status-failed', { class: 'ic-sm' }) %> <%= t('dash.failed') %></div><div class="n"><%= ui.num(counts.FAILED || 0) %></div></a>
  <a class="card" href="/admin/accounts"><div class="l"><%- icon('instagram', { class: 'ic-sm' }) %> <%= t('dash.activeAccounts') %></div><div class="n"><%= ui.num(accounts.length) %></div></a>
</div>

<% if (expiringAccounts.length) { %>
<div class="flash error"><%- icon('status-token-expired') %><span><strong><%= t('dash.tokenWarning') %></strong>
  <% expiringAccounts.forEach((a) => { %> @<%= a.username %> (<%= a.brand.name %>) — <%= a.status === 'TOKEN_EXPIRED' ? t('dash.tokenExpired') : t('dash.tokenExpiring', { date: ui.date(a.tokenExpiresAt) }) %>;<% }) %>
  <a href="/admin/accounts"><%= t('dash.toAccounts') %></a></span></div>
<% } %>

<% if (managed.length) { %>
<h2><%- icon('autopilot') %> <%= t('dash.managedPages') %></h2>
<div class="table-wrap">
<table><thead><tr><th><%= t('common.brand') %></th><th><%= t('dash.plan') %></th><th class="num"><%= t('dash.assets') %></th><th><%= t('dash.lastCycle') %></th><th class="num"><%= t('dash.drafts') %></th><th></th></tr></thead><tbody>
<% managed.forEach((b) => { %>
  <% const pl = b.plan && typeof b.plan === 'object' ? b.plan : null; %>
  <tr>
    <td><strong><%= b.name %></strong><span class="sub-line mono"><%= b.slug %></span></td>
    <td><%= pl ? t('dash.perWeek', { count: pl.postsPerWeek }) + ' · ' + t('dash.reelsShare', { percent: Math.round(pl.reelsShare * 100) }) : '—' %></td>
    <td class="num"><%= pl && Array.isArray(pl.assets) ? pl.assets.length : 0 %></td>
    <td class="muted when"><%= b.lastAutopilotAt ? ui.relative(b.lastAutopilotAt) : t('dash.neverRun') %></td>
    <td class="num"><a href="/admin/posts?status=DRAFT&brand=<%= b.slug %>"><%= b._count.posts %></a></td>
    <td><% if (can('insights:view')) { %><a class="btn ghost small" href="/admin/brands/<%= b.id %>/performance"><%- icon('metric-reach', { class: 'ic-sm' }) %> <%= t('dash.performance') %></a><% } %></td>
  </tr>
<% }) %></tbody></table>
</div>
<% } %>

<div class="grid2">
  <section>
    <h2><%- icon('status-scheduled') %> <%= t('dash.upcoming') %></h2>
    <% if (!upcoming.length) { %>
      <div class="panel"><div class="empty"><%- icon('empty', { class: 'ic-xl' }) %><strong><%= t('dash.upcomingEmpty') %></strong><%= t('dash.upcomingEmptyHint') %></div></div>
    <% } else { %>
    <div class="table-wrap"><table><thead><tr><th><%= t('common.when') %></th><th><%= t('common.brand') %></th><th><%= t('common.publication') %></th></tr></thead><tbody>
    <% upcoming.forEach((p) => { %>
      <tr><td class="when"><%= ui.dateTime(p.scheduledAt) %><span class="sub-line"><%= ui.relative(p.scheduledAt) %></span></td><td><%= p.brand.name %><span class="sub-line">@<%= p.account ? p.account.username : '—' %></span></td><td><a href="/admin/posts/<%= p.id %>"><%= p.caption.slice(0, 54) %><%= p.caption.length > 54 ? '…' : '' %></a></td></tr>
    <% }) %></tbody></table></div><% } %>
  </section>
  <section>
    <h2><%- icon('status-draft') %> <%= t('dash.draftsToReview') %></h2>
    <% if (!recentDrafts.length) { %>
      <div class="panel"><div class="empty"><%- icon('empty', { class: 'ic-xl' }) %><strong><%= t('dash.draftsEmpty') %></strong><%= t('dash.draftsEmptyHint') %></div></div>
    <% } else { %>
    <div class="table-wrap"><table><thead><tr><th><%= t('common.brand') %></th><th><%= t('common.createdBy') %></th><th><%= t('common.publication') %></th></tr></thead><tbody>
    <% recentDrafts.forEach((p) => { %>
      <% const who = ui.creator(p); %>
      <tr><td><%= p.brand.name %></td><td><span class="chip <%= who.tone %>"><%- icon(who.icon, { class: 'ic-sm' }) %> <%= t(who.key) %></span></td><td><a href="/admin/posts/<%= p.id %>"><%= p.caption.slice(0, 54) %><%= p.caption.length > 54 ? '…' : '' %></a></td></tr>
    <% }) %></tbody></table></div><% } %>
  </section>
</div>

<% if (failed.length) { %>
<h2><%- icon('status-failed') %> <%= t('dash.failedTitle') %></h2>
<div class="table-wrap">
<table><thead><tr><th><%= t('common.brand') %></th><th><%= t('common.error') %></th><th class="num"><%= t('common.attempts') %></th><th></th></tr></thead><tbody>
<% failed.forEach((p) => { %>
  <tr><td><%= p.brand.name %></td><td class="mono"><%= (p.lastError || '').slice(0, 110) %></td><td class="num"><%= p.attempts %></td><td><a class="btn ghost small" href="/admin/posts/<%= p.id %>"><%= t('common.open') %></a></td></tr>
<% }) %></tbody></table>
</div>
<% } %>

<h2><%- icon('quota') %> <%= t('dash.quotas') %></h2>
<div class="table-wrap">
<table><thead><tr><th><%= t('common.account') %></th><th><%= t('common.brand') %></th><th><%= t('dash.quotaWindow') %></th><th><%= t('dash.quotaChecked') %></th><th><%= t('dash.tokenUntil') %></th></tr></thead><tbody>
<% accounts.forEach((a) => { %>
  <% const tone = ui.quotaTone(a.quotaUsed, a.quotaTotal); %>
  <tr>
    <td>@<%= a.username %></td>
    <td><%= a.brand.name %></td>
    <td>
      <% if (a.quotaTotal) { %>
      <div class="meter">
        <div class="meter-track"><div class="meter-fill <%= tone %> p-<%= Math.round(Math.min(100, (a.quotaUsed / a.quotaTotal) * 100) / 5) * 5 %>"></div></div>
        <div class="meter-label"><%= a.quotaUsed %> / <%= a.quotaTotal %></div>
      </div>
      <% } else { %><span class="muted"><%= t('dash.quotaUnchecked') %></span><% } %>
    </td>
    <td class="muted when"><%= a.quotaCheckedAt ? ui.relative(a.quotaCheckedAt) : t('common.never') %></td>
    <td class="when"><%= ui.date(a.tokenExpiresAt) %></td>
  </tr>
<% }) %>
<% if (!accounts.length) { %><tr><td colspan="5"><div class="empty"><%- icon('instagram', { class: 'ic-xl' }) %><strong><%= t('dash.noAccounts') %></strong><%= t('dash.noAccountsHint') %></div></td></tr><% } %>
</tbody></table>
</div>
<%- include('../partials/shell-end') %>
