# On the server: /opt/few-few/shared/argano/.env (mode 600). deploy/deploy.sh creates it with random values on the
# first deploy. Never commit a real .env.
POSTGRES_PASSWORD=CHANGE_ME_letters_and_digits_only
AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
APP_PORT=4320
PUBLIC_BASE_URL=https://argano.carbonstealth.eu
# search engines only after the owner approves the public release
ALLOW_INDEXING=false
LOG_LEVEL=info
# first start only: the platform administrator (remove ADMIN_PASSWORD from the file after the first sign-in)
ADMIN_EMAIL=admin@carbonstealth.eu
ADMIN_PASSWORD=
ADMIN_NAME=Carbon Stealth VCC
ADMIN_COMPANY=Carbon Stealth VCC
