# Production конфигурация за „Помагам Бобов дол" (deploy/).
# Копирай в deploy/.env и попълни. НЕ комитвай реалния .env.

# --- Домейн и HTTPS (Caddy) ---
DOMAIN=pomagam.carbonstealth.eu
ACME_EMAIL=admin@carbonstealth.eu

# --- PostgreSQL ---
POSTGRES_USER=pomagam
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=pomagam

# --- API: сесии ---
# Генерирай силен ключ, напр.: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_ATLEAST_16_CHARS
JWT_TTL_HOURS=12
# Бисквитката е host-only към домейна; secure се включва автоматично на production.
COOKIE_SECURE=true

# --- Първоначален админ (seed при старт; паролата се пресетва при всеки деплой) ---
ADMIN_EMAIL=admin@pomagam.carbonstealth.eu
ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- CORS (admin е same-origin; добави външни origin-и при нужда) ---
CORS_ORIGINS=https://pomagam.carbonstealth.eu

# --- Имейл към общината (Brevo SMTP, ползва се от worker-а) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Помагам Бобов дол <noreply@pomagam.carbonstealth.eu>"
EMAIL_TO_MUNICIPALITY=delovodstvo@bobovdol.egov.bg

# --- Лимити ---
MEDIA_MAX_MB=60
EMAIL_ATTACH_MAX_MB=8
