<%- include('_top', { titleKey: !result.ok ? 'auth.verifyFailedTitle' : result.kind === 'changed' ? 'auth.emailChangedTitle' : 'auth.verifiedTitle' }) %>
<% if (result.ok) { %>
<h1><%= t(result.kind === 'changed' ? 'auth.emailChangedTitle' : 'auth.verifiedTitle') %></h1>
<p><%= t(result.kind === 'changed' ? 'auth.emailChangedText' : 'auth.verifiedText') %></p>
<a class="btn btn-primary btn-wide" href="/login"><%= t('auth.toLogin') %></a>
<% } else { %>
<h1><%= t('auth.verifyFailedTitle') %></h1>
<p><%= t('auth.verifyFailedText') %></p>
<div class="auth-links"><a href="/login"><%= t('auth.toLogin') %></a></div>
<% } %>
<%- include('_bottom') %>
