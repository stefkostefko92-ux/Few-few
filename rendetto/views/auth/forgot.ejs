<%- include('_top', { titleKey: 'auth.forgotTitle' }) %>
<h1><%= t('auth.forgotTitle') %></h1>
<% if (sent) { %>
<p><%= t('auth.forgotSent') %></p>
<div class="auth-links"><a href="/login"><%= t('auth.toLogin') %></a></div>
<% } else { %>
<p><%= t('auth.forgotText') %></p>
<form method="post" action="/forgot" class="form">
  <input type="hidden" name="_csrf" value="<%= pre %>">
  <div class="field">
    <label for="email"><%= t('auth.email') %></label>
    <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254">
  </div>
  <button class="btn btn-primary btn-wide" type="submit"><%= t('auth.forgotButton') %></button>
</form>
<div class="auth-links"><a href="/login"><%= t('auth.toLogin') %></a></div>
<% } %>
<%- include('_bottom') %>
