<%- include('../partials/page-top', { title: account.email }) %>
<%- include('../partials/admin-nav') %>
<%- include('../partials/flash') %>
<% const locked = account.lockedUntil && account.lockedUntil > now; %>
<div class="acc-head">
  <h1><%= account.name %></h1>
  <div class="chips-row">
    <%- include('../partials/plan-chip', { plan }) %>
    <% if (account.role !== 'CUSTOMER') { %><span class="chip chip-gold"><%- include('../partials/icon', { name: 'shield' }) %><%= t('role.' + account.role) %></span><% } %>
    <% if (account.bannedAt) { %><span class="chip chip-bad"><%- include('../partials/icon', { name: 'ban' }) %><%= t('admin.status.banned') %></span><% } %>
    <% if (locked) { %><span class="chip chip-warn"><%- include('../partials/icon', { name: 'lock' }) %><%= t('admin.status.locked') %></span><% } %>
    <% if (account.totpEnabledAt) { %><span class="chip chip-ok"><%- include('../partials/icon', { name: 'shield' }) %>2FA</span><% } %>
  </div>
</div>
<p class="muted"><%= account.email %>, <%= t('admin.account.since', { date: fmt.date(account.createdAt) }) %><% if (account.signupCountry) { %>, <%= t('admin.account.signupFrom', { country: fmt.country(account.signupCountry) }) %><% } %></p>
<% if (!manageable) { %><div class="flash flash-info" role="status"><%- include('../partials/icon', { name: 'info' }) %><span><%= t('admin.account.readOnly') %></span></div><% } %>

<div class="acc-grid">
<div>
  <!-- plan -->
  <section class="section" aria-labelledby="plan-h" id="plan">
    <h2 id="plan-h"><%- include('../partials/icon', { name: 'receipt' }) %><%= t('admin.account.planTitle') %></h2>
    <dl class="dl">
      <dt><%= t('admin.col.plan') %></dt><dd><%= t('plan.name.' + account.plan) %></dd>
      <dt><%= t('admin.account.until') %></dt><dd><%= account.plan === 'LIFETIME' ? t('admin.account.forever') : account.planExpiresAt ? fmt.dateTime(account.planExpiresAt) : t('admin.account.notStarted') %><% if (plan.daysLeft) { %> <small>(<%= t('admin.account.daysLeft', { n: plan.daysLeft }) %>)</small><% } %></dd>
    </dl>
    <% if (request) { %><div class="flash flash-info" role="status"><%- include('../partials/icon', { name: 'receipt' }) %><span><%= t('admin.account.fromRequest', { option: request.option === 'lifetime' ? t('plan.lifetime') : t('plan.months', { n: request.months }), price: fmt.money(request.listPriceCents) }) %> <%= t('admin.account.orderTerms', { buyer: t(request.buyerType === 'CONSUMER' ? 'plan.buyer.consumerShort' : 'plan.buyer.businessShort'), early: t(request.earlyStartRequestedAt ? 'admin.account.yes' : 'admin.account.no'), date: fmt.dateTime(request.allowedFrom) }) %></span></div><% } %>
    <% if (manageable && can('accounts:plan')) { %>
    <form method="post" action="/admin/accounts/<%= account.id %>/plan#plan" class="form" data-plan-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (request) { %><input type="hidden" name="requestId" value="<%= request.id %>"><% } %>
      <fieldset>
        <legend><%= t('admin.account.newPlan') %></legend>
        <div class="form-row">
          <div class="field"><label for="p-plan"><%= t('admin.col.plan') %></label>
            <select id="p-plan" name="plan" data-plan-select>
              <option value="TRIAL"><%= t('plan.name.TRIAL') %></option>
              <option value="PREMIUM"<%= request && request.option !== 'lifetime' ? ' selected' : (!request ? ' selected' : '') %>><%= t('plan.name.PREMIUM') %></option>
              <option value="LIFETIME"<%= request && request.option === 'lifetime' ? ' selected' : '' %>><%= t('plan.name.LIFETIME') %></option>
            </select>
          </div>
          <div class="field" data-for-plan="TRIAL"><label for="p-days"><%= t('admin.account.trialDays') %></label><input id="p-days" name="days" type="number" min="1" max="365" value="<%= trialDays %>"></div>
          <div class="field" data-for-plan="PREMIUM"><label for="p-mode"><%= t('admin.account.premiumMode') %></label>
            <select id="p-mode" name="mode"><option value="months"><%= t('admin.account.byMonths') %></option><option value="date"><%= t('admin.account.byDate') %></option></select>
          </div>
          <div class="field" data-for-plan="PREMIUM"><label for="p-months"><%= t('admin.account.months') %></label>
            <select id="p-months" name="months"><% for (const row of prices.filter((r) => r.months)) { %><option value="<%= row.months %>"<%= request && request.months === row.months ? ' selected' : '' %>><%= t('plan.months', { n: row.months }) %> (<%= fmt.money(row.totalCents) %>)</option><% } %></select>
          </div>
          <div class="field" data-for-plan="PREMIUM"><label for="p-until"><%= t('admin.account.untilDate') %></label><input id="p-until" name="until" type="date"></div>
        </div>
        <p class="hint" data-for-plan="LIFETIME"><%= t('admin.account.lifetimeHint', { price: fmt.money(lifetimeCents) }) %></p>
        <p class="hint" data-for-plan="PREMIUM"><%= t('admin.account.premiumHint') %></p>
        <div class="field"><label for="p-note"><%= t('admin.account.note') %></label><input id="p-note" name="note" type="text" maxlength="500" placeholder="<%= t('admin.account.notePlaceholder') %>"></div>
        <label class="check"><input type="checkbox" name="notify" value="yes" checked><span><%= t('admin.account.notify') %></span></label>
      </fieldset>
      <div class="actions"><button class="btn btn-primary" type="submit"><%= t('admin.account.applyPlan') %></button></div>
    </form>
    <% } %>
    <h3><%= t('admin.account.planHistory') %></h3>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th><%= t('security.col.when') %></th><th><%= t('admin.account.change') %></th><th><%= t('admin.account.by') %></th></tr></thead>
      <tbody>
      <% for (const c of account.planChanges) { %>
        <tr><td data-label="<%= t('security.col.when') %>" class="nowrap"><%= fmt.dateTime(c.createdAt) %></td>
        <td data-label="<%= t('admin.account.change') %>"><%= c.fromPlan ? t('plan.name.' + c.fromPlan) + ' → ' : '' %><%= t('plan.name.' + c.toPlan) %><% if (c.toExpiresAt) { %>, <%= t('plan.endsOn', { date: fmt.shortDate(c.toExpiresAt) }) %><% } %><% if (c.listPriceCents) { %><br><small><%= t('admin.account.listPrice', { price: fmt.money(c.listPriceCents) }) %></small><% } %><% if (c.note) { %><br><small><%= fmt.label(c.note) %></small><% } %></td>
        <td data-label="<%= t('admin.account.by') %>" class="mini"><%= fmt.label(c.actorLabel) %></td></tr>
      <% } %>
      </tbody>
    </table></div>
  </section>

  <!-- logins: IP, country, HWID -->
  <% if (showLogins) { %>
  <section class="section" aria-labelledby="ip-h" id="logins">
    <h2 id="ip-h"><%- include('../partials/icon', { name: 'globe' }) %><%= t('admin.account.ipsTitle') %></h2>
    <% if (!ips.length) { %><p class="muted"><%= t('admin.account.noLogins') %></p><% } else { %>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th>IP</th><th><%= t('admin.col.country') %></th><th class="num"><%= t('admin.col.count') %></th><th><%= t('admin.col.last') %></th></tr></thead>
      <tbody><% for (const r of ips) { %><tr><td data-label="IP" class="mono-sm"><a href="/admin/accounts?q=<%= encodeURIComponent(r.ip || '') %>"><%= r.ip || '—' %></a></td><td data-label="<%= t('admin.col.country') %>"><%= r.country ? fmt.country(r.country) + ' (' + r.country + ')' : '—' %></td><td data-label="<%= t('admin.col.count') %>" class="num"><%= fmt.num(r.count) %></td><td data-label="<%= t('admin.col.last') %>" class="nowrap"><%= fmt.dateTime(r.last) %></td></tr><% } %></tbody>
    </table></div>
    <% } %>

    <h3><%= t('admin.account.devicesTitle') %></h3>
    <% if (!account.devices.length) { %><p class="muted"><%= t('admin.account.noDevices') %></p><% } else { %>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th>HWID</th><th><%= t('security.col.device') %></th><th><%= t('admin.col.last') %></th><th class="num"><%= t('admin.col.logins') %></th></tr></thead>
      <tbody><% for (const d of account.devices) { %><tr><td data-label="HWID" class="hwid"><%= fmt.hwid(d.fingerprintHash) || '—' %></td><td data-label="<%= t('security.col.device') %>" class="mini"><%= d.summary %><br><small><%= t('admin.account.firstSeen', { date: fmt.shortDate(d.firstSeenAt) }) %></small></td><td data-label="<%= t('admin.col.last') %>"><span class="nowrap"><%= fmt.dateTime(d.lastSeenAt) %></span><br><small class="mono-sm"><%= d.lastIp || '' %></small><% if (d.lastCountry) { %> <small><%= d.lastCountry %></small><% } %></td><td data-label="<%= t('admin.col.logins') %>" class="num"><%= fmt.num(d.loginCount) %></td></tr><% } %></tbody>
    </table></div>
    <% } %>

    <h3><%= t('admin.account.loginsTitle') %></h3>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th><%= t('security.col.when') %></th><th><%= t('security.col.result') %></th><th>IP</th><th>HWID</th></tr></thead>
      <tbody><% for (const l of logins) { const good = l.outcome === 'SUCCESS' || l.outcome === 'MFA_RECOVERY'; %><tr><td data-label="<%= t('security.col.when') %>" class="nowrap"><%= fmt.dateTime(l.createdAt) %></td><td data-label="<%= t('security.col.result') %>"><span class="chip <%= good ? 'chip-ok' : 'chip-bad' %>"><%- include('../partials/icon', { name: good ? 'check' : 'x' }) %><%= t('outcome.' + l.outcome) %></span></td><td data-label="IP"><span class="mono-sm"><%= l.ip || '—' %></span><% if (l.country) { %> <small><%= l.country %></small><% } %></td><td data-label="HWID" class="hwid"><%= fmt.hwid(l.fingerprintHash || (l.device && l.device.fingerprintHash)) || '—' %></td></tr><% } %></tbody>
    </table></div>
  </section>

  <section class="section" aria-labelledby="link-h" id="linked">
    <h2 id="link-h"><%- include('../partials/icon', { name: 'link' }) %><%= t('admin.account.linkedTitle') %></h2>
    <p class="hint"><%= t('admin.account.linkedHint') %></p>
    <% if (!linked.length) { %><p class="muted"><%= t('admin.account.noLinked') %></p><% } else { %>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th><%= t('admin.col.account') %></th><th><%= t('admin.account.sharedBy') %></th><th><%= t('admin.col.plan') %></th></tr></thead>
      <tbody><% for (const u of linked) { %><tr><td data-label="<%= t('admin.col.account') %>" class="who"><a href="/admin/accounts/<%= u.id %>"><%= u.email %></a><small><%= u.name %>, <%= fmt.shortDate(u.createdAt) %></small></td><td data-label="<%= t('admin.account.sharedBy') %>"><div class="chips-row"><% for (const r of u.reasons) { %><span class="chip <%= r === 'ip' ? '' : 'chip-warn' %>"><%- include('../partials/icon', { name: r === 'ip' ? 'globe' : r === 'hwid' ? 'layers' : 'device' }) %><%= t('admin.account.shared.' + r) %></span><% } %></div></td><td data-label="<%= t('admin.col.plan') %>"><%= t('plan.name.' + u.plan) %><% if (u.bannedAt) { %> <span class="chip chip-bad"><%- include('../partials/icon', { name: 'ban' }) %><%= t('admin.status.banned') %></span><% } %></td></tr><% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } %>

  <section class="section" aria-labelledby="proj-h" id="projects">
    <h2 id="proj-h"><%- include('../partials/icon', { name: 'folder' }) %><%= t('admin.account.projectsTitle', { n: account._count.projects }) %></h2>
    <% if (!account.projects.length) { %><p class="muted"><%= t('admin.account.noProjects') %></p><% } else { %>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th><%= t('app.name') %></th><th><%= t('app.type') %></th><th><%= t('admin.col.last') %></th><th></th></tr></thead>
      <tbody><% for (const p of account.projects) { %><tr><td data-label="<%= t('app.name') %>"><%= p.name %></td><td data-label="<%= t('app.type') %>"><%= t('furniture.' + p.type) %></td><td data-label="<%= t('admin.col.last') %>" class="nowrap"><%= fmt.dateTime(p.updatedAt) %></td><td><% if (can('accounts:security')) { %><a class="btn btn-small" href="/admin/projects/<%= p.id %>/export"><%- include('../partials/icon', { name: 'download' }) %>ZIP</a><% } %></td></tr><% } %></tbody>
    </table></div>
    <% } %>
  </section>
</div>

<div>
  <!-- access: ban / unban -->
  <section class="section<%= account.bannedAt ? ' danger' : '' %>" aria-labelledby="ban-h" id="access">
    <h2 id="ban-h"><%- include('../partials/icon', { name: 'ban' }) %><%= t('admin.account.accessTitle') %></h2>
    <% if (account.bannedAt) { %>
      <p class="bad-text"><%= t('admin.account.bannedSince', { date: fmt.dateTime(account.bannedAt) }) %></p>
      <figure class="ban-reason"><figcaption><%= t('auth.bannedReason') %></figcaption><blockquote><%= account.banReason %></blockquote></figure>
      <% if (manageable && can('accounts:ban')) { %>
      <form method="post" action="/admin/accounts/<%= account.id %>/unban#access" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="unban-note"><%= t('admin.account.unbanNote') %></label><input id="unban-note" name="note" type="text" maxlength="500"></div>
        <div class="actions"><button class="btn btn-primary" type="submit"><%- include('../partials/icon', { name: 'unlock' }) %><%= t('admin.account.unban') %></button></div>
      </form>
      <% } %>
    <% } else { %>
      <p class="ok-text"><%= t('admin.account.notBanned') %></p>
      <% if (manageable && can('accounts:ban')) { %>
      <form method="post" action="/admin/accounts/<%= account.id %>/ban#access" class="form" data-confirm="<%= t('admin.account.banConfirm') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="ban-reason"><%= t('admin.account.banReason') %></label><textarea id="ban-reason" name="reason" required minlength="3" maxlength="500" aria-describedby="ban-hint"></textarea><p class="hint" id="ban-hint"><%= t('admin.account.banHint') %></p></div>
        <div class="actions"><button class="btn btn-danger" type="submit"><%- include('../partials/icon', { name: 'ban' }) %><%= t('admin.account.ban') %></button></div>
      </form>
      <% } %>
    <% } %>
    <% if (account.bans.length) { %>
    <h3><%= t('admin.account.banHistory') %></h3>
    <ul class="mini">
      <% for (const b of account.bans) { %><li><%= fmt.dateTime(b.createdAt) %>, <%= fmt.label(b.bannedByLabel) %>: <%= b.reason %><% if (b.liftedAt) { %><br><small><%= t('admin.account.liftedBy', { date: fmt.dateTime(b.liftedAt), who: fmt.label(b.liftedByLabel) }) %><% if (b.liftNote) { %>: <%= b.liftNote %><% } %></small><% } %></li><% } %>
    </ul>
    <% } %>
  </section>

  <!-- security -->
  <section class="section" aria-labelledby="sec-h" id="security">
    <h2 id="sec-h"><%- include('../partials/icon', { name: 'shield' }) %><%= t('admin.account.securityTitle') %></h2>
    <dl class="dl">
      <dt>2FA</dt><dd><%= account.totpEnabledAt ? t('admin.account.twofaOn', { date: fmt.shortDate(account.totpEnabledAt), n: recoveryLeft }) : t('admin.account.twofaOff') %></dd>
      <dt><%= t('admin.account.sessions') %></dt><dd><%= fmt.num(account.sessions.length) %></dd>
      <dt><%= t('admin.account.lastLogin') %></dt><dd><%= account.lastLoginAt ? fmt.dateTime(account.lastLoginAt) : '—' %><% if (showLogins && account.lastLoginIp) { %><br><small class="mono-sm"><%= account.lastLoginIp %></small><% } %><% if (account.lastLoginCountry) { %> <small><%= fmt.country(account.lastLoginCountry) %></small><% } %></dd>
      <dt><%= t('admin.account.failed') %></dt><dd><%= fmt.num(account.failedLogins) %><% if (locked) { %>, <%= t('admin.account.lockedUntil', { time: fmt.dateTime(account.lockedUntil) }) %><% } %></dd>
    </dl>
    <% if (manageable && can('accounts:security')) { %>
    <div class="actions">
      <form method="post" action="/admin/accounts/<%= account.id %>/sessions/revoke#security"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small" type="submit"><%- include('../partials/icon', { name: 'logout' }) %><%= t('admin.account.revokeSessions') %></button></form>
      <form method="post" action="/admin/accounts/<%= account.id %>/reset-password#security"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small" type="submit"><%- include('../partials/icon', { name: 'mail' }) %><%= t('admin.account.sendReset') %></button></form>
      <% if (locked) { %><form method="post" action="/admin/accounts/<%= account.id %>/unlock#security"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small" type="submit"><%- include('../partials/icon', { name: 'unlock' }) %><%= t('admin.account.unlock') %></button></form><% } %>
      <% if (account.totpEnabledAt) { %><form method="post" action="/admin/accounts/<%= account.id %>/2fa-reset#security" data-confirm="<%= t('admin.account.reset2faConfirm') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small btn-danger" type="submit"><%- include('../partials/icon', { name: 'key' }) %><%= t('admin.account.reset2fa') %></button></form><% } %>
    </div>
    <% } %>
  </section>

  <!-- profile -->
  <section class="section" aria-labelledby="edit-h" id="profile">
    <h2 id="edit-h"><%- include('../partials/icon', { name: 'edit' }) %><%= t('admin.account.profileTitle') %></h2>
    <form method="post" action="/admin/accounts/<%= account.id %>/edit#profile" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset<%= manageable && can('accounts:edit') ? '' : ' disabled' %>>
        <div class="field"><label for="e-name"><%= t('auth.name') %></label><input id="e-name" name="name" type="text" required minlength="2" maxlength="80" value="<%= account.name %>"></div>
        <div class="field"><label for="e-email"><%= t('auth.email') %></label><input id="e-email" name="email" type="email" required maxlength="254" value="<%= account.email %>"></div>
        <div class="field"><label for="e-locale"><%= t('account.language') %></label><select id="e-locale" name="locale"><% for (const l of locales) { %><option value="<%= l %>"<%= account.locale === l ? ' selected' : '' %>><%= localeLabel[l] %></option><% } %></select></div>
        <label class="check"><input type="checkbox" name="emailVerified" value="yes"<%= account.emailVerifiedAt ? ' checked disabled' : '' %>><span><%= t('admin.account.verifiedBox') %></span></label>
        <div class="actions"><button class="btn" type="submit"><%= t('common.save') %></button></div>
      </fieldset>
    </form>
    <% if (manageable && can('staff:manage') && roles.length) { %>
    <form method="post" action="/admin/accounts/<%= account.id %>/role#profile" class="form" data-confirm="<%= t('admin.account.roleConfirm') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="field"><label for="e-role"><%= t('admin.account.role') %></label><select id="e-role" name="role"><% for (const r of roles) { %><option value="<%= r %>"<%= account.role === r ? ' selected' : '' %>><%= t('role.' + r) %></option><% } %></select></div>
        <button class="btn" type="submit"><%= t('admin.account.changeRole') %></button>
      </div>
      <p class="hint"><%= t('admin.account.roleHint') %></p>
    </form>
    <% } %>
  </section>

  <% if (audit.length) { %>
  <section class="section" aria-labelledby="aud-h" id="audit">
    <h2 id="aud-h"><%- include('../partials/icon', { name: 'history' }) %><%= t('admin.account.auditTitle') %></h2>
    <ul class="mini">
      <% for (const a of audit) { %><li><span class="nowrap"><%= fmt.dateTime(a.at) %></span>: <code><%= a.action %></code>, <%= fmt.label(a.actorLabel) %></li><% } %>
    </ul>
  </section>
  <% } %>

  <% if (manageable && can('accounts:delete')) { %>
  <section class="section danger" aria-labelledby="del-h" id="delete">
    <h2 id="del-h"><%- include('../partials/icon', { name: 'trash' }) %><%= t('admin.account.deleteTitle') %></h2>
    <p><%= t('admin.account.deleteText') %></p>
    <form method="post" action="/admin/accounts/<%= account.id %>/delete" class="form" data-confirm="<%= t('admin.account.deleteConfirm') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="d-email"><%= t('admin.account.typeEmail', { email: account.email }) %></label><input id="d-email" name="confirmEmail" type="email" required autocomplete="off"></div>
      <div class="actions"><button class="btn btn-danger" type="submit"><%= t('admin.account.deleteButton') %></button></div>
    </form>
  </section>
  <% } %>
</div>
</div>
<%- include('../partials/page-bottom') %>
