<%- include('../partials/page-top', { title: t('admin.requests.title') }) %>
<div class="page-head"><h1><%= t('admin.requests.title') %></h1>
  <p><a href="/admin/requests<%= status === 'all' ? '' : '?status=all' %>"><%= t(status === 'all' ? 'admin.requests.onlyOpen' : 'admin.requests.showAll') %></a></p></div>
<%- include('../partials/admin-nav') %>
<%- include('../partials/flash') %>
<p class="muted"><%= t('admin.requests.how') %></p>
<% if (!requests.length) { %><p class="empty"><%= t('admin.requests.none') %></p><% } else { %>
<div class="table-wrap"><table class="stack">
  <thead><tr><th><%= t('plan.col.date') %></th><th><%= t('admin.col.account') %></th><th><%= t('plan.col.option') %></th><th class="num"><%= t('plan.col.price') %></th><th><%= t('plan.message') %></th><th><%= t('plan.col.status') %></th><th><%= t('plan.col.actions') %></th></tr></thead>
  <tbody>
  <% for (const r of requests) { %>
    <tr>
      <td data-label="<%= t('plan.col.date') %>" class="nowrap"><%= fmt.dateTime(r.createdAt) %></td>
      <td data-label="<%= t('admin.col.account') %>" class="who"><a href="/admin/accounts/<%= r.user.id %>"><%= r.user.email %></a><small><%= r.user.name %>, <%= t('plan.name.' + r.user.plan) %></small></td>
      <td data-label="<%= t('plan.col.option') %>"><%= r.option === 'lifetime' ? t('plan.lifetime') : t('plan.months', { n: r.months }) %><br><small class="muted"><%= t(r.buyerType === 'CONSUMER' ? 'plan.buyer.consumerShort' : 'plan.buyer.businessShort') %><% if (r.earlyStartRequestedAt) { %>, <%= t('plan.early.short') %><% } %></small></td>
      <td data-label="<%= t('plan.col.price') %>" class="num"><%= fmt.money(r.listPriceCents) %><br><small class="muted"><%= t('plan.netShort') %><% if (r.buyerType === 'CONSUMER') { %>; <%= fmt.money(r.withVatCents) %> <%= t('plan.withVatShort') %><% } %></small></td>
      <td data-label="<%= t('plan.message') %>" class="mini"><%= r.message || '—' %></td>
      <td data-label="<%= t('plan.col.status') %>"><span class="chip <%= r.status === 'DONE' ? 'chip-ok' : r.status === 'OPEN' ? 'chip-gold' : r.status === 'WITHDRAWN' ? 'chip-warn' : '' %>"><%- include('../partials/icon', { name: r.status === 'DONE' ? 'check' : r.status === 'OPEN' ? 'clock' : 'x' }) %><%= t('plan.status.' + r.status) %></span>
        <% if (r.handledByLabel) { %><br><small><%= fmt.label(r.handledByLabel) %></small><% } %>
        <% if (r.status === 'OPEN' && r.activationFrom > now) { %><br><small><%= t('plan.activationAfter', { date: fmt.dateTime(r.activationFrom) }) %></small><% } %>
        <% if (r.status === 'WITHDRAWN') { %><br><small><%= t('plan.withdrawnOn', { date: fmt.dateTime(r.withdrawnAt) }) %></small><br><small><%= t('admin.requests.refundBy', { date: fmt.date(r.refundBy) }) %></small><% if (r.handledAt) { %><br><small><%= t(r.planReverted ? 'admin.requests.planReverted' : 'admin.requests.planManual') %></small><% } %><% } %>
        <% if (r.termsVersion && !r.confirmationSentAt && (r.status === 'OPEN' || r.status === 'DONE')) { %><br><small class="bad-text"><%= t('admin.requests.notConfirmed') %></small><% } %></td>
      <td data-label="<%= t('plan.col.actions') %>"><% if (r.status === 'OPEN') { %><div class="actions">
        <% if (can('accounts:plan')) { %><a class="btn btn-small btn-primary" href="/admin/accounts/<%= r.user.id %>?request=<%= r.id %>#plan"><%= t('admin.requests.activate') %></a><% } %>
        <% if (can('requests:handle')) { %><form method="post" action="/admin/requests/<%= r.id %>/reject" data-confirm="<%= t('admin.requests.rejectConfirm') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-small btn-quiet" type="submit"><%= t('admin.requests.reject') %></button></form><% } %>
      </div><% } else { %>—<% } %></td>
    </tr>
  <% } %>
  </tbody>
</table></div>
<% } %>
<%- include('../partials/page-bottom') %>
