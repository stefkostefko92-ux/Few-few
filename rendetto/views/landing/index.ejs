<%
  const title = t('landing.meta.title');
  const description = t('landing.meta.description', texts.description);
  const edges = (list) => (list.length ? list.map((value) => fmt.num(value)).join(' + ') : '—');
  const mm = (value) => fmt.num(value);
  const sheet = assets.sheet;
  const door = assets.door;
  const register = '/register?lang=' + locale;
%><%- include('../partials/head', { title, description, styles: ['site'], extraHead: include('../partials/public-meta', { title, description, keywords: t('landing.meta.keywords') }) }) %>
<body class="site">
<%- include('../partials/site-bar', { sections: true }) %>
<main id="main">

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-text">
      <h1 id="hero-title"><span><%= t('landing.hero.line1') %></span> <span><%= t('landing.hero.line2') %></span></h1>
      <p class="lead"><%= t('landing.hero.lead') %></p>
      <div class="cta">
        <a class="btn btn-primary btn-big" href="<%= register %>"><%= t('landing.cta.start') %></a>
        <a class="cta-link" href="#how"><%= t('landing.cta.how') %></a>
      </div>
      <p class="trial-note"><%- include('../partials/icon', { name: 'clock' }) %><span><%= t('landing.hero.trial', { days: trialDays }) %></span></p>
    </div>
    <figure class="bed">
      <%- sheet.svg %>
      <figcaption>
        <span><%= t('landing.hero.caption', { no: sheet.no, count: sheet.count, modules: assets.example.modules, width: mm(assets.example.moduleWidth), parts: sheet.parts, holes: mm(sheet.holes) }) %></span>
        <span class="legend">
          <% if (assets.tools.contour) { %><span><i class="key key-contour" aria-hidden="true"></i><%= t('landing.hero.keyContour', { d: mm(assets.tools.contour) }) %></span><% } %>
          <% if (assets.tools.groove) { %><span><i class="key key-groove" aria-hidden="true"></i><%= t('landing.hero.keyGroove', { d: mm(assets.tools.groove) }) %></span><% } %>
          <% if (assets.tools.drills.length) { %><span><i class="key key-drill" aria-hidden="true"></i><%= t('landing.hero.keyDrill', { list: assets.tools.drills.map((d) => 'Ø' + mm(d)).join(', ') }) %></span><% } %>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="band" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title"><%= t('landing.how.title') %></h2>
    <p class="band-lead"><%= t('landing.how.lead') %></p>
    <ol class="steps">
      <% for (const n of howSteps) { %>
      <li id="how-<%= n %>">
        <span class="step-n" aria-hidden="true"><%= n %></span>
        <h3><%= t('landing.how.s' + n + '.title') %></h3>
        <p><%= t('landing.how.s' + n + '.text') %></p>
      </li>
      <% } %>
    </ol>
    <div class="outputs">
      <figure class="output">
        <div class="table-wrap" tabindex="0" role="region" aria-labelledby="cut-caption">
          <table class="cut">
            <caption class="sr-only" id="cut-caption"><%= t('landing.cut.caption', { shown: assets.cutRows.length, total: assets.example.parts }) %></caption>
            <thead>
              <tr>
                <th scope="col"><%= t('landing.cut.id') %></th>
                <th scope="col"><%= t('landing.cut.part') %></th>
                <th scope="col" class="num"><%= t('landing.cut.finished') %></th>
                <th scope="col" class="num"><%= t('landing.cut.cut') %></th>
                <th scope="col" class="num"><%= t('landing.cut.edgeL') %></th>
                <th scope="col" class="num"><%= t('landing.cut.edgeW') %></th>
                <th scope="col" class="num"><%= t('landing.cut.holes') %></th>
              </tr>
            </thead>
            <tbody>
              <% for (const row of assets.cutRows) { %>
              <tr>
                <td class="mono"><%= row.id %></td>
                <td><%= t('landing.cut.parts.' + row.slot) %></td>
                <td class="num nowrap"><%= mm(row.L) %> × <%= mm(row.W) %> × <%= mm(row.T) %></td>
                <td class="num nowrap"><%= mm(row.cutL) %> × <%= mm(row.cutW) %></td>
                <td class="num"><%= edges(row.edgesL) %></td>
                <td class="num"><%= edges(row.edgesW) %></td>
                <td class="num"><%= row.holes || '—' %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <figcaption><%= t('landing.cut.note', { shown: assets.cutRows.length, total: assets.example.parts }) %></figcaption>
      </figure>
      <figure class="output">
        <pre tabindex="0" role="region" aria-labelledby="gcode-note"><code><%= assets.gcode.join('\n') %></code></pre>
        <figcaption id="gcode-note"><%= t('landing.gcode.note', { no: sheet.no, count: sheet.count }) %></figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="band" id="drilling" aria-labelledby="drilling-title">
  <div class="wrap drill-grid">
    <div>
      <h2 id="drilling-title"><%= t('landing.drilling.title') %></h2>
      <p class="band-lead"><%= t('landing.drilling.lead') %></p>
      <ul class="facts">
        <% if (door) { %><li><%- include('../partials/icon', { name: 'drill' }) %><span><%= t('landing.drilling.cup', { c: mm(door.c), overlay: mm(door.overlay), plate: mm(door.plate) }) %></span></li><% } %>
        <li><%- include('../partials/icon', { name: 'drill' }) %><span><%= t('landing.drilling.system32') %></span></li>
        <li><%- include('../partials/icon', { name: 'drill' }) %><span><%= t('landing.drilling.handles') %></span></li>
        <li><%- include('../partials/icon', { name: 'drill' }) %><span><%= t('landing.drilling.edges') %></span></li>
        <li><%- include('../partials/icon', { name: 'alert' }) %><span><%= t('landing.drilling.checks') %></span></li>
      </ul>
    </div>
    <% if (door) { %>
    <figure class="sheet-paper">
      <div class="drill-views">
        <img src="/media/door-elevation.svg" width="<%= door.elevation.width %>" height="<%= door.elevation.height %>" loading="lazy" decoding="async" alt="<%= t('landing.drilling.imageAlt', { h: mm(door.height), w: mm(door.width) }) %>">
        <img src="/media/door-cup.svg" width="<%= door.cup.width %>" height="<%= door.cup.height %>" loading="lazy" decoding="async" alt="<%= t('landing.drilling.cupAlt', { c: mm(door.c) }) %>">
      </div>
      <figcaption><%= t('landing.drilling.caption', { h: mm(door.height), w: mm(door.width) }) %> <a href="/media/door-drawing.svg" target="_blank" rel="noopener"><%= t('landing.drilling.open') %></a></figcaption>
    </figure>
    <% } %>
  </div>
</section>

<section class="band" id="kinds" aria-labelledby="kinds-title">
  <div class="wrap">
    <h2 id="kinds-title"><%= t('landing.kinds.title') %></h2>
    <p class="band-lead"><%= t('landing.kinds.lead') %></p>
    <div class="kinds">
      <% for (const group of kinds) { %>
      <section aria-labelledby="g-<%= group.group %>">
        <h3 id="g-<%= group.group %>"><%= t('furniture.group.' + group.group) %></h3>
        <ul>
          <% for (const kind of group.kinds) { const r = kind.range; %>
          <li><span><%= t('furniture.' + kind.id) %></span><% if (r) { %><small class="muted"><%= r.kind === 'modules' ? t('landing.kinds.modules', { min: r.min, max: r.max, wmin: mm(r.widthMin), wmax: mm(r.widthMax) }) : r.kind === 'mattress' ? t('landing.kinds.mattress', { min: mm(r.min), max: mm(r.max) }) : t('landing.kinds.width', { min: mm(r.min), max: mm(r.max) }) %></small><% } %></li>
          <% } %>
        </ul>
      </section>
      <% } %>
    </div>
    <p class="rules"><%= t('landing.kinds.rules') %></p>
  </div>
</section>

<section class="band" id="machine" aria-labelledby="machine-title">
  <div class="wrap">
    <h2 id="machine-title"><%= t('landing.machine.title') %></h2>
    <p class="band-lead"><%= t('landing.machine.lead') %></p>
    <dl class="formats">
      <div><dt><%= t('landing.machine.dxf.title') %></dt><dd><%= t('landing.machine.dxf.text') %><span class="layers"><% for (const layer of assets.dxfLayers) { %><code><%= layer %></code><% } %></span></dd></div>
      <div><dt><%= t('landing.machine.iso.title') %></dt><dd><%= t('landing.machine.iso.text') %></dd></div>
      <div><dt><%= t('landing.machine.grbl.title') %></dt><dd><%= t('landing.machine.grbl.text') %></dd></div>
      <div><dt><%= t('landing.machine.csv.title') %></dt><dd><%= t('landing.machine.csv.text') %></dd></div>
      <div><dt><%= t('landing.machine.zip.title') %></dt><dd><%= t('landing.machine.zip.text') %></dd></div>
      <div><dt><%= t('landing.machine.drawings.title') %></dt><dd><%= t('landing.machine.drawings.text') %></dd></div>
    </dl>
    <p class="caution"><%- include('../partials/icon', { name: 'alert' }) %><span><%= t('landing.machine.caution') %></span></p>
  </div>
</section>

<section class="band" id="prices" aria-labelledby="prices-title">
  <div class="wrap">
    <h2 id="prices-title"><%= t('landing.prices.title') %></h2>
    <p class="trial-statement"><%= t('landing.prices.trial', { days: trialDays }) %></p>
    <ul class="price-list">
      <% for (const row of prices) { const lifetime = row.id === 'lifetime'; %>
      <li class="price<%= lifetime ? ' price-lifetime' : '' %>">
        <span class="price-period"><%= lifetime ? t('landing.price.lifetime') : t('landing.price.months', { n: row.months }) %></span>
        <span class="price-total"><%= fmt.money(row.totalWithVatCents) %></span>
        <span class="price-month"><%= lifetime ? t('landing.price.once') : t('landing.price.perMonth', { amount: fmt.money(row.perMonthWithVatCents) }) %></span>
        <span class="price-vat"><%= t('landing.price.withoutVat', { amount: fmt.money(row.totalCents) }) %></span>
        <% if (row.discountPercent) { %><span class="price-off"><%= t('landing.price.off', { pct: row.discountPercent }) %></span><% } %>
      </li>
      <% } %>
    </ul>
    <ul class="price-notes">
      <li><%= t('landing.prices.vat', { vat: vatPercent }) %></li>
      <li><%= t('landing.prices.lifetime', texts.lifetime) %></li>
      <li><%= t('landing.prices.manual') %></li>
      <li><%= t('landing.prices.expired') %></li>
    </ul>
    <div class="cta"><a class="btn btn-primary btn-big" href="<%= register %>"><%= t('landing.cta.start') %></a></div>
  </div>
</section>

<section class="band" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <h2 id="faq-title"><%= t('landing.faq.title') %></h2>
    <div class="faq">
      <% for (const id of faqIds) { %>
      <details>
        <summary><h3><%= t('landing.faq.' + id + '.q') %></h3></summary>
        <p><%= t('landing.faq.' + id + '.a', texts.faq[id]) %></p>
      </details>
      <% } %>
    </div>
  </div>
</section>

<section class="band closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 id="closing-title"><%= t('landing.closing.title') %></h2>
    <p><%= t('landing.closing.text', { days: trialDays }) %></p>
    <div class="cta">
      <a class="btn btn-primary btn-big" href="<%= register %>"><%= t('landing.cta.start') %></a>
      <a class="cta-link" href="/login?lang=<%= locale %>"><%= t('landing.closing.login') %></a>
    </div>
  </div>
</section>

</main>
<%- include('../partials/site-foot') %>
</body>
</html>
