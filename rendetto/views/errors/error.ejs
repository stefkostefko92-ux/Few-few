<%- include('../partials/head', { title: t(titleKey) + ' — Rendetto', styles: ['app'], noindex: true }) %>
<body class="auth">
<%- include('../partials/sprite') %>
<main class="auth-main" id="main">
  <div class="auth-card">
    <div class="auth-head">
      <a class="brand" href="<%= paths[locale] %>"><%- include('../partials/mark') %><span>Rendetto</span></a>
    </div>
    <p class="status-code"><%= status %></p>
    <h1><%= t(titleKey) %></h1>
    <p><%= t(messageKey) %></p>
    <% if (typeof details !== 'undefined' && details.length) { %>
    <ul class="error-details"><% for (const d of details) { %><li><%= d %></li><% } %></ul>
    <% } %>
    <div class="auth-links">
      <% if (typeof back !== 'undefined') { %><a href="<%= back.href %>"><%= t(back.key) %></a><% } %>
      <a href="<%= paths[locale] %>"><%= t('error.toHome') %></a>
      <a href="/app"><%= t('error.toProjects') %></a>
    </div>
  </div>
</main>
<%- include('../partials/app-footer') %>
</body>
</html>
