<%- include('../partials/head', { title: project.name + ' — Rendetto', styles: ['app'], noindex: true, extraHead: '<link rel="stylesheet" href="/static/editor/editor.css?v=' + v + '">' + editorPreload.map((p) => '<link rel="modulepreload" href="/static/editor/' + p + '">').join('') }) %>
<body class="appbody editor-body">
<%- include('../partials/app-header') %>
<main class="editor" id="main" lang="bg" data-readonly="<%= readOnly ? 'true' : 'false' %>" data-csrf="<%= csrfToken %>" data-text="<%= JSON.stringify({ saving: te('editor.saving'), unsaved: te('editor.unsaved'), saved: te('editor.saved'), saveFailed: te('editor.saveFailed'), noWebgl: te('editor.noWebgl'), photoPreparing: te('editor.photoPreparing'), photoProgress: te('editor.photoProgress'), photoReady: te('editor.photoReady'), photoUnsupported: te('editor.photoUnsupported'), photoFailed: te('editor.photoFailed'), photoSaveFailed: te('editor.photoSaveFailed'), fullscreen: te('editor.fullscreen'), zoomIn: te('editor.zoomIn'), zoomOut: te('editor.zoomOut'), zoomFit: te('editor.zoomFit'), zoomHint: te('editor.zoomHint'), cncBlockedLink: te('editor.cncBlockedLink'), catalogFailed: te('editor.catalogFailed'), engineFailed: te('editor.engineFailed'), showFailed: te('editor.showFailed') }) %>">
  <div class="ed-top">
    <a class="btn btn-quiet btn-small" href="/app"><%- include('../partials/icon', { name: 'back' }) %><span><%= te('editor.back') %></span></a>
    <div class="ed-title">
      <label class="sr-only" for="project-name"><%= te('editor.name') %></label>
      <input id="project-name" class="ed-name" type="text" maxlength="80" value="<%= project.name %>"<%= readOnly ? ' readonly' : '' %>>
      <span class="ed-spec" id="title-spec"></span>
    </div>
    <div class="ed-actions">
      <span class="ed-state" id="save-state" role="status" aria-live="polite"><%= readOnly ? te('editor.readOnlyState') : te('editor.saved') %></span>
      <% if (!readOnly) { %><button class="btn btn-primary btn-small" type="button" id="save"><%- include('../partials/icon', { name: 'save' }) %><span><%= te('editor.save') %></span></button><% } %>
      <details class="menu">
        <summary class="btn btn-small"><%- include('../partials/icon', { name: 'download' }) %><span><%= te('editor.download') %></span></summary>
        <div class="menu-list" role="menu">
          <a role="menuitem" data-export href="/app/p/<%= project.id %>/export/project.zip"><%= te('editor.export.project') %></a>
          <a role="menuitem" data-export href="/app/p/<%= project.id %>/export/cut-list.csv"><%= te('editor.export.cutlist') %></a>
          <a role="menuitem" data-export href="/app/p/<%= project.id %>/export/hardware.csv"><%= te('editor.export.hardware') %></a>
          <a role="menuitem" data-export href="/app/p/<%= project.id %>/export/drilling.csv"><%= te('editor.export.drilling') %></a>
          <a role="menuitem" data-export href="/app/p/<%= project.id %>/export/drawings.zip"><%= te('editor.export.drawings') %></a>
          <a role="menuitem" data-export="cnc" href="/app/p/<%= project.id %>/export/cnc.zip"><%= te('editor.export.cnc') %></a>
          <p class="menu-note"><%= te('editor.export.note') %></p>
        </div>
      </details>
      <details class="dfm">
        <summary id="dfm-chip" data-level="ok"><%= te('editor.checks') %></summary>
        <ul id="dfm-list"></ul>
      </details>
    </div>
  </div>

  <% if (locale !== 'bg') { %><p class="ed-lang" lang="<%= locale %>"><%- include('../partials/icon', { name: 'info' }) %><span><%= t('editor.languageNote') %></span></p><% } %>
  <% if (readOnly) { %>
  <section class="notice <%= plan.blockedBy === 'unverified' ? 'notice-warn' : 'notice-bad' %> ed-notice" lang="<%= locale %>">
    <%- include('../partials/icon', { name: 'lock' }) %>
    <div>
      <h2><%= t(plan.blockedBy === 'unverified' ? 'app.unverifiedTitle' : 'editor.readOnlyTitle') %></h2>
      <p><%= t(plan.blockedBy === 'unverified' ? 'app.unverifiedText' : 'editor.readOnlyText') %></p>
      <% if (plan.blockedBy !== 'unverified') { %><a class="btn btn-primary btn-small" href="/account/plan"><%= t('app.seePlans') %></a><% } %>
    </div>
  </section>
  <% } %>
  <p class="ed-error" id="save-error" role="alert" hidden></p>

  <div class="app-grid">
    <form id="params" class="rail" aria-label="<%= te('editor.params') %>">
      <fieldset<%= readOnly ? ' disabled' : '' %>>
      <details class="railbox" open>
        <summary><%= te('editor.project') %></summary>
        <div class="group"><h3><%= te('editor.furniture') %></h3><div id="type-picker" role="radiogroup" aria-label="<%= te('editor.furnitureType') %>"></div></div>
        <div class="group"><h3><%= te('editor.sizes') %></h3><div id="param-fields" class="group group-flat"></div></div>
        <div class="group">
          <h3><%= te('editor.materials') %></h3>
          <span class="lbl"><%= te('editor.carcass') %></span>
          <button type="button" class="pickbtn" data-pick="carcassDecor"></button>
          <span class="lbl" id="l-front"><%= te('editor.front') %></span>
          <div class="seg" role="radiogroup" aria-labelledby="l-front">
            <label><input type="radio" name="frontMaterial" value="decor" data-field="frontMaterial"><span><%= te('editor.frontDecor') %></span></label>
            <label><input type="radio" name="frontMaterial" id="f-frontMaterial-ral" value="ral" data-field="frontMaterial"><span><%= te('editor.frontRal') %></span></label>
          </div>
          <div id="row-frontDecor"><button type="button" class="pickbtn" data-pick="frontDecor"></button></div>
          <div id="row-frontRal"><button type="button" class="pickbtn" data-pick="frontRal"></button></div>
          <div class="field sel"><label for="f-bandCarcass"><%= te('editor.bandCarcass') %></label><select id="f-bandCarcass" data-field="bandCarcass"><option value="0"><%= te('editor.none') %></option><option value="0.8">0,8 mm</option><option value="1">1 mm</option><option value="2">2 mm</option></select></div>
          <div class="field sel"><label for="f-bandFront"><%= te('editor.bandFront') %></label><select id="f-bandFront" data-field="bandFront"><option value="0.8">0,8 mm</option><option value="1">1 mm</option><option value="2">2 mm</option></select></div>
          <div class="field"><label for="f-gap"><%= te('editor.gap') %></label><output data-for="gap" data-unit="mm" for="f-gap">3 mm</output><input type="range" id="f-gap" data-field="gap" min="2" max="4" step="0.5"></div>
        </div>
        <div class="group">
          <h3><%= te('editor.hardware') %></h3>
          <div class="field wide"><label for="f-hinge"><%= te('editor.hinge') %></label><select id="f-hinge" data-field="hinge"></select></div>
          <span class="lbl"><%= te('editor.handle') %></span>
          <button type="button" class="pickbtn" data-pick="handle"></button>
          <div class="field wide"><label for="f-slide"><%= te('editor.slide') %></label><select id="f-slide" data-field="slide"></select></div>
          <div class="field wide" id="row-bedFitting"><label for="f-bedFitting"><%= te('editor.bedFitting') %></label><select id="f-bedFitting" data-field="bedFitting"></select></div>
        </div>
        <div class="group">
          <h3><%= te('editor.machine') %></h3>
          <div class="field sel"><label for="f-tool"><%= te('editor.tool') %></label><select id="f-tool" data-field="tool"><option value="6">Ø6 mm</option><option value="8">Ø8 mm</option><option value="10">Ø10 mm</option><option value="12">Ø12 mm</option></select></div>
          <span class="lbl" id="l-post"><%= te('editor.post') %></span>
          <div class="seg" role="radiogroup" aria-labelledby="l-post">
            <label><input type="radio" name="post" value="iso" data-field="post"><span>ISO / Fanuc</span></label>
            <label><input type="radio" name="post" value="grbl" data-field="post"><span>GRBL</span></label>
          </div>
          <label class="check" for="f-onion"><input type="checkbox" id="f-onion" data-field="onion"><span><%= te('editor.onion') %></span></label>
          <label class="check" for="f-comp"><input type="checkbox" id="f-comp" data-field="bandCompensation"><span><%= te('editor.compensation') %></span></label>
          <span class="lbl" id="l-load"><%= te('editor.shelfLoad') %></span>
          <div class="seg" id="f-shelfLoad" role="radiogroup" aria-labelledby="l-load"></div>
        </div>
        <div class="group"><button type="button" class="btn btn-small" id="reset"><%= te('editor.reset') %></button></div>
      </details>
      </fieldset>
    </form>

    <div class="work">
      <div role="tablist" aria-label="<%= te('editor.outputs') %>">
        <button type="button" role="tab" data-tab="view" id="tab-view" aria-controls="panel-view" aria-selected="true">3D</button>
        <button type="button" role="tab" data-tab="bom" id="tab-bom" aria-controls="panel-bom" aria-selected="false" tabindex="-1"><%= te('editor.tab.bom') %></button>
        <button type="button" role="tab" data-tab="drill" id="tab-drill" aria-controls="panel-drill" aria-selected="false" tabindex="-1"><%= te('editor.tab.drill') %></button>
        <button type="button" role="tab" data-tab="nest" id="tab-nest" aria-controls="panel-nest" aria-selected="false" tabindex="-1"><%= te('editor.tab.nest') %></button>
        <button type="button" role="tab" data-tab="draw" id="tab-draw" aria-controls="panel-draw" aria-selected="false" tabindex="-1"><%= te('editor.tab.draw') %></button>
        <button type="button" role="tab" data-tab="cnc" id="tab-cnc" aria-controls="panel-cnc" aria-selected="false" tabindex="-1">CNC</button>
        <button type="button" role="tab" data-tab="cat" id="tab-cat" aria-controls="panel-cat" aria-selected="false" tabindex="-1"><%= te('editor.tab.catalog') %></button>
      </div>

      <section id="panel-view" role="tabpanel" aria-labelledby="tab-view">
        <div class="stage" id="stage"></div>
        <div class="viewbar">
          <div class="ctl"><label for="open"><%= te('editor.open') %></label><input type="range" id="open" min="0" max="100" value="0" step="1"><output id="open-out" for="open">0%</output></div>
          <div class="ctl"><label for="explode"><%= te('editor.explode') %></label><input type="range" id="explode" min="0" max="100" value="0" step="1"><output id="explode-out" for="explode">0%</output></div>
          <button type="button" class="btn btn-small" id="explode-play"><%= te('editor.explodePlay') %></button>
          <label class="check" for="ops"><input type="checkbox" id="ops" checked><span><%= te('editor.showHoles') %></span></label>
          <label class="check" for="room"><input type="checkbox" id="room"><span><%= te('editor.room') %></span></label>
          <button type="button" class="btn btn-small" id="photo" aria-pressed="false"><%= te('editor.photo') %></button>
          <button type="button" class="btn btn-small" id="photo-save" hidden><%= te('editor.photoSave') %></button>
          <output id="photo-state" class="hint" aria-live="polite"></output>
          <button type="button" class="btn btn-small fs-btn" data-fs="panel-view" aria-pressed="false"><%- include('../partials/icon', { name: 'expand' }) %><span><%= te('editor.fullscreen') %></span></button>
        </div>
        <p class="hint"><%= te('editor.viewHint') %></p>
      </section>

      <section id="panel-bom" role="tabpanel" aria-labelledby="tab-bom" hidden>
        <div class="stats" id="bom-summary"></div>
        <div class="row"><h2><%= te('editor.parts') %></h2><div class="acts"><button type="button" class="btn btn-small" id="copy-cut"><%= te('editor.copyCut') %></button><button type="button" class="btn btn-small" id="copy-hw"><%= te('editor.copyHw') %></button></div></div>
        <div class="tablewrap" tabindex="0" role="region" aria-label="<%= te('editor.parts') %>">
          <table id="bom-parts"><thead><tr><th>№</th><th><%= te('editor.col.part') %></th><th><%= te('editor.col.finished') %></th><th><%= te('editor.col.cut') %></th><th><%= te('editor.col.material') %></th><th><%= te('editor.col.bandL') %></th><th><%= te('editor.col.bandW') %></th><th><%= te('editor.col.grain') %></th><th><%= te('editor.col.holes') %></th><th><%= te('editor.col.edgeHoles') %></th></tr></thead><tbody></tbody></table>
        </div>
        <div class="cols">
          <div class="card"><h3><%= te('editor.boards') %></h3><ul id="bom-materials"></ul></div>
          <div class="card"><h3><%= te('editor.hardwareList') %></h3><ul id="bom-hardware"></ul></div>
          <div class="card"><h3><%= te('editor.offCnc') %></h3><ul id="bom-edgeops"></ul></div>
        </div>
      </section>

      <section id="panel-drill" role="tabpanel" aria-labelledby="tab-drill" hidden>
        <div class="stats" id="drill-summary"></div>
        <div class="row"><h2><%= te('editor.drillTitle') %></h2><button type="button" class="btn btn-small" id="copy-drill"><%= te('editor.copyDrill') %></button></div>
        <div class="cols" id="drill-cards"></div>
        <div class="fs" id="drill-fs">
          <div class="row"><h2><%= te('editor.drillMap') %></h2><div class="acts"><select id="drill-part" class="pick" aria-label="<%= te('editor.part') %>"></select><button type="button" class="btn btn-small fs-btn" data-fs="drill-fs" data-fs-zoom="drill-map" aria-pressed="false"><%- include('../partials/icon', { name: 'expand' }) %><span><%= te('editor.fullscreen') %></span></button></div></div>
          <p class="hint" id="drill-axes"></p>
          <div class="paperwrap" id="drill-map"></div>
        </div>
        <div class="tablewrap" tabindex="0" role="region" aria-label="<%= te('editor.col.holes') %>"><table id="drill-table"><thead><tr><th>№</th><th><%= te('editor.col.letter') %></th><th>X (u)</th><th>Y (v)</th><th>Ø</th><th><%= te('editor.col.depth') %></th><th><%= te('editor.col.purpose') %></th><th><%= te('editor.col.hardware') %></th></tr></thead><tbody></tbody></table></div>
        <p class="note"><%= te('editor.drillNote') %></p>
      </section>

      <section id="panel-nest" role="tabpanel" aria-labelledby="tab-nest" hidden>
        <div class="stats" id="nest-summary"></div>
        <div id="nest-errors"></div>
        <p class="note"><%= te('editor.nestNote') %></p>
        <div class="sheets" id="nest-sheets"></div>
      </section>

      <section id="panel-draw" role="tabpanel" aria-labelledby="tab-draw" hidden>
        <div class="fs" id="draw-fs">
          <div class="row"><h2><%= te('editor.drawings') %></h2><div class="acts"><select id="draw-part" class="pick" aria-label="<%= te('editor.sheet') %>"></select><button type="button" class="btn btn-small" id="copy-svg"><%= te('editor.copySvg') %></button><button type="button" class="btn btn-small fs-btn" data-fs="draw-fs" data-fs-zoom="drawing" aria-pressed="false"><%- include('../partials/icon', { name: 'expand' }) %><span><%= te('editor.fullscreen') %></span></button></div></div>
          <div class="paperwrap" id="drawing"></div>
        </div>
        <p class="note"><%= te('editor.drawNote') %></p>
      </section>

      <section id="panel-cnc" role="tabpanel" aria-labelledby="tab-cnc" hidden>
        <div class="blocked" id="cnc-blocked" role="alert" hidden><h2><%= te('editor.cncBlockedTitle') %></h2><p><%= te('editor.cncBlockedText') %></p><ul id="cnc-reasons"></ul></div>
        <div id="cnc-body">
        <div class="row"><select id="cnc-sheet" class="pick" aria-label="<%= te('editor.cncSheet') %>"></select></div>
        <div class="stats" id="cnc-stats"></div>
        <div id="cnc-manual"></div>
        <div class="card fs" id="cnc-fs">
          <div class="sim"><button type="button" class="btn btn-primary btn-small" id="sim-play" aria-pressed="false"><%= te('editor.simulate') %></button><input type="range" id="sim-progress" min="0" max="1000" value="1000" aria-label="<%= te('editor.progress') %>"><output id="sim-label" for="sim-progress">100%</output><button type="button" class="btn btn-small fs-btn" data-fs="cnc-fs" data-fs-zoom="toolpath" aria-pressed="false"><%- include('../partials/icon', { name: 'expand' }) %><span><%= te('editor.fullscreen') %></span></button></div>
          <div id="toolpath"></div>
          <div class="legend" id="cnc-tools"></div>
        </div>
        <p class="safety"><strong><%= te('editor.safetyTitle') %></strong> <%= te('editor.safetyText') %></p>
        <div class="cols">
          <div class="codecard"><header><h3>G-code</h3><span class="meta" id="gcode-meta"></span><button type="button" class="btn btn-small" id="copy-gcode"><%= te('editor.copy') %></button></header><pre id="gcode" tabindex="0"></pre></div>
          <div class="codecard"><header><h3><%= te('editor.dxf') %></h3><span class="meta" id="dxf-meta"></span><button type="button" class="btn btn-small" id="copy-dxf"><%= te('editor.copy') %></button></header><pre id="dxf" tabindex="0"></pre><div class="layers" id="dxf-layers"></div></div>
        </div>
        </div>
      </section>

      <section id="panel-cat" role="tabpanel" aria-labelledby="tab-cat" hidden>
        <div class="cat-tools">
          <div class="chips" id="cat-views"></div>
          <input type="search" id="cat-q" placeholder="<%= te('editor.catSearch') %>" aria-label="<%= te('editor.catSearch') %>">
          <div class="row"><p class="hint" id="cat-meta"></p><div class="acts"><button type="button" class="btn btn-small" id="cat-csv"><%= te('editor.copyCsv') %></button><button type="button" class="btn btn-small" id="cat-json"><%= te('editor.copyJson') %></button></div></div>
        </div>
        <div class="tablewrap" tabindex="0" role="region" aria-label="<%= te('editor.tab.catalog') %>"><table id="cat-table"><thead></thead><tbody></tbody></table></div>
        <button type="button" class="btn btn-small more" id="cat-more" hidden><%= te('editor.showMore') %></button>
        <p class="note"><%= te('editor.catNote') %></p>
      </section>
    </div>
  </div>
</main>

<dialog id="picker" class="picker" lang="bg" aria-labelledby="picker-title">
  <form method="dialog" class="pk">
    <header><h2 id="picker-title"><%= te('editor.pick') %></h2><button value="close" class="btn btn-small"><%= te('editor.close') %></button></header>
    <div class="pk-tools"><input type="search" id="pk-q" placeholder="<%= te('editor.search') %>" aria-label="<%= te('editor.search') %>"><div class="chips" id="pk-chips"></div><div class="chips" id="pk-chips2"></div></div>
    <p class="hint" id="pk-count"></p>
    <div class="pk-list" id="pk-list" role="listbox" aria-label="<%= te('editor.results') %>"></div>
  </form>
</dialog>
<%- include('../partials/app-footer') %>
<script type="application/json" id="boot"><%- boot %></script>
<script type="module" src="/static/editor/editor.js?v=<%= v %>"></script>
</body>
</html>
