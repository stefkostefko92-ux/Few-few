# Rendetto — образец на настройките. Истинският .env живее САМО на сървъра (mode 600),
# никога в репото или в архива за деплой. Ключовете се генерират на сървъра:
#   openssl rand -hex 32   (по веднъж за ENC_KEY и HMAC_KEY — различни)

# Адресът, на който хората отварят сайта (без / накрая) — от него са връзките в писмата,
# canonical, hreflang и sitemap.
PUBLIC_BASE_URL=https://rendetto.carbonstealth.eu

# База (Docker Compose я вдига сама; паролата е само тук).
POSTGRES_PASSWORD=

# AES-256-GCM за тайните на двуфакторната защита и HMAC за бисквитката на устройството и
# резервните кодове. 64 hex знака всеки, различни един от друг. Смяната им обезсилва 2FA
# и разпознатите устройства — не ги сменяй без причина.
ENC_KEY=
HMAC_KEY=

# Писма (Brevo SMTP; Hetzner блокира 25/465/587 — затова 2525).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rendetto <no-reply@carbonstealth.eu>

# Адреси за контакт, показвани на страниците.
CONTACT_EMAIL=info@carbonstealth.eu
PRIVACY_EMAIL=privacy@carbonstealth.eu

# Папката с catalog.json (каталогът от магазините) и dbip-country-lite.mmdb (GeoIP) — на сървъра.
RENDETTO_DATA=/opt/few-few/shared/rendetto/data

# По избор
# HTTP_PORT=4320
# TOTP_ISSUER=Rendetto
# BREACH_CHECK=true
# Срок за пазене на одита в дни (решение на собственика; по подразбиране 5 години).
# AUDIT_RETENTION_DAYS=1825
