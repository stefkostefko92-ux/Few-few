# Rendetto — образец на настройките. Истинският .env живее САМО на сървъра (mode 600),
# никога в репото или в архива за деплой. Ключовете и паролата се генерират на сървъра:
#   openssl rand -hex 32   (по веднъж за POSTGRES_PASSWORD, ENC_KEY и HMAC_KEY — различни)

# Адресът, на който хората отварят сайта (без / накрая) — от него са връзките в писмата,
# canonical, hreflang и sitemap.
PUBLIC_BASE_URL=https://rendetto.carbonstealth.eu

# База (Docker Compose я вдига сама; паролата е само тук). Влиза некодирана в DATABASE_URL —
# „/“, „?“, „#“ и „%“ я чупят (deploy.sh ги отказва), затова hex.
POSTGRES_PASSWORD=

# AES-256-GCM за тайните на двуфакторната защита и HMAC за бисквитката на устройството,
# резервните кодове и одитната верига. 64 hex знака всеки, различни един от друг. Смяна на
# ENC_KEY обезсилва 2FA; на HMAC_KEY — разпознатите устройства и резервните кодове, а одитната
# верига отпреди смяната вече не се проверява (панелът я показва скъсана). Не ги сменяй без причина.
ENC_KEY=
HMAC_KEY=

# Писма (Brevo SMTP; Hetzner блокира 25/465/587 — затова 2525).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rendetto <no-reply@carbonstealth.eu>

# Адреси за контакт, показвани на страниците.
CONTACT_EMAIL=info@carbonstealth.eu
PRIVACY_EMAIL=privacy@carbonstealth.eu

# Ключът на каталога от магазините — в репото той е само шифрован (sealed/catalog.json.enc). 64 hex
# знака; пази го собственикът. Празно — основният каталог (или data/catalog.json, ако го има).
CATALOG_KEY=

# Папката с dbip-country-lite.mmdb (GeoIP), котвата на одита (audit-head.json) и по избор catalog.json
# (само без CATALOG_KEY) — на сървъра. deploy.sh изисква точно този път.
RENDETTO_DATA=/opt/few-few/shared/rendetto/data

# По избор (в контейнера влиза само каквото е изброено в docker-compose.yml)
# HTTP_PORT=4320
# TOTP_ISSUER=Rendetto
# BREACH_CHECK=true
# true само за SMTP с имплицитен TLS (порт 465); 2525 е STARTTLS.
# SMTP_SECURE=false
# LOG_LEVEL=info
# Срок за пазене на одита в дни (решение на собственика; по подразбиране 5 години).
# AUDIT_RETENTION_DAYS=1825
