{
  "name": "deja",
  "version": "0.1.0",
  "description": "Déjà — локална семантична памет на браузъра (Chrome MV3)",
  "private": true,
  "type": "module",
  "homepage": "https://carbonstealth.eu",
  "author": "Carbon Stealth",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node build.mjs",
    "zip": "npm run build && mkdir -p release && cd dist && zip -qr ../release/deja-$npm_package_version.zip .",
    "icons": "python3 tools/generate_icons.py",
    "format": "prettier --write \"src/**/*.{js,css,html}\" build.mjs manifest.json",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" build.mjs manifest.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.0.0"
  }
}
