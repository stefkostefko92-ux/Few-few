# Nexus Dominion — copy to .env and FILL IN every REQUIRED value before
# running `docker compose up`. The compose file refuses to boot if a
# REQUIRED value is unset; the server refuses to boot if NODE_ENV=production
# and CORS_ORIGIN is `*` or missing.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# A long, random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# The exact origin (or comma-separated list) the browser sends in
# Origin/Referer headers when calling /api/*. A wildcard `*` is rejected
# under NODE_ENV=production. Example for one prod site:
#   CORS_ORIGIN=https://nexus.example.com
# Example for prod + staging:
#   CORS_ORIGIN=https://nexus.example.com,https://staging.example.com
CORS_ORIGIN=https://nexus.carbonstealth.eu

# The canonical public URL of the deployment. Stripe success/cancel URLs
# and email links are built off this; do NOT leave it pointing at
# example.com when going live (open-redirect mitigation).
PUBLIC_BASE_URL=https://nexus.carbonstealth.eu

# ─── PAYMENTS (Stripe — leave blank to keep dev mode) ─────────────────────────

# Server-side secret. Test keys (sk_test_*) keep the gateway in test
# mode. Webhook secret is whatever Stripe shows when you create the
# endpoint in the dashboard pointing at /api/payments/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── EMAIL (SMTP през Register.it — за смяна на парола) ───────────────────────
#
# Без SMTP_USER/SMTP_PASS имейли НЕ се пращат (reset токенът се пази в БД, но
# не се доставя). Register.it особености:
#  • Порт 587 (STARTTLS) по подразбиране — 465 е блокиран изходящо на много
#    хостове (напр. Hetzner). Смени на 465 + SMTP_SECURE=true само ако 587 не
#    минава.
#  • authsmtp.register.it представя сертификат за *.securemail.pro (не за
#    connect хоста) → задай SMTP_TLS_SERVERNAME, за да пазиш TLS валидацията
#    вкл. (никога не я изключвай).
#SMTP_HOST=authsmtp.register.it
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=no-reply@your-domain.it
#SMTP_PASS=
#SMTP_FROM=Nexus Dominion <no-reply@your-domain.it>
#SMTP_TLS_SERVERNAME=smtp.securemail.pro

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

JWT_EXPIRES_IN=7d

# Път до SQLite данните на ХОСТА (bind mount в docker-compose.yml). Прод:
# autodeploy.sh го попълва автоматично (/opt/nexus/state/data). Локално
# остави празно → named volume.
#NEXUS_DATA_DIR=/opt/nexus/state/data

# Уважавай клиентския X-Country-Code header при geo проверката (САМО за
# тест/доверен proxy, който сам го поставя — подправя се тривиално).
#TRUST_COUNTRY_HEADER=1

# Used by the bundled Caddyfile when you run with `caddy` in compose.
DOMAIN=nexus.carbonstealth.eu
