# Копирайте в .env и попълнете за продукция.
PORT=3000

# В продукция задължително 'production' — включва HTTPS пренасочване, Secure бисквитки,
# HSTS и изисква ENCRYPTION_KEY.
NODE_ENV=production

# Публичен адрес (за QR кодове, canonical, sitemap, OG). В продукция ЗАДЪЛЖИТЕЛНО HTTPS.
PUBLIC_BASE_URL=https://medqr.carbonstealth.eu

# Ключ за криптиране на медицинските данни в покой (AES-256-GCM).
# 32 байта като 64 hex символа. Генерирайте с:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ПАЗЕТЕ ГО ТАЙНО и извън базата данни. Загубата му прави данните невъзстановими.
ENCRYPTION_KEY=

# Път до SQLite файла (по подразбиране data/medqr.sqlite).
# DB_PATH=/var/lib/medqr/medqr.sqlite

# Имейл (за потвърждение на имейл и нулиране на парола).
# Без SMTP_HOST писмата не се пращат, а се логват (само за разработка).
MAIL_FROM=MedQR <no-reply@example.com>
# SMTP_HOST=mail.your-server.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
