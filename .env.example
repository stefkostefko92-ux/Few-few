# ─────────────────────────────────────────────────────────────
# АСО — environment example. Copy to .env and fill in.
# NEVER commit a real .env. Secrets live only in env / Docker secrets.
#
# Tags per variable:
#   [REQUIRED_PROD] must be set to a real value before launch; the listed
#                   default is localhost/dev-only and is wrong in production.
#   [PAYMENTS]      required only to enable the shop/VIP (Stripe). Unset = the
#                   shop endpoints return 503; the rest of the portal works.
#   [OPTIONAL]      a feature is enabled only when set; safe to leave blank.
#   [DEV_DEFAULT]   ships with a sane default; override only to tune/relocate.
# ─────────────────────────────────────────────────────────────

# [REQUIRED_PROD] must be exactly "production" on the live deploy.
NODE_ENV=development

# ── Ports (S18 proposed block — verify with `ss -tlnp` on VPS) ──
# [DEV_DEFAULT] all three have built-in defaults.
API_PORT=4500
REALTIME_PORT=4501
WEB_PORT=4502

# ── PostgreSQL (host port 5437 per S18) ──
# [REQUIRED_PROD] DATABASE_URL has NO default — every service refuses to boot
# without it. POSTGRES_* are consumed by the bundled docker-compose Postgres.
DATABASE_URL=postgresql://aso:aso@localhost:5437/aso?schema=public
POSTGRES_USER=aso
POSTGRES_PASSWORD=aso
POSTGRES_DB=aso

# ── Redis (host port 6383 per S18) ──
# [REQUIRED_PROD] has a localhost default; point it at the prod Redis.
REDIS_URL=redis://localhost:6383

# ── Auth ──
# [REQUIRED_PROD] no defaults; min 32 chars each. Generate: `openssl rand -hex 32`
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
# [REQUIRED_PROD] set to the apex/parent domain (e.g. ".carbonstealth.eu") so
# the httpOnly auth cookies are shared across api/app subdomains. Blank = host-only.
COOKIE_DOMAIN=

# ── CORS whitelist (comma-separated, never * on prod) ──
# [REQUIRED_PROD] defaults to localhost; set to the real web origin(s).
CORS_ORIGINS=http://localhost:4502,http://localhost:5173

# ── Stripe (S5) ──
# [PAYMENTS] credit is applied ONLY from the signed webhook (never client
# redirects). The webhook returns 503 until STRIPE_WEBHOOK_SECRET is set.
# Local testing: `stripe listen --forward-to localhost:4500/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PK=
# [REQUIRED_PROD] where Stripe + email links + OAuth success redirect the player.
PUBLIC_WEB_URL=http://localhost:4502
# [REQUIRED_PROD] public origin of the API (used to build OAuth callback URLs).
PUBLIC_API_URL=http://localhost:4500
# [REQUIRED_PROD] base path the SPA is served under in prod (e.g. /app); blank in dev.
WEB_BASE_PATH=

# ── Email / SMTP (verification + password reset) ──
# [OPTIONAL] leave SMTP_HOST blank in dev: emails are written to the API log
# instead of being sent, so verify/reset flows stay testable without a provider.
# For launch, set a real SMTP host so account emails actually deliver.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=АСО <no-reply@gaming.carbonstealth.eu>

# ── OAuth (env-gated) ──
# [OPTIONAL] a provider's buttons appear only when BOTH its id and secret are set.
# Register redirect URI: {PUBLIC_API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register redirect URI: {PUBLIC_API_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Discord webhook (admin notifications) ──
# [OPTIONAL] when set, signups / purchases / VIP / flags / admin actions post as
# embeds. Leave blank to disable (calls become logged no-ops).
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_NAME=АСО

# ── Sentry error tracking ──
# [OPTIONAL] init only when a DSN is present; blank = disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Internal service-to-service (realtime → api progression hook, S6) ──
# [REQUIRED_PROD] no real default — the process EXITS in production if this is
# still the dev value. Generate: `openssl rand -hex 24`
INTERNAL_API_SECRET=change-me-internal-secret-min-16-chars
# [REQUIRED_PROD] internal base URL realtime uses to reach the API; localhost default.
API_INTERNAL_URL=http://localhost:4500

# ── Realtime live-play resilience ──
# [DEV_DEFAULT] per-turn clock, disconnect forfeit grace, and how long to wait
# for a human before falling back to a bot.
TURN_SECONDS=30
DISCONNECT_GRACE_SECONDS=45
BOT_FALLBACK_SECONDS=8

# ── Worker (S6) ──
# [DEV_DEFAULT] season length in days (§12).
SEASON_DAYS=35

# ── Monitoring ──
# [OPTIONAL] If set, /metrics on api/realtime/worker requires
# `Authorization: Bearer <token>` (configure the same in Prometheus). Unset =
# open, relying on network isolation. WORKER_METRICS_PORT defaults to 9091.
METRICS_TOKEN=
WORKER_METRICS_PORT=9091
