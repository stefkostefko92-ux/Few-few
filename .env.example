# ─────────────────────────────────────────────────────────────
# АСО — environment example. Copy to .env and fill in.
# NEVER commit a real .env. Secrets live only in env / Docker secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Ports (S18 proposed block — verify with `ss -tlnp` on VPS) ──
API_PORT=4500
REALTIME_PORT=4501
WEB_PORT=4502

# ── PostgreSQL (host port 5437 per S18) ──
DATABASE_URL=postgresql://aso:aso@localhost:5437/aso?schema=public
POSTGRES_USER=aso
POSTGRES_PASSWORD=aso
POSTGRES_DB=aso

# ── Redis (host port 6383 per S18) ──
REDIS_URL=redis://localhost:6383

# ── Auth ──
# Generate strong values: `openssl rand -hex 32`
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
# Cookie domain for httpOnly auth cookies (leave blank for localhost)
COOKIE_DOMAIN=

# ── CORS whitelist (comma-separated, never * on prod) ──
CORS_ORIGINS=http://localhost:4502,http://localhost:5173

# ── Stripe (S5) ──
# Credit is applied ONLY from the signed webhook (never client redirects).
# Local testing: `stripe listen --forward-to localhost:4500/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PK=
# Where Stripe redirects after Checkout / Billing Portal:
PUBLIC_WEB_URL=http://localhost:4502
# Public origin of the API (used to build OAuth callback URLs):
PUBLIC_API_URL=http://localhost:4500
# Base path the SPA is served under in prod (e.g. /app); blank in dev:
WEB_BASE_PATH=

# ── Email / SMTP (verification + password reset) ──
# Leave SMTP_HOST blank in dev: emails are written to the API log instead of
# being sent, so the verify/reset flows stay fully testable without a provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=АСО <no-reply@gaming.carbonstealth.eu>

# ── OAuth (env-gated) ──
# A provider's buttons appear only when BOTH its id and secret are set.
# Register redirect URI: {PUBLIC_API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register redirect URI: {PUBLIC_API_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Discord webhook (admin notifications) ──
# When set, signups / purchases / VIP / flags / admin actions post as embeds.
# Leave blank to disable (calls become logged no-ops).
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_NAME=АСО

# ── Sentry error tracking (optional) ──
# Init only when a DSN is present; blank = disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Internal service-to-service (realtime → api progression hook, S6) ──
# Generate: `openssl rand -hex 24`
INTERNAL_API_SECRET=change-me-internal-secret-min-16-chars
API_INTERNAL_URL=http://localhost:4500

# ── Realtime live-play resilience ──
# Per-turn clock (server auto-plays on expiry) and disconnect forfeit grace.
TURN_SECONDS=30
DISCONNECT_GRACE_SECONDS=45

# ── Worker (S6) ──
SEASON_DAYS=35
