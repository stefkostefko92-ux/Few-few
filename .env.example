# Tanoth-Reborn — copy to .env and adjust before running docker-compose up

# REQUIRED: a long random secret for signing session tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Optional
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Used by the Caddyfile when you run with the bundled reverse proxy
DOMAIN=tanoth.example.com

# ─── Payments (Stripe) ───────────────────────────────────────────────
# Both are OPTIONAL: with neither set the server runs in "dev mode" and
# grants purchases instantly (blocked automatically when NODE_ENV=production).
# Set BOTH to enable real Stripe Checkout.
#
# Secret API key — Dashboard ▸ Developers ▸ API keys.
#   Test:  sk_test_...   Live:  sk_live_...
STRIPE_SECRET_KEY=

# Webhook signing secret — Dashboard ▸ Developers ▸ Webhooks ▸ (your
# endpoint) ▸ Signing secret (starts with whsec_). Create the endpoint
# pointing at:  https://<your-domain>/api/payments/webhook
# and subscribe to the event:  checkout.session.completed
STRIPE_WEBHOOK_SECRET=
