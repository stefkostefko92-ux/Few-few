# Локална разработка: cp .env.example .env и попълни. Тайните в продукция живеят само на сървъра (mode 600).
NODE_ENV=development
PORT=4340
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4340
TRUST_PROXY=loopback
DATABASE_URL=postgresql://fakturist:fakturist@127.0.0.1:5432/fakturist?schema=public
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32 — НИКОГА не се сменя след първата издадена фактура
LEDGER_SEAL_KEY=
REGISTRATION_OPEN=false
# Revolut Merchant API → Webhooks → signing secret (wsk_…)
REVOLUT_WEBHOOK_SECRET=
# IBAN на Revolut Business за плащане по банков път
BILLING_IBAN=
CONTACT_EMAIL=info@carbonstealth.eu
PRIVACY_EMAIL=privacy@carbonstealth.eu
# Мастър акаунтът (scripts/create-owner.ts) — паролата се сменя при първия вход, 2FA е задължителна
OWNER_EMAIL=admin@carbonstealth.eu
OWNER_NAME=
OWNER_PASSWORD=
