<%- include('../partials/app-head', { title: t('admin.sources.title') }) %>
<h1><%= t('admin.sources.title') %></h1>
<%- include('_nav') %>
<p class="lead"><%= t('admin.sources.intro') %></p>
<nav class="actions" aria-label="<%= t('admin.sources.period') %>">
  <% periods.forEach((p) => { %><a class="<%= p === period ? 'button' : 'button-secondary' %>" href="/admin/iztochnitsi?dni=<%= p %>"<%- p === period ? ' aria-current="page"' : '' %>><%= t('admin.sources.periods.' + p) %></a><% }) %>
</nav>
<p><%= t('admin.sources.total', { signups: total.signups, paid: total.paid }) %></p>
<% if (rows.length === 0) { %>
<p class="muted"><%= t('admin.sources.none') %></p>
<% } else { %>
<div class="table-wrap">
  <table class="stack-table">
    <thead><tr>
      <th scope="col"><%= t('admin.sources.source') %></th>
      <th scope="col"><%= t('admin.sources.medium') %></th>
      <th scope="col"><%= t('admin.sources.campaign') %></th>
      <th scope="col" class="num"><%= t('admin.sources.companies') %></th>
      <th scope="col" class="num"><%= t('admin.sources.firms') %></th>
      <th scope="col" class="num"><%= t('admin.sources.paid') %></th>
    </tr></thead>
    <tbody>
      <% rows.forEach((r) => { %>
      <tr>
        <td data-label="<%= t('admin.sources.source') %>"><%= r.source ?? t('admin.sources.direct') %></td>
        <td data-label="<%= t('admin.sources.medium') %>"><%= r.medium ?? '—' %></td>
        <td data-label="<%= t('admin.sources.campaign') %>"><%= r.campaign ?? '—' %></td>
        <td data-label="<%= t('admin.sources.companies') %>" class="num"><%= r.companies %></td>
        <td data-label="<%= t('admin.sources.firms') %>" class="num"><%= r.firms %></td>
        <td data-label="<%= t('admin.sources.paid') %>" class="num"><%= r.paid %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<section class="panel stack" aria-labelledby="how-h">
  <h2 id="how-h"><%= t('admin.sources.howTitle') %></h2>
  <p><%= t('admin.sources.how') %></p>
  <p class="mono"><%= example %></p>
  <p class="muted"><%= t('admin.sources.privacy') %></p>
</section>
<%- include('../partials/app-foot') %>
