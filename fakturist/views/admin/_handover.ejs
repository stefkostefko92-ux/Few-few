<%# Мастърът предава собствеността веднага (SPEC 87): на човек по имейл или на кантора по ЕИК — с 2FA кода и основание. -%>
<section class="panel stack narrow-form" aria-labelledby="h-handover">
  <h2 id="h-handover"><%= t('admin.handover.title') %></h2>
  <p><%= t('admin.handover.intro') %></p>
  <form method="post" action="/admin/firmi/<%= orgId %>/predai" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset class="stack">
      <legend><%= t('admin.handover.to') %></legend>
      <label class="radio"><input type="radio" name="to" value="person" checked> <%= t('admin.handover.toPerson') %></label>
      <% if (isCompany) { %><label class="radio"><input type="radio" name="to" value="firm"> <%= t('admin.handover.toFirm') %></label><% } %>
    </fieldset>
    <label><%= t('admin.handover.email') %><input type="email" name="email" maxlength="254" autocomplete="off" spellcheck="false"><span class="hint"><%= t('admin.handover.emailHint') %></span></label>
    <label><%= t('admin.handover.name') %><input name="name" maxlength="100" autocomplete="off"><span class="hint"><%= t('admin.handover.nameHint') %></span></label>
    <label class="check"><input type="checkbox" name="keepOldOwner" checked> <%= t('admin.handover.keepOldOwner') %></label>
    <% if (isCompany) { %><label><%= t('admin.handover.eik') %><input name="eik" inputmode="numeric" maxlength="13" autocomplete="off"><span class="hint"><%= t('admin.handover.eikHint') %></span></label><% } %>
    <label><%= t('admin.handover.reason') %><textarea name="reason" rows="2" minlength="3" maxlength="200" required></textarea><span class="hint"><%= t('admin.handover.reasonHint') %></span></label>
    <label><%= t('admin.handover.code') %><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></label>
    <div><button type="submit" class="button-danger"><%= t('admin.handover.button') %></button></div>
  </form>
</section>
