<%- include('../partials/app-head', { title: t('admin.announcements.title') }) %>
<% const day = (d) => d ? d.toISOString().slice(0, 10).split('-').reverse().join('.') : '—'; %>
<h1><%= t('admin.announcements.title') %></h1>
<%- include('_nav') %>
<p class="muted"><%= t('admin.announcements.help', { count: audience }) %></p>
<% if (ok) { %><p class="ok" role="status"><%= t('admin.announcements.ok', { count }) %></p><% } %>
<% if (err) { %><p class="error" role="alert"><%= tOr('admin.announcements.err.' + err, t('auth.errors.invalid')) %></p><% } %>
<section class="panel" aria-labelledby="send-h">
  <h2 id="send-h"><%= t('admin.announcements.new') %></h2>
  <form method="post" action="/admin/saobshteniya" class="stack narrow-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('admin.announcements.kind') %><select name="kind" required>
      <% kinds.forEach((k) => { %><option value="<%= k %>"><%= t('admin.announcements.kinds.' + k) %></option><% }) %>
    </select></label>
    <label><%= t('admin.announcements.subject') %><input name="subject" required minlength="3" maxlength="150"></label>
    <label><%= t('admin.announcements.body') %> <span class="hint"><%= t('admin.announcements.bodyHint') %></span><textarea name="body" rows="8" required minlength="10" maxlength="5000"></textarea></label>
    <label><%= t('admin.announcements.effectiveOn') %> <span class="hint"><%= t('admin.announcements.effectiveHint', { date: earliest.split('-').reverse().join('.') }) %></span><input type="date" name="effectiveOn" min="<%= earliest %>"></label>
    <label class="check"><input type="checkbox" name="confirm" required> <%= t('admin.announcements.confirm', { count: audience }) %></label>
    <label><%= t('admin.masterRole.code') %><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required class="mono"></label>
    <div><button type="submit"><%= t('admin.announcements.send') %></button></div>
  </form>
</section>
<h2><%= t('admin.announcements.history') %></h2>
<% if (sent.length === 0) { %><p class="muted"><%= t('admin.announcements.none') %></p><% } else { %>
<div class="table-wrap"><table class="stack-table">
  <thead><tr><th scope="col"><%= t('admin.announcements.date') %></th><th scope="col"><%= t('admin.announcements.kind') %></th><th scope="col"><%= t('admin.announcements.subject') %></th><th scope="col" class="num"><%= t('admin.announcements.recipients') %></th></tr></thead>
  <tbody>
  <% sent.forEach((a) => { %>
    <tr>
      <td data-label="<%= t('admin.announcements.date') %>" class="mono"><%= day(a.createdAt) %></td>
      <td data-label="<%= t('admin.announcements.kind') %>"><%= t('admin.announcements.kinds.' + a.kind) %><% if (a.effectiveOn) { %><br><span class="hint"><%= t('admin.announcements.from', { date: day(a.effectiveOn) }) %></span><% } %></td>
      <td data-label="<%= t('admin.announcements.subject') %>"><%= a.subject %><br><span class="hint"><%= a.createdBy ? a.createdBy.name : '—' %></span></td>
      <td data-label="<%= t('admin.announcements.recipients') %>" class="num mono"><%= a.recipients %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>
<%- include('../partials/app-foot') %>
