<%- include('../partials/app-head', { title: t('admin.features') }) %>
<h1><%= t('admin.features') %></h1>
<%- include('_nav') %>
<p class="muted"><%= t('admin.featuresHelp') %></p>
<% if (saved) { %><p class="ok" role="status"><%= t('admin.saved') %></p><% } %>
<form method="post" action="/admin/funktsii" class="stack">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% groups.forEach((group) => { %>
    <fieldset>
      <legend><%= t('features.groups.' + group) %></legend>
      <% features.filter((f) => f.group === group).forEach((f) => { %>
        <label class="check"><input type="checkbox" name="f_<%= f.code %>"<%= enabled.get(f.code) !== false ? ' checked' : '' %>> <%= t('features.' + f.code + '.name') %> <span class="mono muted"><%= f.code %></span><% if (f.status === 'planned') { %> <span class="tag"><%= t('admin.planned') %> <%= f.target %></span><% } %></label>
      <% }) %>
    </fieldset>
  <% }) %>
  <button type="submit"><%= t('admin.save') %></button>
</form>
<%- include('../partials/app-foot') %>
