    { i: 1, bt: 'BT-1', tag: 'cbc:ID', val: '0000000124' },
    { i: 1, bt: 'BT-2', tag: 'cbc:IssueDate', val: '2026-11-12' },
    { i: 1, bt: 'BT-3', tag: 'cbc:InvoiceTypeCode', val: '380' },
    { i: 1, bt: 'BT-5', tag: 'cbc:DocumentCurrencyCode', val: 'EUR' },
