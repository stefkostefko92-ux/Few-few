<%# Вътрешните връзки към страниците за рекламите (SEO, 23.11.2026) — на началната, цените, за кантори и 2028. -%>
<section class="section site-guides" aria-labelledby="guides-h">
  <div class="wrap">
    <h2 id="guides-h" class="guides-title"><%= t('site.guides.title') %></h2>
    <ul class="guides">
<%# Само публикуваните (функция „проверява се“ няма страница — SPEC 99). -%>
