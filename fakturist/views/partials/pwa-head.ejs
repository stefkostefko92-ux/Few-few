<%#
  Иконите и приложението на началния екран (src/pwa/manifest.ts) — общо за витрината и приложението.
%>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/brand/favicon-32.png?v=<%= v %>" type="image/png" sizes="32x32">
<link rel="icon" href="/img/brand/icon-192.png?v=<%= v %>" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png?v=<%= v %>">
<link rel="manifest" href="<%= lang === 'en' ? '/en/manifest.webmanifest' : '/manifest.webmanifest' %>">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0c1929" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="<%= lang === 'bg' ? brand.name : brand.nameLatin %>">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="application-name" content="<%= lang === 'bg' ? brand.name : brand.nameLatin %>">
