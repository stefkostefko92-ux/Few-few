<%- include('../partials/app-head', { title: t('app.saft.title') }) %>
<p><a href="/app/o/<%= org.id %>">← <%= org.legalName %></a></p>
<h1><%= t('app.saft.title') %></h1>
<p class="muted"><%= t('app.saft.intro') %></p>
<% if (saved) { %><p class="ok" role="status"><%= t('app.saft.saved') %></p><% } %>
<% if (error) { %><p class="error" role="alert"><%= tOr('app.saft.errors.' + error, t('auth.errors.invalid')) %></p><% } %>
<% if (!feature) { %>
<p class="callout"><%= t('app.saft.needsPlan') %> <a href="/app/o/<%= org.id %>/plan"><%= t('app.plan.title') %></a></p>
<% } else { %>
<form method="get" class="search-row" aria-label="<%= t('app.saft.period') %>">
  <label><span class="sr-only"><%= t('app.saft.period') %></span><input type="month" name="period" value="<%= period %>" max="<%= maxPeriod %>" required></label>
  <button type="submit" class="button-secondary"><%= t('app.saft.show') %></button>
</form>
<% if (bundle.included > 0) { %>
<p><%= t('app.saft.summary', { documents: bundle.included, customers: bundle.customers, products: bundle.products }) %></p>
<p><a class="button" href="/app/o/<%= org.id %>/saf-t.zip?period=<%= period %>" target="_blank" rel="noopener"><%= t('app.saft.download') %></a></p>
<p class="hint"><%= t('app.saft.files') %> <span class="mono"><%= bundle.files.map((f) => f.name).join(' · ') %></span></p>
<% } else { %>
<p class="callout"><%= t('app.saft.empty') %></p>
<% } %>
<% if (bundle.manual.length) { %>
<h2><%= t('app.saft.manualTitle') %></h2>
<p><%= t('app.saft.manualIntro') %></p>
<ul>
  <% bundle.manual.forEach((m) => { %><li><span class="mono"><%= m.number %></span> — <%= t('app.saft.reasons.' + m.reason) %></li><% }) %>
</ul>
<% } %>
<section class="panel" aria-labelledby="saft-settings">
  <h2 id="saft-settings"><%= t('app.saft.settingsTitle') %></h2>
  <p class="muted"><%= t('app.saft.settingsHelp') %></p>
  <% if (canEdit) { %>
  <form method="post" action="/app/o/<%= org.id %>/saf-t" class="stack narrow-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <label><%= t('app.saft.receivable') %><input name="receivable" inputmode="numeric" class="mono" required pattern="[1-9][0-9]{2,4}" maxlength="5" value="<%= org.saftReceivableAccount %>"></label>
      <label><%= t('app.saft.revenue') %><input name="revenue" inputmode="numeric" class="mono" required pattern="[1-9][0-9]{2,4}" maxlength="5" value="<%= org.saftRevenueAccount %>"></label>
    </div>
    <p class="hint"><%= t('app.saft.accountHint') %></p>
    <label><%= t('app.saft.related') %><textarea name="related" rows="3" class="mono" aria-describedby="saft-related-hint"><%= org.saftRelatedParties.join('\n') %></textarea></label>
    <p class="hint" id="saft-related-hint"><%= t('app.saft.relatedHint') %></p>
    <button type="submit" class="button-secondary"><%= t('app.saft.save') %></button>
  </form>
  <% } else { %>
  <p class="mono"><%= t('app.saft.receivable') %>: <%= org.saftReceivableAccount %> · <%= t('app.saft.revenue') %>: <%= org.saftRevenueAccount %></p>
  <% } %>
</section>
<% } %>
<h2><%= t('app.saft.notesTitle') %></h2>
<ul>
  <li><%= t('app.saft.notes.schema') %></li>
  <li><%= t('app.saft.notes.direction') %></li>
  <li><%= t('app.saft.notes.codes') %></li>
  <li><%= t('app.saft.notes.balances') %></li>
  <li><%= t('app.saft.notes.transaction') %></li>
  <li><%= t('app.saft.notes.check') %></li>
</ul>
<%- include('../partials/app-foot') %>
