<%- include('../partials/app-head', { title: t('app.members.title') }) %>
<p><a href="/app/o/<%= org.id %>">← <%= org.legalName %></a></p>
<h1><%= t('app.members.title') %></h1>
<% if (ok) { %><p class="ok" role="status"><%= tOr('app.members.ok.' + ok, t('app.catalog.saved.updated')) %></p><% } %>
<% if (err) { %><p class="error" role="alert"><%= tOr('app.members.err.' + err, t('auth.errors.invalid')) %></p><% } %>
<div class="table-wrap"><table class="stack-table">
  <thead><tr><th scope="col"><%= t('app.members.person') %></th><th scope="col"><%= t('auth.email') %></th><th scope="col"><%= t('app.members.role') %></th><th scope="col"><span class="sr-only"><%= t('app.catalog.actions') %></span></th></tr></thead>
  <tbody>
  <% members.forEach((m) => { const self = m.userId === actor.userId; const managed = !self && canManage(m.role); %>
    <tr>
      <td data-label="<%= t('app.members.person') %>"><%= m.user.name %><% if (self) { %> <span class="badge"><%= t('app.members.you') %></span><% } %></td>
      <td data-label="<%= t('auth.email') %>" class="mono"><%= m.user.email %></td>
      <td data-label="<%= t('app.members.role') %>">
        <% if (managed) { %>
          <form method="post" action="/app/o/<%= org.id %>/chlenove/<%= m.id %>/rolya" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label><span class="sr-only"><%= t('app.members.role') %></span><select name="role"><% assignable.forEach((r) => { %><option value="<%= r %>"<%= r === m.role ? ' selected' : '' %>><%= t('app.roles.' + r) %></option><% }) %></select></label>
            <button type="submit" class="button-secondary"><%= t('app.catalog.save') %></button>
          </form>
        <% } else { %><%= t('app.roles.' + m.role) %><% } %>
      </td>
      <td class="actions">
        <% if (managed || (self && m.role !== 'OWNER')) { %>
          <form method="post" action="/app/o/<%= org.id %>/chlenove/<%= m.id %>/mahni"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link"><%= self ? t('app.members.leave') : t('app.members.remove') %></button></form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>

<% if (invites.length) { %>
<h2><%= t('app.members.pending') %></h2>
<ul class="invite-list">
  <% invites.forEach((i) => { %>
    <li><span class="mono"><%= i.email %></span> · <%= t('app.roles.' + i.role) %> · <span class="muted"><%= t('app.members.until', { date: i.expiresAt.toISOString().slice(0, 10).split('-').reverse().join('.') }) %></span>
      <% if (canManage(i.role)) { %><form method="post" action="/app/o/<%= org.id %>/chlenove/pokani/<%= i.id %>/otmeni" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link"><%= t('app.members.revoke') %></button></form><% } %>
    </li>
  <% }) %>
</ul>
<% } %>

<% if (assignable.length) { %>
<section class="panel" aria-labelledby="invite-h">
  <h2 id="invite-h"><%= t('app.members.invite') %></h2>
  <p class="muted"><%= t('app.members.inviteHelp') %></p>
  <form method="post" action="/app/o/<%= org.id %>/chlenove/pokani" class="stack narrow-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('auth.email') %><input type="email" name="email" required maxlength="254" autocomplete="off" spellcheck="false"></label>
    <label><%= t('app.members.role') %><select name="role"><% assignable.forEach((r) => { %><option value="<%= r %>"<%= r === 'ISSUER' ? ' selected' : '' %>><%= t('app.roles.' + r) %></option><% }) %></select></label>
    <button type="submit"><%= t('app.members.send') %></button>
  </form>
</section>
<% } %>
<%- include('../partials/app-foot') %>
