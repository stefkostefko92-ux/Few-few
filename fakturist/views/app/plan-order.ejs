<%- include('../partials/app-head', { title: t('app.plan.order'), refreshSeconds: refresh ? 5 : 0 }) %>
<% const day = (d) => d.toISOString().slice(0, 10).split('-').reverse().join('.'); %>
<% const eur = (c) => (lang === 'bg' ? (c / 100).toFixed(2).replace('.', ',') + ' €' : '€' + (c / 100).toFixed(2)); %>
<% const planName = plan ? (lang === 'bg' ? plan.nameBg : plan.nameEn) : payment.planCode; %>
<p><a href="/app/o/<%= orgId %>/plan">← <%= t('app.plan.title') %></a></p>
<h1><%= t('app.plan.orderTitle', { reference: payment.reference || '' }) %></h1>
<% if (err) { %><p class="error" role="alert"><%= tOr('app.plan.err.' + err, t('auth.errors.invalid')) %></p><% } %>
<% if (payment.status === 'COMPLETED') { %>
  <p class="ok" role="status"><%= t('app.plan.paid', { date: day(payment.paidAt || payment.createdAt) }) %></p>
<% } else if (refresh) { %>
  <p class="notice" role="status"><%= t('app.plan.processing') %></p>
<% } %>
<dl class="facts">
  <div><dt><%= t('app.plan.planLabel') %></dt><dd><%= planName %> · <%= t('app.plan.interval.' + payment.interval) %></dd></div>
  <div><dt><%= t('app.plan.net') %></dt><dd class="mono"><%= eur(payment.netCents) %></dd></div>
  <div><dt><%= t('app.plan.vat') %> <%= payment.vatRate %> %</dt><dd class="mono"><%= eur(payment.vatCents) %></dd></div>
  <div><dt><%= t('app.plan.total') %></dt><dd class="mono strong"><%= eur(payment.amountCents) %></dd></div>
  <div><dt><%= t('app.plan.status') %></dt><dd><span class="tag<%= payment.status === 'COMPLETED' ? ' tag-active' : payment.status === 'PENDING' ? ' tag-pending' : '' %>"><%= t('app.plan.statuses.' + payment.status) %></span></dd></div>
  <% if (payment.invoiceDocument) { %><div><dt><%= t('app.plan.invoice') %></dt><dd><% if (inboxEntryId) { %><a href="/app/o/<%= orgId %>/shkafche/<%= inboxEntryId %>"><%= payment.invoiceDocument.number %></a><% } else { %><span class="mono"><%= payment.invoiceDocument.number %></span><% } %></dd></div><% } %>
</dl>

<% if (payment.status === 'PENDING' && payment.provider === 'MANUAL' && supplier && supplier.iban) { %>
<section class="panel">
  <h2><%= t('app.plan.transferTitle') %></h2>
  <dl class="facts">
    <div><dt><%= t('app.plan.beneficiary') %></dt><dd><%= supplier.legalName %></dd></div>
    <div><dt>IBAN</dt><dd class="mono"><%= supplier.iban %></dd></div>
    <% if (supplier.bic) { %><div><dt>BIC</dt><dd class="mono"><%= supplier.bic %></dd></div><% } %>
    <div><dt><%= t('app.plan.amount') %></dt><dd class="mono strong"><%= eur(payment.amountCents) %></dd></div>
    <div><dt><%= t('app.plan.reference') %></dt><dd class="mono strong"><%= payment.reference %></dd></div>
  </dl>
  <p class="hint"><%= t('app.plan.transferNote') %></p>
  <p><a class="button button-secondary" href="/app/o/<%= orgId %>/plan/<%= payment.id %>/proforma.pdf" download target="_blank" rel="noopener"><%= t('app.plan.proforma') %></a></p>
</section>
<% } %>

<% if (expired) { %>
<p class="callout"><%= t('app.plan.err.expired') %> <a href="/app/o/<%= orgId %>/plan"><%= t('app.plan.title') %></a></p>
<% } else if (payment.status === 'PENDING' && payment.provider === 'REVOLUT' && !refresh) { %>
<section class="panel">
  <h2><%= t('app.plan.cardTitle') %></h2>
  <p class="hint"><%= t('app.plan.cardNote') %></p>
  <% if (payment.checkoutUrl) { %>
    <p><a class="button" href="<%= payment.checkoutUrl %>" rel="noopener noreferrer"><%= t('app.plan.payNow', { amount: eur(payment.amountCents) }) %></a></p>
  <% } else { %>
    <form method="post" action="/app/o/<%= orgId %>/plan/<%= payment.id %>/karta"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= t('app.plan.retry') %></button></form>
  <% } %>
</section>
<% } %>

<% if (payment.status === 'PENDING') { %>
<form method="post" action="/app/o/<%= orgId %>/plan/<%= payment.id %>/otkazhi" class="plan-cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link"><%= t('app.plan.cancel') %></button></form>
<% } %>
<%- include('../partials/app-foot') %>
