<%- include('../partials/app-head', { title: item ? t('app.catalog.editItem') : t('app.catalog.newItem') }) %>
<%
  const v = (name) => (values && values[name] !== undefined && values[name] !== null ? String(values[name]) : '');
  const err = (name) => (errors[name] ? tOr('app.catalog.errors.' + errors[name], t('auth.errors.invalid')) : '');
  const invalid = (name) => (errors[name] ? ' aria-invalid="true" aria-describedby="e-' + name + '"' : '');
%>
<p><a href="/app/o/<%= org.id %>/artikuli">← <%= t('app.catalog.items') %></a></p>
<section class="narrow wide-ish">
  <h1><%= item ? t('app.catalog.editItem') : t('app.catalog.newItem') %></h1>
  <% if (item) { %><p class="muted"><%= t('app.catalog.copyNote') %></p><% } %>
  <form method="post" class="stack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label<%= errors.name ? ' class="has-error"' : '' %>><%= t('app.catalog.name') %><input name="name" required value="<%= v('name') %>"<%- invalid('name') %>><% if (errors.name) { %><span class="field-error" id="e-name"><%= err('name') %></span><% } %></label>
    <div class="row">
      <label><%= t('app.doc.unit') %><select name="unitCode"><% units.forEach((u) => { %><option<%= v('unitCode') === u ? ' selected' : '' %>><%= u %></option><% }) %></select></label>
      <label<%= errors.netPrice ? ' class="has-error"' : '' %>><%= t('app.catalog.netPrice') %><input name="netPrice" inputmode="decimal" class="mono" required value="<%= v('netPrice') %>"<%- invalid('netPrice') %>><% if (errors.netPrice) { %><span class="field-error" id="e-netPrice"><%= err('netPrice') %></span><% } %></label>
    </div>
    <div class="row">
      <label><%= t('app.doc.category') %><select name="vatCategory"><% categories.forEach((c) => { %><option<%= v('vatCategory') === c ? ' selected' : '' %>><%= c %></option><% }) %></select></label>
      <label<%= errors.vatRate ? ' class="has-error"' : '' %>><%= t('app.doc.vatRate') %><input name="vatRate" inputmode="decimal" class="mono" value="<%= v('vatRate') %>"<%- invalid('vatRate') %>><% if (errors.vatRate) { %><span class="field-error" id="e-vatRate"><%= err('vatRate') %></span><% } %></label>
    </div>
    <label><%= t('app.catalog.sellerItemId') %><input name="sellerItemId" class="mono" value="<%= v('sellerItemId') %>"></label>
    <button type="submit"><%= t('app.catalog.save') %></button>
  </form>
</section>
<%- include('../partials/app-foot') %>
