<%- include('../partials/app-head', { title: t('app.peppol.title') }) %>
<% const day = (d) => d ? d.toISOString().slice(0, 10).split('-').reverse().join('.') : '—'; %>
<p><a href="/app/o/<%= org.id %>">← <%= org.legalName %></a></p>
<h1><%= t('app.peppol.title') %></h1>
<p class="muted"><%= t('app.peppol.how') %></p>
<% if (ok) { %><p class="ok" role="status"><%= tOr('app.peppol.ok.' + ok, t('app.catalog.saved.updated')) %></p><% } %>
<% if (err) { %><p class="error" role="alert"><%= tOr('app.peppol.err.' + err, t('auth.errors.invalid')) %></p><% } %>
<% if (!configured) { %><p class="callout"><%= t('app.peppol.notConfigured') %></p><% } else if (!available) { %><p class="callout"><%= t('app.peppol.notAvailable') %></p><% } %>
<section class="panel" aria-labelledby="peppol-h">
  <h2 id="peppol-h"><%= t('app.peppol.receiveTitle') %></h2>
  <dl class="facts">
    <div><dt><%= t('app.peppol.address') %></dt><dd class="mono"><%= partyId || t('app.peppol.noVat') %></dd></div>
    <div><dt><%= t('app.peppol.status') %></dt><dd><span class="tag<%= participant && participant.status === 'ACTIVE' ? ' tag-active' : participant && participant.status === 'FAILED' ? '' : ' tag-pending' %>"><%= t('app.peppol.statuses.' + (participant ? participant.status : 'NONE')) %></span><% if (participant && participant.enrolledAt) { %> <span class="muted"><%= day(participant.enrolledAt) %></span><% } %></dd></div>
  </dl>
  <% if (participant && participant.lastError) { %><p class="error" role="alert"><%= participant.lastError %></p><% } %>
  <% if (configured && available && partyId && !verified && (!participant || participant.status !== 'ACTIVE')) { %><p class="callout"><%= t('app.peppol.notVerified') %></p><% } %>
  <% if (canManage && configured && partyId) { %>
    <% if (participant && participant.status === 'ACTIVE') { %>
      <form method="post" action="/app/o/<%= org.id %>/peppol/izklyuchi"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="button-secondary"><%= t('app.peppol.disable') %></button></form>
    <% } else if (verified && available) { %>
      <p class="hint"><%= t('app.peppol.directory') %></p>
      <form method="post" action="/app/o/<%= org.id %>/peppol/vklyuchi"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= t('app.peppol.enable') %></button></form>
    <% } %>
  <% } %>
</section>
<h2><%= t('app.peppol.sentTitle') %></h2>
<% if (transmissions.length === 0) { %><p class="muted"><%= t('app.peppol.none') %></p><% } else { %>
<div class="table-wrap"><table class="stack-table">
  <thead><tr><th scope="col"><%= t('app.peppol.document') %></th><th scope="col"><%= t('app.peppol.receiver') %></th><th scope="col"><%= t('app.peppol.status') %></th><th scope="col"><%= t('app.peppol.sentAt') %></th></tr></thead>
  <tbody>
  <% transmissions.forEach((x) => { %>
    <tr>
      <td data-label="<%= t('app.peppol.document') %>" class="mono"><a href="/app/o/<%= org.id %>/d/<%= x.document.id %>"><%= x.document.number %></a> <span class="muted"><%= x.document.buyerName %></span></td>
      <td data-label="<%= t('app.peppol.receiver') %>" class="mono"><%= x.receiverPartyId %></td>
      <td data-label="<%= t('app.peppol.status') %>"><span class="tag<%= x.status === 'SENT' ? ' tag-active' : x.status === 'FAILED' ? '' : ' tag-pending' %>"><%= t('app.peppol.tx.' + x.status) %></span><% if (x.lastError) { %><br><span class="hint"><%= x.lastError %></span><% } %></td>
      <td data-label="<%= t('app.peppol.sentAt') %>" class="mono"><%= day(x.sentAt) %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('../partials/pager', { pager }) %>
<% } %>
<%- include('../partials/app-foot') %>
