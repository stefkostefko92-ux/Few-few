<%- include('../partials/app-head', { title: t('app.settings.title') }) %>
<%
  const v = (name) => (values && typeof values[name] === 'string' ? values[name] : '');
  const err = (name) => errors[name] ? tOr('app.settings.errors.' + errors[name], t('auth.errors.invalid')) : '';
%>
<p><a href="/app/o/<%= org.id %>">← <%= org.legalName %></a></p>
<h1><%= t('app.settings.title') %></h1>
<% if (saved) { %><p class="ok" role="status"><%= t('app.settings.saved.' + saved) %></p><% } %>

<section aria-labelledby="h-profile" class="stack wide-ish">
  <h2 id="h-profile"><%= t('app.settings.profile.title') %></h2>
  <p class="muted"><%= t('app.settings.profile.intro') %></p>
  <% if (locals.profileError) { %><p class="error" role="alert"><%= tOr('app.settings.profile.errors.' + profileError, t('auth.errors.invalid')) %></p><% } %>
  <% if (locals.canEditProfile) { %>
  <form method="post" action="/app/o/<%= org.id %>/nastroyki/danni" class="panel stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('app.settings.profile.legalName') %><input name="legalName" value="<%= org.legalName %>" minlength="2" maxlength="200" required autocomplete="organization"></label>
    <label><%= t('app.settings.profile.eik') %><input value="<%= org.eik || '' %>" readonly><span class="hint"><%= t('app.settings.profile.eikHint') %></span></label>
    <label><%= t('app.settings.profile.vatNumber') %><input name="vatNumber" value="<%= org.vatNumber || '' %>" maxlength="14" autocomplete="off"><span class="hint"><%= t('app.settings.profile.vatHint', { eik: org.eik || '' }) %></span></label>
    <label><%= t('app.settings.profile.addressStreet') %><input name="addressStreet" value="<%= org.addressStreet %>" minlength="3" maxlength="200" required autocomplete="street-address"></label>
    <div class="grid-2">
      <label><%= t('app.settings.profile.addressCity') %><input name="addressCity" value="<%= org.addressCity %>" minlength="2" maxlength="100" required autocomplete="address-level2"></label>
      <label><%= t('app.settings.profile.postalCode') %><input name="postalCode" value="<%= org.postalCode %>" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required autocomplete="postal-code"></label>
    </div>
    <label><%= t('app.settings.profile.iban') %><input name="iban" value="<%= org.iban || '' %>" maxlength="34" autocomplete="off" spellcheck="false"></label>
    <div class="grid-2">
      <label><%= t('app.settings.profile.bic') %><input name="bic" value="<%= org.bic || '' %>" maxlength="11" autocomplete="off" spellcheck="false"></label>
      <label><%= t('app.settings.profile.bankName') %><input name="bankName" value="<%= org.bankName || '' %>" maxlength="120" autocomplete="off"></label>
    </div>
    <div class="grid-2">
      <label><%= t('app.settings.profile.email') %><input type="email" name="email" value="<%= org.email || '' %>" maxlength="254" autocomplete="email"></label>
      <label><%= t('app.settings.profile.phone') %><input type="tel" name="phone" value="<%= org.phone || '' %>" maxlength="30" autocomplete="tel"></label>
    </div>
    <p class="hint"><%= t('app.settings.profile.issuedNote') %></p>
    <div><button type="submit"><%= t('app.settings.profile.save') %></button></div>
  </form>
  <% } else { %>
  <p class="callout"><%= t('app.settings.profile.ownerOnly') %></p>
  <% } %>
</section>

<section aria-labelledby="h-pdf" class="stack wide-ish">
  <h2 id="h-pdf"><%= t('app.settings.pdfTitle') %></h2>
  <p class="muted"><%= t('app.settings.pdfIntro') %></p>
  <p><a class="button-secondary" href="/app/o/<%= org.id %>/nastroyki/obrazets.pdf" target="_blank" rel="noopener"><%= t('app.settings.preview') %></a></p>

  <section class="panel stack" aria-labelledby="h-logo">
    <h3 id="h-logo"><%= t('app.settings.logo') %></h3>
    <% if (hasLogo) { %>
      <img class="logo-preview" src="/app/o/<%= org.id %>/nastroyki/logo.png?v=<%= logoVersion %>" alt="<%= t('app.settings.logoAlt', { company: org.legalName }) %>">
    <% } else { %>
      <p class="muted"><%= t('app.settings.noLogo') %></p>
    <% } %>
    <% if (errors.logo) { %><p class="error" role="alert"><%= err('logo') %></p><% } %>
    <form method="post" action="/app/o/<%= org.id %>/nastroyki/logo" enctype="multipart/form-data" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/file-pick', { name: 'logo', accept: 'image/png,image/jpeg,image/webp', label: hasLogo ? t('app.settings.replaceLogo') : t('app.settings.uploadLogo'), hint: t('app.settings.logoHelp'), hintId: 'logo-help' }) %>
      <button type="submit"><%= t('app.settings.uploadButton') %></button>
    </form>
    <% if (hasLogo) { %>
      <form method="post" action="/app/o/<%= org.id %>/nastroyki/logo/mahni">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="button-secondary"><%= t('app.settings.removeLogo') %></button>
      </form>
    <% } %>
  </section>

  <form method="post" action="/app/o/<%= org.id %>/nastroyki/pdf" class="panel stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3><%= t('app.settings.look') %></h3>
    <% if (Object.keys(errors).some((f) => f !== 'logo')) { %><div class="error-box" role="alert"><ul><% Object.entries(errors).filter(([f]) => f !== 'logo').forEach(([f]) => { %><li><%= t('app.settings.fields.' + f) %>: <%= err(f) %></li><% }) %></ul></div><% } %>
    <fieldset class="choice">
      <legend><%= t('app.settings.fields.template') %></legend>
      <% templates.forEach((tpl) => { %>
        <label class="radio"><input type="radio" name="template" value="<%= tpl %>"<%= v('template') === tpl ? ' checked' : '' %>> <span><strong><%= t('app.settings.templates.' + tpl + '.name') %></strong> <span class="hint"><%= t('app.settings.templates.' + tpl + '.help') %></span></span></label>
      <% }) %>
    </fieldset>
    <label<%- errors.font ? ' class="has-error"' : '' %>><%= t('app.settings.fields.font') %>
      <select name="font"><% fonts.forEach((f) => { %><option value="<%= f.key %>"<%= v('font') === f.key ? ' selected' : '' %>><%= f.label %> — <%= t('app.settings.fontKinds.' + f.key) %></option><% }) %></select>
      <span class="hint"><%= t('app.settings.fontHelp') %></span>
    </label>
    <label<%- errors.accent ? ' class="has-error"' : '' %>><%= t('app.settings.fields.accent') %>
      <input type="color" name="accent" value="<%= v('accent') || '#03756c' %>" aria-describedby="accent-help">
      <span class="hint" id="accent-help"><%= t('app.settings.accentHelp') %></span>
    </label>
    <fieldset class="choice">
      <legend><%= t('app.settings.fields.logoPosition') %></legend>
      <% positions.forEach((p) => { %>
        <label class="radio"><input type="radio" name="logoPosition" value="<%= p %>"<%= v('logoPosition') === p ? ' checked' : '' %>> <%= t('app.settings.positions.' + p) %></label>
      <% }) %>
    </fieldset>
    <p class="hint"><%= t('app.settings.contentNote') %></p>
    <button type="submit"><%= t('app.settings.save') %></button>
  </form>
</section>
<%- include('../partials/app-foot') %>
