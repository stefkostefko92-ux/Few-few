<%- include('../partials/app-head', { title: t('app.legalUpdate.title') }) %>
<%
  const owner = pending.companies.length > 0;
  const changes = ['1', '2', '3', '4'].map((n) => t('app.legalUpdate.changes.' + n));
%>
<section class="narrow wide-ish stack">
  <h1><%= t('app.legalUpdate.title') %></h1>
  <p class="lead"><%= t('app.legalUpdate.intro', { date: bgDate(new Date(date + 'T12:00:00Z')) }) %></p>
  <h2><%= t('app.legalUpdate.whatsNew') %></h2>
  <ul>
    <% changes.forEach((c) => { %><li><%= c %></li><% }) %>
  </ul>
  <ul class="plain doc-links">
    <li><a href="<%= legalUrl('terms') %>" target="_blank" rel="noopener"><%= t('app.legalUpdate.docs.terms') %></a></li>
    <% if (owner) { %><li><a href="<%= legalUrl('dpa') %>" target="_blank" rel="noopener"><%= t('app.legalUpdate.docs.dpa') %></a></li><% } %>
    <li><a href="<%= legalUrl('privacy') %>" target="_blank" rel="noopener"><%= t('app.legalUpdate.docs.privacy') %></a></li>
  </ul>
  <form method="post" action="/app/usloviya" class="panel stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <% if (error) { %><p class="error" role="alert"><%= owner ? t('auth.invite.errors.acceptTerms') : t('auth.member.errors.acceptTerms') %></p><% } %>
    <%- include('../partials/legal-accept', { orgName: pending.companies.map((c) => c.legalName).join(', '), memberOnly: !owner, many: pending.companies.length > 1, invalid: error }) %>
    <div><button type="submit"><%= t('app.legalUpdate.accept') %></button></div>
  </form>
  <p class="muted"><%= t('app.legalUpdate.refuse') %> <a href="/app/sigurnost"><%= t('app.legalUpdate.security') %></a></p>
  <% if (owner) { %>
  <ul class="plain">
    <% pending.companies.forEach((c) => { %>
    <li class="muted"><%= c.legalName %>: <a href="/app/o/<%= c.id %>/iznos.zip" target="_blank" rel="noopener"><%= t('app.legalUpdate.export') %></a> · <a href="/app/o/<%= c.id %>/prekratyavane"><%= t('app.legalUpdate.terminate') %></a></li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('../partials/app-foot') %>
