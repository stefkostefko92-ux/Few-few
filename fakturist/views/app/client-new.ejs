<%- include('../partials/app-head', { title: t('app.client.title') }) %>
<% const v = (n) => (values && typeof values[n] === 'string' ? values[n] : ''); %>
<p><a href="/app">← <%= firm.legalName %></a></p>
<section class="narrow wide-ish">
  <h1><%= t('app.client.title') %></h1>
  <p class="muted"><%= t('app.client.help') %></p>
  <% if (Object.keys(errors).length) { %><div class="error-box" role="alert"><ul><% Object.entries(errors).forEach(([f, code]) => { %><li><%= tOr('auth.' + f, f) %>: <%= tOr('auth.errors.' + code, t('auth.errors.invalid')) %></li><% }) %></ul></div><% } %>
  <form method="post" action="/app/o/<%= firm.id %>/klienti/nov" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('auth.legalName') %><input name="legalName" required value="<%= v('legalName') %>"></label>
    <div class="row">
      <label><%= t('auth.eik') %><input name="eik" class="mono" required value="<%= v('eik') %>"></label>
      <label><%= t('auth.vatNumber') %><input name="vatNumber" class="mono" value="<%= v('vatNumber') %>"></label>
    </div>
    <label><%= t('auth.addressStreet') %><input name="addressStreet" required value="<%= v('addressStreet') %>"></label>
    <div class="row">
      <label><%= t('auth.addressCity') %><input name="addressCity" required value="<%= v('addressCity') %>"></label>
      <label><%= t('auth.postalCode') %><input name="postalCode" class="mono" required value="<%= v('postalCode') %>"></label>
    </div>
    <label><%= t('auth.iban') %><input name="iban" class="mono" value="<%= v('iban') %>"></label>
    <div class="row">
      <label><%= t('app.client.documentRef') %><input name="documentRef" required value="<%= v('documentRef') %>"></label>
      <label><%= t('app.client.validFrom') %><input type="date" name="validFrom" required value="<%= v('validFrom') %>"></label>
    </div>
    <button type="submit"><%= t('app.client.save') %></button>
  </form>
</section>
<%- include('../partials/app-foot') %>
