<%- include('../partials/app-head', { title: t('app.incoming.title') }) %>
<% const day = (d) => d ? d.toISOString().slice(0, 10).split('-').reverse().join('.') : '—'; %>
<% const amount = (c, cur) => (Number(c) / 100).toFixed(2).replace('.', lang === 'bg' ? ',' : '.') + ' ' + cur; %>
<p><a href="/app/o/<%= org.id %>">← <%= org.legalName %></a></p>
<h1><%= t('app.incoming.title') %></h1>
<% if (ok) { %><p class="ok" role="status"><%= tOr('app.incoming.ok.' + ok, t('app.catalog.saved.updated')) %></p><% } %>
<% if (err) { %><p class="error" role="alert"><%= tOr('app.incoming.err.' + err, t('auth.errors.invalid')) %></p><% } %>
<p class="muted"><%= t('app.incoming.intro') %></p>
<% if (canWrite) { %>
<form method="post" action="/app/o/<%= org.id %>/vhodyashti" enctype="multipart/form-data" class="panel stack narrow-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label><%= t('app.incoming.file') %><input type="file" name="file" required accept=".xml,application/xml,text/xml"><span class="hint"><%= t('app.incoming.fileHint') %></span></label>
  <div><button type="submit"><%= t('app.incoming.upload') %></button></div>
</form>
<% } %>
<% if (rows.length === 0) { %><p class="muted"><%= t('app.incoming.none') %></p><% } else { %>
<div class="table-wrap"><table class="stack-table">
  <thead><tr><th scope="col"><%= t('app.incoming.supplier') %></th><th scope="col"><%= t('app.incoming.number') %></th><th scope="col"><%= t('app.incoming.date') %></th><th scope="col"><%= t('app.incoming.due') %></th><th scope="col" class="num"><%= t('app.incoming.amount') %></th><th scope="col"><%= t('app.incoming.status') %></th></tr></thead>
  <tbody>
  <% rows.forEach((r) => { %>
    <tr>
      <td data-label="<%= t('app.incoming.supplier') %>"><%= r.supplier %><% if (r.eik) { %><br><span class="hint mono"><%= r.eik %></span><% } %></td>
      <td data-label="<%= t('app.incoming.number') %>" class="mono"><a href="<%= r.kind === 'upload' ? '/app/o/' + org.id + '/vhodyashti/' + r.id : '/app/o/' + org.id + '/shkafche/' + r.id %>"><%= r.number %></a></td>
      <td data-label="<%= t('app.incoming.date') %>" class="mono"><%= day(r.issueDate) %></td>
      <td data-label="<%= t('app.incoming.due') %>" class="mono"><%= day(r.dueDate) %></td>
      <td data-label="<%= t('app.incoming.amount') %>" class="num mono"><%= amount(r.payableCents, r.currency) %></td>
      <td data-label="<%= t('app.incoming.status') %>"><span class="tag"><%= r.kind === 'upload' ? t('app.incoming.statuses.' + r.status) : t('app.inbox.status.' + r.status) %></span><% if (!r.valid) { %> <span class="tag tag-pending"><%= t('app.incoming.hasIssues') %></span><% } %><br><span class="hint"><%= t('app.incoming.sources.' + r.kind) %></span></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>
<%- include('../partials/app-foot') %>
