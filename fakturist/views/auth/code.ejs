<%- include('../partials/app-head', { title: t('auth.codeTitle') }) %>
<section class="narrow">
  <h1><%= t('auth.codeTitle') %></h1>
  <p><%= t('auth.codeHelp') %></p>
  <% if (error) { %><p class="error" role="alert"><%= t(error) %></p><% } %>
  <form method="post" action="/vhod/kod" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label><%= t('auth.code') %><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" required class="mono"></label>
    <button type="submit"><%= t('auth.confirm') %></button>
  </form>
</section>
<%- include('../partials/app-foot') %>
