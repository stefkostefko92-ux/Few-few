<%
  const deadline = Date.UTC(2028, 6, 1);
  const left = Math.ceil((deadline - Date.now()) / 86400000);
  const days = left > 0 ? left : null;
  const app = locals.appUrls || { register: '/registraciya', login: '/vhod' };
  const planName = (p) => (lang === 'bg' ? p.nameBg : p.nameEn);
  const plural = (key, n) => t('site.units.' + key + (n === 1 ? '.one' : '.other'), { n });
  const firm = plans ? plans.find((p) => p.audience === 'accountant') : null;
  const limitsOf = (p) => {
    const bits = [];
    if (p.audience === 'accountant') {
      if (p.includedClientCompanies !== null) bits.push(plural('clients', p.includedClientCompanies));
    } else if (p.maxCompanies !== null) bits.push(plural('companies', p.maxCompanies));
    if (p.maxUsers !== null) bits.push(plural('users', p.maxUsers));
    if (p.monthlyDocumentSoftLimit !== null) bits.push(t('site.home.pricing.softLimit', { documents: plural('documents', p.monthlyDocumentSoftLimit) }));
    return bits.join(', ');
  };
-%>
<%- include('../partials/site-head') %>
<main id="main">

<section class="hero" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-top">
      <h1 id="h1"><%= t('site.home.hero.title') %></h1>
      <div class="hero-side">
        <p class="lead"><%= t('site.home.hero.lead') %></p>
        <div class="actions">
<% if (registrationOpen) { -%>
          <a class="btn" href="<%= app.register %>"><%= t('site.cta.registerFree') %></a>
          <a class="btn btn-ghost" href="<%= urls.pricing %>"><%= t('landing.hero.pricing') %></a>
<% } else { -%>
          <a class="btn" href="#proba"><%= t('landing.hero.tryIt') %></a>
          <a class="btn btn-ghost" href="<%= urls.pricing %>"><%= t('landing.hero.pricing') %></a>
          <p class="muted actions-note"><%= t('site.cta.closed') %></p>
<% } -%>
        </div>
<% if (registrationOpen) { -%>
        <p class="hero-try"><a class="link" href="#proba"><%= t('landing.hero.tryIt') %></a></p>
<% } -%>
      </div>
    </div>
    <%- include('../partials/home-stage', { link: demoChain[1] }) %>
  </div>
</section>

<section class="section" aria-labelledby="rules-h">
  <div class="wrap split">
    <div class="split-head" data-rv>
      <h2 id="rules-h"><%= t('site.home.rules.title') %></h2>
      <p class="muted"><%= t('site.home.rules.lead') %></p>
    </div>
    <dl class="ledger">
<% for (const n of [1, 2, 3, 4, 5]) { -%>
      <div class="ledger-row">
        <dt><%= t('site.home.rules.' + n + '.name') %></dt>
        <dd><%= t('site.home.rules.' + n + '.text') %></dd>
        <dd class="ledger-ref"><%= t('site.home.rules.' + n + '.ref') %></dd>
      </div>
<% } -%>
    </dl>
  </div>
</section>

<%- include('../partials/home-trial', { chain: demoChain, demoPrefix: 'fakturist-demo' }) %>

<%- include('../partials/home-recv') %>

<%- include('../partials/home-road', { days, more: urls.einvoicing2028 }) %>

<section class="section section-tint" aria-label="<%= t('site.nav.accountants') %>">
  <div class="wrap two">
    <div>
      <h2><%= t('site.home.who.companies.title') %></h2>
      <p><%= t('site.home.who.companies.text') %></p>
<% if (registrationOpen) { -%>
      <p><a class="link" href="<%= app.register %>"><%= t('site.home.who.companies.cta') %></a></p>
<% } -%>
    </div>
    <div>
      <h2><%= t('site.home.who.firms.title') %></h2>
      <p><%= t('site.home.who.firms.text') %></p>
<% if (firm && firm.perClientCompanyCents !== null && firm.includedClientCompanies !== null) { -%>
      <p><%= t('site.home.who.firms.price', { included: plural('clients', firm.includedClientCompanies), price: formatEuro(firm.perClientCompanyCents), unit: t('site.units.perClientMonth') }) %></p>
<% } -%>
      <p><a class="link" href="<%= urls.accountants %>"><%= t('site.home.who.firms.cta') %></a></p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="price-h">
  <div class="wrap split">
    <div class="split-head">
      <h2 id="price-h"><%= t('site.home.pricing.title') %></h2>
      <p class="muted"><%= t('site.home.pricing.lead') %></p>
      <p><a class="link" href="<%= urls.pricing %>"><%= t('site.home.pricing.link') %></a></p>
    </div>
<% if (plans) { -%>
    <table class="mini">
      <caption class="sr"><%= t('site.home.pricing.title') %></caption>
      <tbody>
<% for (const p of plans) { -%>
        <tr<% if (p.highlighted) { %> class="is-hl"<% } %>>
          <th scope="row"><%= planName(p) %></th>
          <td class="mini-limits"><%= limitsOf(p) %><% if (p.audience === 'accountant' && p.perClientCompanyCents !== null) { %>, <%= formatEuro(p.perClientCompanyCents) %> <%= t('site.units.perClientMonth') %><% } %></td>
          <td class="mini-price">
<% if (p.priceMonthlyCents === null) { -%>
            <%= t('site.home.pricing.contract') %>
<% } else if (p.priceMonthlyCents === 0) { -%>
            <%= t('site.home.pricing.free') %>
<% } else { -%>
            <%- include('../partials/site-price', { cents: p.priceMonthlyCents, unit: t('site.units.perMonth') }) %>
<% } -%>
          </td>
        </tr>
<% } -%>
      </tbody>
    </table>
<% } else { -%>
    <p class="notice" role="status"><%= t('site.home.pricing.unavailable', { email: company.email }) %></p>
<% } -%>
  </div>
</section>

<section class="section section-tint" aria-labelledby="sec-h">
  <div class="wrap split">
    <h2 id="sec-h"><%= t('site.home.security.title') %></h2>
    <dl class="trio">
<% for (const n of [1, 2, 3]) { -%>
      <div><dt><%= t('site.home.security.' + n + '.name') %></dt><dd><%= t('site.home.security.' + n + '.text') %></dd></div>
<% } -%>
    </dl>
  </div>
</section>

<%- include('../partials/site-faq') %>
<%- include('../partials/site-cta') %>
</main>
<%- include('../partials/site-foot') %>
