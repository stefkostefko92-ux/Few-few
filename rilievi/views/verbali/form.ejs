<%
  // Формата на черновата на протокола — разделите като хартиения лист: главата (дата, адрес, „N° buono“),
  // редовете (текст; „Certificato“ SÌ/NO там, където го има), „Verbale positivo“. Подписите не са тук:
  // слагат се на страницата „Firma e conferma“ върху окончателния протокол (firma.ejs).
  const isEdit = verbale !== null;
  const action = isEdit ? '/verbali/' + verbale.id : '/verbali';
  const errorKeys = Object.keys(errors);
  const voceDi = (key) => sezioni.flatMap((s) => s.voci.map((v) => ({ ...v, sezione: s.key }))).find((v) => v.key === key);
  const maxOf = (key) => key.startsWith('t-') ? maxDi(voceDi(key.slice(2)) || {}) : { indirizzo: maxIndirizzo, buono: maxBuono }[key];
  const labelOf = (key) => {
    if (key === 'azienda') return t('scheda.field.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.titolo');
    if (key === 'positivo') return t('verbali.positivo');
    const voce = voceDi(key.slice(2));
    if (voce && key.startsWith('t-')) return t('verbali.voceDi', { voce: t('verbali.voce.' + voce.key), sezione: t('verbali.sezione.' + voce.sezione) });
    if (voce && key.startsWith('c-')) return t('verbali.certificatoDi', { voce: t('verbali.voce.' + voce.key) });
    return t('verbali.campo.' + key);
  };
  const messageOf = (key) => {
    if (key === 'azienda') return t('scheda.error.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.nonDisponibile');
    if (key === 'data' && errors[key] === 'required') return t('verbali.dataMancante');
    return t('scheda.error.' + errors[key], { maxLength: maxOf(key) });
  };
  const str = (key) => typeof values[key] === 'string' ? values[key] : '';
  const aria = (key) => errors[key] ? ' aria-invalid="true" aria-describedby="err-' + key + '"' : '';
  const siNo = (name, legend) => include('_si-no', { name, legend, message: errors[name] ? messageOf(name) : '' });
  const collegata = isEdit ? verbale.scheda : null;
%><%- include('../partials/top', { titleKey: isEdit ? 'verbali.modifica' : 'verbali.new', narrowMain: true }) %>
<div class="page-head">
  <div>
    <a href="<%= isEdit ? '/verbali/' + verbale.id : '/verbali' %>"><%= isEdit ? t('verbali.conferma.torna') : t('verbali.indietro') %></a>
    <h1><%= isEdit ? t('verbali.titolo') : t('verbali.new') %></h1>
    <% if (isEdit) { %><p class="page-head__sub"><%= verbale.azienda.name %></p><% } %>
  </div>
</div>
<div class="stack-gap">
<% if (typeof conflict !== 'undefined' && conflict) { %>
  <div class="notice" role="alert"><p><strong><%= t('verbali.flash.conflitto') %></strong></p></div>
<% } %>
<% if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="#f-<%= key %>"><%= labelOf(key) %>: <%= messageOf(key) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<% if (!isEdit && (puoCercare || scheda)) { %><%- include('../cartelli/_da-scheda', { daSchedaNuovo: '/verbali/nuovo', daSchedaTesti: 'verbali' }) %><% } %>
<% if (collegata && !collegata.deletedAt) { %><p class="muted"><%= t('cartelli.daScheda.collegato', { nome: [collegata.matricola ? t('cartelli.daScheda.matricola', { m: collegata.matricola }) : '', collegata.numeroImpianto ? t('cartelli.daScheda.numero', { n: collegata.numeroImpianto }) : ''].filter(Boolean).join(' · ') || '—' }) %></p><% } %>
<form class="form verbale-form" method="post" action="<%= action %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= base %>"><% } %>
  <% if (!isEdit && scheda) { %><input type="hidden" name="scheda" value="<%= scheda.id %>"><% } %>
  <% if (!isEdit && !scheda && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required<%- aria('azienda') %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors.azienda) { %><p class="field__error" id="err-azienda"><%= messageOf('azienda') %></p><% } %>
  </div>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('verbali.sezione.testata') %></legend>
    <div class="grid">
      <div class="field">
        <label class="field__label" for="f-data"><%= t('verbali.campo.data') %></label>
        <input class="input" id="f-data" name="data" type="date" required min="1950-01-01" max="2099-12-31" value="<%= str('data') %>"<%- aria('data') %>>
        <% if (errors.data) { %><p class="field__error" id="err-data"><%= messageOf('data') %></p><% } %>
      </div>
      <div class="field">
        <label class="field__label" for="f-buono"><%= t('verbali.campo.buono') %></label>
        <input class="input" id="f-buono" name="buono" type="text" maxlength="<%= maxBuono %>" autocomplete="off" value="<%= str('buono') %>"<%- aria('buono') %>>
        <% if (errors.buono) { %><p class="field__error" id="err-buono"><%= messageOf('buono') %></p><% } %>
      </div>
      <div class="field field--wide">
        <label class="field__label" for="f-indirizzo"><%= t('verbali.campo.indirizzo') %></label>
        <input class="input" id="f-indirizzo" name="indirizzo" type="text" maxlength="<%= maxIndirizzo %>" autocomplete="street-address" value="<%= str('indirizzo') %>"<%- aria('indirizzo') %>>
        <% if (errors.indirizzo) { %><p class="field__error" id="err-indirizzo"><%= messageOf('indirizzo') %></p><% } %>
      </div>
    </div>
  </fieldset>

  <% for (const sezione of sezioni) { %>
  <fieldset class="section verbale-sezione">
    <legend class="section__title"><%= t('verbali.sezione.' + sezione.key) %></legend>
    <% for (const voce of sezione.voci) { const key = 't-' + voce.key; %>
    <div class="verbale-riga<%= voce.certificato ? ' verbale-riga--cert' : '' %>">
      <div class="field">
        <label class="field__label" for="f-<%= key %>"><%= t('verbali.voce.' + voce.key) %></label>
        <% if (voce.varie) { %><textarea class="textarea" id="f-<%= key %>" name="<%= key %>" rows="3" maxlength="<%= maxDi(voce) %>"<%- aria(key) %>><%= str(key) %></textarea>
        <% } else { %><input class="input" id="f-<%= key %>" name="<%= key %>" type="text" maxlength="<%= maxDi(voce) %>" autocomplete="off" value="<%= str(key) %>"<%- aria(key) %>>
        <% } %>
        <% if (errors[key]) { %><p class="field__error" id="err-<%= key %>"><%= messageOf(key) %></p><% } %>
      </div>
      <% if (voce.certificato) { %><%- siNo('c-' + voce.key, t('verbali.certificatoDi', { voce: t('verbali.voce.' + voce.key) })) %><% } %>
    </div>
    <% } %>
  </fieldset>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('verbali.sezione.esito') %></legend>
    <%- siNo('positivo', t('verbali.positivo')) %>
  </fieldset>

  <div class="actions">
    <button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('verbali.salva') %></button>
    <a class="btn btn--ghost" href="<%= isEdit ? '/verbali/' + verbale.id : '/verbali' %>"><%= t('common.cancel') %></a>
  </div>
</form>
</div>
<%- include('../partials/bottom') %>
