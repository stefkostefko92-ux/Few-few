<%
  // Формата на клиента (routes/clienti.ts) — нов или промяна върху отворената версия (`base`): името е
  // задължително, останалото — по избор. При няколко фирми новият клиент пита за коя е. Имейлът взима две
  // колони (сам на реда на телефон) — дълъг адрес не се реже в тясна колона.
  const isEdit = cliente !== null;
  const action = isEdit ? '/clienti/' + cliente.id : '/clienti';
  const back = isEdit ? '/clienti/' + cliente.id : '/clienti';
  const errorKeys = Object.keys(errors);
  const str = (key) => typeof values[key] === 'string' ? values[key] : '';
  const labelOf = (key) => key === 'azienda' ? t('scheda.field.azienda') : t('clienti.campo.' + key);
  const messageOf = (key) => {
    const code = errors[key];
    if (key === 'azienda') return t('clienti.errore.azienda');
    if (code === 'required') return t('clienti.errore.required');
    if (code === 'tooLong') return t('clienti.errore.tooLong', { max: max[key] });
    return t('clienti.errore.' + key);
  };
  const CAMPI = [
    { key: 'nome', tipo: 'text', wide: true, required: true },
    { key: 'indirizzo', tipo: 'text', wide: true },
    { key: 'piva', tipo: 'text', hint: t('clienti.hint.piva') },
    { key: 'email', tipo: 'email', doppia: true },
    { key: 'telefono', tipo: 'tel', hint: t('clienti.hint.telefono') },
    { key: 'referente', tipo: 'text', hint: t('clienti.hint.referente') },
    { key: 'note', tipo: 'textarea', wide: true, hint: t('clienti.hint.note') },
  ];
%><%- include('../partials/top', { titleKey: isEdit ? 'clienti.modificaTitolo' : 'clienti.new', narrowMain: true }) %>
<div class="page-head">
  <div>
    <a href="<%= back %>"><%= isEdit ? t('clienti.torna') : t('clienti.indietro') %></a>
    <h1><%= isEdit ? t('clienti.modificaTitolo') : t('clienti.new') %></h1>
    <% if (isEdit) { %><p class="page-head__sub"><%= cliente.azienda.name %></p><% } %>
  </div>
</div>
<div class="stack-gap">
<% if (conflict) { %>
  <div class="notice" role="alert"><p><strong><%= t('clienti.flash.conflitto') %></strong></p></div>
<% } %>
<% if (pieno) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1"><h2><%= t('clienti.errore.pieno', { max: maxClienti }) %></h2></div>
<% } else if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="#f-<%= key %>"><%= labelOf(key) %>: <%= messageOf(key) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<form class="form" method="post" action="<%= action %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= base %>"><% } %>
  <% if (!isEdit && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required<% if (errors.azienda) { %> aria-invalid="true" aria-describedby="err-azienda"<% } %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors.azienda) { %><p class="field__error" id="err-azienda"><%= messageOf('azienda') %></p><% } %>
  </div>
  <% } %>
  <fieldset class="section">
    <legend class="section__title"><%= t('clienti.sezione.dati') %></legend>
    <div class="grid grid--righe">
      <% for (const campo of CAMPI) {
        const errore = errors[campo.key] ? messageOf(campo.key) : '';
        const desc = [campo.hint ? 'hint-' + campo.key : '', errore ? 'err-' + campo.key : ''].filter(Boolean).join(' ');
        const attrs = (errore ? ' aria-invalid="true"' : '') + (desc ? ' aria-describedby="' + desc + '"' : '') + (campo.required ? ' required' : '');
      %><div class="field<%= campo.wide ? ' field--wide' : '' %><%= campo.doppia ? ' field--doppia field--riga-telefono' : '' %>">
        <label class="field__label" for="f-<%= campo.key %>"><%= t('clienti.campo.' + campo.key) %></label>
        <% if (campo.tipo === 'textarea') { %><textarea class="textarea" id="f-<%= campo.key %>" name="<%= campo.key %>" rows="4" maxlength="<%= max[campo.key] %>"<%- attrs %>><%= str(campo.key) %></textarea>
        <% } else { %><input class="input" id="f-<%= campo.key %>" name="<%= campo.key %>" type="<%= campo.tipo %>" maxlength="<%= max[campo.key] %>" autocomplete="off" value="<%= str(campo.key) %>"<%- attrs %>>
        <% } %>
        <div class="field__piede"><% if (campo.hint) { %><p class="field__hint" id="hint-<%= campo.key %>"><%= campo.hint %></p><% } %><% if (errore) { %><p class="field__error" id="err-<%= campo.key %>"><%= errore %></p><% } %></div>
      </div>
      <% } %>
    </div>
  </fieldset>
  <div class="actions">
    <button class="btn btn--inverse" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('clienti.salva') %></button>
    <a class="btn btn--bar" href="<%= back %>"><%= t('common.cancel') %></a>
  </div>
</form>
</div>
<%- include('../partials/bottom') %>
