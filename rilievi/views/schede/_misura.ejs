<%
  // Една спирка от мерките на старите бутониери (src/schede/misure.ts). `row.n` е номерът ѝ или „__N__“
  // в шаблона, от който app.js прави нови редове, докато се пише броят на спирките.
%><fieldset class="misura" data-misura="<%= row.n %>">
  <legend class="misura__title"><%= t('scheda.misure.row', { n: row.n }) %></legend>
  <div class="misura__grid">
  <% for (const cell of row.cells) {
       const col = cell.column;
       const id = 'f-' + cell.name;
       const errId = 'err-' + cell.name;
       const unitId = 'u-' + cell.name;
       const label = t('scheda.misure.col.' + col.key);
       const errText = cell.error ? t('scheda.error.' + cell.error, { min: col.min, max: col.max, maxLength: col.maxLength }) : null;
       const unit = col.unit ? t('scheda.unit.' + col.unit, { n: 2 }) : null;
       const describedBy = [unit ? unitId : null, errText ? errId : null].filter(Boolean).join(' ');
       const aria = (describedBy ? ' aria-describedby="' + describedBy + '"' : '') + (errText ? ' aria-invalid="true"' : '');
  %><% if (col.kind === 'yesno') { %>
    <fieldset class="choice choice--compact field" id="<%= id %>"<% if (errText) { %> aria-describedby="<%= errId %>"<% } %>>
      <legend><%= label %></legend>
      <div class="choice__opts">
        <% for (const option of ['si', 'no']) { %><label class="tick"><input type="radio" name="<%= cell.name %>" value="<%= option %>" data-clearable<% if (cell.value === option) { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= t(option === 'si' ? 'common.yes' : 'common.no') %></span></label>
        <% } %>
      </div>
      <% if (errText) { %><p class="field__error" id="<%= errId %>"><%= errText %></p><% } %>
    </fieldset>
    <% } else { %>
    <div class="field<%= col.key === 'piano' ? ' field--piano' : '' %>">
      <label class="field__label" for="<%= id %>"><%= label %></label>
      <% if (unit) { %><div class="unit"><% } %>
      <% if (col.kind === 'decimal') { %><input class="input" id="<%= id %>" name="<%= cell.name %>" type="text" inputmode="decimal" maxlength="10" autocomplete="off" value="<%= cell.value %>"<%- aria %>>
      <% } else { %><input class="input" id="<%= id %>" name="<%= cell.name %>" type="text" maxlength="<%= col.maxLength %>" autocomplete="off" value="<%= cell.value %>"<%- aria %>>
      <% } %>
      <% if (unit) { %><span class="unit__text" id="<%= unitId %>"><%= unit %></span></div><% } %>
      <% if (errText) { %><p class="field__error" id="<%= errId %>"><%= errText %></p><% } %>
    </div>
    <% } %><% } %>
  </div>
</fieldset>
