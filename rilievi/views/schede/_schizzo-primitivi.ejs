<%#
  Примитивите на един лист (src/schizzi/forme.ts) като елементи на SVG — листът на скицника (_schizzo.ejs) и
  анотациите върху снимка (_annotazioni.ejs). Всичко е проверено при запис; EJS екранира атрибутите и текста.
%><% for (const p of schizzoForme(foglio)) { %><% if (p.p === 'l') { %><path d="<%= p.d %>" stroke="<%= p.c %>" stroke-width="<%= p.w %>" fill="none" stroke-linecap="round" stroke-linejoin="round"<% if (p.k) { %> stroke-dasharray="<%= p.k[0] %> <%= p.k[1] %>"<% } %>/><% } else if (p.p === 'f') { %><path d="<%= p.d %>" fill="<%= p.c %>"/><% } else if (p.p === 'e') { %><ellipse cx="<%= p.x %>" cy="<%= p.y %>" rx="<%= p.rx %>" ry="<%= p.ry %>" stroke="<%= p.c %>" stroke-width="<%= p.w %>" fill="none" stroke-linecap="round"<% if (p.k) { %> stroke-dasharray="<%= p.k[0] %> <%= p.k[1] %>"<% } %>/><% } else { %><text x="<%= p.x %>" y="<%= p.y %>" fill="<%= p.c %>" font-size="<%= p.z %>" font-family="Fira Sans, sans-serif" font-weight="500"<% if (p.h !== 'start') { %> text-anchor="<%= p.h %>"<% } %><% if (p.a) { %> transform="rotate(<%= p.a %> <%= p.x %> <%= p.y %>)"<% } %>><%= p.v %></text><% } %><% } %>
