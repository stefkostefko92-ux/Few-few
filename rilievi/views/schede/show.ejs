<%
  const byKey = Object.fromEntries(sections.flatMap((s) => s.fields).map((f) => [f.key, f]));
%><%- include('../partials/top', { title: ident.length > 40 ? ident.slice(0, 39) + '…' : ident, scripts: ['allegati', 'carica', 'schizzo-intero'] }) %>
<div class="page-head">
  <div>
    <a href="/schede"><%= t('schede.back') %></a>
    <h1><%= ident %></h1>
    <p class="page-head__sub"><%= t('scheda.dateLine', { date: fmt.day(scheda.data) }) %></p>
  </div>
  <div class="toolbar toolbar--griglia">
    <% if (!scheda.deletedAt && canIn('schede:write', scheda.aziendaId)) { %><a class="btn btn--primary" href="/schede/<%= scheda.id %>/modifica"><%- include('../partials/icon', { name: 'edit' }) %><%= t('scheda.actions.edit') %></a><% } %>
    <a class="btn" href="/schede/<%= scheda.id %>/stampa?auto=1"><%- include('../partials/icon', { name: 'print' }) %><%= t('scheda.actions.print') %></a>
    <a class="btn" data-pdf href="/schede/<%= scheda.id %>/pdf"><%- include('../partials/icon', { name: 'download' }) %><%= t('scheda.actions.pdf') %></a>
    <% if (modifica) { %><a class="btn" href="#invia"><%- include('../partials/icon', { name: 'mail' }) %><%= t('scheda.actions.email') %></a><% } %>
    <a class="btn" href="/schede/<%= scheda.id %>/etichetta"><%- include('../partials/icon', { name: 'print' }) %><%= t('etichetta.apri') %></a>
    <%# Изчисленията за аргано и за ограничителя — не при хидравлична уредба (там аргано и раздел „Limitatore“ няма). %>
    <% if (!(scheda.tipoImpianto || []).includes('IDRAULICO')) { %><a class="btn" href="/schede/<%= scheda.id %>/calcolo-argano"><%- include('../partials/icon', { name: 'calc' }) %><%= t('argano.apri') %></a>
    <a class="btn" href="/schede/<%= scheda.id %>/calcolo-limitatore"><%- include('../partials/icon', { name: 'gauge' }) %><%= t('limitatore.apri') %></a><% } %>
    <% if (!scheda.deletedAt && canIn('interventi:write', scheda.aziendaId)) { %><a class="btn" href="/cartelli/nuovo?scheda=<%= scheda.id %>"><%- include('../partials/icon', { name: 'stop' }) %><%= t('cartelli.daScheda.crea') %></a><% } %>
    <% if (!scheda.deletedAt && canIn('interventi:write', scheda.aziendaId)) { %><a class="btn" href="/buoni/nuovo?scheda=<%= scheda.id %>"><%- include('../partials/icon', { name: 'buono' }) %><%= t('buoni.daScheda.crea') %></a><% } %>
    <% if (!scheda.deletedAt && scheda.azienda.preventiviAttivi && canIn('preventivi:write', scheda.aziendaId)) { %><a class="btn" href="/preventivi/nuovo?scheda=<%= scheda.id %>"><%- include('../partials/icon', { name: 'euro' }) %><%= t('preventivi.daScheda.crea') %></a><% } %>
    <% if (!scheda.deletedAt && canIn('interventi:write', scheda.aziendaId)) { %><a class="btn" href="/verbali/nuovo?scheda=<%= scheda.id %>"><%- include('../partials/icon', { name: 'sign' }) %><%= t('verbali.daScheda.crea') %></a><% } %>
    <% if (!scheda.deletedAt && canIn('schede:write', scheda.aziendaId)) { %><a class="btn" href="/schede/nuova?da=<%= scheda.id %>"><%- include('../partials/icon', { name: 'copy' }) %><%= t('flusso.duplica.azione') %></a><% } %>
    <% if (!scheda.deletedAt && canIn('schede:delete', scheda.aziendaId)) { %><a class="btn btn--ghost" href="/schede/<%= scheda.id %>/elimina"><%- include('../partials/icon', { name: 'trash' }) %><%= t('scheda.actions.delete') %></a><% } %>
  </div>
</div>
<div class="with-index">
<%- include('_index', { titles: sections.map((s) => ({ key: s.key, title: s.title })).concat(schizzi.length ? [{ key: 'schizzi', title: t('schizzi.title') }] : []) }) %>
<div class="sheet">
  <% if (scheda.deletedAt) { %>
  <div class="banner" role="status">
    <span><%= t('trash.banner', { at: fmt.dateTime(scheda.deletedAt), name: scheda.deletedBy ? scheda.deletedBy.name : '—' }) %></span>
    <% if (canIn('schede:trash', scheda.aziendaId)) { %><span class="toolbar">
      <form class="inline-form" method="post" action="/cestino/<%= scheda.id %>/ripristina"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm" type="submit"><%- include('../partials/icon', { name: 'restore' }) %><%= t('trash.restore') %></button></form>
      <a class="btn btn--sm btn--ghost" href="/cestino/<%= scheda.id %>/elimina"><%= t('trash.purge') %></a>
    </span><% } %>
  </div>
  <% } %>
  <% if (discrepanze.length) { %>
  <div class="notice notice--diff">
    <p><strong><%= t('collegati.banner') %></strong></p>
    <ul><% for (const d of discrepanze) { %><li><%- include('_discrepanza', { d }) %></li><% } %></ul>
  </div>
  <% } %>
  <%- include('../partials/plate', { byKey }) %>
  <% sections.forEach((section, index) => { %>
  <section class="sheet__section" id="s-<%= section.key %>" aria-labelledby="h-<%= section.key %>">
    <h2 class="sheet__title" id="h-<%= section.key %>"><span class="secnum" aria-hidden="true"><%= index + 1 %></span><%= section.title %></h2>
    <dl class="kv">
      <% for (const field of section.fields) { %><div class="kv__item<%= field.wide ? ' kv__item--wide' : '' %>">
        <dt><%= field.label %></dt>
        <% if (field.value) { %><dd><%= field.value %><% if (field.table) { %><%- include('_table', { table: field.table }) %><% } %><% if (field.modulo) { %>
          <span class="modulo-links"><span class="modulo-links__name"><%= field.modulo.nome %></span>
            <a class="btn btn--sm" data-pdf href="/schede/<%= scheda.id %>/<%= field.modulo.path %>"><%- include('../partials/icon', { name: 'download' }) %><%= t('ordini.download') %></a>
            <a class="btn btn--sm" data-pdf href="/schede/<%= scheda.id %>/<%= field.modulo.path %>?inline=1" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'print' }) %><%= t('ordini.print') %></a>
          </span><% } %></dd><% } else { %><dd class="empty-value">—</dd><% } %>
      </div>
      <% } %>
    </dl>
    <%- include('_allegati', { section, ritorno: 'scheda' }) %>
  </section>
  <% }) %>
  <%# Листовете на скицника — и когато фирмата вече го е изключила (нарисуваното остава). %>
  <% if (schizzi.length) { %>
  <section class="sheet__section" id="s-schizzi" aria-labelledby="h-schizzi">
    <h2 class="sheet__title" id="h-schizzi"><span class="secnum" aria-hidden="true"><%= sections.length + 1 %></span><%= t('schizzi.title') %></h2>
    <ol class="schizzi__fogli">
      <% schizzi.forEach((foglio, i) => { %><li class="schizzi__foglio"><figure class="schizzi__figura"><button class="schizzi__anteprima" type="button" data-schizzo-intero aria-label="<%= t('schizzi.apri', { n: i + 1 }) %>"><%- include('_schizzo', { foglio, titolo: t('schizzi.foglio', { n: i + 1 }) }) %></button><figcaption class="schizzi__nome"><%= t('schizzi.foglio', { n: i + 1 }) %></figcaption></figure></li>
      <% }) %>
    </ol>
    <%# Листът на цял екран (schizzo-intero.js): докосване на прегледа го показва тук, Esc или „Chiudi“ — обратно. %>
    <dialog class="schizzo-intero" data-schizzo-intero-vista aria-labelledby="schizzo-intero-titolo">
      <div class="schizzo-intero__testa">
        <h2 class="schizzo-intero__titolo" id="schizzo-intero-titolo"></h2>
        <button class="btn btn--sm" type="button" data-schizzo-intero-chiudi><%- include('../partials/icon', { name: 'close' }) %><%= t('schizzi.chiudiVista') %></button>
      </div>
      <div class="schizzo-intero__corpo" data-schizzo-intero-corpo></div>
      <p class="schizzo-intero__ruota"><%= t('schizzi.editor.ruota') %></p>
    </dialog>
  </section>
  <% } %>
  <% if (cartelli && cartelli.length) { %>
  <section class="cartelli-scheda" aria-labelledby="h-cartelli-scheda">
    <h2 class="section__title" id="h-cartelli-scheda"><%= t('cartelli.daScheda.dellaScheda') %></h2>
    <ul role="list">
      <% for (const c of cartelli) { %><li><a href="/cartelli/<%= c.id %>"><%= fmt.day(c.data) %></a><% if (c.ubicazione) { %> · <%= c.ubicazione %><% } %></li>
      <% } %>
    </ul>
  </section>
  <% } %>
  <% if (typeof buoni !== 'undefined' && buoni && buoni.length) { %>
  <section class="cartelli-scheda" aria-labelledby="h-buoni-scheda">
    <h2 class="section__title" id="h-buoni-scheda"><%= t('buoni.daScheda.dellaScheda') %></h2>
    <ul role="list">
      <% for (const b of buoni) { %><li><a href="/buoni/<%= b.id %>"><%= b.numero ? t('buoni.campo.numero') + ' ' + b.numero : t('buoni.senzaNumero') %></a> · <%= fmt.dayRoma(b.createdAt) %> · <%= b._count.firme === 0 ? t('buoni.firmeNessuna') : t('buoni.firmeN', { n: b._count.firme }) %></li>
      <% } %>
    </ul>
  </section>
  <% } %>
  <% if (typeof preventivi !== 'undefined' && preventivi && preventivi.length) { %>
  <section class="cartelli-scheda" aria-labelledby="h-preventivi-scheda">
    <h2 class="section__title" id="h-preventivi-scheda"><%= t('preventivi.daScheda.dellaScheda') %></h2>
    <ul role="list">
      <% for (const p of preventivi) { %><li><a href="/preventivi/<%= p.id %>"><%= t('preventivi.numero', { n: p.numero }) %></a> · <%= fmt.day(p.data) %> · <%= t('preventivi.stato.' + p.stato) %></li>
      <% } %>
    </ul>
  </section>
  <% } %>
  <% if (verbali && verbali.length) { %>
  <section class="cartelli-scheda" aria-labelledby="h-verbali-scheda">
    <h2 class="section__title" id="h-verbali-scheda"><%= t('verbali.daScheda.dellaScheda') %></h2>
    <ul role="list">
      <% for (const v of verbali) { %><li><a href="/verbali/<%= v.id %>"><%= fmt.day(v.data) %></a><% if (v.buono) { %> · <%= t('verbali.campo.buono') %> <%= v.buono %><% } %> · <%= t(v.confermatoAt ? 'verbali.stato.chiuso' : 'verbali.stato.bozza') %></li>
      <% } %>
    </ul>
  </section>
  <% } %>
  <% if (modifica) { %><%- include('_invia') %><% } %>
  <%- include('_flusso') %>
  <p class="sheet__meta">
    <% if (showAzienda) { %><span><%= t('scheda.field.azienda') %>: <%= scheda.azienda.name %></span><% } %>
    <span><%= t('scheda.meta.created', { name: scheda.createdBy ? scheda.createdBy.name : '—', at: fmt.dateTime(scheda.createdAt) }) %></span>
    <span><%= t('scheda.meta.updated', { name: scheda.updatedBy ? scheda.updatedBy.name : '—', at: fmt.dateTime(scheda.updatedAt) }) %></span>
    <% if (scheda._count.versioni > 0) { %><span><a href="/schede/<%= scheda.id %>/versioni"><%= t('flusso.versioni.link', { n: scheda._count.versioni }) %></a></span><% } %>
  </p>
</div>
<% if (modifica) { %><%- include('_allegati-forms', { ritorno: 'scheda' }) %><% } %>
</div>
<%- include('../partials/bottom') %>
