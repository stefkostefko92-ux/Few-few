<%
  // Индексът на разделите на картата — вляво на широк екран, с номерата от чертежа във витрината.
  // Връзките водят до `#s-<раздел>`; app.js само отбелязва раздела, който е на екрана.
%><nav class="secindex" aria-label="<%= t('scheda.index') %>" data-secindex>
  <p class="secindex__title"><%= t('scheda.index') %></p>
  <ol>
    <% titles.forEach((item, i) => { %><li><a href="#s-<%= item.key %>"><span class="secnum" aria-hidden="true"><%= i + 1 %></span><span><%= item.title %></span></a></li>
    <% }) %>
  </ol>
</nav>
