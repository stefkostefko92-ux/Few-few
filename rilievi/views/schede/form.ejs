<%
  const isEdit = scheda !== null;
  const action = isEdit ? '/schede/' + scheda.id : '/schede';
  const errorKeys = Object.keys(errors);
  const fieldMap = Object.fromEntries(sections.flatMap((s) => s.fields).map((f) => [f.key, f]));
  // Грешка в ред от мерките (`mb-<спирка>-<колона>`) — с името на колоната и номера на спирката.
  const labelOf = (key) => {
    if (key === identifiersErrorKey) return t('scheda.identifiers');
    if (key === 'riepilogoOrdini') return t('riepilogo.title');
    const moduloField = moduloFieldOf(key);
    if (moduloField) return t('ordini.errorLabel', { label: moduloField.field.label, fornitore: moduloField.slot.modulo.fornitore || moduloField.slot.modulo.titolo });
    const misura = misuraOf(key);
    if (misura) return t('scheda.misure.errorLabel', { col: t('scheda.misure.col.' + misura.column.key), n: misura.n });
    return t('scheda.field.' + key);
  };
  const anchorOf = (key) => key === identifiersErrorKey ? '#f-indirizzo' : '#f-' + key;
  const paramsOf = (key) => { const misura = misuraOf(key); const moduloField = moduloFieldOf(key); const f = misura ? misura.column : moduloField ? moduloField.field : (fieldMap[key] || {}); return { min: f.min, max: f.max, maxLength: f.maxLength }; };
%><%- include('../partials/top', { titleKey: isEdit ? 'schede.edit.title' : 'schede.create.title', scripts: ['valori', 'moduli', 'collegati'] }) %>
<div class="page-head">
  <div>
    <h1><%= t(isEdit ? 'schede.edit.title' : 'schede.create.title') %></h1>
    <p class="page-head__sub"><%= isEdit ? t('scheda.meta.updated', { name: scheda.updatedBy ? scheda.updatedBy.name : '—', at: fmt.dateTime(scheda.updatedAt) }) : t('schede.create.sub') %></p>
  </div>
</div>
<div class="stack-gap">
<% if (conflict) { %>
  <div class="notice" role="alert">
    <p><strong><%= t('schede.conflict.title') %></strong></p>
    <p><%= t('schede.conflict.text') %></p>
    <div class="toolbar"><a class="btn btn--sm" href="/schede/<%= scheda.id %>" target="_blank" rel="noopener"><%= t('schede.conflict.open') %></a></div>
  </div>
<% } %>
<% if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="<%= anchorOf(key) %>"><%= labelOf(key) %>: <%= t('scheda.error.' + errors[key], paramsOf(key)) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<% if (conferma && conferma.discrepanze.length) { %>
  <div class="notice notice--diff" role="alert" id="confirm-summary" tabindex="-1">
    <h2><%= t('collegati.conferma.title', { n: conferma.discrepanze.length }) %></h2>
    <p><%= t('collegati.conferma.text') %></p>
    <ul><% for (const d of conferma.discrepanze) { %><li><%- include('_discrepanza', { d }) %></li><% } %></ul>
  </div>
<% } %>
<% if (!isEdit && can('aziende:manage') && aziende.length === 0) { %>
<div class="empty">
  <p><strong><%= t('schede.noAziende') %></strong></p>
  <a class="btn btn--primary" href="/aziende/nuova"><%- include('../partials/icon', { name: 'plus' }) %><%= t('aziende.new') %></a>
</div>
<% } else { %>
<div class="with-index">
<%- include('_index', { titles: sections.map((s) => ({ key: s.key, title: t('scheda.section.' + s.key) })) }) %>
<form class="form" method="post" action="<%= action %>" novalidate data-scheda-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (!isEdit && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required<% if (errors[aziendaErrorKey]) { %> aria-invalid="true" aria-describedby="err-azienda"<% } %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors[aziendaErrorKey]) { %><p class="field__error" id="err-azienda"><%= t('scheda.error.azienda') %></p><% } %>
  </div>
  <% } else if (isEdit && showAzienda) { %>
  <p class="muted"><%= t('scheda.field.azienda') %>: <strong><%= scheda.azienda.name %></strong></p>
  <% } %>
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= conflict ? scheda.updatedAt.toISOString() : base %>"><% } %>
  <% sections.forEach((section, index) => { %>
  <fieldset class="section" id="s-<%= section.key %>">
    <legend class="section__title"><span class="secnum" aria-hidden="true"><%= index + 1 %></span><%= t('scheda.section.' + section.key) %></legend>
    <% if (section.key === 'impianto') { %><p class="field__hint<%= errors[identifiersErrorKey] ? ' field__error' : '' %>" id="identifiers-hint"><%= t('scheda.identifiersHint') %></p><% } %>
    <%# Разделът „Impianto“ е подреден като главата и табелата на листа (sheet.css, .grid--testa). %>
    <div class="grid<%= section.key === 'impianto' ? ' grid--testa' : '' %>">
      <% for (const field of section.fields) { %><%- include('_field', { field, value: values[field.key], error: errors[field.key] }) %>
      <% if (field.misure) { %><%- include('_misure') %><% } %>
      <% } %>
      <%# Модулите на доставчиците — в края на раздела си, след полетата на въпроса им (брой окачвания). %>
      <% for (const field of section.fields) { for (const slot of moduli.filter((s) => s.column === field.modulo)) { %><%- include('_modulo', { slot }) %><% } } %>
    </div>
  </fieldset>
  <% }) %>
  <fieldset class="section" id="s-riepilogo">
    <legend class="section__title"><%= t('riepilogo.title') %></legend>
    <div class="grid">
      <div class="field field--wide">
        <label class="tick"><input type="checkbox" id="f-riepilogoOrdini" name="riepilogoOrdini" value="1" aria-describedby="riepilogo-hint"<% if (values.riepilogoOrdini === '1') { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= t('riepilogo.label') %></span></label>
        <p class="field__hint" id="riepilogo-hint"><%= t('riepilogo.hint') %></p>
      </div>
    </div>
  </fieldset>
  <div class="actions">
    <button class="btn btn--inverse" type="submit"><%= t(isEdit ? 'schede.edit.submit' : 'schede.create.submit') %></button>
    <%# След „Salva“: Enter в поле натиска първия бутон на формата — никога потвърждението. %>
    <% if (conferma && conferma.discrepanze.length) { %><button class="btn btn--bar" type="submit" name="conferma" value="<%= conferma.impronta %>"><%= t('collegati.conferma.submit') %></button><% } %>
    <a class="btn btn--bar" href="<%= isEdit ? '/schede/' + scheda.id : '/schede' %>"><%= t('common.cancel') %></a>
    <span class="actions__hint" data-dirty-hint hidden><%= t('schede.unsaved') %></span>
  </div>
</form>
<script type="application/json" id="collegati-dati" nonce="<%= cspNonce %>"><%- collegati.json %></script>
</div>
<% } %>
</div>
<%- include('../partials/bottom') %>
