<%
  const statusText = query
    ? t('schede.search.found', { n: page.total, q: query })
    : t('schede.count', { n: page.total });
  const tipo = (row) => row.tipoImpianto.map((v) => t('scheda.option.tipoImpianto.' + v)).join(', ');
  const ident = (row) => row.numeroImpianto || row.matricola || row.indirizzo || fmt.day(row.data);
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (typeof aziendaFilter !== 'undefined' && aziendaFilter) params.set('azienda', aziendaFilter);
  const base = (typeof listBase !== 'undefined' ? listBase : '/schede') + (params.size ? '?' + params.toString() : '');
  const showAzienda = typeof aziende !== 'undefined' && aziende.length > 0;
  const inTrash = typeof trashMode !== 'undefined' && trashMode;
%><div data-status="<%= statusText %>">
<% if (page.rows.length === 0) { %>
  <div class="empty">
    <% if (query) { %>
      <p><strong><%= t('schede.search.none', { q: query }) %></strong></p>
      <p class="muted"><%= t('schede.search.tip') %></p>
    <% } else if (inTrash) { %>
      <p><strong><%= t('trash.empty') %></strong></p>
    <% } else { %>
      <p><strong><%= t('schede.empty') %></strong></p>
      <% if (can('schede:write')) { %><a class="btn btn--primary" href="/schede/nuova"><%- include('../partials/icon', { name: 'plus' }) %><%= t('schede.createFirst') %></a><% } %>
    <% } %>
  </div>
<% } else { %>
  <table class="table table--stack">
    <caption class="visually-hidden"><%= statusText %></caption>
    <thead>
      <tr>
        <th scope="col"><%= t('scheda.field.numeroImpianto') %></th>
        <th scope="col"><%= t('scheda.field.matricola') %></th>
        <th scope="col"><%= t('scheda.field.indirizzo') %></th>
        <th scope="col"><%= t('scheda.field.marca') %></th>
        <th scope="col"><%= t('scheda.field.tipoImpianto') %></th>
        <% if (showAzienda) { %><th scope="col"><%= t('scheda.field.azienda') %></th><% } %>
        <th scope="col"><%= inTrash ? t('trash.deletedAt') : t('scheda.field.data') %></th>
        <% if (inTrash) { %><th scope="col"><span class="visually-hidden"><%= t('common.actions') %></span></th><% } %>
      </tr>
    </thead>
    <tbody>
      <% for (const row of page.rows) { %><tr>
        <td class="num" data-label="<%= t('scheda.field.numeroImpianto') %>"><a class="row-link" href="/schede/<%= row.id %>" aria-label="<%= t('schede.openRow', { id: ident(row) }) %>"><%- include('_hl', { text: row.numeroImpianto, tokens: page.tokens }) %></a></td>
        <td class="num" data-label="<%= t('scheda.field.matricola') %>"><%- include('_hl', { text: row.matricola, tokens: page.tokens }) %></td>
        <td class="wide" data-label="<%= t('scheda.field.indirizzo') %>"><%- include('_hl', { text: row.indirizzo, tokens: page.tokens }) %></td>
        <td data-label="<%= t('scheda.field.marca') %>"><%- include('_hl', { text: row.marca, tokens: page.tokens }) %></td>
        <td data-label="<%= t('scheda.field.tipoImpianto') %>"><%= tipo(row) || '—' %></td>
        <% if (showAzienda) { %><td data-label="<%= t('scheda.field.azienda') %>"><%= row.azienda.name %></td><% } %>
        <td data-label="<%= inTrash ? t('trash.deletedAt') : t('scheda.field.data') %>"><%= inTrash ? fmt.dateTime(row.deletedAt) : fmt.day(row.data) %></td>
        <% if (inTrash) { %><td class="actions-cell" data-label="<%= t('common.actions') %>">
          <form class="inline-form" method="post" action="/cestino/<%= row.id %>/ripristina"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm" type="submit"><%- include('../partials/icon', { name: 'restore' }) %><%= t('trash.restore') %></button></form>
          <a class="btn btn--sm btn--ghost" href="/cestino/<%= row.id %>/elimina"><%= t('trash.purge') %></a>
        </td><% } %>
      </tr>
      <% } %>
    </tbody>
  </table>
  <%- include('../partials/pager', { base, page: page.page, pages: page.pages }) %>
<% } %>
</div>
