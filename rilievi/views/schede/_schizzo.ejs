<%#
  Лист от скицника като SVG (src/schizzi/): картата, печатът и прегледът във формата. Листът е бял като
  хартия и в тъмната тема, мрежата — бледа; после примитивите на елементите (src/schizzi/forme.ts) в реда,
  в който са нарисувани: линии (с пунктир), запълнени върхове на стрелки, елипси и надписи (завъртени —
  котите). Всичко е проверено при запис и е само от числа и написаното, а EJS екранира атрибутите и текста.
  `mini`: само елементите в кутия 120 × 120, без хартия — иконката на символ в редактора, скрита от четеца.
%><% const v = schizzoVista; const piccolo = typeof locals.mini !== 'undefined' && locals.mini; %><% if (piccolo) { %><svg class="schizzo-mini" viewBox="0 0 120 120" aria-hidden="true" focusable="false"><% } else { %><svg class="schizzo" viewBox="0 0 <%= v.larghezza %> <%= v.altezza %>" role="img" aria-label="<%= titolo %>"><rect width="<%= v.larghezza %>" height="<%= v.altezza %>" fill="#ffffff"/><path d="<%= v.griglia %>" stroke="<%= v.coloreGriglia %>" stroke-width="1" fill="none"/><% } %><% for (const p of schizzoForme(foglio)) { %><% if (p.p === 'l') { %><path d="<%= p.d %>" stroke="<%= p.c %>" stroke-width="<%= p.w %>" fill="none" stroke-linecap="round" stroke-linejoin="round"<% if (p.k) { %> stroke-dasharray="<%= p.k[0] %> <%= p.k[1] %>"<% } %>/><% } else if (p.p === 'f') { %><path d="<%= p.d %>" fill="<%= p.c %>"/><% } else if (p.p === 'e') { %><ellipse cx="<%= p.x %>" cy="<%= p.y %>" rx="<%= p.rx %>" ry="<%= p.ry %>" stroke="<%= p.c %>" stroke-width="<%= p.w %>" fill="none" stroke-linecap="round"<% if (p.k) { %> stroke-dasharray="<%= p.k[0] %> <%= p.k[1] %>"<% } %>/><% } else { %><text x="<%= p.x %>" y="<%= p.y %>" fill="<%= p.c %>" font-size="<%= p.z %>" font-family="Fira Sans, sans-serif" font-weight="500"<% if (p.h !== 'start') { %> text-anchor="<%= p.h %>"<% } %><% if (p.a) { %> transform="rotate(<%= p.a %> <%= p.x %> <%= p.y %>)"<% } %>><%= p.v %></text><% } %><% } %></svg>
