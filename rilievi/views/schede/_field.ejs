<%
  // Едно поле на схемата по вида му от src/schede/fields.ts. Грешката е до полето и в обобщението.
  // Поле с условие (`when`) носи data-when: app.js го скрива, докато условието не е изпълнено.
  const id = 'f-' + field.key;
  const errId = 'err-' + field.key;
  const unitId = 'u-' + field.key;
  const label = t((field.question ? 'scheda.question.' : 'scheda.field.') + field.key);
  const errText = error ? t('scheda.error.' + error, { min: field.min, max: field.max, maxLength: field.maxLength }) : null;
  const unit = field.unit ? t('scheda.unit.' + field.unit, { n: 2 }) : null;
  const describedBy = [unit ? unitId : null, errText ? errId : null].filter(Boolean).join(' ');
  const aria = (describedBy ? ' aria-describedby="' + describedBy + '"' : '') + (errText ? ' aria-invalid="true"' : '');
  const classes = 'field' + (field.wide ? ' field--wide' : '') + (field.kind === 'yesno' ? ' choice--compact' : '');
  const when = field.when ? ' data-when="' + field.when.field + '" data-when-values="' + field.when.values.join(' ') + '"' + (active.has(field.key) ? '' : ' data-off') : '';
  const list = Array.isArray(value) ? value : [];
  const text = typeof value === 'string' ? value : '';
  // Sì/No със свои думи и ред (`risposte`, „Accessi: 1 / 2“) — иначе Sì, No.
  const radios = field.kind === 'yesno' ? (field.risposte || ['si', 'no']) : field.kind === 'choice' ? field.options : [];
  const radioLabel = (option) => field.kind === 'yesno' && !field.risposte ? t(option === 'si' ? 'common.yes' : 'common.no') : t('scheda.option.' + field.key + '.' + option);
%><% if (field.kind === 'checks' || radios.length) { %>
<fieldset class="choice <%= classes %>" id="<%= id %>"<%- when %><% if (errText) { %> aria-describedby="<%= errId %>"<% } %>>
  <legend><%= label %></legend>
  <div class="choice__opts">
    <% if (field.kind === 'checks') { %><% for (const option of field.options) { %>
    <label class="tick"><input type="checkbox" name="<%= field.key %>" value="<%= option %>"<% if (list.includes(option)) { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= t('scheda.option.' + field.key + '.' + option) %></span></label>
    <% } %><% } else { %><% for (const option of radios) { %>
    <label class="tick"><input type="radio" name="<%= field.key %>" value="<%= option %>" data-clearable<% if (text === option) { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= radioLabel(option) %></span></label>
    <% } %><% } %>
  </div>
  <% if (errText) { %><p class="field__error" id="<%= errId %>"><%= errText %></p><% } %>
</fieldset>
<% } else { %>
<div class="<%= classes %>"<%- when %>>
  <label class="field__label" for="<%= id %>"><%= label %></label>
  <% if (unit) { %><div class="unit<%= unit.length > 3 ? ' unit--long' : '' %>"><% } %>
  <% if (field.kind === 'textarea') { %><textarea class="textarea" id="<%= id %>" name="<%= field.key %>" rows="4" maxlength="<%= field.maxLength %>"<%- aria %>><%= text %></textarea>
  <% } else if (field.kind === 'date') { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="date" required min="1950-01-01" max="2099-12-31" value="<%= text %>"<%- aria %>>
  <% } else if (field.kind === 'digits') { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="<%= field.maxLength %>" autocomplete="off" value="<%= text %>"<%- aria %>>
  <% } else if (field.kind === 'int' && field.min < 0) { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="number" step="1" min="<%= field.min %>" max="<%= field.max %>" autocomplete="off" value="<%= text %>"<%- aria %>>
  <% } else if (field.kind === 'int') { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="9" autocomplete="off" value="<%= text %>"<%- aria %>>
  <% } else if (field.kind === 'decimal') { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="text" inputmode="decimal" maxlength="10" autocomplete="off" value="<%= text %>"<%- aria %>>
  <% } else { %><input class="input" id="<%= id %>" name="<%= field.key %>" type="text" maxlength="<%= field.maxLength %>" autocomplete="off" value="<%= text %>"<%- aria %>>
  <% } %>
  <% if (unit) { %><span class="unit__text" id="<%= unitId %>"><%= unit %></span></div><% } %>
  <% if (errText) { %><p class="field__error" id="<%= errId %>"><%= errText %></p><% } %>
</div>
<% } %>
