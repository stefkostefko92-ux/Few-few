<%
  const logoUrl = azienda.logoType ? '/aziende/' + azienda.id + '/logo?v=' + (azienda.logoUpdatedAt ? azienda.logoUpdatedAt.getTime() : 0) : null;
%><%- include('../partials/top', { title: azienda.name, narrowMain: true }) %>
<div class="page-head">
  <div>
    <a href="/aziende"><%= t('aziende.back') %></a>
    <h1><%= azienda.name %></h1>
    <p class="page-head__sub"><% if (azienda.deactivatedAt) { %><span class="badge badge--off"><%= t('aziende.deactivated') %></span><% } else { %><span class="badge"><%= t('aziende.active') %></span><% } %></p>
  </div>
</div>
<div class="stack-gap">
  <% if (error) { %><div class="errors" role="alert" id="form-error" tabindex="-1"><h2><%= t(error) %></h2></div><% } %>
  <div class="toolbar">
    <% if (!azienda.deactivatedAt) { %><a class="btn btn--primary" href="/utenti/invita?azienda=<%= azienda.id %>"><%- include('../partials/icon', { name: 'plus' }) %><%= t('aziende.inviteHere') %></a><% } %>
    <a class="btn" href="/utenti?azienda=<%= azienda.id %>"><%= t('aziende.usersHere') %></a>
    <a class="btn" href="/schede?azienda=<%= azienda.id %>"><%= t('aziende.schedeHere') %></a>
  </div>
  <section aria-labelledby="h-name">
    <h2 class="section__title" id="h-name"><%= t('aziende.name') %></h2>
    <form class="row-form" method="post" action="/aziende/<%= azienda.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="visually-hidden" for="name"><%= t('aziende.name') %></label>
        <input class="input" id="name" name="name" type="text" required minlength="2" maxlength="120" autocomplete="organization" value="<%= azienda.name %>"<% if (error === 'aziende.error.name' || error === 'aziende.error.nameTaken') { %> aria-invalid="true" aria-describedby="form-error"<% } %>>
      </div>
      <button class="btn" type="submit"><%= t('aziende.rename') %></button>
    </form>
  </section>
  <section aria-labelledby="h-logo">
    <h2 class="section__title" id="h-logo"><%= t('aziende.logo') %></h2>
    <% if (logoUrl) { %>
    <div class="logo-paper"><img src="<%= logoUrl %>" alt="<%= t('aziende.logoAlt', { name: azienda.name }) %>" width="<%= azienda.logoWidth %>" height="<%= azienda.logoHeight %>"></div>
    <% } else { %>
    <p class="muted"><%= t('aziende.logoNone') %></p>
    <% } %>
    <form class="form form--tight" method="post" action="/aziende/<%= azienda.id %>/logo" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="logo"><%= t(logoUrl ? 'aziende.logoReplace' : 'aziende.logoUpload') %></label>
        <input class="file-input" id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" required aria-describedby="logo-hint"<% if (error && error.startsWith('aziende.error.logo')) { %> aria-invalid="true"<% } %>>
        <p class="field__hint" id="logo-hint"><%= t('aziende.logoHint', { kb: maxKb }) %></p>
      </div>
      <div class="toolbar"><button class="btn" type="submit"><%= t(logoUrl ? 'aziende.logoReplace' : 'aziende.logoUpload') %></button></div>
    </form>
    <% if (logoUrl) { %>
    <form method="post" action="/aziende/<%= azienda.id %>/logo/rimuovi"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="toolbar"><button class="btn btn--ghost" type="submit"><%- include('../partials/icon', { name: 'trash' }) %><%= t('aziende.logoRemove') %></button></div></form>
    <% } %>
  </section>
  <%# Функциите по избор: офертите (C1) — включва ги само MASTER; изключени, нищо не се трие. %>
  <section aria-labelledby="h-preventivi">
    <h2 class="section__title" id="h-preventivi"><%= t('aziende.preventivi.title') %></h2>
    <p><strong><%= t(azienda.preventiviAttivi ? 'aziende.preventivi.attivi' : 'aziende.preventivi.spenti') %></strong></p>
    <p class="muted"><%= t('aziende.preventivi.text') %></p>
    <% if (!azienda.preventiviAttivi && azienda.preventiviArchivio) { %><p class="notice notice--sopra"><%= t('aziende.preventivi.archivio') %></p><% } %>
    <form method="post" action="/aziende/<%= azienda.id %>/preventivi">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="attivi" value="<%= azienda.preventiviAttivi ? '0' : '1' %>">
      <div class="toolbar"><button class="btn" type="submit"><%= t(azienda.preventiviAttivi ? 'aziende.preventivi.disattiva' : 'aziende.preventivi.attiva') %></button></div>
    </form>
  </section>
  <%# Абонаментът, зададен на ръка от MASTER (routes/aziende-abbonamento.ts) — за плащания извън Revolut. %>
  <% const ab = abbonamento; const livelloForm = ab.stato.poi ? ab.stato.poi.livello : ab.stato.livello; const datafine = ab.stato.fino ? fmt.dayRoma(new Date(ab.stato.fino.getTime() - 1)) : ''; %>
  <section aria-labelledby="h-abbonamento">
    <h2 class="section__title" id="h-abbonamento"><%= t('abbonamento.master.titolo') %></h2>
    <p><strong><%= t('abbonamento.stato.' + ab.stato.tipo + '.titolo', { data: datafine, livello: ab.stato.livello || '' }) %></strong></p>
    <% if (ab.stato.poi) { %><p><%= t('abbonamento.poi', { livello: ab.stato.poi.livello, dal: fmt.dayRoma(ab.stato.poi.dal), data: fmt.dayRoma(new Date(ab.stato.poi.fino.getTime() - 1)) }) %></p><% } %>
    <p class="muted"><%= t('abbonamento.master.testo') %></p>
    <form class="row-form" method="post" action="/aziende/<%= azienda.id %>/abbonamento" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="base" value="<%= azienda.abbonamentoFino ? azienda.abbonamentoFino.toISOString() : '' %>">
      <div class="field">
        <label class="field__label" for="abb-livello"><%= t('abbonamento.master.livello') %></label>
        <select class="select" id="abb-livello" name="livello">
          <option value=""<% if (!livelloForm) { %> selected<% } %>><%= t('abbonamento.master.nessuno') %></option>
          <% for (const l of ab.livelli) { %><option value="<%= l.n %>"<% if (livelloForm === l.n) { %> selected<% } %>><%= t('abbonamento.master.opzione', { n: l.n, persone: l.max === null ? t('abbonamento.livelli.breveOltre', { n: 25 }) : t('abbonamento.livelli.breveFino', { n: l.max }) }) %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="abb-fino"><%= t('abbonamento.master.fino') %></label>
        <input class="input" id="abb-fino" name="fino" type="date" value="<%= ab.ultimoGiorno %>">
      </div>
      <label class="tick"><input type="checkbox" name="confermo" value="1"><span class="tick__box" aria-hidden="true"></span><span><%= t('abbonamento.master.confermo') %></span></label>
      <button class="btn" type="submit"><%= t('abbonamento.master.salva') %></button>
    </form>
  </section>
  <section aria-labelledby="h-access">
    <h2 class="section__title" id="h-access"><%= t('aziende.accessTitle') %></h2>
    <p class="muted"><%= t(azienda.deactivatedAt ? 'aziende.reactivateText' : 'aziende.deactivateText', { days: giorniPrimaEliminazione }) %></p>
    <form method="post" action="/aziende/<%= azienda.id %>/stato">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="active" value="<%= azienda.deactivatedAt ? '1' : '0' %>">
      <div class="toolbar"><button class="btn<%= azienda.deactivatedAt ? '' : ' btn--danger' %>" type="submit"><%= t(azienda.deactivatedAt ? 'aziende.reactivate' : 'aziende.deactivate') %></button></div>
    </form>
  </section>
  <%# Краят на услугата: износът винаги; изтриването — само на деактивирана фирма, с името ѝ. %>
  <section aria-labelledby="h-fine">
    <h2 class="section__title" id="h-fine"><%= t('aziende.fine.title') %></h2>
    <p class="muted"><%= t('aziende.fine.esportaText') %></p>
    <form class="form form--tight" method="post" action="/aziende/<%= azienda.id %>/esporta" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="f-esporta-password"><%= t('esportazione.scarica.password') %></label>
        <input class="input" id="f-esporta-password" name="password" type="password" autocomplete="current-password" required<% if (error === 'esportazione.errore.password') { %> aria-invalid="true" aria-describedby="form-error"<% } %>>
      </div>
      <div class="toolbar"><button class="btn" type="submit"><%- include('../partials/icon', { name: 'download' }) %><%= t('aziende.fine.esporta') %></button></div>
    </form>
    <% if (eliminaIl) { %>
    <p><strong><%= t('aziende.fine.eliminaIl', { date: fmt.day(eliminaIl) }) %></strong> <%= t('aziende.fine.eliminaText', { days: giorniPrimaEliminazione }) %></p>
    <form class="form form--tight" method="post" action="/aziende/<%= azienda.id %>/elimina" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="fine-conferma"><%= t('aziende.fine.conferma', { name: azienda.name }) %></label>
        <input class="input" id="fine-conferma" name="conferma" type="text" autocomplete="off" required maxlength="120"<% if (error === 'aziende.error.eliminaNome') { %> aria-invalid="true" aria-describedby="form-error"<% } %>>
      </div>
      <div class="toolbar"><button class="btn btn--danger" type="submit"><%= t('aziende.fine.elimina') %></button></div>
    </form>
    <% } else { %>
    <p class="muted"><%= t('aziende.fine.soloDisattivata', { days: giorniPrimaEliminazione }) %></p>
    <% } %>
  </section>
</div>
<%- include('../partials/bottom') %>
