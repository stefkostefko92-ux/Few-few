<%
  // Формата на черновата на листа за интервенция — разделите като хартиения блок: главата, петте групи с
  // точките (кутийка, номер, текстът, празното място на реда като поле), „Altro“ с пробите и часовете.
  // Подписите не са тук: слагат се на страницата „Firma e conferma“ върху окончателния лист (firma.ejs).
  const isEdit = intervento !== null;
  const action = isEdit ? '/interventi/' + intervento.id : '/interventi';
  const errorKeys = Object.keys(errors);
  const vocePrefixes = ['v-', 'q-', 'c-'];
  const labelOf = (key) => {
    if (key === 'azienda') return t('scheda.field.azienda');
    if (vocePrefixes.includes(key.slice(0, 2))) return t('interventi.voce', { n: key.slice(2) });
    return t('interventi.campo.' + key);
  };
  const maxOf = (key) => key.startsWith('q-') ? maxCampo[gruppi.flatMap((g) => g.voci).find((v) => codice(v.n) === key.slice(2))?.campo || 'n'] : { indirizzo: 200, citta: 120, tecnici: 300, matricola: 40, altro: 1000 }[key];
  const messageOf = (key) => key === 'data' && errors[key] === 'required' ? t('interventi.dataMancante') : t('scheda.error.' + errors[key], { maxLength: maxOf(key), min: 0, max: 9999 });
  const anchorOf = (key) => '#f-' + key;
  const str = (key) => typeof values[key] === 'string' ? values[key] : '';
  const list = (key) => Array.isArray(values[key]) ? values[key] : [];
  const campo = (key, label, kind, maxLength, extra = {}) => include('_campo', { key, label, kind, maxLength, values, errors, ...extra });
%><%- include('../partials/top', { titleKey: 'interventi.new', title: typeof title !== 'undefined' ? title : undefined, scripts }) %>
<div class="page-head">
  <div>
    <a href="<%= isEdit ? '/interventi/' + intervento.id : '/interventi' %>"><%= t('interventi.indietro') %></a>
    <h1><%= t('interventi.titolo') %><% if (numero) { %> <span class="intervento__num">n. <%= numero %></span><% } %></h1>
    <p class="page-head__sub"><%= numero ? t('interventi.servizio') : t('interventi.numeroNuovo') %></p>
  </div>
</div>
<div class="stack-gap">
<% if (typeof conflict !== 'undefined' && conflict) { %>
  <div class="notice" role="alert"><p><strong><%= t('interventi.flash.conflitto') %></strong></p></div>
<% } %>
<% if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="<%= anchorOf(key) %>"><%= labelOf(key) %>: <%= messageOf(key) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<form class="form intervento-form" method="post" action="<%= action %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= base %>"><% } %>
  <% if (!isEdit && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required<% if (errors.azienda) { %> aria-invalid="true" aria-describedby="err-azienda"<% } %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors.azienda) { %><p class="field__error" id="err-azienda"><%= t('scheda.error.azienda') %></p><% } %>
  </div>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('interventi.sezione.testata') %></legend>
    <div class="grid">
      <%- campo('data', t('interventi.campo.data'), 'date') %>
      <fieldset class="choice field" id="f-turno">
        <legend><%= t('interventi.campo.turno') %></legend>
        <div class="choice__opts">
          <% for (const turno of turni) { %><label class="tick"><input type="radio" name="turno" value="<%= turno %>" data-clearable<% if (str('turno') === turno) { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= t('interventi.turno.' + turno) %></span></label>
          <% } %>
        </div>
      </fieldset>
      <%- campo('indirizzo', t('interventi.campo.indirizzo'), 'text', 200, { wide: true, autocomplete: 'street-address' }) %>
      <%- campo('citta', t('interventi.campo.citta'), 'text', 120, { autocomplete: 'address-level2' }) %>
      <%- campo('matricola', t('interventi.campo.matricola'), 'text', 40) %>
      <%- campo('tecnici', t('interventi.campo.tecnici'), 'textarea', 300, { wide: true }) %>
    </div>
  </fieldset>

  <p class="voci__lead"><%= t('interventi.eseguite') %></p>
  <% for (const gruppo of gruppi) { %>
  <fieldset class="section voci">
    <legend class="section__title"><%= gruppo.titolo %></legend>
    <ul class="voci__list">
      <% for (const voce of gruppo.voci) {
           const key = codice(voce.n);
           const [prima, dopo] = voce.testo.split('{q}');
           const errQ = errors['q-' + key]; %>
      <li class="voce">
        <label class="tick voce__tick"><input type="checkbox" id="f-v-<%= key %>" name="v-<%= key %>" value="si"<% if (str('v-' + key) === 'si') { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><b class="voce__n"><%= key %></b> <%= prima.trim() %></span></label>
        <% if (voce.campo) { %><input class="input voce__q<%= voce.campo === 'testo' ? ' voce__q--testo' : '' %>" id="f-q-<%= key %>" name="q-<%= key %>" type="text" maxlength="<%= maxCampo[voce.campo] %>" autocomplete="off"<% if (voce.campo === 'n') { %> inputmode="decimal"<% } %> value="<%= str('q-' + key) %>" aria-label="<%= t('interventi.campo.quantita', { n: key }) %>"<% if (errQ) { %> aria-invalid="true"<% } %> data-voce="<%= key %>"><% } %>
        <% if (dopo && dopo.trim()) { %><span class="voce__dopo"><%= dopo.trim() %></span><% } %>
        <% for (const scelta of voce.scelte || []) { %><label class="tick tick--sm voce__scelta"><input type="checkbox" name="c-<%= key %>" value="<%= scelta %>"<% if (list('c-' + key).includes(scelta)) { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= scelta %></span></label><% } %>
      </li>
      <% } %>
    </ul>
  </fieldset>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('interventi.sezione.altro') %></legend>
    <div class="grid">
      <%- campo('altro', t('interventi.campo.altro'), 'textarea', 1000, { wide: true }) %>
      <div class="field field--wide"><label class="tick"><input type="checkbox" id="f-prove" name="prove" value="si"<% if (str('prove') === 'si') { %> checked<% } %>><span class="tick__box" aria-hidden="true"></span><span><%= t('interventi.campo.prove') %></span></label></div>
      <%- campo('oreTecnico', t('interventi.campo.oreTecnico'), 'decimal') %>
      <%- campo('oreTotali', t('interventi.campo.oreTotali'), 'decimal') %>
    </div>
  </fieldset>

  <div class="actions">
    <button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('interventi.salva') %></button>
    <a class="btn btn--ghost" href="<%= isEdit ? '/interventi/' + intervento.id : '/interventi' %>"><%= t('common.cancel') %></a>
  </div>
</form>
</div>
<%- include('../partials/bottom') %>
