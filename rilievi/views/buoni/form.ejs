<%
  // Формата на „Buono di lavoro“ — разделите като хартиения лист: общите данни, редовете с работа (колкото
  // трябват — routes/buoni.ts дава записаните и още няколко празни), шестте проверки, отчетът и фамилиите на
  // техниците. Подписите по редовете и проверките — по избор, тук; подписите долу — на страницата на листа.
  const isEdit = buono !== null;
  const action = isEdit ? '/buoni/' + buono.id : '/buoni';
  const errorKeys = Object.keys(errors);
  const str = (key) => typeof values[key] === 'string' ? values[key] : '';
  const aria = (key) => errors[key] ? ' aria-invalid="true" aria-describedby="err-' + key + '"' : '';
  const posizione = (i) => righe.indexOf(i) + 1;
  const labelOf = (key) => {
    if (key === 'azienda') return t('scheda.field.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.titolo');
    if (key === 'firme' || key === 'sequenze') return t('buoni.campo.sequenze');
    let m = /^seq-(\d+)-(\w+)$/.exec(key);
    if (m) return t('buoni.riga.titolo', { n: posizione(Number(m[1])) || Number(m[1]) + 1 }) + ' — ' + t('buoni.riga.' + m[2]);
    m = /^ctl-(\w+)-(\w+)$/.exec(key);
    if (m) return t('buoni.controllo.' + m[1]) + ' — ' + t('buoni.controllo.' + m[2]);
    return t('buoni.campo.' + key);
  };
  const MAXLEN = { numero: max.numero, geometra: max.geometra, ordine: max.ordine, offerta: max.offerta, matricola: max.matricola, ubicazione: max.ubicazione, note: max.note, noteControlli: max.noteControlli, sospensioni: max.sospensioni, tecnici: max.tecnici };
  const messageOf = (key) => {
    const code = errors[key];
    if (key === 'azienda') return t('scheda.error.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.nonDisponibile');
    if (key === 'sequenze') return t('buoni.errore.sequenze', { n: maxSequenze });
    if (code === 'range') return t('buoni.errore.range');
    if (key === 'firme' || key.endsWith('-firma')) return t('buoni.errore.' + code);
    if (/^ctl-\w+-esito$/.test(key) && code === 'required') return t('buoni.errore.esitoFirma');
    const m = /^seq-\d+-(\w+)$/.exec(key);
    const maxLength = m ? max[m[1]] : MAXLEN[key];
    return t('scheda.error.' + code, { maxLength });
  };
  const anchorOf = (key) => {
    if (key === 'firme' || key === 'sequenze') return 'sequenze';
    return 'f-' + key;
  };
  const campo = (key, tipo, wide) => include('_campo', { key, tipo, wide: !!wide, maxLength: MAXLEN[key], valore: str(key), errore: errors[key] ? messageOf(key) : '' });
  const testo = (key) => campo(key, 'textarea', true);
  const collegata = isEdit ? buono.scheda : null;
  const rigaVuota = { values: {}, errors: {}, firmata: null, messageOf, max };
%><%- include('../partials/top', { titleKey: isEdit ? 'buoni.modifica' : 'buoni.new', narrowMain: true, scripts }) %>
<div class="page-head">
  <div>
    <a href="<%= isEdit ? '/buoni/' + buono.id : '/buoni' %>"><%= isEdit ? t('buoni.torna') : t('buoni.indietro') %></a>
    <h1><%= isEdit ? t('buoni.titolo') : t('buoni.new') %></h1>
    <% if (isEdit) { %><p class="page-head__sub"><%= buono.azienda.name %><%= buono.numero ? ' · ' + t('buoni.campo.numero') + ' ' + buono.numero : '' %></p><% } %>
  </div>
</div>
<div class="stack-gap">
<% if (typeof conflict !== 'undefined' && conflict) { %>
  <div class="notice" role="alert"><p><strong><%= t('buoni.flash.conflitto') %></strong></p></div>
<% } %>
<% if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="#<%= anchorOf(key) %>"><%= labelOf(key) %>: <%= messageOf(key) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<% if (!isEdit && (puoCercare || scheda)) { %><%- include('../cartelli/_da-scheda', { daSchedaNuovo: '/buoni/nuovo', daSchedaTesti: 'buoni' }) %><% } %>
<% if (collegata && !collegata.deletedAt) { %><p class="muted"><%= t('cartelli.daScheda.collegato', { nome: [collegata.matricola ? t('cartelli.daScheda.matricola', { m: collegata.matricola }) : '', collegata.numeroImpianto ? t('cartelli.daScheda.numero', { n: collegata.numeroImpianto }) : ''].filter(Boolean).join(' · ') || '—' }) %></p><% } %>
<form class="form buono-form" method="post" action="<%= action %>" novalidate>
  <%# Enter в поле натиска първия бутон на формата: той е „Salva“, не „Togli la firma“ на някой ред. %>
  <button class="visually-hidden" type="submit" tabindex="-1" aria-hidden="true"><%= t('buoni.salva') %></button>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= base %>"><% } %>
  <% if (!isEdit && scheda) { %><input type="hidden" name="scheda" value="<%= scheda.id %>"><% } %>
  <% if (!isEdit && !scheda && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required<%- aria('azienda') %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors.azienda) { %><p class="field__error" id="err-azienda"><%= messageOf('azienda') %></p><% } %>
  </div>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('buoni.sezione.dati') %></legend>
    <div class="grid">
      <%- campo('numero', 'text') %>
      <%- campo('dataConferma', 'date') %>
      <%- campo('geometra', 'text') %>
      <%- campo('ordine', 'text') %>
      <%- campo('offerta', 'text') %>
      <%- campo('inizioPrevisto', 'date') %>
      <%- campo('finePrevista', 'date') %>
      <%- campo('matricola', 'text') %>
      <%- campo('ubicazione', 'text', true) %>
      <div class="field field--wide buono-pos">
        <%- include('_scelta', { name: 'pos', legend: t('buoni.campo.pos'), opzioni: [{ value: 'si', label: t('buoni.si') }, { value: 'no', label: t('buoni.no') }], message: errors.pos ? messageOf('pos') : '' }) %>
        <p class="buono-pos__nota"><%= t('buoni.posNota') %></p>
      </div>
      <%- testo('note') %>
    </div>
  </fieldset>

  <fieldset class="section" id="sequenze">
    <legend class="section__title"><%= t('buoni.sezione.sequenze') %></legend>
    <p class="field__hint"><%= t('buoni.firma.facoltative') %></p>
    <div class="buono-righe" data-buono-righe data-max="<%= maxSequenze %>" data-prossimo="<%= prossimo %>">
      <% righe.forEach((i, pos) => {
           const id = str('seq-' + i + '-id');
           const firmata = id ? (firme.get(postoRiga(id)) || null) : null; %>
      <%- include('_riga', { i, n: pos + 1, firmata, messageOf, max }) %>
      <% }) %>
    </div>
    <p class="field__hint" data-buono-senza-js><%= t('buoni.riga.hint') %></p>
    <button class="btn" type="button" data-buono-aggiungi hidden><%- include('../partials/icon', { name: 'plus' }) %><%= t('buoni.riga.aggiungi') %></button>
    <template data-buono-modello><%- include('_riga', { ...rigaVuota, i: '__i__', n: '__n__' }) %></template>
  </fieldset>

  <fieldset class="section">
    <legend class="section__title"><%= t('buoni.sezione.controlli') %></legend>
    <% let gruppo = 'generale'; for (const c of controlli) { %>
    <% if (c.gruppo !== gruppo) { gruppo = c.gruppo; %><h3 class="buono-gruppo"><%= t('buoni.controllo.gruppoQuadro') %></h3><% } %>
    <%- include('_controllo', { c, firmata: firme.get(postoControllo(c.key)) || null, messageOf }) %>
    <% } %>
    <div class="grid"><%- testo('noteControlli') %></div>
  </fieldset>

  <fieldset class="section">
    <legend class="section__title"><%= t('buoni.sezione.resoconto') %></legend>
    <div class="grid">
      <%- campo('inizioLavori', 'date') %>
      <%- campo('inizioOra', 'time') %>
      <%- campo('fineLavori', 'date') %>
      <%- campo('fineOra', 'time') %>
      <%- testo('sospensioni') %>
      <%- campo('tecnici', 'text', true) %>
    </div>
    <p class="field__hint"><%= t('buoni.firma.finaliHint') %></p>
  </fieldset>

  <div class="actions">
    <button class="btn btn--inverse" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('buoni.salva') %></button>
    <a class="btn btn--bar" href="<%= isEdit ? '/buoni/' + buono.id : '/buoni' %>"><%= t('common.cancel') %></a>
  </div>
</form>
</div>
<%- include('../partials/bottom') %>
