<%
  // Шаблонът на табелата „Avviso di fermo impianto“ (src/cartelli/modelli.ts): картинката на всеки е
  // самата табела с логото и данните на фирмата горе (cartelli/vista.ts); отметнат е избраният.
%><section aria-labelledby="h-cartello">
  <h2 class="section__title" id="h-cartello"><%= t('impostazioni.cartello.title') %></h2>
  <p class="muted"><%= t('impostazioni.cartello.text') %></p>
  <% if (!azienda.logoType) { %><p class="field__hint"><% if (can('aziende:manage')) { %><a href="/aziende/<%= encodeURIComponent(azienda.id) %>"><%= t('impostazioni.cartello.mancaLogoMaster') %></a><% } else { %><%= t('impostazioni.cartello.mancaLogo') %><% } %></p><% } %>
  <form method="post" action="/impostazioni/cartello">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="azienda" value="<%= azienda.id %>">
    <fieldset class="modelli">
      <legend class="visually-hidden"><%= t('impostazioni.cartello.title') %></legend>
      <% for (const item of modelli) { %><label class="modelli__item">
        <input type="radio" name="modello" value="<%= item.id %>"<% if (item.id === modello) { %> checked<% } %>>
        <img class="modelli__img" src="/impostazioni/cartello/anteprima/<%= item.id %>.webp?azienda=<%= encodeURIComponent(azienda.id) %>" width="<%= item.width %>" height="<%= item.height %>" alt="<%= t('impostazioni.cartello.anteprimaAlt', { titolo: item.titolo }) %>" loading="lazy">
        <span class="modelli__nome"><span class="modelli__dot" aria-hidden="true"></span><%= item.titolo %><% if (item.id === modello) { %> <span class="stato stato--chiuso"><%= t('impostazioni.cartello.inUso') %></span><% } %></span>
      </label>
      <% } %>
    </fieldset>
    <div class="toolbar">
      <button class="btn btn--primary" type="submit"><%= t('impostazioni.cartello.save') %></button>
    </div>
  </form>
</section>
