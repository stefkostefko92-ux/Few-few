<%
  // „Abbonamento“ (routes/impostazioni-abbonamento.ts): състоянието, заетите места и нивата по брой хора.
  const ab = abbonamento;
  const s = ab.stato;
  const data = ab.ultimoGiorno ? fmt.dayRoma(ab.ultimoGiorno) : '';
  const occupati = ab.posti.membri + ab.posti.inviti;
%><section class="abbonamento" aria-labelledby="h-abbonamento">
  <h2 class="section__title" id="h-abbonamento"><%= t('impostazioni.pagine.abbonamento.titolo') %></h2>
  <div class="<%= s.solaLettura ? 'errors' : 'notice' %>" role="status">
    <p><strong><%= t('abbonamento.stato.' + s.tipo + '.titolo', { data, livello: s.livello || '' }) %></strong></p>
    <% if (!s.poi) { %><p><%= t('abbonamento.stato.' + s.tipo + '.testo', { data }) %></p><% } %>
    <% if (s.poi) { %><p><strong><%= t('abbonamento.poi', { livello: s.poi.livello, dal: fmt.dayRoma(s.poi.dal), data: fmt.dayRoma(new Date(s.poi.fino.getTime() - 1)) }) %></strong></p><% } %>
    <% if (s.solaLettura) { %><div class="toolbar"><a class="btn" href="/impostazioni/esportazione?azienda=<%= encodeURIComponent(azienda.id) %>"><%- include('../partials/icon', { name: 'download' }) %><span><%= t('abbonamento.esporta') %></span></a></div><% } %>
  </div>
  <dl class="kv">
    <div class="kv__item"><dt><%= t('abbonamento.persone') %></dt><dd><%= s.maxPersone === null ? t('abbonamento.postiSenzaLimite', { n: occupati }) : t('abbonamento.posti', { n: occupati, max: s.maxPersone }) %></dd></div>
    <% if (ab.posti.inviti > 0) { %><div class="kv__item"><dt><%= t('abbonamento.invitiAttesa') %></dt><dd><%= ab.posti.inviti %></dd></div><% } %>
  </dl>
  <h3><%= t('abbonamento.livelli.titolo') %></h3>
  <ul class="abbonamento-livelli">
    <% for (const l of ab.livelli) { %><li<% if (s.livello === l.n) { %> aria-current="true"<% } %>><strong><%= t('abbonamento.livello', { n: l.n }) %></strong> — <%= l.max === null ? t('abbonamento.livelli.oltre', { n: 25 }) : t('abbonamento.livelli.fino', { n: l.max }) %></li>
    <% } %>
  </ul>
  <% if (ab.piani) { %><h3 id="h-piani"><%= t('pagamenti.piani.titolo') %></h3>
  <p class="muted"><%= t('pagamenti.piani.intro') %></p>
  <% if (ab.piani.length) { %><ul class="abbonamento-piani" aria-labelledby="h-piani">
    <% for (const p of ab.piani) { const durata = t(p.mesi === 1 ? 'pagamenti.mesi.uno' : 'pagamenti.mesi.altri', { n: p.mesi }); %><li>
      <span><%= t('pagamenti.piani.riga', { livello: p.livello, persone: p.max === null ? t('abbonamento.livelli.oltre', { n: 25 }) : t('abbonamento.livelli.fino', { n: p.max }), durata }) %></span>
      <span class="abbonamento-piani__prezzo"><%= t('pagamenti.euro', { importo: p.prezzo }) %></span>
      <% if (p.manuale) { %><span class="muted"><%= t('pagamenti.piani.manuale', { email: ab.contatto }) %></span><% } else if (p.basta) { %><a class="btn btn--sm" href="/impostazioni/abbonamento/offerta?azienda=<%= encodeURIComponent(azienda.id) %>&amp;piano=<%= encodeURIComponent(p.id) %>"><%= t('pagamenti.piani.scegli') %><span class="visually-hidden"> <%= t('pagamenti.piani.scegliCosa', { livello: p.livello, durata }) %></span></a><% } else { %><span class="muted"><%= t('pagamenti.piani.troppoPiccolo', { n: ab.occupati }) %></span><% } %>
    </li>
    <% } %>
  </ul>
  <p class="field__hint"><%= t('pagamenti.piani.inizio') %></p><% } else { %><p><%= t('pagamenti.piani.nessuno', { email: ab.contatto }) %></p><% } %>
  <% } else if (s.poi) { %><p class="field__hint"><%= t('pagamenti.errore.inCoda') %></p><% } else { %><p class="field__hint"><%= t('abbonamento.contatto', { email: ab.contatto }) %></p><% } %>
</section>
