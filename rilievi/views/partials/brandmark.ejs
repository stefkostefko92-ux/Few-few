<%# Марката — табела „RI“, рендерирана от scripts/logo (картинка, не SVG: собственикът, 31 октомври 2026). `marchio` — височината в CSS px: 36 в лентите и на входа, 48 в долната част на витрината; файловете са за 1x, 2x и 3x. Името до нея е текст. %><% const marchioH = locals.marchio === 48 ? 48 : 36; %><img class="brand__mark brand__mark--<%= marchioH %>" src="/static/img/brand/marchio-<%= marchioH %>.webp?v=<%= v %>" srcset="/static/img/brand/marchio-<%= marchioH * 2 %>.webp?v=<%= v %> 2x, /static/img/brand/marchio-<%= marchioH * 3 %>.webp?v=<%= v %> 3x" width="<%= Math.round(marchioH * 1.3) %>" height="<%= marchioH %>" alt="">
