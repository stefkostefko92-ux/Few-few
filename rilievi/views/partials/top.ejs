<%
  // Заглавие на страницата < 60 знака: „<страница> — Rilievi Impianti“.
  const pageTitle = (typeof title !== 'undefined' && title) ? title : t(titleKey);
  const narrow = typeof narrowMain !== 'undefined' && narrowMain;
  const bareMain = typeof bare !== 'undefined' && bare;
  // Входът е без лентата на портала, но с чертежа на шахтата (shaft.css).
  // Темата „Personalizzato“: класът и светла/тъмна основа на <html>, стилът с цветовете — след останалите.
  const personale = typeof temaPersonale !== 'undefined' && temaPersonale ? temaPersonale : null;
  const sheets = ['base', 'buttons', 'shell', 'sidenav', 'navigazione', 'cerca', 'layout', 'plate', 'forms', 'righe', 'pages', 'data', 'tabelle-strette', 'sheet', 'misure', 'moduli', 'allegati', 'foto-stampa', 'schizzi', 'schizzo-editor', 'schizzo-barre', 'interventi', 'foglio', 'verbali', 'buoni', 'preventivi', 'cartelli', 'impostazioni', 'impostazioni-hub', 'master', 'master-grafico', 'master-strumenti', 'avvisi', 'argano', 'due-fattori', 'installa', 'legale'].concat(bareMain ? ['shaft'] : []);
  // Прозорецът с новините след обновяване (src/novita/popup.ts) — само на вписан човек в портала.
  const novita = currentUser && !bareMain && typeof novitaPopup !== 'undefined' && novitaPopup ? novitaPopup : null;
  if (novita) sheets.push('novita');
  // Съобщенията на MASTER до фирмите (src/master/banner.ts) — лентите над съдържанието.
  const avvisi = currentUser && !bareMain && ((typeof comunicazioni !== 'undefined' && comunicazioni.length > 0) || (typeof cambiInCorso !== 'undefined' && cambiInCorso.length > 0));
%><!doctype html>
<html lang="<%= locale %>"<% if (personale) { %> class="tema-personale" data-theme="<%= personale.schema %>"<% } else if (theme === 'LIGHT') { %> data-theme="light"<% } else if (theme === 'DARK') { %> data-theme="dark"<% } %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= pageTitle %> — Rilievi Impianti</title>
<meta name="description" content="<%= t('meta.description') %>">
<meta name="keywords" content="<%= t('meta.keywords') %>">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/static/img/favicon-32.png?v=<%= v %>" type="image/png" sizes="32x32">
<link rel="icon" href="/static/img/favicon-192.png?v=<%= v %>" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png?v=<%= v %>">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Rilievi">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<link rel="stylesheet" href="/static/fonts/fonts.css?v=<%= v %>">
<% for (const sheet of sheets) { %><link rel="stylesheet" href="/static/css/<%= sheet %>.css?v=<%= v %>">
<% } %><% if (personale) { %><link rel="stylesheet" href="<%= personale.href %>">
<% } %><script nonce="<%= cspNonce %>">document.documentElement.classList.add('js')</script>
<script src="/static/js/app.js?v=<%= v %>" defer></script>
<% if (currentUser && !bareMain) { %><script src="/static/js/menu.js?v=<%= v %>" defer></script>
<script src="/static/js/cerca.js?v=<%= v %>" defer></script>
<script src="/static/js/pdf-app.js?v=<%= v %>" defer></script>
<% } %><% if (avvisi) { %><script src="/static/js/comunicazioni.js?v=<%= v %>" defer></script>
<% } %><% if (novita) { %><script src="/static/js/novita.js?v=<%= v %>" defer></script>
<% } %><% for (const script of (typeof scripts !== 'undefined' ? scripts : [])) { %><script src="/static/js/<%= script %>.js?v=<%= v %>" defer></script>
<% } %></head>
<body<% if (currentUser && !bareMain) { %> class="with-nav" data-pdf-attesa="<%= t('pdfApp.attesa') %>" data-pdf-pronto="<%= t('pdfApp.pronto') %>" data-pdf-errore="<%= t('pdfApp.errore') %>" data-pdf-non-supportato="<%= t('pdfApp.nonSupportato') %>"<% } %>>
<a class="skip" href="#main"><%= t('nav.skip') %></a>
<% if (currentUser && !bareMain) { %><%- include('header') %><% } %>
<% if (novita) { %><%- include('novita') %><% } %>
<main id="main" class="<%= bareMain ? 'main-bare' : 'main' + (narrow ? ' main--narrow' : '') %>" tabindex="-1">
<% if (!bareMain) { %><%- include('flash') %><% } %>
<% if (avvisi) { %><%- include('comunicazioni') %><% } %>
