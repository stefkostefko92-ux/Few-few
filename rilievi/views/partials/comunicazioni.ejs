<%
  // Лентите със съобщенията на MASTER (src/master/banner.ts) — над съдържанието на страницата, най-спешните
  // първи. „Chiudi“ е форма (и без JavaScript — връща на същата страница); comunicazioni.js я праща във фонов
  // режим и маха лентата. Текстът е на редове, както е написан (CSS `white-space: pre-line`, без HTML).
%><div class="avvisi" role="region" aria-label="<%= t('master.comunicazioni.banner.regione') %>">
  <% for (const c of comunicazioni) { %><section class="avviso avviso--<%= c.livello.toLowerCase() %>" aria-labelledby="avviso-<%= c.id %>" data-avviso>
    <div class="avviso__testa">
      <h2 class="avviso__titolo" id="avviso-<%= c.id %>"><%- include('icon', { name: c.livello === 'INFO' ? 'megaphone' : 'alert' }) %><span><%= c.titolo %></span></h2>
      <form class="avviso__chiudi" method="post" action="/comunicazioni/<%= c.id %>/chiudi" data-avviso-chiudi>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="torna" value="<%= comunicazioniTorna %>">
        <button class="btn btn--ghost btn--sm" type="submit" aria-label="<%= t('master.comunicazioni.banner.chiudiAria', { titolo: c.titolo }) %>"><%- include('icon', { name: 'close' }) %><span><%= t('master.comunicazioni.banner.chiudi') %></span></button>
      </form>
    </div>
    <p class="avviso__testo"><%= c.testo %></p>
  </section>
  <% } %>
</div>
