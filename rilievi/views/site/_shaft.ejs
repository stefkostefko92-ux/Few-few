<%
  // Разрез на асансьорна шахта — единствената „снимка“ на портала: линии, щриховка и кота, като на
  // чертеж. Кабината е на етаж 2; при `live` идва от етаж 0 веднъж (site-hero.css, без движение при
  // prefers-reduced-motion). Маркерите са номерата на разделите на картата (легендата отдолу, `legend`):
  // всеки раздел сочи своята част от уредбата, номерът е мястото му в картата.
  // Координатите на движещите се части се смятат заедно с ключовите кадри в site-hero.css.
  const floors = [650, 556, 462, 368, 274];
  const walls = [[164, 210], [274, 304], [368, 398], [462, 492], [556, 586], [650, 712]];
  const withMarkers = typeof markers !== 'undefined' && markers;
  const live = typeof animate !== 'undefined' && animate;
  // Раздел → [център на маркера, точка на детайла].
  const spots = {
    // Разделът 1 — идентификацията и табелата: табелата в кабината.
    impianto: [[412, 391], [219, 393]],
    ubicazione: [[48, 70], [91, 70]],
    tipologia: [[78, 322], [139, 336]],
    quadro: [[48, 112], [104, 112]],
    argano: [[251, -8], [251, 52]],
    funi: [[412, 250], [301, 250]],
    limitatore: [[418, 112], [328, 124]],
    cavi: [[412, 600], [262, 590]],
    serrature: [[100, 585], [141, 592]],
    allarme: [[78, 410], [166, 414]],
    note: [[78, 508], [120, 522]],
  };
  const callouts = withMarkers ? legend.filter((s) => spots[s.key]).map((s) => [s.n, ...spots[s.key]]) : [];
  const edge = (from, to, r) => {
    const dx = to[0] - from[0], dy = to[1] - from[1], len = Math.hypot(dx, dy) || 1;
    return [from[0] + (dx / len) * r, from[1] + (dy / len) * r];
  };
%><svg class="shaft<%= live ? ' shaft--live' : '' %>" viewBox="0 -24 440 760" width="440" height="760" focusable="false"<% if (withMarkers) { %> role="img" aria-labelledby="shaft-title shaft-desc"<% } else { %> aria-hidden="true"<% } %>>
<% if (withMarkers) { %><title id="shaft-title"><%= t('site.shaft.title') %></title>
<desc id="shaft-desc"><%= t('site.shaft.desc') %></desc>
<% } %><defs>
  <pattern id="shaft-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V5" stroke="currentColor" stroke-width="1" class="shaft__hatch"/></pattern>
</defs>
<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <%# Машинно помещение: покрив, стени, под с отвори за въжетата %>
  <g class="shaft__structure">
    <rect x="84" y="20" width="312" height="14" fill="url(#shaft-hatch)"/>
    <rect x="84" y="34" width="14" height="116" fill="url(#shaft-hatch)"/>
    <rect x="382" y="34" width="14" height="116" fill="url(#shaft-hatch)"/>
    <rect x="84" y="150" width="114" height="14" fill="url(#shaft-hatch)"/>
    <rect x="212" y="150" width="78" height="14" fill="url(#shaft-hatch)"/>
    <rect x="332" y="150" width="64" height="14" fill="url(#shaft-hatch)"/>
    <%# Шахтата: лявата стена с отворите на вратите, дясната стена, дъното на приямъка %>
    <% for (const [top, bottom] of walls) { %><rect x="132" y="<%= top %>" width="18" height="<%= bottom - top %>" fill="url(#shaft-hatch)"/>
    <% } %><rect x="330" y="164" width="18" height="548" fill="url(#shaft-hatch)"/>
    <rect x="132" y="712" width="216" height="12" fill="url(#shaft-hatch)"/>
    <%# Етажите: площадка, вратата на етажа, бутонното табло до нея %>
    <% floors.forEach((y, floor) => { %><rect x="36" y="<%= y %>" width="96" height="8" fill="url(#shaft-hatch)"/>
    <path d="M141 <%= y - 64 %>V<%= y %>" stroke-width="3"/>
    <rect x="120" y="<%= y - 40 %>" width="7" height="12" rx="1"/>
    <circle cx="123.5" cy="<%= y - 34 %>" r="1.5" fill="currentColor" stroke="none"/>
    <% }) %>
    <%# Осветлението на шахтата %>
    <path d="M330 232a5 5 0 0 0 0 10M330 420a5 5 0 0 0 0 10M330 608a5 5 0 0 0 0 10"/>
  </g>
  <%# Кота: ходът на кабината и спирките %>
  <g class="shaft__dim" stroke-width="1">
    <path d="M20 280V644"/>
    <path d="M20 274l-4 9h8zM20 650l-4-9h8z" fill="currentColor" stroke="none"/>
    <% for (const y of floors) { %><path d="M13 <%= y %>H27"/>
    <% } %>
  </g>
  <g class="shaft__floors" fill="currentColor" stroke="none">
    <% floors.forEach((y, floor) => { %><text x="42" y="<%= y - 10 %>"><%= floor %></text>
    <% }) %>
  </g>
  <%# Табло, тягова машина с шайба, ограничител %>
  <g class="shaft__machine">
    <rect x="104" y="64" width="44" height="86" rx="2"/>
    <path d="M112 74H140M112 79H140M112 84H140M126 112V150" stroke-width="1"/>
    <rect x="112" y="94" width="28" height="12" rx="1" stroke-width="1"/>
    <circle cx="118" cy="128" r="3" stroke-width="1"/>
    <circle cx="134" cy="128" r="3" stroke-width="1"/>
    <circle cx="251" cy="98" r="46"/>
    <circle cx="251" cy="98" r="40" stroke-width="1"/>
    <circle cx="251" cy="98" r="12"/>
    <circle cx="251" cy="98" r="3" fill="currentColor" stroke="none"/>
    <path d="M251 98L230 144M251 98L272 144" stroke-width="1"/>
    <rect x="222" y="144" width="58" height="6"/>
    <circle cx="322" cy="126" r="6"/>
    <circle cx="322" cy="126" r="1.5" fill="currentColor" stroke="none"/>
    <path d="M312 148H332M318 132L314 148M326 132L330 148" stroke-width="1"/>
  </g>
  <%# Въжето на ограничителя и обтегачът в приямъка %>
  <g class="shaft__governor" stroke-width="1">
    <path d="M316 126V690M328 126V690"/>
    <circle cx="322" cy="690" r="6" stroke-width="1.5"/>
    <path d="M322 690L311 701"/>
    <rect x="303" y="698" width="9" height="9" fill="currentColor" stroke="none"/>
  </g>
  <%# Буферите %>
  <g class="shaft__buffers">
    <rect x="198" y="694" width="14" height="18"/>
    <path d="M198 700H212M198 706H212" stroke-width="1"/>
    <rect x="290" y="698" width="14" height="14"/>
  </g>
  <%# Носещите въжета: към кабината и към противотежестта %>
  <g class="shaft__ropes-car" stroke-width="1.25"><path d="M202 98V370M205 98V370M208 98V370"/></g>
  <g class="shaft__ropes-cw" stroke-width="1.25"><path d="M294 98V396M297 98V396M300 98V396"/></g>
  <%# Противотежестта %>
  <g class="shaft__cw">
    <rect x="286" y="396" width="22" height="66"/>
    <path d="M286 407H308M286 418H308M286 429H308M286 440H308M286 451H308" stroke-width="1"/>
  </g>
  <%# Гъвкавият кабел: закрепен на задната стена, виси под кабината %>
  <path d="M264 470H276" stroke-width="2"/>
  <path class="shaft__cable-fixed" d="M270 470V578" stroke-width="2.25"/>
  <path class="shaft__cable-loop" d="M246 578A12 12 0 0 0 270 578" stroke-width="2.25"/>
  <path class="shaft__cable-car" d="M246 462V578" stroke-width="2.25"/>
  <%# Кабината на етаж 2: окачване, врата, бутонно табло, табелата %>
  <g class="shaft__car">
    <path d="M158 386L205 370L252 386"/>
    <rect x="158" y="386" width="94" height="76" fill="currentColor" fill-opacity="0.06"/>
    <path d="M161 398V462" stroke-width="3"/>
    <path d="M154 462H256" stroke-width="2.5"/>
    <rect x="166" y="404" width="7" height="26" rx="1" stroke-width="1"/>
    <circle cx="169.5" cy="410" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="169.5" cy="416" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="169.5" cy="422" r="1.3" fill="currentColor" stroke="none"/>
    <rect x="196" y="389" width="22" height="10" rx="1.5" stroke-width="1"/>
    <path d="M200 394H214" stroke-width="1"/>
  </g>
</g>
<% if (withMarkers) { %><g class="shaft__markers" aria-hidden="true">
  <% for (const [n, at, target] of callouts) { const [x1, y1] = edge(at, target, 11); %><g class="shaft__marker">
    <path d="M<%= x1.toFixed(1) %> <%= y1.toFixed(1) %>L<%= target[0] %> <%= target[1] %>" fill="none" stroke="currentColor" stroke-width="1"/>
    <circle cx="<%= target[0] %>" cy="<%= target[1] %>" r="2.2" fill="currentColor"/>
    <circle cx="<%= at[0] %>" cy="<%= at[1] %>" r="11" fill="currentColor"/>
    <text class="shaft__num" x="<%= at[0] %>" y="<%= at[1] %>" text-anchor="middle" dominant-baseline="central"><%= n %></text>
  </g>
  <% } %>
</g><% } %>
</svg>
