<%# Вторият фактор при вход: кодът от приложението (6 цифри) или резервен код. %><%- include('../partials/auth-top', { titleKey: 'auth.codice.title' }) %>
<form class="auth__form" method="post" action="/accesso/codice" novalidate>
  <h1><%= t('auth.codice.title') %></h1>
  <p class="muted"><%= t('auth.codice.testo') %></p>
  <% if (error) { %><div class="errors" role="alert" id="form-error"><h2><%= t(error, errorParams) %></h2></div><% } %>
  <input type="hidden" name="_csrf" value="<%= preCsrf %>">
  <div class="field">
    <label class="field__label" for="codice"><%= t('auth.codice.label') %></label>
    <input class="input input--codice" id="codice" name="codice" type="text" inputmode="numeric" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" maxlength="20" required autofocus aria-describedby="codice-hint<%= error ? ' form-error' : '' %>"<% if (error) { %> aria-invalid="true"<% } %>>
    <p class="field__hint" id="codice-hint"><%= t('auth.codice.hint') %></p>
  </div>
  <button class="btn btn--primary btn--block" type="submit"><%= t('auth.codice.submit') %></button>
  <div class="auth__links">
    <a href="/accesso"><%= t('auth.codice.annulla') %></a>
  </div>
</form>
<%- include('../partials/auth-bottom') %>
