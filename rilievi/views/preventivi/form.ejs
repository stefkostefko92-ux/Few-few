<%
  // Формата на офертата (routes/preventivi-vista.ts): фирмата (при няколко), картата (по избор), клиентът,
  // документът (ден, валидност, предмет, уредба), редовете (записаните и още няколко празни; с JavaScript —
  // „Aggiungi una riga“ и „Aggiungi dal listino“), бележките и условията. Сумите — показани от браузъра,
  // сметнати от сървъра при записа.
  const isEdit = preventivo !== null;
  const action = isEdit ? '/preventivi/' + preventivo.id : '/preventivi';
  const errorKeys = Object.keys(errors);
  const str = (key) => typeof values[key] === 'string' ? values[key] : '';
  const aria = (key) => errors[key] ? ' aria-invalid="true" aria-describedby="err-' + key + '"' : '';
  const posizione = (i) => righe.indexOf(i) + 1;
  const labelOf = (key) => {
    if (key === 'azienda') return t('scheda.field.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.titolo');
    if (key === 'righe' || key === 'totale') return t('preventivi.sezione.righe');
    const m = /^r-(\d+)-(\w+)$/.exec(key);
    if (m) return t('preventivi.riga.titolo', { n: posizione(Number(m[1])) || Number(m[1]) + 1 }) + ' — ' + t('preventivi.colonna.' + m[2]);
    return t('preventivi.campo.' + key);
  };
  const messageOf = (key) => {
    const code = errors[key];
    if (key === 'azienda') return t('preventivi.errore.azienda');
    if (key === 'scheda') return t('cartelli.daScheda.nonDisponibile');
    if (key === 'righe') return t(code === 'range' ? 'preventivi.errore.troppeRighe' : 'preventivi.errore.nessunaRiga', { n: maxRighe });
    if (key === 'totale') return t('preventivi.errore.totale');
    const m = /^r-\d+-(\w+)$/.exec(key);
    const campo = m ? m[1] : key;
    if (code === 'tooLong') return t('preventivi.errore.tooLong', { max: max[campo] });
    if (code === 'decimal' || code === 'range' || code === 'invalid' || code === 'option') return t('preventivi.errore.' + campo);
    if (code === 'invalidDate') return t('preventivi.errore.data');
    return t('preventivi.errore.required');
  };
  const anchorOf = (key) => key === 'righe' || key === 'totale' ? 'righe' : 'f-' + key;
  const campo = (key, tipo, opts) => include('_campo', { key, tipo, wide: !!(opts && opts.wide), maxLength: max[key], valore: str(key), errore: errors[key] ? messageOf(key) : '', hint: opts && opts.hint ? opts.hint : '' });
  const collegata = isEdit ? preventivo.scheda : null;
  const rigaVuota = { values: {}, errors: {}, messageOf };
%><%- include('../partials/top', { titleKey: isEdit ? 'preventivi.modifica' : 'preventivi.new', narrowMain: true, scripts }) %>
<div class="page-head">
  <div>
    <a href="<%= isEdit ? '/preventivi/' + preventivo.id : '/preventivi' %>"><%= isEdit ? t('preventivi.torna') : t('preventivi.indietro') %></a>
    <h1><%= isEdit ? t('preventivi.numero', { n: preventivo.numero }) : t('preventivi.new') %></h1>
    <% if (isEdit) { %><p class="page-head__sub"><%= preventivo.azienda.name %></p><% } %>
  </div>
</div>
<div class="stack-gap">
<% if (typeof conflict !== 'undefined' && conflict) { %>
  <div class="notice" role="alert"><p><strong><%= t('preventivi.flash.conflitto') %></strong></p></div>
<% } %>
<% if (errorKeys.length) { %>
  <div class="errors" role="alert" id="error-summary" tabindex="-1">
    <h2><%= t('scheda.errorSummary', { n: errorKeys.length }) %></h2>
    <ul>
      <% for (const key of errorKeys) { %><li><a href="#<%= anchorOf(key) %>"><%= labelOf(key) %>: <%= messageOf(key) %></a></li>
      <% } %>
    </ul>
  </div>
<% } %>
<% if (!isEdit && (puoCercare || scheda)) { %><%- include('../cartelli/_da-scheda', { daSchedaNuovo: '/preventivi/nuovo', daSchedaTesti: 'preventivi' }) %><% } %>
<% if (collegata && !collegata.deletedAt) { %><p class="muted"><%= t('cartelli.daScheda.collegato', { nome: [collegata.matricola ? t('cartelli.daScheda.matricola', { m: collegata.matricola }) : '', collegata.numeroImpianto ? t('cartelli.daScheda.numero', { n: collegata.numeroImpianto }) : ''].filter(Boolean).join(' · ') || '—' }) %></p><% } %>
<form class="form preventivo-form" method="post" action="<%= action %>" novalidate data-preventivo data-azienda="<%= azienda %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isEdit) { %><input type="hidden" name="base" value="<%= base %>"><% } %>
  <% if (!isEdit && scheda) { %><input type="hidden" name="scheda" value="<%= scheda.id %>"><% } %>
  <% if (!isEdit && !scheda && aziende.length > 0) { %>
  <div class="field field--azienda">
    <label class="field__label" for="f-azienda"><%= t('scheda.field.azienda') %></label>
    <select class="select" id="f-azienda" name="azienda" required data-scelta-azienda<%- aria('azienda') %>>
      <option value=""<% if (!azienda) { %> selected<% } %>>—</option>
      <% for (const item of aziende) { %><option value="<%= item.id %>"<% if (azienda === item.id) { %> selected<% } %>><%= item.name %></option>
      <% } %>
    </select>
    <% if (errors.azienda) { %><p class="field__error" id="err-azienda"><%= messageOf('azienda') %></p><% } %>
  </div>
  <% } %>

  <fieldset class="section">
    <legend class="section__title"><%= t('preventivi.sezione.cliente') %></legend>
    <div class="grid grid--righe">
      <%- campo('cliente', 'text', { wide: true }) %>
      <%- campo('clienteIndirizzo', 'text', { wide: true }) %>
      <%- campo('clientePiva', 'text', { hint: t('preventivi.hint.piva') }) %>
      <%- campo('clienteEmail', 'email') %>
    </div>
  </fieldset>

  <fieldset class="section">
    <legend class="section__title"><%= t('preventivi.sezione.documento') %></legend>
    <div class="grid grid--righe">
      <%- campo('data', 'date') %>
      <%- campo('validitaGiorni', 'giorni', { hint: t('preventivi.hint.validita') }) %>
      <%- campo('oggetto', 'text', { wide: true }) %>
      <%- campo('impianto', 'text', { wide: true, hint: t('preventivi.hint.impianto') }) %>
    </div>
  </fieldset>

  <fieldset class="section" id="righe">
    <legend class="section__title"><%= t('preventivi.sezione.righe') %></legend>
    <div class="preventivo-listino" data-listino hidden data-caricato="<%= t('preventivi.listino.caricato') %>" data-non-trovata="<%= t('preventivi.listino.nonTrovata') %>" data-aggiunta="<%= t('preventivi.listino.aggiunta') %>">
      <label class="field__label" for="f-listino"><%= t('preventivi.listino.aggiungiLabel') %></label>
      <div class="filter__row">
        <input class="input" id="f-listino" type="search" list="listino-voci" autocomplete="off" placeholder="<%= t('preventivi.listino.cercaVoce') %>">
        <button class="btn" type="button" data-listino-aggiungi><%- include('../partials/icon', { name: 'plus' }) %><%= t('preventivi.listino.aggiungi') %></button>
      </div>
      <p class="field__hint" data-listino-stato role="status"></p>
      <datalist id="listino-voci"></datalist>
      <datalist id="listino-codici"></datalist>
    </div>
    <div class="preventivo-righe-form" data-righe data-max="<%= maxRighe %>" data-max-indice="<%= maxIndice %>" data-prossimo="<%= prossimo %>">
      <% righe.forEach((i, pos) => { %><%- include('_riga', { i, n: pos + 1, messageOf }) %>
      <% }) %>
    </div>
    <p class="field__hint" data-senza-js><%= t('preventivi.riga.hint') %></p>
    <button class="btn" type="button" data-aggiungi-riga hidden><%- include('../partials/icon', { name: 'plus' }) %><%= t('preventivi.riga.aggiungi') %></button>
    <template data-modello-riga><%- include('_riga', { ...rigaVuota, i: '__i__', n: '__n__' }) %></template>
    <dl class="preventivo-totali" data-totali hidden>
      <div><dt><%= t('preventivi.pdf.imponibile') %></dt><dd><output data-tot="imponibile">—</output></dd></div>
      <div><dt><%= t('preventivi.pdf.imposta') %></dt><dd><output data-tot="imposta">—</output></dd></div>
      <div class="preventivo-totali__totale"><dt><%= t('preventivi.pdf.totale') %></dt><dd><output data-tot="totale">—</output></dd></div>
    </dl>
    <p class="field__hint" data-totali hidden><%= t('preventivi.totaliHint') %></p>
  </fieldset>

  <fieldset class="section">
    <legend class="section__title"><%= t('preventivi.sezione.note') %></legend>
    <div class="grid grid--righe">
      <%- campo('note', 'textarea', { wide: true }) %>
      <%- campo('condizioni', 'textarea', { wide: true, hint: t('preventivi.hint.condizioni') }) %>
    </div>
  </fieldset>

  <div class="actions">
    <button class="btn btn--inverse" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('preventivi.salva') %></button>
    <a class="btn btn--bar" href="<%= isEdit ? '/preventivi/' + preventivo.id : '/preventivi' %>"><%= t('common.cancel') %></a>
  </div>
</form>
</div>
<%- include('../partials/bottom') %>
