<%
  // Промяна на ред от ценоразписа (routes/preventivi-listino.ts) и изтриването му. Цената на вече
  // направените оферти не се сменя — тя е написаната в тях.
  const errorKeys = Object.keys(errors);
  const back = '/preventivi/listino?azienda=' + encodeURIComponent(azienda.id);
%><%- include('../partials/top', { titleKey: 'preventivi.listino.modifica', narrowMain: true }) %>
<div class="page-head">
  <div>
    <a href="<%= back %>"><%= t('preventivi.listino.torna') %></a>
    <h1><%= t('preventivi.listino.modifica') %></h1>
    <p class="page-head__sub"><%= azienda.name %></p>
  </div>
</div>
<div class="stack-gap">
<p class="muted"><%= t('preventivi.listino.nota') %></p>
<form class="form" method="post" action="/preventivi/listino/<%= id %>?azienda=<%= encodeURIComponent(azienda.id) %>" novalidate>
  <% if (errorKeys.length) { %><div class="errors" role="alert" tabindex="-1"><h2><%= t('preventivi.listino.errore.titolo') %></h2></div><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('_voce-campi', { maxVoci: 0 }) %>
  <div class="toolbar">
    <button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'check' }) %><%= t('preventivi.listino.salva') %></button>
    <a class="btn" href="<%= back %>"><%= t('common.cancel') %></a>
  </div>
</form>
<details class="panel buono-elimina">
  <summary><%= t('preventivi.listino.elimina') %></summary>
  <form method="post" action="/preventivi/listino/<%= id %>/elimina?azienda=<%= encodeURIComponent(azienda.id) %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p><%= t('preventivi.listino.eliminaTesto') %></p>
    <button class="btn btn--danger" type="submit"><%- include('../partials/icon', { name: 'trash' }) %><%= t('preventivi.listino.elimina') %></button>
  </form>
</details>
</div>
<%- include('../partials/bottom') %>
