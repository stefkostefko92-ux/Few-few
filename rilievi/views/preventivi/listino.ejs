<%
  // Ценоразписът на фирмата (routes/preventivi-listino.ts): търсене, страници, нов ред; промяна и
  // изтриване — за тези, които пишат офертите. С няколко фирми — изборът горе.
  const params = new URLSearchParams();
  params.set('azienda', azienda.id);
  if (query) params.set('q', query);
  const base = '/preventivi/listino?' + params.toString();
  const errorKeys = Object.keys(errors);
%><%- include('../partials/top', { titleKey: 'preventivi.listino.titolo', narrowMain: true }) %>
<div class="page-head">
  <div>
    <a href="/preventivi"><%= t('preventivi.indietro') %></a>
    <h1><%= t('preventivi.listino.titolo') %></h1>
    <p class="page-head__sub"><%= azienda.name %> · <%= t('preventivi.listino.voci', { n: page.total }) %></p>
  </div>
</div>
<div class="stack-gap">
<% if (aziende.length > 1) { %>
<form class="filter" method="get" action="/preventivi/listino">
  <label class="field__label" for="listino-azienda"><%= t('scheda.field.azienda') %></label>
  <div class="filter__row">
    <select class="select" id="listino-azienda" name="azienda">
      <% for (const a of aziende) { %><option value="<%= a.id %>"<% if (a.id === azienda.id) { %> selected<% } %>><%= a.name %></option>
      <% } %>
    </select>
    <button class="btn" type="submit"><%= t('preventivi.listino.apri') %></button>
  </div>
</form>
<% } %>
<p class="muted"><%= t('preventivi.listino.intro', { n: maxVoci }) %></p>
<% if (scrive) { %>
<form class="panel form" method="post" action="/preventivi/listino" novalidate>
  <h2 class="section__title"><%= t('preventivi.listino.nuova') %></h2>
  <% if (errorKeys.length) { %><div class="errors" role="alert" tabindex="-1"><h2><%= t('preventivi.listino.errore.titolo') %></h2></div><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="azienda" value="<%= azienda.id %>">
  <%- include('_voce-campi') %>
  <div class="toolbar"><button class="btn btn--primary" type="submit"><%- include('../partials/icon', { name: 'plus' }) %><%= t('preventivi.listino.aggiungiVoce') %></button></div>
</form>
<% } %>
<form class="filter" method="get" action="/preventivi/listino" role="search">
  <input type="hidden" name="azienda" value="<%= azienda.id %>">
  <label class="field__label" for="listino-q"><%= t('preventivi.listino.cercaLabel') %></label>
  <div class="filter__row">
    <input class="input" id="listino-q" name="q" type="search" maxlength="100" value="<%= query %>">
    <button class="btn" type="submit"><%- include('../partials/icon', { name: 'search' }) %><%= t('preventivi.cercaBtn') %></button>
  </div>
</form>
<% if (page.rows.length === 0) { %>
<div class="empty"><p><strong><%= query ? t('preventivi.listino.vuotoCerca') : t('preventivi.listino.vuoto') %></strong></p></div>
<% } else { %>
<table class="table table--stack">
  <caption class="visually-hidden"><%= t('preventivi.listino.titolo') %></caption>
  <thead>
    <tr>
      <th scope="col"><%= t('preventivi.colonna.codice') %></th>
      <th scope="col"><%= t('preventivi.colonna.descrizione') %></th>
      <th scope="col"><%= t('preventivi.colonna.unita') %></th>
      <th scope="col" class="importo"><%= t('preventivi.colonna.prezzoEuro') %></th>
      <th scope="col" class="importo"><%= t('preventivi.colonna.ivaPercento') %></th>
      <% if (scrive) { %><th scope="col"><span class="visually-hidden"><%= t('preventivi.listino.azioni') %></span></th><% } %>
    </tr>
  </thead>
  <tbody>
    <% for (const v of page.rows) { %><tr>
      <td data-label="<%= t('preventivi.colonna.codice') %>"><%= v.codice || '—' %></td>
      <td class="wide" data-label="<%= t('preventivi.colonna.descrizione') %>"><%= v.descrizione %></td>
      <td data-label="<%= t('preventivi.colonna.unita') %>"><%= v.unita %></td>
      <td class="importo" data-label="<%= t('preventivi.colonna.prezzoEuro') %>"><%= euro(v.prezzo) %></td>
      <td class="importo" data-label="<%= t('preventivi.colonna.ivaPercento') %>"><%= v.iva %></td>
      <% if (scrive) { %><td><a href="/preventivi/listino/<%= v.id %>?azienda=<%= encodeURIComponent(azienda.id) %>"><%= t('preventivi.listino.modificaVoce') %><span class="visually-hidden"> <%= v.descrizione %></span></a></td><% } %>
    </tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/pager', { base, page: page.page, pages: page.pages }) %>
<% } %>
</div>
<%- include('../partials/bottom') %>
