<%- include('../partials/top', { titleKey: 'account.title', narrowMain: true }) %>
<div class="page-head">
  <div>
    <h1><%= t('account.title') %></h1>
    <p class="page-head__sub"><%= currentUser.email %><% if (currentUser.master) { %>, <%= t('role.MASTER') %><% } %></p>
  </div>
  <form method="post" action="/esci"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit"><%= t('account.logout') %></button></form>
</div>
<div class="stack-gap">
  <% if (currentUser.mustChangePassword) { %><div class="notice" role="alert"><p><strong><%= t('account.mustChange') %></strong></p></div><% } %>
  <% if (error) { %><div class="errors" role="alert" id="form-error"><h2><%= t(error) %></h2></div><% } %>
  <% if (currentUser.memberships.length > 0) { %>
  <section aria-labelledby="h-aziende">
    <h2 class="section__title" id="h-aziende"><%= t('account.aziendeTitle') %></h2>
    <dl class="kv">
      <% for (const m of currentUser.memberships) { %><div class="kv__item"><dt><%= m.aziendaName %></dt><dd><%= t('role.' + m.role) %></dd></div>
      <% } %>
    </dl>
  </section>
  <% } %>
  <section aria-labelledby="h-password">
    <h2 class="section__title" id="h-password"><%= t('account.passwordTitle') %></h2>
    <form class="form" method="post" action="/account/password" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="current"><%= t('account.currentPassword') %></label>
        <input class="input" id="current" name="current" type="password" autocomplete="current-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="password"><%= t('auth.newPassword') %></label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="<%= passwordMin %>" aria-describedby="password-hint">
        <p class="field__hint" id="password-hint"><%= t('auth.passwordRule') %></p>
      </div>
      <div class="field">
        <label class="field__label" for="confirm"><%= t('auth.confirmPassword') %></label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
      </div>
      <div class="toolbar"><button class="btn btn--primary" type="submit"><%= t('account.passwordSubmit') %></button></div>
    </form>
  </section>
  <% if (!currentUser.mustChangePassword) { %>
  <section aria-labelledby="h-profile">
    <h2 class="section__title" id="h-profile"><%= t('account.profileTitle') %></h2>
    <form class="row-form" method="post" action="/account/profilo" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="name"><%= t('auth.name') %></label>
        <input class="input" id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" value="<%= name %>">
      </div>
      <button class="btn" type="submit"><%= t('account.profileSubmit') %></button>
    </form>
  </section>
  <section aria-labelledby="h-prefs">
    <h2 class="section__title" id="h-prefs"><%= t('account.prefsTitle') %></h2>
    <p class="muted"><%= t('account.prefsText') %></p>
  </section>
  <% } %>
</div>
<%- include('../partials/bottom') %>
