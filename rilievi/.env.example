# Rilievi Impianti — образец на настройките. Истинският .env живее САМО на сървъра (mode 600) в
# /opt/few-few/shared/rilievi/.env — никога в репото или в архива за деплой. Прави го веднъж
# `sudo bash rilievi/deploy/setup-env.sh` (генерира паролата и ключа; пита само за SMTP).

# Адресът, на който хората отварят портала (без / накрая) — от него са връзките в поканите.
PUBLIC_BASE_URL=https://rilievi.carbonstealth.eu

# База (Docker Compose я вдига сама). Влиза некодирана в DATABASE_URL — затова hex:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Подписът на бисквитката на сесията (JWT, HS256). 64 hex знака: openssl rand -hex 32.
# Смяна = всички излизат (нищо друго не се губи).
JWT_SECRET=

# Печатът на потвърдените листове за интервенция (HMAC). 64 hex знака: openssl rand -hex 32.
# НИКОГА не се сменя и се пази в бекъпа на тайните: без него нито един потвърден лист не минава
# проверката (PDF и имейл спират). deploy/deploy.sh го създава веднъж, ако липсва.
INTERVENTI_SEAL_KEY=

# Писма (Brevo SMTP; Hetzner блокира 25/465/587 — затова 2525). По избор: без SMTP_HOST поканите и
# връзките за нова парола се показват на екрана за копиране, а „Password dimenticata?“ казва да се
# поиска връзка от администратор.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rilievi Impianti <no-reply@carbonstealth.eu>

# По избор (в контейнера влиза само каквото е изброено в docker-compose.yml)
# HTTP_PORT=4330
# true само за SMTP с имплицитен TLS (порт 465); 2525 е STARTTLS.
# SMTP_SECURE=false
# LOG_LEVEL=info
# Срок за пазене на одита в дни (по подразбиране 2 години).
# AUDIT_RETENTION_DAYS=730
# Адресите на публичната страница: за връзка (и в JSON-LD) и за въпроси по личните данни.
# CONTACT_EMAIL=info@carbonstealth.eu
# PRIVACY_EMAIL=privacy@carbonstealth.eu
# Снимките и клиповете на картите: таванът на един качен файл (MB, преди компресията), най-дългият
# клип (минути) и свободното място на диска, под което качването спира (MB). Клип над 1024 MB иска
# и по-висок client_max_body_size в deploy/nginx/.
# MEDIA_MAX_PHOTO_MB=40
# MEDIA_MAX_VIDEO_MB=1024
# MEDIA_MAX_VIDEO_MIN=10
# MEDIA_MIN_FREE_MB=2048

# Само за локална разработка (npm run dev чете .env в папката на продукта): NODE_ENV=development,
# DATABASE_URL към локалната база и MEDIA_DIR=./media (README, „Локално“; в контейнера е томът
# /data/media). Компресията на качените файлове — `npm run worker` (иска ffmpeg).
