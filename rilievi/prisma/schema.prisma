  verbali                      Verbale[]
  calcoloArgano                CalcoloArgano?
  calcoloLimitatore            CalcoloLimitatore?
  /// Одобрението на две стъпки (src/schede/approvazione.ts) — само във фирма с `approvazioneSchede`:
  /// техникът праща, отговорникът одобрява или връща с бележка; промяна на одобрена карта я връща в чернова.
  /// null — фирмата не го ползва (или картата е отпреди).
  statoApprovazione            StatoApprovazione?
  approvazioneAt               DateTime?
  approvazioneDaId             String?
  approvazioneDa               User?                    @relation("SchedeApprovate", fields: [approvazioneDaId], references: [id], onDelete: SetNull)
  notaApprovazione             String?                  @db.VarChar(1000)
  /// Кой е пратил картата за одобрение — той не я одобрява (четирите очи, в условието на самия запис).
  inviataDaId                  String?
  /// Записаните версии (src/schede/versioni.ts) и пратените поръчки (src/ordini/invio.ts).
  versioni                     SchedaVersione[]
  ordini                       OrdineFornitore[]
  buoni                        BuonoLavoro[]
  preventivi                   Preventivo[]
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@index([aziendaId, statoApprovazione])
  @@index([approvazioneDaId])
  @@index([aziendaId, deletedAt])
  @@index([data])
  @@index([matricola])
  @@index([numeroImpianto])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Одит: кой, какво, кога — без съдържание на схемите и без IP. Само добавяне, маршрут за промяна няма.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  /// Фирмата, за която е събитието — администраторът ѝ вижда само тях; null — събитие на портала.
  aziendaId  String?
  azienda    Azienda? @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  targetType String?
  targetId   String?
  /// Малки неличностни подробности (напр. стара/нова роля). Никога пароли, токени или текст от схема.
  meta       Json?

  @@index([at])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([aziendaId, at])
}

/// Мерките на една стара бутониера — ред за спирка (1 = най-ниската), до броя „Fermate“ на картата.
/// Пише ги само src/schede/service.ts (заедно с картата, в една транзакция); изтриват се с нея.
model MisuraBottoniera {
  id                 String   @id @default(cuid())
  schedaId           String
  scheda             Scheda   @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  fermata            Int
  /// Името на етажа („T“, „S1“); null — номерът на спирката.
  piano              String?  @db.VarChar(20)
  lunghezzaMm        Decimal? @db.Decimal(7, 2)
  larghezzaMm        Decimal? @db.Decimal(7, 2)
  interasseSuperiore String?  @db.VarChar(60)
  interasseInferiore String?  @db.VarChar(60)
  display            Boolean?

  @@unique([schedaId, fermata])
}

/// Снимка или клип към раздел на картата (src/allegati/). Файловете са на диска (`MEDIA_DIR`, пътят е
/// само от id-тата), тук — описанието и докъде е обработката (фоновият процес, src/worker.ts). Изтриват
/// се с картата; окончателното ѝ изтриване маха и папката ѝ.
model Allegato {
  id            String        @id @default(cuid())
  schedaId      String
  scheda        Scheda        @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  /// Разделът на картата (ключът му от src/schede/fields.ts).
  sezione       String        @db.VarChar(20)
  tipo          TipoAllegato
  stato         StatoAllegato @default(IN_CODA)
  /// Надписът по избор („quadro, lato sinistro“).
  didascalia    String?       @db.VarChar(200)
  /// Името на качения файл — само за показ и за името при сваляне, никога за път на диска.
  nomeOriginale String        @db.VarChar(200)
  /// Байтовете преди и след компресията.
  byteOriginali Int
  byte          Int?
  larghezza     Int?
  altezza       Int?
  durataMs      Int?
  /// Защо обработката не успя — ключ от речника (`allegati.errore.<…>`), никога текст на грешка.
  errore        String?       @db.VarChar(40)
  /// Снимката влиза в края на печата и PDF-а — иконките в края на формата (по подразбиране не;
  /// клиповете — никога).
  inStampa      Boolean       @default(false)
  /// Мястото на снимката в печата и PDF-а, избрано в „Stampa e PDF“ (10 ноември 2026); празно — по
  /// разделите в реда на фирмата и по реда на качване, след подредените.
  ordineStampa  Int?
  /// Анотациите върху снимката (C5): лист от скицника `{e: [...]}` в единиците 1400 × 1000, снимката —
  /// цяла, в средата (src/allegati/annotazioni.ts); null — без.
  annotazioni   Json?
  tentativi     Int           @default(0)
  caricatoDaId  String?
  caricatoDa    User?         @relation("AllegatiCaricati", fields: [caricatoDaId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([schedaId, sezione, createdAt])
  @@index([stato, createdAt])
  @@index([caricatoDaId])
}

/// Лист от скицника на картата: нарисуваното (линии и надписи) в JSON, проверено при запис
/// (src/schizzi/model.ts). Записва се с картата, в същата транзакция; пада с нея.
model Schizzo {
  id        String   @id @default(cuid())
  schedaId  String
  scheda    Scheda   @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  /// Мястото на листа в картата (0, 1, 2…).
  ordine    Int
  elementi  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schedaId, ordine])
}

enum TipoAllegato {
  FOTO
  VIDEO
}

/// В опашката → обработва се → готов (компресиран) или грешка (файлът не се чете, клипът е твърде дълъг).
enum StatoAllegato {
  IN_CODA
  IN_LAVORAZIONE
  PRONTO
  ERRORE
}

/// Mastech: моделът на таблото — всеки със свой модул за поръчка.
enum QuadroModello {
  NG120
  QI_TOUCH
}

/// AMI 100 при намалена яма или горно пространство — всеки вид със свой лист за поръчка.
enum Ami100Tipo {
  MONO_UCM
  MONO_RTBS
}

/// Централата на хидравличния асансьор (src/schede/field-options.ts).
enum CentralinaAzionamento {
