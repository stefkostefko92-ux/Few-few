// Rilievi Impianti — схема на данните. PostgreSQL, миграции само през `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Седем нива както в ERP Ascensori: по-малкият номер включва правата на по-големия
/// (MASTER 1 … CLIENTE 7). Правата се проверяват по СПОСОБНОСТ в src/auth/roles.ts.
enum Role {
  MASTER
  ADMIN
  DIREZIONE
  RESPONSABILE
  TECNICO
  OPERATORE
  CLIENTE
}

enum Theme {
  AUTO
  LIGHT
  DARK
  /// Цветовете на човека (`User.colori`, src/http/colori.ts) — собственикът, 30 октомври 2026.
  CUSTOM
}

enum UbicazioneMacchina {
  ALTO
  BASSO
}

enum TipoImpianto {
  ELETTRICO
  IDRAULICO
  /// На екрана и на листа — „MRL“ (собственикът смени надписа, октомври 2026). Стойността в базата
  /// остава: така откатът само на кода (autodeploy при паднала сонда) чете всяка карта.
  GEARLESS
}

enum TipoPorte {
  AUTOMATICHE
  SEMIAUTOMATICHE
  MANUALI
}

/// Наличната аварийна връзка (telesoccorso): пълна или без периферно устройство.
enum TelesoccorsoStato {
  COMPLETO
  MANCA_PERIFERICA
}

/// Марката на таблото за поръчка; при Pelazza — техният модул за поръчка.
enum QuadroMarca {
  PELAZZA
  MOVILIFT
  DMG
  MASTECH
  ELETTROQUADRI
  GEAT
  ALTRO
}

/// Марката на аргано (машината). От октомври 2026 не се пита (листът с данни е за всеки вид аргано);
/// колоната остава със старите отговори.
enum ArganoMarca {
  MONTANARI
  ALTRO
}

/// Колко души ще ползват портала — по избор в заявката за достъп.
enum TeamSize {
  S1_5
  S6_20
  S21_50
  S50_PLUS
}

/// Заявката за достъп: нова, приета (фирмата е създадена и администраторът е поканен) или отказана.
enum AccessRequestStatus {
  NEW
  ACCEPTED
  REJECTED
}

/// Фирма — клиент на портала: свои хора, свои карти, свое лого на листа. Създава я само MASTER
/// (собственикът на портала); всяка фирма вижда само своето (src/auth/scope.ts).
model Azienda {
  id                   String       @id @default(cuid())
  name                 String       @unique @db.VarChar(120)
  /// Логото за листа и PDF-а — вече прекодирано от src/aziende/logo.ts (PNG или JPEG, без метаданни).
  logo                 Bytes?
  logoType             String?      @db.VarChar(20)
  logoWidth            Int?
  logoHeight           Int?
  logoUpdatedAt        DateTime?
  /// Деактивирана фирма: хората ѝ не влизат и сесиите им падат; картите ѝ остават.
  deactivatedAt        DateTime?
  /// Редът на разделите на картата във фирмата (ключовете от src/schede/fields.ts); празно — редът по
  /// подразбиране. Подрежда го администраторът ѝ (src/aziende/sezioni.ts).
  ordineSezioni        String[]     @default([])
  /// Скицникът — от 10 ноември 2026 винаги включен за всички (собственикът: „attiva gli schizzi per tutti
  /// … togli l'opzione per disattivarli“); кодът не чете колоната, тя остава за връщане назад.
  schizzi              Boolean      @default(true)
  /// Последният даден номер на лист за интервенция във фирмата (собствен брояч от 1, без дупки):
  /// новият лист взема +1 в транзакцията си (src/interventi/service.ts).
  interventiNumero     Int          @default(0)
  /// Данните на фирмата за главата на табелата „Avviso di fermo impianto“ (име, дейност, адрес,
  /// контакти, P. IVA) — попълва ги администраторът ѝ; проверени при запис и четени с недоверие
  /// (src/aziende/dati.ts). null — още не са записани.
  datiSocietari        Json?
  /// Шаблонът на табелата, избран в настройките (src/cartelli/modelli.ts); непознат или null — първият.
  cartelloModello      String?      @db.VarChar(40)
  /// Имената на ролите във фирмата ({ADMIN: „Titolare“, …}) — сменя ги администраторът ѝ; липсващото
  /// е името по подразбиране (src/auth/permessi.ts).
  nomiRuoli            Json?
  /// Правата на ролите под ADMIN за картите, листовете, табелите и регистъра ({TECNICO: [...], …}) —
  /// сменя ги администраторът ѝ; липсващата роля е по йерархията (src/auth/permessi.ts).
  permessiRuoli        Json?
  /// Версията на условията за услугата, приети за фирмата от неин ADMIN (src/legale/); различна от
  /// текущата — хората ѝ не ползват портала до приемането. Доказателството е в `Accettazione`.
  condizioniVersione   String?      @db.VarChar(20)
  /// Смяната на доставчика (Data Act, чл. 23–30; src/aziende/cambio.ts): поискана от ADMIN на фирмата;
  /// услугата продължава през прехода, който свършва в `cambioFineAt` (30 дни, веднъж удължен) — тогава
  /// фирмата се деактивира. Трите полета са заедно или ги няма (CHECK `Azienda_cambio_check`).
  cambioRichiestoAt    DateTime?
  cambioFineAt         DateTime?
  cambioEsito          CambioEsito?
  /// Преходът е удължен веднъж (чл. 25(5) Data Act — правото е еднократно).
  cambioProrogato      Boolean      @default(false)
  /// Информацията по чл. 13 GDPR на страницата на подписа (листът за интервенция, протоколът), както
  /// фирмата я е написала — тя е администраторът; null — моделът, попълнен с данните ѝ (legale/informativa.ts).
  informativaFirme     String?      @db.VarChar(4000)
  /// Одобрението на две стъпки на картите (C7) — включва го администраторът ѝ; по подразбиране — не.
  approvazioneSchede   Boolean      @default(false)
  /// „Buono di lavoro“: кодът на модула горе вдясно („Mod. PO-05-3 Ed. 02 …“) и клаузата долу — както
  /// фирмата ги е написала в настройките; null — нищо (src/buoni/).
  buonoCodice          String?      @db.VarChar(80)
  buonoClausola        String?      @db.VarChar(1000)
  /// Офертите (C1) — включва ги САМО MASTER на страницата на фирмата; по подразбиране — не.
  preventiviAttivi     Boolean      @default(false)
  /// Последният номер на оферта на фирмата (увеличава се в транзакцията на новата — без дупки и повторения).
  preventiviNumero     Int          @default(0)
  /// Условията за плащане по подразбиране на новата оферта (настройките на фирмата).
  preventivoCondizioni String?      @db.VarChar(2000)
  /// Входът с доставчика на самоличност на клиента (D1, чл. 4.6 на условията): директорията на Microsoft
  /// Entra (tenant ID — GUID с малки букви) и домейнът на Google Workspace (`hd`). Пише ги ADMIN;
  /// null — изключено. Сменени или махнати, свързаните акаунти спират при следващия вход (src/auth/oidc*.ts).
  accessoMicrosoft     String?      @db.VarChar(36)
  accessoGoogle        String?      @db.VarChar(253)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  memberships       Membership[]
  invites           Invite[]
  schede            Scheda[]
  interventi        Intervento[]
  cartelli          Cartello[]
  calcoliArgano     CalcoloArgano[]
  calcoliLimitatore CalcoloLimitatore[]
  verbali           Verbale[]
  fornitori         Fornitore[]
  ordini            OrdineFornitore[]
  buoni             BuonoLavoro[]
  preventivi        Preventivo[]
  listino           VoceListino[]
  audit             AuditLog[]
  accessRequests    AccessRequest[]
  chiaviApi         ChiaveApi[]
}

/// Акаунт. Създава се САМО от приета покана (или от `owner:create` за първия MASTER) — регистрация няма.
/// MASTER е без фирма (вижда всички); всеки друг е в точно една фирма — проверява го и CHECK в базата.
model User {
  id                 String    @id @default(cuid())
  /// Винаги с малки букви (src/auth/email.ts).
  email              String    @unique
  name               String
  passwordHash       String
  /// Собственикът на портала (Carbon Stealth): вижда и управлява всичко, без фирма и без членства.
  master             Boolean   @default(false)
  /// Не се ползва — порталът е само на италиански. Колоната остава („it“), за да не се трие с миграция.
  locale             String    @default("it")
  theme              Theme     @default(AUTO)
  /// Цветовете на темата „Personalizzato“ ({sfondo, testo, menu, menuTesto, accento, linee} — #rrggbb),
  /// проверени при запис и четени с недоверие (src/http/colori.ts). null — няма свои.
  colori             Json?
  /// Деактивиран акаунт не влиза; сесиите му падат при деактивирането.
  deactivatedAt      DateTime?
  /// Първият MASTER от скрипта сменя паролата при първия вход.
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  /// Поредни заключвания без успешен вход между тях — всяко следващо е по-дълго (src/auth/lockout.ts).
  lockouts           Int       @default(0)
  /// Двуфакторният вход (TOTP, RFC 6238) — по избор на всеки човек. Тайната е шифрована (AES-256-GCM,
  /// src/auth/chiavi.ts); преди потвърждението с код `totpEnabledAt` е празно и входът не я иска.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  /// Последната приета стъпка от 30 s: същият код не минава втори път.
  totpLastStep       Int?
  lastLoginAt        DateTime?
  /// Докога човекът е прочел новините на портала (src/novita/): прозорецът показва публикуваните след
  /// това. Нов акаунт — от създаването си (по-старите новини не са новост за него); „Ho capito“ — сега.
  novitaLetteAt      DateTime  @default(now())
  /// Версията на правилата за ползване, които човекът е приел (src/legale/); различна от текущата —
  /// порталът иска приемане, преди да отвори нещо друго. Доказателството е в `Accettazione`.
  regoleVersione     String?   @db.VarChar(20)
  passwordChangedAt  DateTime  @default(now())
  invitedById        String?
  invitedBy          User?     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invitedUsers        User[]                @relation("InvitedUsers")
  memberships         Membership[]
  sessions            Session[]
  invitesSent         Invite[]              @relation("InvitesSent")
  resets              PasswordReset[]       @relation("ResetsFor")
  resetsCreated       PasswordReset[]       @relation("ResetsCreated")
  schedeCreated       Scheda[]              @relation("SchedeCreated")
  schedeUpdated       Scheda[]              @relation("SchedeUpdated")
  schedeDeleted       Scheda[]              @relation("SchedeDeleted")
  allegatiCaricati    Allegato[]            @relation("AllegatiCaricati")
  interventiCreati    Intervento[]          @relation("InterventiCreati")
  interventiMod       Intervento[]          @relation("InterventiModificati")
  interventiChiusi    Intervento[]          @relation("InterventiChiusi")
  cartelliCreati      Cartello[]            @relation("CartelliCreati")
  recoveryCodes       RecoveryCode[]
  firmeCondizioni     FirmaCondizioni[]
  loginChallenges     LoginChallenge[]
  cartelliMod         Cartello[]            @relation("CartelliModificati")
  calcoliArgano       CalcoloArgano[]
  calcoliLimitatore   CalcoloLimitatore[]
  verbaliCreati       Verbale[]             @relation("VerbaliCreati")
  verbaliMod          Verbale[]             @relation("VerbaliModificati")
  verbaliChiusi       Verbale[]             @relation("VerbaliChiusi")
  auditEntries        AuditLog[]
  requestsDecided     AccessRequest[]       @relation("AccessRequestsDecided")
  comunicazioni       Comunicazione[]       @relation("ComunicazioniScritte")
  comunicazioniChiuse ComunicazioneChiusa[]
  identitaEsterne     IdentitaEsterna[]
  postaAggiornata     PostaPortale[]        @relation("PostaAggiornata")
  violazioni          Violazione[]          @relation("ViolazioniScritte")
  schedeApprovate     Scheda[]              @relation("SchedeApprovate")
  versioniScritte     SchedaVersione[]      @relation("VersioniScritte")
  ordiniInviati       OrdineFornitore[]     @relation("OrdiniInviati")
  buoniCreati         BuonoLavoro[]         @relation("BuoniCreati")
  buoniMod            BuonoLavoro[]         @relation("BuoniModificati")
  buoniFirme          BuonoFirma[]          @relation("BuoniFirmati")
  preventiviCreati    Preventivo[]          @relation("PreventiviCreati")
  preventiviMod       Preventivo[]          @relation("PreventiviModificati")
  avvisiStato         AvvisoStato[]         @relation("AvvisiStato")
  chiaviApi           ChiaveApi[]           @relation("ChiaviApi")

  @@index([invitedById])
  @@index([master])
}

/// Членство: човекът е във фирмата с роля (ADMIN…CLIENTE) — различна за всяка фирма. Само MASTER слага
/// и маха членства; MASTER самият няма членства (вижда всички фирми). Извън MASTER — поне едно членство.
model Membership {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aziendaId String
  azienda   Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  role      Role
  createdAt DateTime @default(now())

  @@id([userId, aziendaId])
  @@index([aziendaId])
}

/// Сесия зад бисквитката: JWT-то носи само `sid`, а редът тук решава дали сесията е жива —
/// изход, деактивиране и смяна на ролята я прекратяват веднага.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Плъзгащ се край (бездействие); абсолютният таван се смята от createdAt.
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Покана: връзка с еднократен токен (в базата е само SHA-256 хешът), валидна INVITE_DAYS дни.
model Invite {
  id             String         @id @default(cuid())
  email          String
  name           String?
  role           Role
  /// Не се ползва — порталът е само на италиански. Колоната остава („it“), за да не се трие с миграция.
  locale         String         @default("it")
  /// Фирмата, в която влиза поканеният — избрана от MASTER или фирмата на администратора, който кани.
  aziendaId      String
  azienda        Azienda        @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  tokenHash      String         @unique
  invitedById    String
  invitedBy      User           @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  /// Заявката за достъп, от която е поканата (ако е от заявка).
  accessRequest  AccessRequest?

  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@index([aziendaId])
}

/// Заявка за достъп от публичната страница: фирма иска да влезе в портала. Регистрация няма — MASTER
/// разглежда заявката и при „да“ създава фирмата (или избира съществуваща) и кани администратора ѝ
/// (src/requests/). Изтрива се 180 дни след последната промяна (maintenance.ts) или ръчно от MASTER.
model AccessRequest {
  id          String              @id @default(cuid())
  name        String              @db.VarChar(120)
  company     String              @db.VarChar(120)
  /// Винаги с малки букви (src/auth/email.ts).
  email       String              @db.VarChar(254)
  phone       String?             @db.VarChar(40)
  city        String?             @db.VarChar(120)
  teamSize    TeamSize?
  message     String?             @db.VarChar(2000)
  /// Не се ползва — порталът е само на италиански. Колоната остава („it“), за да не се трие с миграция.
  locale      String              @default("it") @db.VarChar(5)
  status      AccessRequestStatus @default(NEW)
  /// При приемане: фирмата, в която е поканен администраторът, и самата покана.
  aziendaId   String?
  azienda     Azienda?            @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  inviteId    String?             @unique
  invite      Invite?             @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  decidedById String?
  decidedBy   User?               @relation("AccessRequestsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([aziendaId])
  @@index([decidedById])
  @@index([updatedAt])
}

/// Връзка за нова парола: от самия човек („забравена парола“, ако има SMTP) или от по-висок ранг.
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ResetsFor", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("ResetsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdById])
  @@index([expiresAt])
}

/// Схемата на уредбата — полетата и редът им са дословно от заданието (src/schede/fields.ts).
/// N° impianto е низ само от цифри (водещата нула се пази); матрикулата — свободен текст до 40 знака
/// (собственикът, 10 ноември 2026).
model Scheda {
  id                           String                   @id @default(cuid())
  data                         DateTime                 @db.Date
  indirizzo                    String?                  @db.VarChar(200)
  marca                        String?                  @db.VarChar(120)
  matricola                    String?                  @db.VarChar(40)
  numeroImpianto               String?                  @db.VarChar(20)
  /// Работната поръчка, по която е огледът (по желание).
  buonoLavoro                  String?                  @db.VarChar(60)
  portataKg                    Int?
  capienzaPersone              Int?
  fermate                      Int?
  ubicazioneMacchina           UbicazioneMacchina[]
  /// Къде е кутийката — свободен текст (до октомври 2026 беше цяло число: етажът).
  ubicazioneCassettina         String?                  @db.VarChar(120)
  /// „Note locale macchina“ — под мястото на машинното (3 ноември 2026).
  noteLocaleMacchina           String?
  parcheggio                   String?                  @db.VarChar(300)
  tipoImpianto                 TipoImpianto[]
  tipoPorte                    TipoPorte[]
  /// Марката, светлият отвор и напрежението на оператора на вратите не се питат от октомври 2026
  /// (собственикът ги махна); колоните остават със старите отговори.
  operatoreMarca               String?                  @db.VarChar(120)
  lucePorte                    String?                  @db.VarChar(60)
  operatoreTensione            String?                  @db.VarChar(60)
  /// „Accessi: 1 / 2“ на листа — true е 2 достъпа (двоен достъп), false — един.
  doppioAccesso                Boolean?
  /// Блокировката на вратичките, донивелирането и броят шейни не се питат от октомври 2026 (собственикът
  /// ги махна от листа); колоните остават със старите отговори.
  bloccaPortine                Boolean?
  autolivellamento             Boolean?
  /// „Pattino retrattile da cambiare“ — при ръчни и полуавтоматични врати; при true — видът на шейната
  /// (от октомври 2026 в „Serrature o sospensioni“, след бравите).
  pattinoRetrattile            Boolean?
  pattinoRetrattileNumero      Int?
  pattinoRetrattileTipo        String?                  @db.VarChar(120)
  /// Само при ръчни врати (собственикът, 10 ноември 2026).
  contattiAntine               Boolean?
  /// Не `bloccaPortine` — тя е махнатият въпрос от октомври със старите си отговори.
  bloccaPortineDaInstallare    Boolean?
  /// „Serrature da cambiare“ (до октомври 2026 — „Serrature/sospensioni“) — при ръчни и полуавтоматични
  /// врати. numero/tipo — само при true.
  serrature                    Boolean?
  serratureNumero              Int?
  serratureTipo                String?                  @db.VarChar(120)
  /// „Sospensioni da cambiare“ — само при автоматични врати; при true броят и листът 2SG (окачванията и
  /// операторът на кабината).
  sospensioni                  Boolean?
  sospensioniNumero            Int?
  /// „Operatore da cambiare“ — при полуавтоматични врати (на етажите са бравите, кабината е с оператор;
  /// собственикът, 22 октомври 2026) и от 24 октомври и при автоматични; при true — листът 2SG, в същата
