  centralinaMotoreHp           Decimal?                 @db.Decimal(8, 2)
  centralinaPompaLMin          Decimal?                 @db.Decimal(8, 2)
  centralinaAvvio              CentralinaAvviamento?
  centralinaTensioneValvole    String?                  @db.VarChar(40)
  centralinaDiametroTubazione  String?                  @db.VarChar(40)
