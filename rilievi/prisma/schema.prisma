/// Шибърът 0611/HM-SV/AXI: ASS/2 (1" 1/4) или ASS/3 (1" 1/2).
enum Saracinesca {
  ASS_2
  ASS_3
}

/// Частта от деня на интервенцията от хартиения лист: „Matt.“ / „Pom.“.
enum TurnoIntervento {
  MATTINA
  POMERIGGIO
}

/// Лист за интервенция — „Servizio assistenza elevatori · Modulo di pronto intervento“ (собственикът, 30
/// октомври 2026, по хартиения блок): номер за фирмата от 1, отметките 01–97 с бройките си, „Altro“,
/// часовете, подписите на техника и на клиента. Докато е чернова, се пише; след „Conferma“
/// (`confermatoAt`) не се пипа — остават PDF-ът и имейлът. Не се трие (номерата са без дупки).
model Intervento {
  id               String           @id @default(cuid())
  aziendaId        String
  azienda          Azienda          @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  numero           Int
  data             DateTime         @db.Date
  turno            TurnoIntervento?
  indirizzo        String?          @db.VarChar(200)
  citta            String?          @db.VarChar(120)
  tecnici          String?          @db.VarChar(300)
  matricola        String?          @db.VarChar(40)
  /// Отметките по номер („01“…„97“): {x: отметнато, q: бройката или текстът на реда, c: „C“/„P“ на 84}.
  /// Проверени при запис (src/interventi/voci.ts); непознатите номера не влизат.
  voci             Json             @default("{}")
  altro            String?          @db.VarChar(1000)
  prove            Boolean          @default(false)
  oreTecnico       Decimal?         @db.Decimal(6, 2)
  oreTotali        Decimal?         @db.Decimal(6, 2)
  /// Подписите — щрихи с пръст в поле 600 × 200 ({s: [[x, y, x, y, …], …]}) — и имената. Слагат се
  /// само с потвърждението, върху окончателното съдържание (src/interventi/conferma.ts); черновата никога
  /// не ги носи (CHECK `Intervento_firme_check` в базата).
  firmaTecnico     Json?
  firmaTecnicoNome String?          @db.VarChar(120)
  firmaCliente     Json?
  firmaClienteNome String?          @db.VarChar(120)
  confermatoAt     DateTime?
  /// SHA-256 на съдържанието, което е подписано (src/interventi/sigillo.ts) — показан при подписа, в PDF-а.
  impronta         String?          @db.Char(64)
  /// HMAC-SHA256 (INTERVENTI_SEAL_KEY) над отпечатъка, подписите, имената и часа: проверява се при всяко
  /// показване, PDF и имейл — несъвпадение спира PDF-а и имейла.
  sigillo          String?          @db.Char(64)
  /// SHA-256 на щрихите на всеки подпис (sigillo.ts, `improntaFirma`): подпис, който вече стои на друг
  /// лист (копиран от страницата, PDF-а или прихванат), се отказва при потвърждението.
  firmaTecnicoHash String?          @db.Char(64)
  firmaClienteHash String?          @db.Char(64)
  confermatoById   String?
  confermatoBy     User?            @relation("InterventiChiusi", fields: [confermatoById], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?            @relation("InterventiCreati", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?            @relation("InterventiModificati", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([aziendaId, numero])
  @@index([aziendaId, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([confermatoById])
  @@index([firmaTecnicoHash])
  @@index([firmaClienteHash])
}

/// Табелата „Avviso di fermo impianto“ (src/cartelli/): датата, адресът, градът, мястото на уредбата и
/// текстът към хората. Облеклото ѝ е шаблонът, избран от фирмата, а главата — логото и данните ѝ, взети
/// при всяко рисуване на PDF-а.
model Cartello {
  id          String   @id @default(cuid())
  aziendaId   String
  azienda     Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  data        DateTime @db.Date
  indirizzo   String?  @db.VarChar(200)
  citta       String?  @db.VarChar(80)
  ubicazione  String?  @db.VarChar(120)
  testo       String   @db.VarChar(600)
  /// Картата на уредбата, от която е попълнена (същата фирма — проверява се при записа). Окончателно
  /// изтритата карта оставя табелата без връзка; табела без карта е нормална.
  schedaId    String?
  scheda      Scheda?  @relation(fields: [schedaId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("CartelliCreati", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("CartelliModificati", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([aziendaId, createdAt])
  @@index([schedaId, createdAt])
  @@index([createdById])
  @@index([updatedById])
}

/// „Verbale di chiusura cantiere“ (собственикът, 5 ноември 2026, по хартиения лист): от картата на
/// уредбата или без карта; от картата идват само адресът и „N° buono“, датата е днешната — всичко друго
/// пише и избира човекът. Редовете по раздели (src/verbali/voci.ts): текст, а при някои „Certificato“
/// SÌ/NO; накрая „Verbale positivo“ SÌ/NO. Подписват техникът изпълнител и супервайзърът — както листа
/// за интервенция: само с потвърждението, върху окончателното съдържание, с отпечатък и печат; след това
/// не се пипа и излиза в два PDF-а — „Copia azienda“ и „Copia installatore“.
model Verbale {
  id                   String    @id @default(cuid())
  aziendaId            String
  azienda              Azienda   @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  /// Картата, от която е попълнен (същата фирма — проверява се при записа). Окончателно изтритата карта
  /// оставя протокола без връзка; връзката не е в отпечатъка, затова печатът остава верен.
  schedaId             String?
  scheda               Scheda?   @relation(fields: [schedaId], references: [id], onDelete: SetNull)
  data                 DateTime  @db.Date
  indirizzo            String?   @db.VarChar(200)
  buono                String?   @db.VarChar(60)
  /// Редовете по ключ ({t: текстът, c: „si“/„no“ — само при редовете с „Certificato“). Проверени при
  /// запис (src/verbali/voci.ts); непознатите ключове не влизат.
  voci                 Json      @default("{}")
  positivo             Boolean?
  /// Подписите (щрихи 600 × 200, src/interventi/firma.ts) и имената — само с потвърждението
  /// (CHECK `Verbale_firme_check`).
  firmaTecnico         Json?
  firmaTecnicoNome     String?   @db.VarChar(120)
  firmaSupervisore     Json?
  firmaSupervisoreNome String?   @db.VarChar(120)
  confermatoAt         DateTime?
  /// SHA-256 на подписаното съдържание (src/verbali/sigillo.ts).
  impronta             String?   @db.Char(64)
  /// HMAC-SHA256 (INTERVENTI_SEAL_KEY) над отпечатъка, подписите, имената, часа и кой е потвърдил.
  sigillo              String?   @db.Char(64)
  /// SHA-256 на щрихите на всеки подпис: подпис, който вече стои на лист или протокол, се отказва.
  firmaTecnicoHash     String?   @db.Char(64)
  firmaSupervisoreHash String?   @db.Char(64)
  confermatoById       String?
  confermatoBy         User?     @relation("VerbaliChiusi", fields: [confermatoById], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?     @relation("VerbaliCreati", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?     @relation("VerbaliModificati", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([aziendaId, createdAt])
  @@index([schedaId, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([confermatoById])
  @@index([firmaTecnicoHash])
  @@index([firmaSupervisoreHash])
}

/// Изчислението за аргано по „RT-E MOD 10411-1“ на собственика (31 октомври 2026): входът (`argano/dati.ts`,
/// чете се с недоверие), по едно на карта или без карта; резултатите се смятат при всяко показване.
/// Отделна таблица — записът не мести версията на картата (`base`), а окончателно изтритата карта го
/// взима със себе си.
model CalcoloArgano {
  id             String   @id @default(cuid())
  /// Картата на уредбата (едно изчисление на карта); null — изчисление без карта (собственикът, 31
  /// октомври 2026): тогава адресът, матрикулата и номерът са тук (`CalcoloArgano_impianto_check`).
  schedaId       String?  @unique
  scheda         Scheda?  @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  /// Фирмата — на картата или избраната при новото изчисление без карта; обхватът се решава по нея.
  aziendaId      String
  azienda        Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  indirizzo      String?
  matricola      String?
  numeroImpianto String?
  /// Нормализираният адрес, матрикула и номер (като `Scheda.searchText`) — само без карта.
  searchText     String   @default("")
  dati           Json
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedById])
  @@index([aziendaId, updatedAt])
}

/// Изчислението за ограничителя на скоростта по „Limitatore_velocita_EN81-20-2020.xlsx“ на собственика (5
/// ноември 2026): входът (`limitatore/dati.ts`, чете се с недоверие), по едно на карта или без карта —
/// както `CalcoloArgano`; резултатите се смятат при всяко показване. Записът не мести версията на картата,
/// а окончателно изтритата карта го взима със себе си.
model CalcoloLimitatore {
  id             String   @id @default(cuid())
  /// Картата на уредбата; null — изчисление без карта: тогава адресът, матрикулата и номерът са тук
  /// (`CalcoloLimitatore_impianto_check`).
  schedaId       String?  @unique
  scheda         Scheda?  @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  /// Фирмата — на картата или избраната при новото изчисление без карта; обхватът се решава по нея.
  aziendaId      String
  azienda        Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  indirizzo      String?
  matricola      String?
  numeroImpianto String?
  /// Нормализираният адрес, матрикула и номер (като `Scheda.searchText`) — само без карта.
  searchText     String   @default("")
  dati           Json
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedById])
  @@index([aziendaId, updatedAt])
}

/// Резервните кодове на двуфакторния вход: 10, всеки — веднъж; в базата е само HMAC (src/auth/recovery.ts).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, codeHash])
}

/// Вход с вярна парола, който чака втория фактор: сесия още няма. Бисквитката носи токена, тук е само
/// SHA-256; живее 10 минути и дава най-много 5 опита с код (src/services/login-2fa.ts).
model LoginChallenge {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  next      String
  failures  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Грешен вход от мрежа (IPv4 адрес или IPv6 /64) — само HMAC на мрежата, не адресът; пази се ден.
/// Таванът по мрежа (src/auth/rete.ts) важи и след рестарт, и за всички процеси.
model LoginFailure {
  id        String   @id @default(cuid())
  rete      String
  createdAt DateTime @default(now())

  @@index([rete, createdAt])
  @@index([createdAt])
}

/// Кога всяка новина на портала (src/novita/voci.ts) е излязла: при първото пускане на портал, който я
/// знае — на нова инсталация в деня на новината. Текстовете са в речника, тук — само кога.
model Novita {
  id           String   @id
  pubblicataAt DateTime
}

/// Видът на правния текст, който се приема (src/legale/): условията за услугата — за фирмата, от неин ADMIN,
/// със специалното одобрение на клаузите (чл. 1341–1342 c.c.); правилата за ползване — от всеки човек.
enum TipoTesto {
  CONDIZIONI
  REGOLE
}

/// Точният текст на всяка версия, както е бил приет: пише се веднъж при първото приемане на версията и не
/// се сменя никога (src/legale/testi.ts). Доказателството не зависи от историята на репото.
model TestoLegale {
  tipo         TipoTesto
  versione     String    @db.VarChar(20)
  /// SHA-256 (hex) на `testo`.
  hash         String    @db.Char(64)
  testo        String
  registratoAt DateTime  @default(now())

  @@id([tipo, versione])
}

/// Едно приемане — доказателство, не настройка. Без връзки към човека и фирмата: редът остава и след
/// изтриването им (чл. 17, ал. 3, б. „e“ GDPR), със снимка на имената. Пази се докато фирмата съществува
/// и още ANNI_CONSERVAZIONE години след изтриването ѝ (`conservaFino` се мести тогава); изтрива го само
/// поддръжката (src/legale/).
model Accettazione {
  id              String    @id @default(cuid())
  at              DateTime  @default(now())
  tipo            TipoTesto
  versione        String    @db.VarChar(20)
  hash            String    @db.Char(64)
  /// Номерата на клаузите, одобрени специално с отделната отметка и кода (само за CONDIZIONI).
  clausole        String[]  @default([])
  userId          String
  userNome        String    @db.VarChar(120)
  userEmail       String    @db.VarChar(254)
  /// Фирмата на човека към момента и ролята му в нея.
  aziendaId       String?
  aziendaNome     String?   @db.VarChar(120)
  ruolo           Role?
  /// Данните на фирмата, декларирани от ADMIN при приемането (само за CONDIZIONI).
  ragioneSociale  String?   @db.VarChar(200)
  sede            String?   @db.VarChar(300)
  partitaIva      String?   @db.VarChar(20)
  /// Кодът за подписа (FES): до кой адрес, кога е пратен и кога е въведен (само за CONDIZIONI).
  otpEmail        String?   @db.VarChar(254)
  otpInviatoAt    DateTime?
  otpVerificatoAt DateTime?
  /// Адресът и браузърът при приемането (чл. 19.1 от условията; privacy — регистърът на приеманията).
  ip              String?   @db.VarChar(45)
  userAgent       String?   @db.VarChar(300)
  /// SHA-256 на PDF копието, пратено на администратора (само за CONDIZIONI).
  copiaHash       String?   @db.Char(64)
  /// HMAC над всички полета отгоре (src/legale/sigillo.ts): промяна на кое да е се вижда.
  sigillo         String    @db.Char(64)
  conservaFino    DateTime

  @@index([userId, tipo, versione])
  @@index([aziendaId, tipo, versione])
  @@index([conservaFino])
}

/// Чакащ подпис на условията с код (втората стъпка на ADMIN): HMAC на кода, никога самият код. Важи 10
/// минути и веднъж; поддръжката чисти старите.
model FirmaCondizioni {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aziendaId  String
  versione   String    @db.VarChar(20)
  /// Декларираните данни на фирмата от първата стъпка ({ragioneSociale, sede, partitaIva}).
  dichiarati Json
  codiceHmac String    @db.Char(64)
  email      String    @db.VarChar(254)
  inviatoAt  DateTime  @default(now())
  scadeAt    DateTime
  tentativi  Int       @default(0)
  usataAt    DateTime?

  @@index([userId])
  @@index([scadeAt])
}

/// Всеки изтеглен PDF с изчисление — какво е въвел човекът и какво е отпечатал софтуерът (входните данни,
/// редовете на резултата, build-ът, отпечатъкът „Rif.“ от листа). Без връзки: остава и след изтриването
/// на изчислението, картата и фирмата, до `conservaFino` (src/legale/emissioni.ts).
model EmissioneCalcolo {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  /// `argano` | `limitatore` (и бъдещите изчисления).
  calcolo      String   @db.VarChar(20)
  impronta     String   @db.VarChar(14)
  build        String   @db.VarChar(10)
  /// SHA-256 на байтовете на изпратения PDF.
  pdfHash      String   @db.Char(64)
  dati         Json
  risultato    Json
  calcoloId    String?
  schedaId     String?
  aziendaId    String
  aziendaNome  String   @db.VarChar(120)
  userId       String
  userNome     String   @db.VarChar(120)
  userEmail    String   @db.VarChar(254)
  /// HMAC над всички полета отгоре (src/legale/sigillo.ts).
  sigillo      String   @db.Char(64)
  conservaFino DateTime

  @@index([aziendaId, at])
  @@index([impronta])
  @@index([conservaFino])
}

enum LivelloComunicazione {
  INFO
  AVVISO
  URGENTE
}

/// Съобщение на MASTER до фирмите (собственикът, 10 ноември 2026 — „Espandi le funzioni di master“): лента
/// над страниците на портала за хората на избраните фирми (празно `aziendaIds` — всички) в прозореца
/// `inizioAt`…`fineAt`; всеки я затваря за себе си (`ComunicazioneChiusa`). Пише и спира само MASTER
/// (src/master/comunicazioni.ts); в одита — без текста.
model Comunicazione {
  id           String                @id @default(cuid())
  titolo       String                @db.VarChar(120)
  testo        String                @db.VarChar(2000)
  livello      LivelloComunicazione  @default(INFO)
  /// Фирмите, до които е; празно — до всички.
  aziendaIds   String[]              @default([])
  inizioAt     DateTime
  /// Краят на показването; null — докато MASTER не я спре.
  fineAt       DateTime?
  /// Спряна на ръка от MASTER.
  fermataAt    DateTime?
  autoreId     String?
  autore       User?                 @relation("ComunicazioniScritte", fields: [autoreId], references: [id], onDelete: SetNull)
  /// Колко писма до администраторите на фирмите са тръгнали при създаването (null — без писма).
  emailInviate Int?
  createdAt    DateTime              @default(now())
  chiusure     ComunicazioneChiusa[]

  @@index([inizioAt])
  @@index([autoreId])
}

/// Човекът е затворил лентата на съобщението — не я вижда повече.
model ComunicazioneChiusa {
  comunicazioneId String
  comunicazione   Comunicazione @relation(fields: [comunicazioneId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  at              DateTime      @default(now())

  @@id([comunicazioneId, userId])
  @@index([userId])
}

/// Какво ще стане с данните след прехода (Data Act, чл. 25(2)(d)) — изборът на клиента.
enum CambioEsito {
  ALTRO_FORNITORE
  INFRASTRUTTURA_PROPRIA
  CANCELLAZIONE
}

/// Рискът за хората (чл. 33–34 GDPR): малко вероятен — без уведомяване на органа; риск — органът;
/// висок риск — и самите хора.
enum RischioViolazione {
  IMPROBABILE
  RISCHIO
  ELEVATO
}

/// В каква роля сме при нарушението: обработващ (данните на фирмите-клиенти — уведомяваме тях, чл. 33(2))
/// или администратор (нашите обработвания — уведомяваме органа, чл. 33(1)).
enum RuoloViolazione {
  RESPONSABILE
  TITOLARE
}

/// Регистърът на нарушенията на сигурността на личните данни (чл. 33(5) GDPR; src/master/violazioni.ts):
/// пише само MASTER, редове не се трият (доказателство пред надзорния орган); фирмите — като текст, за да
/// надживее изтриването им. Без лични данни отвъд необходимото — описания, не копия.
model Violazione {
  id                    String            @id @default(cuid())
  /// Кога е открито (T0 — от него текат 72-та часа на чл. 33(1)).
  rilevataAt            DateTime
  /// Кога се е случило (оценка), ако се знае.
  eventoAt              DateTime?
  titolo                String            @db.VarChar(160)
  rilevazione           String            @db.VarChar(2000)
  natura                String            @db.VarChar(4000)
  ruolo                 RuoloViolazione
  categorieDati         String            @db.VarChar(2000)
  interessati           String            @db.VarChar(2000)
  aziende               String            @db.VarChar(2000)
  conseguenze           String            @db.VarChar(4000)
  misure                String            @db.VarChar(4000)
  rischio               RischioViolazione
  /// Уведомени администратори на данните (фирмите-клиенти; чл. 33(2) — ние сме обработващ).
  titolariAvvisatiAt    DateTime?
  /// Уведомен надзорен орган (чл. 33(1) — само където ние сме администратор) и номерът при него.
  autoritaNotificataAt  DateTime?
  autoritaProtocollo    String?           @db.VarChar(80)
  /// Уведомени хора (чл. 34).
  interessatiAvvisatiAt DateTime?
  /// Защо е решено така (и защо някой не е уведомен, или защо със закъснение).
  motivazione           String?           @db.VarChar(4000)
  /// Какво научихме и какво променяме.
  lezioni               String?           @db.VarChar(4000)
  chiusaAt              DateTime?
  autoreId              String?
  autore                User?             @relation("ViolazioniScritte", fields: [autoreId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([rilevataAt])
  @@index([autoreId])
}

/// Обявата на нова версия на правен текст (чл. 18.1 на условията; src/legale/annunci.ts): кога е обявена
/// и със кое съобщение. Версията влиза в сила най-рано 30 дни след обявата (src/legale/versioni.ts); без ред
/// тук не влиза никога. Не се трие — доказателството за предизвестието.
model AnnuncioTesto {
  tipo            TipoTesto
  versione        String    @db.VarChar(20)
  annunciatoAt    DateTime  @default(now())
  autoreId        String?
  comunicazioneId String?
  /// Колко писма до администраторите са тръгнали (попълва се след изпращането).
  emailInviate    Int?

  @@id([tipo, versione])
}

/// Одобрението на картата (C7; src/schede/approvazione.ts).
enum StatoApprovazione {
  BOZZA
  INVIATA
  APPROVATA
  RESPINTA
}

/// Пратената поръчка към доставчика (C2): пратена, потвърдена от доставчика (на ръка) или отменена.
enum StatoOrdine {
  INVIATO
  CONFERMATO
  ANNULLATO
}

/// Записаните версии на картата (C4; src/schede/versioni.ts): снимка на полетата и мерките след всеки
/// запис — за разликите между версиите. Пазят се последните 100; падат с картата.
model SchedaVersione {
  id       String   @id @default(cuid())
  schedaId String
  scheda   Scheda   @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  numero   Int
  at       DateTime @default(now())
  autoreId String?
  autore   User?    @relation("VersioniScritte", fields: [autoreId], references: [id], onDelete: SetNull)
  dati     Json

  @@unique([schedaId, numero])
  @@index([autoreId])
}

/// Адресникът на доставчиците на фирмата за поръчките (C2) — пише го администраторът ѝ.
model Fornitore {
  id        String   @id @default(cuid())
  aziendaId String
  azienda   Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  nome      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  createdAt DateTime @default(now())

  @@unique([aziendaId, email])
}

/// Модул за поръчка, пратен от портала на доставчика (C2; src/ordini/invio.ts): кой, кога, до кого, кой
/// модул и състоянието. Пази адреса — той е поръчката (износът го носи, Allegato B, B.7 k).
model OrdineFornitore {
  id                String      @id @default(cuid())
  aziendaId         String
  azienda           Azienda     @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  schedaId          String
  scheda            Scheda      @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  modulo            String      @db.VarChar(60)
  destinatarioNome  String      @db.VarChar(120)
  destinatarioEmail String      @db.VarChar(254)
  messaggio         String?     @db.VarChar(2000)
  stato             StatoOrdine @default(INVIATO)
  inviatoAt         DateTime    @default(now())
  inviatoDaId       String?
  inviatoDa         User?       @relation("OrdiniInviati", fields: [inviatoDaId], references: [id], onDelete: SetNull)
  confermatoAt      DateTime?
  nota              String?     @db.VarChar(1000)
  updatedAt         DateTime    @updatedAt

  @@index([aziendaId, stato])
  @@index([schedaId])
  @@index([inviatoDaId])
}

/// „Buono di lavoro“ (собственикът, 12 ноември 2026 — по хартиения лист; src/buoni/): общите данни,
/// редовете с работа (`sequenze` — JSON, проверен при запис и четен с недоверие), шестте проверки
/// (`controlli`), отчетът и фамилиите на техниците. Подписите — в `BuonoFirma`, всеки по избор.
model BuonoLavoro {
  id             String       @id @default(cuid())
  aziendaId      String
  azienda        Azienda      @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  /// Картата, от която е попълнен (същата фирма — проверява се при записа); окончателно изтритата я нулира.
  schedaId       String?
  scheda         Scheda?      @relation(fields: [schedaId], references: [id], onDelete: SetNull)
  numero         String?      @db.VarChar(40)
  dataConferma   DateTime?    @db.Date
  geometra       String?      @db.VarChar(80)
  ordine         String?      @db.VarChar(40)
  offerta        String?      @db.VarChar(40)
  inizioPrevisto DateTime?    @db.Date
  finePrevista   DateTime?    @db.Date
  matricola      String?      @db.VarChar(40)
  ubicazione     String?      @db.VarChar(200)
  pos            Boolean?
  note           String?      @db.VarChar(4000)
  /// [{id, descrizione, esito: "ok"|"nonOk"|null, data: "YYYY-MM-DD"|null, fornitore}] — до 30.
  sequenze       Json         @default("[]")
  /// {<ключ на проверката>: {esito, data}} — ключовете от src/buoni/voci.ts.
  controlli      Json         @default("{}")
  noteControlli  String?      @db.VarChar(4000)
  inizioLavori   DateTime?    @db.Date
  inizioOra      String?      @db.VarChar(5)
  fineLavori     DateTime?    @db.Date
  fineOra        String?      @db.VarChar(5)
  sospensioni    String?      @db.VarChar(4000)
  tecnici        String?      @db.VarChar(200)
  /// Нормализираният текст за търсене (номер, матрикула, място, поръчка, оферта, геометър).
  searchText     String       @default("")
  createdById    String?
  createdBy      User?        @relation("BuoniCreati", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("BuoniModificati", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  firme          BuonoFirma[]

  @@index([aziendaId, createdAt])
  @@index([schedaId, createdAt])
  @@index([createdById])
  @@index([updatedById])
}

/// Подпис на „Buono di lavoro“: мястото (`s-<ред>`, `c-<проверка>`, `f-<подпис долу>` — src/buoni/posti.ts),
/// щрихите (600 × 200, src/interventi/firma.ts), SHA-256 на щрихите (копиран подпис се отказва в целия
/// портал), SHA-256 на подписаното и печатът HMAC (src/buoni/firme.ts).
model BuonoFirma {
  id          String      @id @default(cuid())
  buonoId     String
  buono       BuonoLavoro @relation(fields: [buonoId], references: [id], onDelete: Cascade)
  posto       String      @db.VarChar(24)
  tratti      Json
  hash        String      @db.Char(64)
  impronta    String      @db.Char(64)
  sigillo     String      @db.Char(64)
  firmatoAt   DateTime
  /// Кой е бил вписан, когато подписът е взет (подписва друг — техникът, пазачът; това е устройството).
  firmatoDaId String?
  firmatoDa   User?       @relation("BuoniFirmati", fields: [firmatoDaId], references: [id], onDelete: SetNull)

  @@unique([buonoId, posto])
  @@index([hash])
  @@index([firmatoDaId])
}

enum StatoPreventivo {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

/// Оферта към клиента на фирмата (C1; src/preventivi/): номерът е на фирмата, от 1; редовете — JSON с
/// цели числа (центове, хилядни, стотни от процента — preventivi/importi.ts), проверен при запис и четен с
/// недоверие; сборовете се смятат на сървъра при всеки запис и се пазят за списъка. Не е фактура.
model Preventivo {
  id               String          @id @default(cuid())
  aziendaId        String
  azienda          Azienda         @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  schedaId         String?
  scheda           Scheda?         @relation(fields: [schedaId], references: [id], onDelete: SetNull)
  numero           Int
  data             DateTime        @db.Date
  validitaGiorni   Int             @default(30)
  cliente          String          @db.VarChar(200)
  clienteIndirizzo String?         @db.VarChar(300)
  clientePiva      String?         @db.VarChar(20)
  clienteEmail     String?         @db.VarChar(254)
  oggetto          String          @db.VarChar(300)
  impianto         String?         @db.VarChar(300)
  /// [{codice, descrizione, unita, quantita, prezzo, sconto, iva}] — до 100.
  righe            Json            @default("[]")
  note             String?         @db.VarChar(4000)
  condizioni       String?         @db.VarChar(2000)
  imponibile       Int             @default(0)
  imposta          Int             @default(0)
  totale           Int             @default(0)
  stato            StatoPreventivo @default(BOZZA)
  statoAt          DateTime?
  searchText       String          @default("")
  createdById      String?
  createdBy        User?           @relation("PreventiviCreati", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?           @relation("PreventiviModificati", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([aziendaId, numero])
  @@index([aziendaId, createdAt])
  @@index([schedaId])
  @@index([createdById])
  @@index([updatedById])
}

/// Ред от ценоразписа на фирмата (C1): цената в центове, ставката на ДДС; оттам се попълват редовете на
/// офертата. До 1000 на фирма.
model VoceListino {
  id          String   @id @default(cuid())
  aziendaId   String
  azienda     Azienda  @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  codice      String?  @db.VarChar(30)
  descrizione String   @db.VarChar(300)
  unita       String   @db.VarChar(12)
  prezzo      Int
  iva         Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([aziendaId, codice])
  @@index([aziendaId, descrizione])
}

/// Какво казва `/stato` (чл. 2.4 от условията, версия 2027-01-12): прекъсване в ход или планирана
/// поддръжка, написани от MASTER. `fine` празно — прекъсването още трае. Не се трие: историята е на страницата.
model AvvisoStato {
  id          String          @id @default(cuid())
  tipo        TipoAvvisoStato
  titolo      String          @db.VarChar(160)
  testo       String          @db.VarChar(2000)
  inizio      DateTime
  fine        DateTime?
  createdById String?
  createdBy   User?           @relation("AvvisiStato", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([inizio])
  @@index([createdById])
}

enum TipoAvvisoStato {
  INTERRUZIONE
  MANUTENZIONE
}

/// Ключ за API само за четене на фирма (D2): в базата — префиксът (за търсене) и HMAC на тайната част; самият
/// ключ се показва веднъж. Изтича (`scadeAt`), отменя се (`revocataAt`); не влиза в износа (Allegato B, B.7).
model ChiaveApi {
  id          String    @id @default(cuid())
  aziendaId   String
  azienda     Azienda   @relation(fields: [aziendaId], references: [id], onDelete: Cascade)
  nome        String    @db.VarChar(80)
  prefisso    String    @unique @db.VarChar(16)
  hash        String    @db.VarChar(64)
  scadeAt     DateTime
  usataAt     DateTime?
  revocataAt  DateTime?
  createdById String?
  createdBy   User?     @relation("ChiaviApi", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([aziendaId])
  @@index([createdById])
}

enum FornitoreIdentita {
  MICROSOFT
  GOOGLE
}

/// Акаунтът на човека при доставчика на самоличност на клиента (D1): свързва го самият човек от „Account“ с
/// паролата си; входът го намира САМО по `soggetto` — никога по имейл. Не влиза в износа (B.8 b).
model IdentitaEsterna {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fornitore      FornitoreIdentita
  /// Microsoft: `<tid>:<oid>` (oid е единствен в директорията си); Google: `sub`.
  soggetto       String            @db.VarChar(200)
  /// Директорията (tid) или домейнът (hd), от които е дошъл — входът ги сверява с настройката на фирмата.
  organizzazione String            @db.VarChar(253)
  /// Имейлът/UPN от токена — само за да го види човекът в „Account“.
  etichetta      String?           @db.VarChar(254)
  createdAt      DateTime          @default(now())
  usataAt        DateTime?

  @@unique([fornitore, soggetto])
  @@unique([userId, fornitore])
}

/// Пощата на портала (#32 — Brevo SMTP), настроена от MASTER в конзолата: един ред (`id` = "posta"). Докато
/// е включена, е над SMTP_* от средата. Ключът — шифрован (AES-256-GCM, src/auth/chiavi.ts), никога показан.
model PostaPortale {
  id            String   @id @default("posta") @db.VarChar(10)
  host          String   @db.VarChar(253)
  porta         Int
  utente        String   @db.VarChar(254)
  passwordEnc   String
  mittenteNome  String   @db.VarChar(80)
  mittenteEmail String   @db.VarChar(254)
  attiva        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedBy     User?    @relation("PostaAggiornata", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}
