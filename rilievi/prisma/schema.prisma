// Rilievi Impianti — схема на данните. PostgreSQL, миграции само през `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Седем нива както в ERP Ascensori: по-малкият номер включва правата на по-големия
/// (MASTER 1 … CLIENTE 7). Правата се проверяват по СПОСОБНОСТ в src/auth/roles.ts.
enum Role {
  MASTER
  ADMIN
  DIREZIONE
  RESPONSABILE
  TECNICO
  OPERATORE
  CLIENTE
}

enum Theme {
  AUTO
  LIGHT
  DARK
}

enum UbicazioneMacchina {
  ALTO
  BASSO
}

enum TipoImpianto {
  ELETTRICO
  IDRAULICO
  GEARLESS
}

enum TipoPorte {
  AUTOMATICHE
  SEMIAUTOMATICHE
  MANUALI
}

/// Наличната аварийна връзка (telesoccorso): пълна или без периферно устройство.
enum TelesoccorsoStato {
  COMPLETO
  MANCA_PERIFERICA
}

/// Марката на таблото за поръчка; при Pelazza — техният модул за поръчка.
enum QuadroMarca {
  PELAZZA
  MOVILIFT
  DMG
  MASTECH
  ALTRO
}

/// Марката на аргано (машината); при Montanari — тяхното запитване за оферта.
enum ArganoMarca {
  MONTANARI
  ALTRO
}

/// Фирма — клиент на портала: свои хора, свои карти, свое лого на листа. Създава я само MASTER
/// (собственикът на портала); всяка фирма вижда само своето (src/auth/scope.ts).
model Azienda {
  id            String    @id @default(cuid())
  name          String    @unique @db.VarChar(120)
  /// Логото за листа и PDF-а — вече прекодирано от src/aziende/logo.ts (PNG или JPEG, без метаданни).
  logo          Bytes?
  logoType      String?   @db.VarChar(20)
  logoWidth     Int?
  logoHeight    Int?
  logoUpdatedAt DateTime?
  /// Деактивирана фирма: хората ѝ не влизат и сесиите им падат; картите ѝ остават.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users   User[]
  invites Invite[]
  schede  Scheda[]
  audit   AuditLog[]
}

/// Акаунт. Създава се САМО от приета покана (или от `owner:create` за първия MASTER) — регистрация няма.
/// MASTER е без фирма (вижда всички); всеки друг е в точно една фирма — проверява го и CHECK в базата.
model User {
  id                 String    @id @default(cuid())
  /// Винаги с малки букви (src/auth/email.ts).
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  locale             String    @default("it")
  theme              Theme     @default(AUTO)
  /// Деактивиран акаунт не влиза; сесиите му падат при деактивирането.
  deactivatedAt      DateTime?
  /// Първият MASTER от скрипта сменя паролата при първия вход.
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  aziendaId          String?
  azienda            Azienda?  @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  invitedById        String?
  invitedBy          User?     @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invitedUsers  User[]          @relation("InvitedUsers")
  sessions      Session[]
  invitesSent   Invite[]        @relation("InvitesSent")
  resets        PasswordReset[] @relation("ResetsFor")
  resetsCreated PasswordReset[] @relation("ResetsCreated")
  schedeCreated Scheda[]        @relation("SchedeCreated")
  schedeUpdated Scheda[]        @relation("SchedeUpdated")
  schedeDeleted Scheda[]        @relation("SchedeDeleted")
  auditEntries  AuditLog[]

  @@index([invitedById])
  @@index([role])
  @@index([aziendaId])
}

/// Сесия зад бисквитката: JWT-то носи само `sid`, а редът тук решава дали сесията е жива —
/// изход, деактивиране и смяна на ролята я прекратяват веднага.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Плъзгащ се край (бездействие); абсолютният таван се смята от createdAt.
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// Покана: връзка с еднократен токен (в базата е само SHA-256 хешът), валидна INVITE_DAYS дни.
model Invite {
  id             String    @id @default(cuid())
  email          String
  name           String?
  role           Role
  locale         String    @default("it")
  /// Фирмата, в която влиза поканеният — избрана от MASTER или фирмата на администратора, който кани.
  aziendaId      String
  azienda        Azienda   @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  tokenHash      String    @unique
  invitedById    String
  invitedBy      User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
  @@index([aziendaId])
}

/// Връзка за нова парола: от самия човек („забравена парола“, ако има SMTP) или от по-висок ранг.
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ResetsFor", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("ResetsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdById])
  @@index([expiresAt])
}

/// Схемата на уредбата — полетата и редът им са дословно от заданието (src/schede/fields.ts).
/// Идентификаторите (matricola, numeroImpianto) са низове само от цифри: водещата нула се пази.
model Scheda {
  id                      String               @id @default(cuid())
  data                    DateTime             @db.Date
  indirizzo               String?              @db.VarChar(200)
  marca                   String?              @db.VarChar(120)
  matricola               String?              @db.VarChar(20)
  numeroImpianto          String?              @db.VarChar(20)
  /// Работната поръчка, по която е огледът (по желание).
  buonoLavoro             String?              @db.VarChar(60)
  portataKg               Int?
  capienzaPersone         Int?
  fermate                 Int?
  ubicazioneMacchina      UbicazioneMacchina[]
  ubicazioneCassettina    Int?
  parcheggio              String?              @db.VarChar(300)
  tipoImpianto            TipoImpianto[]
  tipoPorte               TipoPorte[]
  /// Операторът на вратите — само при автоматични/полуавтоматични врати (иначе null).
  operatoreMarca          String?              @db.VarChar(120)
  lucePorte               String?              @db.VarChar(60)
  operatoreTensione       String?              @db.VarChar(60)
  doppioAccesso           Boolean?
  /// Само при ръчни врати; шейната — при ръчни и полуавтоматични, броят — при true.
  bloccaPortine           Boolean?
  autolivellamento        Boolean?
  pattinoRetrattile       Boolean?
  pattinoRetrattileNumero Int?
  /// „Serrature/sospensioni“. null — не е отбелязано; numero/tipo имат смисъл само при true.
  serrature               Boolean?
  serratureNumero         Int?
  serratureTipo           String?              @db.VarChar(120)
  /// Осветлението на шахтата е за смяна.
  luceVanoSostituire      Boolean?
  funiDiametroMm          Decimal?             @db.Decimal(6, 2)
  funiTrefoli             Int?
  funiNumero              Int?
  funiLunghezzaM          Decimal?             @db.Decimal(8, 2)
  limitatoreTipo          String?              @db.VarChar(120)
  funicellaDiametroMm     Decimal?             @db.Decimal(6, 2)
  funicellaLunghezzaM     Decimal?             @db.Decimal(8, 2)
  tenditore               String?              @db.VarChar(120)
  caviNumero              Int?
  caviConduttori          Int?
  caviLunghezzaM          Decimal?             @db.Decimal(8, 2)
  /// Аварийна връзка; състоянието има смисъл само при true.
  telesoccorso            Boolean?
  telesoccorsoStato       TelesoccorsoStato?
  allarmePortineria       Boolean?
  displayPortineria       Boolean?
  noteQuadretto           String?
  noteImpianto            String?
  noteBottoniere          String?
  /// „Мерки на старите бутониери?“ — при true редовете са в MisuraBottoniera.
  bottoniereMisure        Boolean?
  misureBottoniere        MisuraBottoniera[]
  lavoriExtra             String?
  quadroMarca             QuadroMarca?
  quadroMarcaAltro        String?              @db.VarChar(120)
  /// „Да попълня ли модула за поръчка на таблото?“ — само при Pelazza.
  quadroOrdine            Boolean?
  /// Модулът за поръчка на Pelazza: {modulo, valori} — ключовете са в assets/moduli/*.json. Има свой PDF.
  ordineQuadro            Json?
  arganoMarca             ArganoMarca?
  arganoMarcaAltro        String?              @db.VarChar(120)
  /// „Да попълня ли запитването за аргано?“ — само при Montanari.
  arganoPreventivo        Boolean?
  /// Запитването за оферта на Montanari: {modulo, valori}. Има свой PDF.
  preventivoArgano        Json?
  /// Нормализиран текст за търсачката (малки букви, без ударения) — пише го САМО src/schede/service.ts.
  searchText              String               @default("")
  /// Фирмата на картата — тази на създателя (или избраната от MASTER). Вижда я само тази фирма и MASTER.
  aziendaId               String
  azienda                 Azienda              @relation(fields: [aziendaId], references: [id], onDelete: Restrict)
  createdById             String?
  createdBy               User?                @relation("SchedeCreated", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById             String?
  updatedBy               User?                @relation("SchedeUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  /// Кошче: изтритата схема се пази, докато ADMIN не я възстанови или изтрие окончателно.
  deletedAt               DateTime?
  deletedById             String?
  deletedBy               User?                @relation("SchedeDeleted", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([aziendaId, deletedAt])
  @@index([data])
  @@index([matricola])
  @@index([numeroImpianto])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Одит: кой, какво, кога — без съдържание на схемите и без IP. Само добавяне, маршрут за промяна няма.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  /// Фирмата, за която е събитието — администраторът ѝ вижда само тях; null — събитие на портала.
  aziendaId  String?
  azienda    Azienda? @relation(fields: [aziendaId], references: [id], onDelete: SetNull)
  targetType String?
  targetId   String?
  /// Малки неличностни подробности (напр. стара/нова роля). Никога пароли, токени или текст от схема.
  meta       Json?

  @@index([at])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([aziendaId, at])
}

/// Мерките на една стара бутониера — ред за спирка (1 = най-ниската), до броя „Fermate“ на картата.
/// Пише ги само src/schede/service.ts (заедно с картата, в една транзакция); изтриват се с нея.
model MisuraBottoniera {
  id                 String   @id @default(cuid())
  schedaId           String
  scheda             Scheda   @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  fermata            Int
  /// Името на етажа („T“, „S1“); null — номерът на спирката.
  piano              String?  @db.VarChar(20)
  lunghezzaMm        Decimal? @db.Decimal(7, 2)
  larghezzaMm        Decimal? @db.Decimal(7, 2)
  interasseSuperiore String?  @db.VarChar(60)
  interasseInferiore String?  @db.VarChar(60)
  display            Boolean?

  @@unique([schedaId, fermata])
}
