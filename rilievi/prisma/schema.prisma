enum CentralinaAlimentazione {
  TRIFASE_400
  MONOFASE_230
  ALTRO
}

enum CentralinaAvviamento {
  DIRETTO
  STELLA_TRIANGOLO
  SOFT_STARTER
  INVERTER
}

enum Tubazione {
  RIGIDA
  FLESSIBILE
}

enum CentralinaMotore {
  IMMERSO
  ESTERNO
}

enum OlioLivello {
