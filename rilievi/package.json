{
  "name": "rilievi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rilievi Impianti by Carbon Stealth VCC — портал само с покана за схеми на асансьорни уредби: попълване, търсене, печат и PDF.",
  "license": "UNLICENSED",
  "author": "Carbon Stealth VCC",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefkostefko92-ux/Few-few.git",
    "directory": "rilievi"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "Carbon Stealth",
    "rilievi impianti",
    "scheda rilievo ascensore",
    "manutenzione ascensori",
    "matricola impianto",
    "elevator survey"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/fonts.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "prisma generate && npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "owner:create": "node dist/scripts/create-owner.js",
    "brand:images": "node scripts/brand-images.mjs",
    "brand:logo": "node scripts/logo/encode.mjs",
    "moduli:disegna": "node scripts/moduli/2sg.mjs && node scripts/moduli/ami100.mjs && prettier --write assets/moduli/2sg-ordine-porte.json assets/moduli/ami100-mono-*.json",
    "render:encode": "node scripts/render/encode.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "axe-core": "^4.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
