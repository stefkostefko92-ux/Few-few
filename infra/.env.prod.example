# АСО production env — copy to ".env" next to docker-compose.prod.yml and fill in.
# Generate each secret with:  openssl rand -hex 32

# ── GHCR images (owner is your GitHub username, lowercase) ──
IMAGE_OWNER=stefkostefko92-ux
IMAGE_TAG=latest

# ── Host ports (must be free; 8080 is taken by Pterodactyl Wings) ──
API_HOST_PORT=4500
RT_HOST_PORT=4501
WEB_HOST_PORT=4502
MK_HOST_PORT=8090

# ── Database / secrets ──
POSTGRES_USER=aso
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aso
JWT_SECRET=CHANGE_ME_32_HEX
JWT_REFRESH_SECRET=CHANGE_ME_32_HEX
INTERNAL_API_SECRET=CHANGE_ME_24_HEX

# ── Public URLs (use your domain once the reverse proxy is set; IP works for testing) ──
CORS_ORIGINS=http://46.225.136.10:4502
PUBLIC_WEB_URL=http://46.225.136.10:4502
COOKIE_DOMAIN=

# ── Stripe (optional; leave blank to disable the shop) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Watchtower ──
# Seconds between GHCR checks. 60 = near-instant after a deploy; raise to reduce load.
WATCHTOWER_INTERVAL=60
DOCKER_CONFIG_JSON=/root/.docker/config.json
