// ERP Ascensori Enterprise — схема v3.0 по „Documentazione tecnica"
// PostgreSQL 16 · Prisma ORM · Node.js 20
// 24 таблици · 13 енумерации · UUID PK · createdAt/updatedAt навсякъде

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Енумерации ──────────────────────────────────────────────────────────────

enum UserRole {
  MASTER
  ADMIN
  DIREZIONE
  RESPONSABILE
  TECNICO
  OPERATORE
  CLIENTE
}

enum StatoImpianto {
  ATTIVO
  FERMO
  MANUTENZIONE
  FUORI_SERVIZIO
  /// Спрян ПО ЗАКОН, не по повреда.
  ///
  /// При отрицателна периодична проверка проверяващият уведомява Общината, а
  /// собственикът е длъжен да изведе уредбата от служба НЕЗАБАВНО (чл. 14, ал.
  /// 2 D.P.R. 162/1999). Пускането ѝ пак иска нова положителна проверка — не е
  /// решение на поддържащата фирма. Затова е отделно състояние: „FERMO" е
  /// повреда, която ние оправяме; това е забрана.
  FERMO_AMMINISTRATIVO
  DISMESSO
}

/// Кой вид уредба е — режимите се различават по закон.
enum TipoImpianto {
  ASCENSORE
  MONTACARICHI
  /// Платформа за трудноподвижни хора (D.P.R. 162/1999, чл. 1, ал. 2).
  PIATTAFORMA_ELEVATRICE
  MONTASCALE
  SCALA_MOBILE
  MONTAVIVANDE
}

/// Правният режим, по който уредбата е пусната в служба.
///
/// Определя коя нормативна уредба важи: за уредба отпреди 1999 г. се прилага
/// D.P.R. 1497/1963 с преходните правила, за по-новите — директивата за
/// асансьорите. Смесването им дава грешен срок и грешен списък проверки.
enum RegimeImpianto {
  /// Пусната преди D.P.R. 162/1999 (заварена).
  PREESISTENTE
  /// Директива 95/16/CE, транспонирана с D.P.R. 162/1999.
  DIRETTIVA_95_16
  /// Директива 2014/33/UE.
  DIRETTIVA_2014_33
}

enum TipoVerifica {
  /// Двугодишната по чл. 13 D.P.R. 162/1999, от нотифициран орган или ASL/ARPA.
  PERIODICA
  /// Извънредна по чл. 14: след злополука или след съществено изменение.
  STRAORDINARIA
  /// Първата, преди пускането в служба.
  MESSA_IN_SERVIZIO
}

enum EsitoVerifica {
  POSITIVO
  /// Положителна, но с предписания и срок за изпълнението им.
  CON_PRESCRIZIONI
  /// Отрицателна: уредбата се извежда от служба НЕЗАБАВНО.
  NEGATIVO
}

/// Какъв е бил визитът — от него зависи какво е задължително да се провери.
enum TipoIntervento {
  MANUTENZIONE_ORDINARIA
  /// Шестмесечните проверки по чл. 15, ал. 4 D.P.R. 162/1999.
  VERIFICA_SEMESTRALE
  RIPARAZIONE
  EMERGENZA
  /// Освобождаване на блокирани хора — брои се отделно за времената за отзив.
  SOCCORSO
  SOSTITUZIONE_COMPONENTI
}

enum StatoOrdine {
  BOZZA
  EMESSO
  CONFERMATO
  IN_LAVORO
  SOSPESO
  COMPLETATO
  CHIUSO
  CONTESTATO
  ANNULLATO
}

enum PrioritaOrdine {
  ORDINARIA
  URGENTE
  EMERGENZA
}

enum StatoPreventivo {
  BOZZA
  INVIATO
  APPROVATO
  RIFIUTATO
  SCADUTO
}

enum TipoFattura {
  EMESSA
  RICEVUTA
}

/// Пътят на документа през Sistema di Interscambio — РАЗЛИЧЕН от `StatoFattura`.
///
/// Смесването на двете е скъпа грешка: „изпратена" не значи „платена", а
/// SCARTATA значи, че документът НИКОГА не е бил издаден — номерът остава
/// свободен и същият се преиздава в 5-дневен срок (циркуляр 13/E от 2018 г.
/// на Agenzia delle Entrate).
enum StatoSdi {
  NON_INVIATA
  /// XML-ът е издаден, чака подаване.
  GENERATA
  INVIATA
  /// RC — доставена на получателя.
  CONSEGNATA
  /// MC — SDI не намери канала. Документът Е издаден: стои в кутията на
  /// получателя в AdE, а подателят е длъжен да го уведоми по друг път.
  MANCATA_CONSEGNA
  /// NS — отхвърлена. Не е издадена; 5 дни за преиздаване със СЪЩИЯ номер.
  SCARTATA
  /// NE + EC01 (само публична администрация).
  ACCETTATA
  /// NE + EC02 (само публична администрация).
  RIFIUTATA
  /// DT — PA не се произнесе в 15 дни; равносилно на приемане.
  DECORSI_TERMINI
}

enum TipoNotificaSdi {
  RC
  NS
  MC
  NE
  DT
  AT
}

/// Плащането е ОТДЕЛНО измерение от жизнения цикъл на документа: фактура може
/// да е доставена през SDI и неплатена, или платена частично.
enum StatoPagamentoFattura {
  NON_PAGATA
  PARZIALE
  PAGATA
}

enum StatoFattura {
  BOZZA
  EMESSA
  INVIATA
  PAGATA
  SCADUTA
  STORNATA
}

enum TipoAmministratore {
  PERSONA_FISICA
  SOCIETA
}

enum TipoDipendente {
  TECNICO
  AMMINISTRATIVO
  COMMERCIALE
  MAGAZZINIERE
}

enum TipoCottimista {
  DITTA_INDIVIDUALE
  COOPERATIVA
  AZIENDA
}

enum TipoMagazzino {
  COMPONENTI
  VENDITA
}

enum TipoMovimento {
  ENTRATA
  USCITA
  RETTIFICA
}

// Договорът за поддръжка е източникът на приходите на асансьорна фирма: тя
// живее от canone, не от единични ордини.
enum StatoContratto {
  BOZZA
  ATTIVO
  SOSPESO
  SCADUTO
  DISDETTO
}

/// Периодичност — на посещенията и на фактурирането поотделно: типично е
/// „две посещения годишно, фактура на тримесечие".
enum Periodicita {
  MENSILE
  BIMESTRALE
  TRIMESTRALE
  QUADRIMESTRALE
  SEMESTRALE
  ANNUALE
}

/// Изходът от намесата — техникът го избира на място.
enum EsitoIntervento {
  RISOLTO
  DA_COMPLETARE
  RINVIATO
  NON_RISOLVIBILE
}

enum TipoDocumento {
  CARTELLO_CANTIERE
  VERBALE_CANTIERE
  CERTIFICATO
  CONTRATTO
  ALTRO
}

// ─── Система ────────────────────────────────────────────────────────────────

// Мулти-фирмени инсталации: всяка редица е фирма-клиент със свой лицензен план.
model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  slug                 String    @unique
  ragioneSociale       String
  email                String
  piano                String    @default("TRIAL") // TRIAL, STARTER, PROFESSIONAL, ENTERPRISE
  attivo               Boolean   @default(true)
  scadenzaAbbonamento  DateTime? // след тази дата достъпът се отказва с 402
  stripeCustomerId     String?
  stripeSubscriptionId String?
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users     User[]
  auditLogs AuditLog[]

  @@map("tenants")
}

/// Фискалната самоличност на ИЗДАВАЩАТА фирма (cedente/prestatore).
///
/// Отделно от `Tenant`, защото при еднофирмена инсталация `tenantId` е `null`
/// и запис в `Tenant` изобщо няма — а данните на издателя трябват на всеки
/// документ: чл. 1, ал. 3 D.P.R. 472/1996 иска generalità del cedente върху
/// DDT, а бъдещият XML за SDI иска и повече. Един ред на фирма (вкл. `null`).
model DatiAzienda {
  id              String   @id @default(uuid()) @db.Uuid
  ragioneSociale  String
  partitaIva      String?
  codiceFiscale   String?
  indirizzo       String?
  cap             String?
  citta           String?
  provincia       String?
  telefono        String?
  email           String?
  pec             String?
  /// Codice destinatario / codice SDI за е-фактурата.
  codiceSdi       String?
  /// Данъчен режим по кодировката на SDI (RF01 = обикновен, RF19 = forfettario).
  /// Задължителен реквизит на `CedentePrestatore` — без него XML-ът се отхвърля.
  regimeFiscale   String   @default("RF01")
  iban            String?
  /// Регистрация в търговския регистър (REA) — влиза в подписа на документите.
  rea             String?
  capitaleSociale String?
  /// Бележка под линия на печатните документи (условия на плащане и подобни).
  notePiePagina   String?
  /// Кой получава известията за срокове. Списък с адреси, разделени със запетая.
  ///
  /// ОТДЕЛНО от `email` (адреса на фирмата върху фактурите): известието за
  /// изтичаща законова проверка трябва да стигне до техническия отговорник, а
  /// не в общата кутия „info@", която никой не отваря.
  emailAvvisi     String?
  /// Изпращат ли се известията изобщо. ИЗКЛЮЧЕНО по подразбиране — включването
  /// е съзнателно действие, защото праща поща от името на фирмата.
  avvisiAttivi    Boolean  @default(false)
  tenantId        String?  @unique @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("dati_azienda")
}

/// Изходящо известие — ОПАШКА, не изпращане.
///
/// Същото разделение като при webhook-ите и по същата причина: автоматизмът за
/// сроковете ЗАПИСВА известието в своята транзакция (бързо, надеждно), а друг
/// процес го праща (бавно, през чужд сървър). Слети в едно, паднало реле
/// проваля целия пуск на автоматизма — тоест чужд пощенски сървър решава дали
/// сроковете на импиантите ще се вдигнат.
///
/// СЪДЪРЖАНИЕТО Е МИНИМАЛНО. В тялото влизат матрикола, вид срок, дата и
/// връзка към записа — не имена на живи хора, не адреси на кондомини.
/// Известието пътува през реле на трета страна и остава в кутията на
/// получателя завинаги; чл. 5(1)(в) ОРЗД иска точно това ограничение.
model Notifica {
  id                String        @id @default(uuid()) @db.Uuid
  tipo              TipoNotifica
  /// Идемпотентен ключ: „scadenza:<id>:90". С него вторият пуск на автоматизма
  /// в същия ден НЕ праща същото известие втори път.
  chiave            String
  destinatario      String
  oggetto           String
  corpo             String
  stato             StatoNotifica @default(IN_ATTESA)
  tentativi         Int           @default(0)
  prossimoTentativo DateTime      @default(now())
  inviataAt         DateTime?
  /// Причината за последния неуспех — КОД и стъпка, никога отговорът на релето
  /// дословно (той носи адреса на получателя и е на английски).
  ultimoErrore      String?
  tenantId          String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, chiave, destinatario])
  /// Опашката се чете по „чакащи, чието време е дошло" — това е индексът за нея.
  @@index([stato, prossimoTentativo])
  @@index([tenantId])
  @@map("notifiche")
}

enum TipoNotifica {
  SCADENZA_IMPIANTO
  SCADENZA_AUTOMEZZO
  FATTURA_SCADUTA
  PREVENTIVO_SCADUTO
}

enum StatoNotifica {
  IN_ATTESA
  INVIATA
  /// Изчерпани опити. Редът ОСТАВА — „не е изпратено" е информация.
  FALLITA
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  password           String // bcrypt hash, 10 rounds — никога в чист вид
  nome               String
  cognome            String
  ruolo              UserRole  @default(OPERATORE)
  attivo             Boolean   @default(true)
  tentativi          Int       @default(0) // поредни неуспешни входа
  bloccatoFino       DateTime? // заключен до този момент
  ultimoAccesso      DateTime?
  refreshToken       String? // нулира се при изход
  /// Втори фактор (TOTP). Тайната е в чист вид, защото алгоритъмът я иска, за
  /// да сметне кода — затова достъпът до базата вече значи компрометиран втори
  /// фактор, и точно затова той е ДОПЪЛНЕНИЕ към паролата, не заместител.
  totpSegreto        String?
  totpAttivo         Boolean   @default(false)
  /// Резервни кодове (bcrypt хешове). Без тях загубен телефон = загубен акаунт,
  /// а единственият изход би бил администраторска вратичка около мярката.
  codiciRecupero     String[]  @default([])
  /// Кога паролата е сменяна за последно — за политиката за срок.
  passwordCambiataAt DateTime?
  tenantId           String?   @db.Uuid
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant?          @relation(fields: [tenantId], references: [id])
  sessioni   SessioneAttiva[]
  auditLogs  AuditLog[]
  preventivi Preventivo[]
  fatture    Fattura[]
  documenti  Documento[]

  @@map("users")
}

// Неизменяем регистър: всяка редица е подписана с HMAC-SHA256.
/// Активните сесии на един потребител.
///
/// Досега refresh token-ът беше ЕДИН хеш върху `User`: вход от втори
/// компютър мълчаливо изхвърляше първия, никой не можеше да види откъде е
/// влизано, а „прекрати всички сесии" при уволнен служител не съществуваше.
model SessioneAttiva {
  id         String    @id @default(uuid()) @db.Uuid
  utenteId   String    @db.Uuid
  /// SHA-256 на refresh token-а — самият токен не се пази никъде.
  tokenHash  String    @unique
  /// Груб отпечатък на устройството, за да е разпознаваемо в списъка.
  userAgent  String?
  ip         String?
  ultimoUso  DateTime  @default(now())
  scadenza   DateTime
  revocataAt DateTime?
  createdAt  DateTime  @default(now())

  utente User @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, revocataAt])
  @@index([scadenza])
  @@map("sessioni_attive")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// Монотонен ред на вписване. `createdAt` НЕ става за подредба на веригата:
  /// две операции в една и съща милисекунда се сортират произволно и проверката
  /// би обявила счупена верига там, където няма такава.
  seq            BigInt   @unique @default(autoincrement())
  azione         String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, STATE_CHANGE, IMPORT
  entita         String
  entitaId       String?
  dettagli       Json?
  ip             String?
  userAgent      String?
  hmac           String // криптографски подпис на редицата
  /// Подписът на ПРЕДХОДНИЯ ред — веригата, която лови ИЗТРИВАНЕ на ред.
  hmacPrecedente String?
  versioneFirma  Int      @default(3) // 1 = ред на вмъкване · 2 = сортирани ключове · 3 = + верига
  utenteId       String?  @db.Uuid
  /// Фирмата, чиито данни е засегнала операцията. Без нея регистърът не може
  /// да се филтрира и администраторът на една фирма чете одита на друга.
  tenantId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  utente User?   @relation(fields: [utenteId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([entita, entitaId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ─── Анагрифики ─────────────────────────────────────────────────────────────

model Impianto {
  id                  String         @id @default(uuid()) @db.Uuid
  /// Вътрешният номер на фирмата.
  matricola           String
  /// Номерът, който ОБЩИНАТА дава при съобщението по чл. 12 D.P.R. 162/1999.
  ///
  /// Той е официалният идентификатор на уредбата и се изписва на табелата в
  /// кабината. Без него уредбата формално не е в служба — а точно по него
  /// проверяващият орган я търси. Дотук продуктът пазеше само своя номер.
  matricolaComune     String?
  /// Коя община го е дала. Един и същ номер се повтаря между общините.
  comune              String?
  /// Кога е подадено съобщението по чл. 12 (срок: 10 дни от декларацията за
  /// съответствие).
  dataComunicazione   DateTime?
  tipo                TipoImpianto   @default(ASCENSORE)
  /// По кой правен режим е пусната в служба — определя коя уредба важи.
  regime              RegimeImpianto @default(DIRETTIVA_2014_33)
  marca               String
  modello             String
  anno                Int?
  portata             Int? // kg
  /// Брой лица по табелата — реквизит на самата табела.
  persone             Int?
  /// m/s, с три десетични: 0,63 · 1,00 · 1,60.
  velocita            Decimal?       @db.Decimal(5, 3)
  fermate             Int?
  stato               StatoImpianto  @default(ATTIVO)
  indirizzo           String?
  piano               String?
  dataInstallazione   DateTime?
  /// Органът, който прави двугодишната проверка по чл. 13 (нотифициран орган,
  /// ASL или ARPA). Собственикът го избира; ние само го знаем.
  organismoNotificato String?
  /// Откога поддръжката е поверена на нас (чл. 15, ал. 1). Определя откога
  /// отговаряме за шестмесечните проверки.
  manutentoreDal      DateTime?
  ultimaRevisione     DateTime?
  prossimaRevisione   DateTime? // генерира автоматичните известия
  condominioId        String?        @db.Uuid
  amministratoreId    String?        @db.Uuid
  note                String?
  attivo              Boolean        @default(true)
  tenantId            String?        @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  condominio     Condominio?           @relation(fields: [condominioId], references: [id])
  amministratore Amministratore?       @relation(fields: [amministratoreId], references: [id])
  verifiche      VerificaImpianto[]
  rapportini     Rapportino[]
  scadenze       ScadenzaImpianto[]
  assegnazioni   AssegnazioneTecnico[]
  preventivi     Preventivo[]
  ordiniLavoro   OrdineLavoro[]
  contratti      ContrattoImpianto[]

  @@unique([tenantId, matricola])
  @@index([tenantId, matricola])
  @@map("impianti")
}

/// Законовата проверка на уредбата — чл. 13 и 14 D.P.R. 162/1999.
///
/// НЕ е нашата поддръжка. Тази проверка я прави ТРЕТА страна (нотифициран
/// орган, ASL или ARPA) на всеки две години, а собственикът я поръчва. Ние
/// вписваме резултата, защото от него зависи дали уредбата изобщо може да
/// работи — и защото при отрицателен изход поддържащата фирма е първата, която
/// разбира.
///
/// Дотук продуктът пазеше само дата „prossimaRevisione" — число без протокол,
/// без орган, без предписания и без начин да се докаже, че проверката е минала.
model VerificaImpianto {
  id                   String        @id @default(uuid()) @db.Uuid
  impiantoId           String        @db.Uuid
  tipo                 TipoVerifica  @default(PERIODICA)
  data                 DateTime
  esito                EsitoVerifica
  /// Кой я е извършил.
  organismo            String?
  /// Номерът на протокола — по него се доказва пред контролния орган.
  numeroVerbale        String?
  /// Предписанията при `CON_PRESCRIZIONI` и срокът за изпълнението им.
  prescrizioni         String?
  scadenzaPrescrizioni DateTime?
  /// Кога е следващата. Извежда се от датата, но се пази явно: органът може да
  /// определи по-кратък срок.
  prossimaVerifica     DateTime?
  /// Сканираният протокол. `SetNull`: изтрит документ не бива да отнася със
  /// себе си доказателството, че проверката е минала.
  documentoId          String?       @db.Uuid
  documento            Documento?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  note                 String?
  utenteId             String?       @db.Uuid
  tenantId             String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  impianto Impianto @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([impiantoId])
  @@map("verifiche_impianti")
}

/// Прикачен файл — сертификат, протокол, снимка от обекта.
///
/// Дотук продуктът пазеше само ПЪТИЩА (`impianti_media.url`), тоест сочеше към
/// нещо, което не съществува. Сега файлът наистина се съхранява.
///
/// Връзката е свободна (`entita` + `entitaId`), а не външен ключ: един и същ
/// механизъм обслужва уредби, проверки, поръчки и рапортички, а добавянето на
/// пета е конфигурация, не миграция. Цената е, че целостта се пази от
/// приложението — затова четенето ВИНАГИ минава през проверка на собственика.
model Allegato {
  id         String   @id @default(uuid()) @db.Uuid
  /// Коя таблица („impianti“, „verifiche_impianti“, „rapportini“…).
  entita     String
  entitaId   String   @db.Uuid
  /// Оригиналното име — САМО за показване. На диска не отива никога.
  nome       String
  /// Типът, ПОДУШЕН от съдържанието; не този, който браузърът е обявил.
  mimeType   String
  dimensione Int
  /// Пътят спрямо корена на хранилището. Строи се от UUID, не от името.
  percorso   String
  /// SHA-256 на съдържанието: разпознава дубликати и доказва, че файлът не е
  /// подменян след качването.
  sha256     String
  utenteId   String?  @db.Uuid
  tenantId   String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([entita, entitaId])
  @@map("allegati")
}

// Законови срокове; трите флага пазят от повторно известяване.
model ScadenzaImpianto {
  id           String   @id @default(uuid()) @db.Uuid
  impiantoId   String   @db.Uuid
  tipo         String // revisione, certificazione, manutenzione
  dataScadenza DateTime
  notificato90 Boolean  @default(false)
  notificato60 Boolean  @default(false)
  notificato30 Boolean  @default(false)
  completata   Boolean  @default(false)
  note         String?
  tenantId     String?  @db.Uuid // изолация по фирма
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  impianto Impianto @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@index([dataScadenza])
  // Автоматизмът минава по НЕЗАВЪРШЕНИТЕ, подредени по дата — всяка нощ, по
  // всички уредби. Точно тази комбинация иска съставен индекс.
  @@index([tenantId, completata, dataScadenza])
  @@map("scadenze_impianti")
}

model AssegnazioneTecnico {
  id           String    @id @default(uuid()) @db.Uuid
  impiantoId   String    @db.Uuid
  dipendenteId String    @db.Uuid
  dataInizio   DateTime  @default(now())
  dataFine     DateTime?
  attiva       Boolean   @default(true)
  note         String?
  tenantId     String?   @db.Uuid // изолация по фирма
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  impianto   Impianto   @relation(fields: [impiantoId], references: [id], onDelete: Cascade)
  dipendente Dipendente @relation(fields: [dipendenteId], references: [id])

  @@index([tenantId])
  @@map("assegnazioni_tecnici")
}

model Condominio {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String
  indirizzo        String
  citta            String
  cap              String?
  provincia        String?
  codiceFiscale    String?
  /// Кондоминиумът е самостоятелен фискален субект и ПОЛУЧАТЕЛ на фактурата —
  /// администраторът само го представлява. Затова адресът за доставка на
  /// е-фактурата е негов, не на студиото.
  pec              String?
  /// Codice destinatario на кондоминиума (7 знака). Празно + празна PEC значи
  /// `0000000`: документът е валиден и стои в кутията на получателя в AdE.
  codiceSdi        String?
  /// Кондоминиумът е заместник по данъка по закон (чл. 25-ter D.P.R. 600/1973)
  /// и удържа 4 % върху възнагражденията по договор за изработка. Изключение
  /// има само при кондоминиум без данъчен номер — рядко и се маркира ръчно.
  sostitutoImposta Boolean  @default(true)
  unitaImmobiliari Int?
  amministratoreId String?  @db.Uuid
  note             String?
  attivo           Boolean  @default(true)
  tenantId         String?  @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  amministratore Amministratore? @relation(fields: [amministratoreId], references: [id])
  impianti       Impianto[]
  fatture        Fattura[]
  contratti      Contratto[]

  @@index([tenantId])
  @@map("condomini")
}

// Договорна и фискална контрагентска страна — данните влизат в XML фактурата.
model Amministratore {
  id             String             @id @default(uuid()) @db.Uuid
  tipo           TipoAmministratore @default(PERSONA_FISICA)
  nome           String
  cognome        String?
  ragioneSociale String?
  partitaIva     String?
  codiceFiscale  String?
  pec            String?
  /// Codice destinatario НА КЛИЕНТА (7 знака за частни, 6 за PA). Без него и
  /// без PEC фактурата няма къде да бъде доставена: `0000000` праща документа
  /// в „кутията" на получателя в Agenzia delle Entrate, не при него.
  codiceSdi      String?
  email          String?
  telefono       String?
  indirizzo      String?
  citta          String?
  cap            String?
  /// Част от фискалния адрес: иска се и на DDT, и в XML-а за SDI.
  provincia      String?
  note           String?
  attivo         Boolean            @default(true)
  tenantId       String?            @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  condomini  Condominio[]
  impianti   Impianto[]
  preventivi Preventivo[]
  fatture    Fattura[]
  contratti  Contratto[]

  @@index([tenantId])
  @@map("amministratori")
}

model Dipendente {
  id               String         @id @default(uuid()) @db.Uuid
  nome             String
  cognome          String
  tipo             TipoDipendente @default(TECNICO)
  codiceFiscale    String?
  dataAssunzione   DateTime?
  /// Цена на ЧАС за фирмата (заплата + осигуровки), без ДДС. Без нея отчетът за
  /// рентабилност не брои труда като разход и договорът изглежда по-печеливш,
  /// отколкото е.
  costoOrario      Decimal?       @db.Decimal(10, 2)
  patente          String?
  specializzazioni String[]       @default([])
  email            String?
  telefono         String?
  note             String?
  attivo           Boolean        @default(true)
  tenantId         String?        @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  automezzo    Automezzo?
  assegnazioni AssegnazioneTecnico[]
  ordiniLavoro OrdineLavoro[]
  rapportini   Rapportino[]

  @@index([tenantId])
  @@map("dipendenti")
}

// Фирмен автопарк — трите дати определят цветния статус в списъка.
model Automezzo {
  id                    String    @id @default(uuid()) @db.Uuid
  targa                 String
  marca                 String
  modello               String
  chilometraggio        Int       @default(0)
  scadenzaRevisione     DateTime?
  scadenzaAssicurazione DateTime?
  scadenzaTagliando     DateTime?
  stato                 String    @default("verde") // verde, giallo, rosso
  conducenteId          String?   @unique @db.Uuid
  note                  String?
  attivo                Boolean   @default(true)
  tenantId              String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  conducente Dipendente? @relation(fields: [conducenteId], references: [id])

  @@unique([tenantId, targa])
  @@index([tenantId])
  @@map("automezzi")
}

model Cottimista {
  id             String         @id @default(uuid()) @db.Uuid
  ragioneSociale String
  tipo           TipoCottimista @default(DITTA_INDIVIDUALE)
  partitaIva     String?
  email          String?
  telefono       String?
  indirizzo      String?
  note           String?
  attivo         Boolean        @default(true)
  tenantId       String?        @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  squadre      Squadra[]
  ordiniLavoro OrdineLavoro[]

  @@index([tenantId])
  @@map("cottimisti")
}

model Squadra {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  cottimistiId String   @db.Uuid
  capocantiere String?
  membri       String[] @default([])
  attiva       Boolean  @default(true)
  note         String?
  tenantId     String?  @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cottimista   Cottimista     @relation(fields: [cottimistiId], references: [id])
  ordiniLavoro OrdineLavoro[]

  @@index([tenantId])
  @@map("squadre")
}

// ─── Магазин ────────────────────────────────────────────────────────────────

model ArticoloMagazzino {
  id             String        @id @default(uuid()) @db.Uuid
  codice         String
  barcode        String?
  nome           String
  descrizione    String        @default("")
  tipo           TipoMagazzino @default(COMPONENTI)
  categoria      String?
  ubicazione     String?
  quantita       Int           @default(0) // движи се САМО чрез движения
  sogliaMinima   Int           @default(0)
  prezzoAcquisto Decimal?      @db.Decimal(12, 2)
  prezzoVendita  Decimal?      @db.Decimal(12, 2)
  marginePerc    Decimal?      @db.Decimal(7, 2)
  aliquotaIva    Decimal       @default(22) @db.Decimal(5, 2)
  note           String?
  attivo         Boolean       @default(true)
  tenantId       String?       @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  movimenti           MovimentoMagazzino[]
  vociPreventivo      VocePreventivo[]
  materialiRapportino MaterialeRapportino[]

  @@unique([tenantId, codice])
  @@index([tenantId])
  @@map("articoli_magazzino")
}

// Хронологичен регистър — quantita никога не се пипа директно.
model MovimentoMagazzino {
  id             String        @id @default(uuid()) @db.Uuid
  articoloId     String        @db.Uuid
  tipo           TipoMovimento
  quantita       Int
  nota           String?
  ddtId          String?       @db.Uuid
  /// Ордина, за който е излязъл материалът. Без тази връзка вложеното не може
  /// да се отнесе към договор или импиант и отчетът брои само труда.
  ordineLavoroId String?       @db.Uuid
  tenantId       String?       @db.Uuid // изолация по фирма
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  articolo            ArticoloMagazzino    @relation(fields: [articoloId], references: [id])
  ddt                 Ddt?                 @relation(fields: [ddtId], references: [id])
  ordineLavoro        OrdineLavoro?        @relation(fields: [ordineLavoroId], references: [id])
  materialeRapportino MaterialeRapportino?

  @@index([tenantId])
  /// Отчетът за рентабилност чете движенията ПО ОРДИН — без индекса това е
  /// пълно сканиране на най-голямата таблица във фирмата.
  @@index([ordineLavoroId])
  @@map("movimenti_magazzino")
}

// ─── Активен цикъл ──────────────────────────────────────────────────────────

model Preventivo {
  id               String          @id @default(uuid()) @db.Uuid
  numero           String
  stato            StatoPreventivo @default(BOZZA)
  oggetto          String
  descrizione      String?
  totaleNetto      Decimal         @default(0) @db.Decimal(12, 2) // преизчислява се от редовете
  totaleIva        Decimal         @default(0) @db.Decimal(12, 2)
  totaleLordo      Decimal         @default(0) @db.Decimal(12, 2)
  validitaGiorni   Int             @default(30)
  impiantoId       String?         @db.Uuid
  amministratoreId String?         @db.Uuid
  utenteId         String?         @db.Uuid
  note             String?
  tenantId         String?         @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  impianto       Impianto?        @relation(fields: [impiantoId], references: [id])
  amministratore Amministratore?  @relation(fields: [amministratoreId], references: [id])
  utente         User?            @relation(fields: [utenteId], references: [id])
  voci           VocePreventivo[]
  ordiniLavoro   OrdineLavoro[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@map("preventivi")
}

model VocePreventivo {
  id             String   @id @default(uuid()) @db.Uuid
  preventivoId   String   @db.Uuid
  articoloId     String?  @db.Uuid
  descrizione    String
  quantita       Decimal  @default(1) @db.Decimal(12, 2)
  prezzoUnitario Decimal  @default(0) @db.Decimal(12, 2)
  aliquotaIva    Decimal  @default(22) @db.Decimal(5, 2)
  /// „Natura" по кодировката на SDI (N1…N7). ЗАДЪЛЖИТЕЛНА, когато ставката е 0:
  /// без нея SDI не може да различи освободена доставка от забравена ставка.
  naturaIva      String?
  totale         Decimal  @default(0) @db.Decimal(12, 2)
  ordine         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preventivo Preventivo         @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  articolo   ArticoloMagazzino? @relation(fields: [articoloId], references: [id])

  @@map("voci_preventivo")
}

// Работата за изпълнение. Статусът минава само по позволените преходи.
/// Договор за поддръжка: canone, обхванати импианти, периодичност на
/// посещенията и на фактурирането, срок и автоматично подновяване.
///
/// От него се раждат ДВЕ неща, и двете автоматично:
///   • ордини за периодичните посещения (`prossimaVisita`),
///   • фактури за canone-то (`prossimaFattura`).
/// Двете дати са „водачът" на автоматизма: местят се напред само след успешно
/// раждане, така че спрян cron наваксва, вместо да прескача периоди.
model Contratto {
  id                      String         @id @default(uuid()) @db.Uuid
  numero                  String
  stato                   StatoContratto @default(BOZZA)
  oggetto                 String
  /// Такса за периода на фактуриране, БЕЗ ДДС.
  canone                  Decimal        @default(0) @db.Decimal(12, 2)
  aliquotaIva             Decimal        @default(22) @db.Decimal(5, 2)
  periodicitaVisite       Periodicita    @default(SEMESTRALE)
  periodicitaFatturazione Periodicita    @default(TRIMESTRALE)
  dataInizio              DateTime
  dataFine                DateTime
  /// Мълчаливо подновяване: при изтичане срокът се продължава с още толкова.
  rinnovoAutomatico       Boolean        @default(true)
  /// Срок за предизвестие при отказ (месеци) — за напомнянето преди подновяване.
  preavvisoMesi           Int            @default(3)

  // ── Договорените времена за отзив ─────────────────────────────────────────
  //
  // Праговете са ДОГОВОРНИ, не нормативни. UNI EN 81-28 е платен стандарт и
  // точните му числа НЕ са възпроизведени тук; това, което се мери, е обещаното
  // на клиента. `null` значи „не е договорено", тоест не се мери — а не
  // мълчаливо наложено задължение, каквото фирмата не е поела.
  /// Минути от сигнала до пристигане.
  slaInterventoMin Int?
  /// Часове от сигнала до връщане в служба.
  slaRipristinoOre Int?
  amministratoreId String?   @db.Uuid
  condominioId     String?   @db.Uuid
  /// Кога автоматизмът трябва да роди следващия ордин / следващата фактура.
  prossimaVisita   DateTime?
  prossimaFattura  DateTime?
  note             String?
  tenantId         String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  amministratore Amministratore?     @relation(fields: [amministratoreId], references: [id])
  condominio     Condominio?         @relation(fields: [condominioId], references: [id])
  impianti       ContrattoImpianto[]
  ordini         OrdineLavoro[]
  fatture        Fattura[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([stato, prossimaVisita])
  @@index([stato, prossimaFattura])
  @@map("contratti")
}

/// Кои импианти покрива договорът. Отделна таблица, защото един договор
/// обикновено покрива няколко импианта на един и същ кондоминиум, а един
/// импиант може да смени договора си във времето.
model ContrattoImpianto {
  id          String   @id @default(uuid()) @db.Uuid
  contrattoId String   @db.Uuid
  impiantoId  String   @db.Uuid
  createdAt   DateTime @default(now())

  contratto Contratto @relation(fields: [contrattoId], references: [id], onDelete: Cascade)
  impianto  Impianto  @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@unique([contrattoId, impiantoId])
  @@index([impiantoId])
  @@map("contratti_impianti")
}

model OrdineLavoro {
  id              String         @id @default(uuid()) @db.Uuid
  numero          String
  stato           StatoOrdine    @default(BOZZA)
  priorita        PrioritaOrdine @default(ORDINARIA)
  oggetto         String
  descrizione     String?
  noteInterne     String? // никога не се печатат
  noteCommittente String?
  /// Платено на котимиста / външен изпълнител за този ордин, без ДДС.
  costoEsterno    Decimal?       @db.Decimal(12, 2)
  dataInizio      DateTime?
  dataFine        DateTime?

  // ── Времената за отзив (само за спешните приоритети) ──────────────────────
  //
  // Асансьорна фирма се продава по две неща: цената на canone-то и колко бързо
  // идва при повикване. Второто дотук не се мереше никъде — казваше се на думи
  // в офертата и никой не можеше да го докаже нито пред клиента, нито пред
  // себе си.
  //
  // Началото е СИГНАЛЪТ, не `createdAt`: записът в системата се прави след
  // обаждането, понякога часове по-късно, а клиентът чака от обаждането.
  /// Кога е постъпил сигналът (обаждане или аларма от кабината).
  segnalatoAt  DateTime?
  /// Кога техникът е стъпил на място.
  arrivoAt     DateTime?
  /// Кога уредбата е върната в служба (или блокираният е освободен).
  /// РАЗЛИЧНО от `arrivoAt`: техникът може да е дошъл за 30 минути и да чака
  /// резервна част три дни. Един показател би скрил точно това.
  ripristinoAt DateTime?

  impiantoId   String?  @db.Uuid
  preventivoId String?  @db.Uuid
  /// Попълва се, когато ордина е роден от периодичното посещение по договор.
  contrattoId  String?  @db.Uuid
  tecnicoId    String?  @db.Uuid
  cottimistiId String?  @db.Uuid
  squadraId    String?  @db.Uuid
  tenantId     String?  @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  impianto   Impianto?            @relation(fields: [impiantoId], references: [id])
  preventivo Preventivo?          @relation(fields: [preventivoId], references: [id])
  contratto  Contratto?           @relation(fields: [contrattoId], references: [id])
  tecnico    Dipendente?          @relation(fields: [tecnicoId], references: [id])
  cottimista Cottimista?          @relation(fields: [cottimistiId], references: [id])
  squadra    Squadra?             @relation(fields: [squadraId], references: [id])
  storico    StoricoStato[]
  movimenti  MovimentoMagazzino[]
  fatture    Fattura[]
  ddt        Ddt[]
  rapportini Rapportino[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@map("ordini_lavoro")
}

/// Отчет за намесата (rapportino di intervento), подписан на място.
///
/// Това е документът, който техникът попълва при клиента и администраторът на
/// кондоминиума подписва. Днес този лист се пише на хартия и се преписва в
/// офиса — с всичко, което се губи по пътя: часове, вложени материали, кой
/// какво е приел.
///
/// Подписът се пази като PNG (data URL). Не е квалифициран електронен подпис
/// по eIDAS и не претендира да е такъв — той е доказателство за приемане на
/// работата, каквото е и подписът върху хартиения лист.
model Rapportino {
  id             String          @id @default(uuid()) @db.Uuid
  numero         String
  ordineLavoroId String          @db.Uuid
  /// Уредбата ПРЯКО, не само през ордина.
  ///
  /// Историята на една уредба е нейна, не на поръчката: при смяна на
  /// администратора или при проверка се иска всичко правено по ТАЗИ уредба, а
  /// стигането дотам през ордините е и бавно, и непълно.
  impiantoId     String?         @db.Uuid
  tecnicoId      String?         @db.Uuid
  dataOra        DateTime        @default(now())
  tipoIntervento TipoIntervento  @default(MANUTENZIONE_ORDINARIA)
  /// Отработени часове, с четвъртинки (1.25 = час и петнайсет).
  oreLavoro      Decimal         @default(0) @db.Decimal(6, 2)
  descrizione    String
  esito          EsitoIntervento @default(RISOLTO)

  // ── Проверките по чл. 15, ал. 4 D.P.R. 162/1999 ───────────────────────────
  //
  // Законът изброява какво поддържащата фирма е ДЛЪЖНА да провери периодично.
  // Свободният текст „всичко наред" не доказва нищо: при злополука се пита кое
  // точно е проверено и кога. Затова са отделни полета — `null` значи „не е
  // проверено на този визит", а не „наред".
  vFuni                   Boolean?
  vParacadute             Boolean?
  vLimitatoreVelocita     Boolean?
  vIsolamentoElettrico    Boolean?
  vMessaTerra             Boolean?
  vPorteSerrature         Boolean?
  vIlluminazioneEmergenza Boolean?
  /// Двупосочната връзка от кабината (UNI EN 81-28). Неработеща значи, че
  /// блокиран човек не може да повика помощ — това е спиране, не забележка.
  vCitofonoAllarme        Boolean?
  /// Свободен текст за вложеното, което НЕ е артикул от склада (купено на
  /// място, чуждо, дребно). За артикулите от склада има редове — виж
  /// `MaterialeRapportino`; те и само те движат наличността.
  materiali               String?
  noteInterne             String?
  /// PNG (data URL) на подписа. Празно = още неподписан.
  firmaCliente            String?
  firmatarioNome          String?
  firmatarioRuolo         String?
  firmatoAt               DateTime?
  tenantId                String?   @db.Uuid
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  ordineLavoro OrdineLavoro @relation(fields: [ordineLavoroId], references: [id], onDelete: Cascade)
  impianto     Impianto?    @relation(fields: [impiantoId], references: [id])
  tecnico      Dipendente?  @relation(fields: [tecnicoId], references: [id])

  materialiUsati MaterialeRapportino[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([ordineLavoroId])
  @@index([impiantoId])
  @@map("rapportini")
}

/// Вложен артикул от склада — редът, който ЗАДЪЛЖИТЕЛНО движи наличността.
///
/// Дотук вложеното живееше като свободен текст в `Rapportino.materiali`.
/// Последицата не е разкрасяване: техникът слага контактор, наличността в
/// системата не мърда, а следващият вижда „има един" и тръгва без резервна
/// част. Отделно вложеното не влизаше в рентабилността и всеки договор
/// изглеждаше по-печеливш, отколкото е.
///
/// РЕДЪТ И ДВИЖЕНИЕТО СЕ РАЖДАТ ЗАЕДНО, в една транзакция. `movimentoId` е
/// задължителен и уникален — тоест ред без движение е невъзможен по СХЕМА, а
/// не по добра воля на маршрута.
///
/// Моментът е ДОБАВЯНЕТО, не подписването. Частта е излязла от склада, когато
/// техникът я е взел; а подписването е най-лошият възможен момент за отказ
/// „недостатъчна наличност" — човекът е пред клиента, с отворен капак на
/// шахтата. Махнат ред преди подписа връща количеството с обратно движение.
model MaterialeRapportino {
  id           String   @id @default(uuid()) @db.Uuid
  rapportinoId String   @db.Uuid
  articoloId   String   @db.Uuid
  quantita     Int
  /// Изходящото движение. Едно към едно: складът и отчетът не могат да се
  /// разминат, защото са един и същ запис, видян от две страни.
  movimentoId  String   @unique @db.Uuid
  tenantId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rapportino Rapportino         @relation(fields: [rapportinoId], references: [id], onDelete: Cascade)
  articolo   ArticoloMagazzino  @relation(fields: [articoloId], references: [id])
  movimento  MovimentoMagazzino @relation(fields: [movimentoId], references: [id])

  @@index([tenantId])
  @@index([rapportinoId])
  @@map("materiali_rapportino")
}

// Пише се автоматично при всяка смяна на статус.
model StoricoStato {
  id              String       @id @default(uuid()) @db.Uuid
  ordineLavoroId  String       @db.Uuid
  statoPrecedente StatoOrdine?
  statoNuovo      StatoOrdine
  nota            String?
  utente          String
  createdAt       DateTime     @default(now())

  ordineLavoro OrdineLavoro @relation(fields: [ordineLavoroId], references: [id], onDelete: Cascade)

  @@map("storico_stati")
}

// ─── Документална област ────────────────────────────────────────────────────

model Fattura {
  id               String       @id @default(uuid()) @db.Uuid
  numero           String
  tipo             TipoFattura  @default(EMESSA)
  stato            StatoFattura @default(BOZZA)
  data             DateTime     @default(now())
  dataScadenza     DateTime?
  oggetto          String?
  totaleNetto      Decimal      @default(0) @db.Decimal(12, 2)
  totaleIva        Decimal      @default(0) @db.Decimal(12, 2)
  totaleLordo      Decimal      @default(0) @db.Decimal(12, 2)
  /// ПОЛУЧАТЕЛЯТ на фактурата, когато работата е за кондоминиум. Той е
  /// фискалният субект (свой данъчен номер, свой адрес); администраторът е
  /// само представител. Фактура, издадена на студиото вместо на кондоминиума,
  /// е издадена на грешно лице — разходът не се приспада, а удържането не е
  /// направено от този, който дължи.
  condominioId     String?      @db.Uuid
  amministratoreId String?      @db.Uuid
  ordineLavoroId   String?      @db.Uuid
  /// Попълва се, когато фактурата е за canone по договор.
  contrattoId      String?      @db.Uuid
  utenteId         String?      @db.Uuid
  note             String?

  // ── Пътят през SDI ──────────────────────────────────────────────────────
  statoSdi          StatoSdi  @default(NON_INVIATA)
  /// Идентификаторът, който SDI дава на подаването — по него се връзват всички
  /// известия и по него се спори при проверка.
  identificativoSdi String?
  dataInvioSdi      DateTime?
  /// При SCARTATA: докога документът може да бъде преиздаден със СЪЩИЯ номер
  /// и същата дата (5 дни от известието — циркуляр 13/E от 2018 г.).
  scadenzaRinvioSdi DateTime?
  /// Замразява се при първото генериране на XML. Преди беше извеждан от броя
  /// фактури при всяко натискане на бутона — тоест се менеше след поправка и
  /// SDI виждаше нов файл вместо преиздаден.
  progressivoInvio  String?

  // ── Ritenuta d'acconto ──────────────────────────────────────────────────
  /// Чл. 25-ter D.P.R. 600/1973: кондоминиумът удържа 4 % върху
  /// възнагражденията по договор за изработка и ги внася вместо изпълнителя.
  ritenuta         Boolean   @default(false)
  ritenutaAliquota Decimal   @default(4) @db.Decimal(5, 2)
  ritenutaImporto  Decimal   @default(0) @db.Decimal(12, 2)
  /// RT01 = физическо лице · RT02 = юридическо лице.
  ritenutaTipo     String    @default("RT02")
  /// Причина по кодировката на модел 770; „W" е чл. 25-ter.
  ritenutaCausale  String    @default("W")
  /// Дата на внасяне (F24) — попълва се, когато удържаното е преведено.
  ritenutaVersata  DateTime?

  // ── Плащане ─────────────────────────────────────────────────────────────
  statoPagamento      StatoPagamentoFattura @default(NON_PAGATA)
  totalePagato        Decimal               @default(0) @db.Decimal(12, 2)
  /// Кодировката на SDI: MP01 контанти, MP05 банков превод, MP08 карта…
  modalitaPagamento   String                @default("MP05")
  /// TP01 на вноски · TP02 наведнъж · TP03 авансово.
  condizioniPagamento String                @default("TP02")
  /// Чл. 17-ter D.P.R. 633/1972: ДДС-то се внася от публичния получател, не от
  /// доставчика. `EsigibilitaIVA=S`, а платимото е само облагаемата основа.
  splitPayment        Boolean               @default(false)
  /// Обществена поръчка — задължителни при доставка към PA (закон 136/2010).
  cig                 String?
  cup                 String?

  /// Режимът на „значимите блага" (D.M. 29.12.1999): при него ставката 10 %
  /// важи само до стойността на престацията, остатъкът е 22 %.
  regimeBeniSignificativi Boolean @default(false)

  tenantId  String?  @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condominio     Condominio?     @relation(fields: [condominioId], references: [id])
  amministratore Amministratore? @relation(fields: [amministratoreId], references: [id])
  ordineLavoro   OrdineLavoro?   @relation(fields: [ordineLavoroId], references: [id])
  contratto      Contratto?      @relation(fields: [contrattoId], references: [id])
  utente         User?           @relation(fields: [utenteId], references: [id])
  voci           VoceFattura[]
  pagamenti      Pagamento[]
  notificheSdi   NotificaSdi[]
  solleciti      Sollecito[]
  /// Съпровождащите доставки при отложено фактуриране (TD24).
  ddt            Ddt[]

  @@unique([tenantId, numero])
  // Съставни, не едноколонни. Измерено с 50 000 фактури: `@@index([tenantId])`
  // сам НЕ покрива подредбата — планировчикът намира редовете, но после
  // сортира всичките и избира последователно сканиране. С реда на подредбата в
  // самия индекс базата минава по него и спира след петдесетия ред.
  @@index([tenantId, data(sort: Desc)])
  @@index([tenantId, statoSdi, data(sort: Desc)])
  @@index([tenantId, statoPagamento, dataScadenza])
  @@index([condominioId])
  @@map("fatture")
}

/// Получено плащане по фактура. Отделна таблица, а не поле „платена да/не":
/// частичните плащания са правило при кондоминиумите, а датата на всяко от тях
/// е нужна и за лихвата при забава, и за касовия отчет.
model Pagamento {
  id          String   @id @default(uuid()) @db.Uuid
  fatturaId   String   @db.Uuid
  data        DateTime @default(now())
  importo     Decimal  @db.Decimal(12, 2)
  /// Кодировката на SDI (MP01…MP23) — същата, която влиза в XML-а.
  modalita    String   @default("MP05")
  /// CRO на превода, номер на чек и подобни — следата към банката.
  riferimento String?
  note        String?
  utenteId    String?  @db.Uuid
  tenantId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fattura Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fatturaId])
  @@map("pagamenti")
}

/// Известие от Sistema di Interscambio. Пазим ги ВСИЧКИ и непроменени: при
/// проверка тежи известието, не какво пише в нашата таблица.
model NotificaSdi {
  id                String          @id @default(uuid()) @db.Uuid
  fatturaId         String          @db.Uuid
  tipo              TipoNotificaSdi
  identificativoSdi String?
  dataOra           DateTime        @default(now())
  descrizione       String?
  /// Списъкът с кодове и описания от известието за отхвърляне (само при NS).
  errori            Json?
  nomeFile          String?
  tenantId          String?         @db.Uuid
  createdAt         DateTime        @default(now())

  fattura Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fatturaId])
  @@map("notifiche_sdi")
}

/// Последователността на подаванията към SDI — по фирма, монотонна, без дупки
/// надолу. Преди прогресивният код се извеждаше от БРОЯ фактури; при повече от
/// 9999 документа и при преиздаване това дава повтарящо се име на файл, а SDI
/// отхвърля повторено име като дубликат независимо от съдържанието.
model ContatoreSdi {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @unique @db.Uuid
  ultimo    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("contatori_sdi")
}

model VoceFattura {
  id                String   @id @default(uuid()) @db.Uuid
  fatturaId         String   @db.Uuid
  descrizione       String
  quantita          Decimal  @default(1) @db.Decimal(12, 2)
  prezzoUnitario    Decimal  @default(0) @db.Decimal(12, 2)
  aliquotaIva       Decimal  @default(22) @db.Decimal(5, 2)
  /// „Natura" по кодировката на SDI (N1…N7). ЗАДЪЛЖИТЕЛНА, когато ставката е 0:
  /// без нея SDI не може да различи освободена доставка от забравена ставка.
  naturaIva         String?
  /// „Значимо благо" по D.M. 29.12.1999. Асансьорите и подемниците са изрично
  /// в списъка: при поддръжка на жилищна сграда ставката 10 % важи за тях само
  /// до стойността на престацията, а надвишението е с 22 %.
  beneSignificativo Boolean  @default(false)
  totale            Decimal  @default(0) @db.Decimal(12, 2)
  ordine            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fattura Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  @@map("voci_fattura")
}

// Транспортни документи по D.P.R. 472/1996.
model Ddt {
  id                String   @id @default(uuid()) @db.Uuid
  numero            String
  data              DateTime @default(now())
  causale           String?
  destinatario      String?
  indirizzoConsegna String?
  vettore           String?
  /// Дата И ЧАС на започване на превоза — чл. 1, ал. 3 D.P.R. 472/1996.
  ///
  /// Отделно от `data` (датата на документа) нарочно: DDT може да се изготви
  /// сутринта, а камионът да тръгне следобед. Часът е това, което прави
  /// документа годен да оправдае превоза при пътна проверка; без него
  /// презумпцията за прехвърляне на собствеността по чл. 1, ал. 2 не се държи.
  /// Стенен час в Италия (`TZ=Europe/Rome` е пинована и в образа, и в Compose).
  inizioTrasporto   DateTime?
  ordineLavoroId    String?  @db.Uuid
  /// Фактурата, която е обхванала тази доставка (отложено фактуриране).
  ///
  /// Един DDT се фактурира НАЙ-МНОГО веднъж; една фактура покрива много DDT.
  /// От тази връзка се извежда и типът на документа за SDI: наличието на
  /// съпровождащи документи ПРАВИ фактурата отложена (TD24). Отделно поле
  /// „differita" би било втора истина, която някой ден ще се разминава с тази.
  fatturaId         String?  @db.Uuid
  note              String?
  tenantId          String?  @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ordineLavoro OrdineLavoro?        @relation(fields: [ordineLavoroId], references: [id])
  fattura      Fattura?             @relation(fields: [fatturaId], references: [id])
  righe        RigaDdt[]
  movimenti    MovimentoMagazzino[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  /// „Кои доставки чакат фактуриране" е основната справка в края на месеца —
  /// без индекса тя сканира цялата таблица.
  @@index([fatturaId])
  @@map("ddt")
}

model RigaDdt {
  id          String   @id @default(uuid()) @db.Uuid
  ddtId       String   @db.Uuid
  descrizione String
  quantita    Decimal  @default(1) @db.Decimal(12, 2)
  um          String?
  peso        Decimal? @db.Decimal(10, 2)
  ordine      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ddt Ddt @relation(fields: [ddtId], references: [id], onDelete: Cascade)

  @@map("righe_ddt")
}

model Documento {
  id        String        @id @default(uuid()) @db.Uuid
  tipo      TipoDocumento @default(ALTRO)
  titolo    String
  contenuto String?
  fileUrl   String?
  utenteId  String?       @db.Uuid
  note      String?
  tenantId  String?       @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  utente    User?              @relation(fields: [utenteId], references: [id])
  verifiche VerificaImpianto[]

  @@index([tenantId])
  @@map("documenti")
}

// ─── Наблюдаемост на автоматизмите ──────────────────────────────────────────

// Всяко пускане на автоматизъм оставя следа. Без нея спрян cron/рестартирала
// машина означава пропуснат законов срок, за който никой не разбира.
model AutomatismoRun {
  id          String    @id @default(uuid()) @db.Uuid
  nome        String // scadenze | retention
  iniziatoAt  DateTime  @default(now())
  terminatoAt DateTime?
  esito       String    @default("IN_CORSO") // IN_CORSO | OK | ERRORE
  durataMs    Int?
  dettagli    Json? // агрегатни броячи, никога лични данни
  errore      String? // тип + код, без съобщение
  createdAt   DateTime  @default(now())

  @@index([nome, iniziatoAt])
  @@map("automatismi_run")
}

// ─── Публично API и webhooks ────────────────────────────────────────────────

/// Ключ за достъп на ВЪНШНА система (счетоводен софтуер, портал на клиента).
///
/// Пази се само SHA-256 отпечатък: ключът се показва ВЕДНЪЖ при създаване и не
/// може да бъде възстановен. Компрометирана база тогава не дава достъп до API-то,
/// а изгубен ключ се сменя, вместо да се търси.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  /// Кратък видим префикс — за разпознаване в списъка без да се пази ключът.
  prefisso   String    @unique
  chiaveHash String    @unique
  etichetta  String
  /// Правата на ключа. Празно значи НИЩО, не „всичко" — затворено по подразбиране.
  ambiti     String[]  @default([])
  ultimoUso  DateTime?
  scadenza   DateTime?
  revocataAt DateTime?
  tenantId   String?   @db.Uuid
  creataDaId String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@map("api_keys")
}

/// Абонамент за събития. Външната система получава известие, вместо да пита.
model Webhook {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  /// Тайна за подписа на доставката. Виждала се е само при създаване.
  segreto    String
  /// Кои събития. Празно = никакви (затворено по подразбиране).
  eventi     String[] @default([])
  attivo     Boolean  @default(true)
  /// Поредни неуспехи; след тавана абонаментът се спира сам.
  fallimenti Int      @default(0)
  tenantId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consegne WebhookConsegna[]

  @@index([tenantId])
  @@map("webhooks")
}

/// Опашката на доставките. Отделна таблица, защото доставката се ПОВТАРЯ:
/// получателят може да е недостъпен, а събитието не бива да се губи.
model WebhookConsegna {
  id                String    @id @default(uuid()) @db.Uuid
  webhookId         String    @db.Uuid
  evento            String
  /// Тялото се замразява при пораждането: препращане на „текущото състояние"
  /// би пратило по-късна стойност и получателят би видял събитие, което не се е
  /// случило така.
  corpo             Json
  stato             String    @default("IN_ATTESA") // IN_ATTESA | CONSEGNATO | FALLITO
  tentativi         Int       @default(0)
  prossimoTentativo DateTime  @default(now())
  ultimoErrore      String?
  rispostaStato     Int?
  consegnatoAt      DateTime?
  tenantId          String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([stato, prossimoTentativo])
  @@index([tenantId])
  @@map("webhook_consegne")
}

/// Изпратена покана за плащане.
///
/// Записът е ДОКАЗАТЕЛСТВОТО, че поканата е тръгнала: при спор се пита кога и
/// какво е поискано, а „мисля, че писах имейл" не е отговор. Затова редът е
/// само за добавяне — маршрути за промяна и изтриване няма, точно както при
/// одита.
///
/// Лихвата се ЗАМРАЗЯВА в момента на изпращането. Пресмятане наново по-късно
/// би дало друго число от това, което клиентът е получил на хартия.
model Sollecito {
  id                 String   @id @default(uuid()) @db.Uuid
  fatturaId          String   @db.Uuid
  /// 1 = първа покана · 2 = втора · 3 = покана за забава (messa in mora).
  livello            Int
  /// Дни закъснение към момента на изпращането — не се преизчислява.
  giorniRitardo      Int
  /// Дължимата главница в центесими към момента на изпращането.
  importoCentesimi   Int
  /// Начислената лихва в центесими; 0 при първа покана.
  interessiCentesimi Int      @default(0)
  /// Как е тръгнала: „email", „pec", „posta", „consegna" — свободен текст,
  /// защото пътищата са различни при всяка фирма и не си струва енумерация.
  canale             String?
  note               String?
  utenteId           String?  @db.Uuid
  tenantId           String?  @db.Uuid
  createdAt          DateTime @default(now())

  fattura Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  /// ЕДНА СТЕПЕН — ЕДНА ПОКАНА. Проверката „следващата степен е N" се прави в
  /// маршрута, но между четенето и записа има прозорец: двоен клик по бавна
  /// връзка ражда два реда „primo sollecito". Таблицата е само-добавяща, тоест
  /// грешката не се поправя после — затова правилото стои и в базата.
  @@unique([fatturaId, livello])
  @@index([tenantId])
  @@index([fatturaId])
  @@map("solleciti")
}
