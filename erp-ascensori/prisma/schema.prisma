// ERP Ascensori Enterprise — схема v3.0 по „Documentazione tecnica"
// PostgreSQL 16 · Prisma ORM · Node.js 20
// 24 таблици · 13 енумерации · UUID PK · createdAt/updatedAt навсякъде

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Енумерации ──────────────────────────────────────────────────────────────

enum UserRole {
  MASTER
  ADMIN
  DIREZIONE
  RESPONSABILE
  TECNICO
  OPERATORE
  CLIENTE
}

enum StatoImpianto {
  ATTIVO
  FERMO
  MANUTENZIONE
  FUORI_SERVIZIO
  DISMESSO
}

enum StatoOrdine {
  BOZZA
  EMESSO
  CONFERMATO
  IN_LAVORO
  SOSPESO
  COMPLETATO
  CHIUSO
  CONTESTATO
  ANNULLATO
}

enum PrioritaOrdine {
  ORDINARIA
  URGENTE
  EMERGENZA
}

enum StatoPreventivo {
  BOZZA
  INVIATO
  APPROVATO
  RIFIUTATO
  SCADUTO
}

enum TipoFattura {
  EMESSA
  RICEVUTA
}

enum StatoFattura {
  BOZZA
  EMESSA
  INVIATA
  PAGATA
  SCADUTA
  STORNATA
}

enum TipoAmministratore {
  PERSONA_FISICA
  SOCIETA
}

enum TipoDipendente {
  TECNICO
  AMMINISTRATIVO
  COMMERCIALE
  MAGAZZINIERE
}

enum TipoCottimista {
  DITTA_INDIVIDUALE
  COOPERATIVA
  AZIENDA
}

enum TipoMagazzino {
  COMPONENTI
  VENDITA
}

enum TipoMovimento {
  ENTRATA
  USCITA
  RETTIFICA
}

// Договорът за поддръжка е източникът на приходите на асансьорна фирма: тя
// живее от canone, не от единични ордини.
enum StatoContratto {
  BOZZA
  ATTIVO
  SOSPESO
  SCADUTO
  DISDETTO
}

/// Периодичност — на посещенията и на фактурирането поотделно: типично е
/// „две посещения годишно, фактура на тримесечие".
enum Periodicita {
  MENSILE
  BIMESTRALE
  TRIMESTRALE
  QUADRIMESTRALE
  SEMESTRALE
  ANNUALE
}

/// Изходът от намесата — техникът го избира на място.
enum EsitoIntervento {
  RISOLTO
  DA_COMPLETARE
  RINVIATO
  NON_RISOLVIBILE
}

enum TipoDocumento {
  CARTELLO_CANTIERE
  VERBALE_CANTIERE
  CERTIFICATO
  CONTRATTO
  ALTRO
}

// ─── Система ────────────────────────────────────────────────────────────────

// Мулти-фирмени инсталации: всяка редица е фирма-клиент със свой лицензен план.
model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  slug                 String    @unique
  ragioneSociale       String
  email                String
  piano                String    @default("TRIAL") // TRIAL, STARTER, PROFESSIONAL, ENTERPRISE
  attivo               Boolean   @default(true)
  scadenzaAbbonamento  DateTime? // след тази дата достъпът се отказва с 402
  stripeCustomerId     String?
  stripeSubscriptionId String?
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users     User[]
  auditLogs AuditLog[]

  @@map("tenants")
}

/// Фискалната самоличност на ИЗДАВАЩАТА фирма (cedente/prestatore).
///
/// Отделно от `Tenant`, защото при еднофирмена инсталация `tenantId` е `null`
/// и запис в `Tenant` изобщо няма — а данните на издателя трябват на всеки
/// документ: чл. 1, ал. 3 D.P.R. 472/1996 иска generalità del cedente върху
/// DDT, а бъдещият XML за SDI иска и повече. Един ред на фирма (вкл. `null`).
model DatiAzienda {
  id               String   @id @default(uuid()) @db.Uuid
  ragioneSociale   String
  partitaIva       String?
  codiceFiscale    String?
  indirizzo        String?
  cap              String?
  citta            String?
  provincia        String?
  telefono         String?
  email            String?
  pec              String?
  /// Codice destinatario / codice SDI за е-фактурата.
  codiceSdi        String?
  /// Данъчен режим по кодировката на SDI (RF01 = обикновен, RF19 = forfettario).
  /// Задължителен реквизит на `CedentePrestatore` — без него XML-ът се отхвърля.
  regimeFiscale    String   @default("RF01")
  iban             String?
  /// Регистрация в търговския регистър (REA) — влиза в подписа на документите.
  rea              String?
  capitaleSociale  String?
  /// Бележка под линия на печатните документи (условия на плащане и подобни).
  notePiePagina    String?
  tenantId         String?  @unique @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("dati_azienda")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  password     String // bcrypt hash, 10 rounds — никога в чист вид
  nome         String
  cognome      String
  ruolo        UserRole  @default(OPERATORE)
  attivo       Boolean   @default(true)
  tentativi    Int       @default(0) // поредни неуспешни входа
  bloccatoFino DateTime? // заключен до този момент
  ultimoAccesso DateTime?
  refreshToken String? // нулира се при изход
  /// Втори фактор (TOTP). Тайната е в чист вид, защото алгоритъмът я иска, за
  /// да сметне кода — затова достъпът до базата вече значи компрометиран втори
  /// фактор, и точно затова той е ДОПЪЛНЕНИЕ към паролата, не заместител.
  totpSegreto  String?
  totpAttivo   Boolean   @default(false)
  /// Резервни кодове (bcrypt хешове). Без тях загубен телефон = загубен акаунт,
  /// а единственият изход би бил администраторска вратичка около мярката.
  codiciRecupero String[] @default([])
  /// Кога паролата е сменяна за последно — за политиката за срок.
  passwordCambiataAt DateTime?
  tenantId     String?   @db.Uuid
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant?     @relation(fields: [tenantId], references: [id])
  sessioni   SessioneAttiva[]
  auditLogs  AuditLog[]
  preventivi Preventivo[]
  fatture    Fattura[]
  documenti  Documento[]

  @@map("users")
}

// Неизменяем регистър: всяка редица е подписана с HMAC-SHA256.
/// Активните сесии на един потребител.
///
/// Досега refresh token-ът беше ЕДИН хеш върху `User`: вход от втори
/// компютър мълчаливо изхвърляше първия, никой не можеше да види откъде е
/// влизано, а „прекрати всички сесии" при уволнен служител не съществуваше.
model SessioneAttiva {
  id           String   @id @default(uuid()) @db.Uuid
  utenteId     String   @db.Uuid
  /// SHA-256 на refresh token-а — самият токен не се пази никъде.
  tokenHash    String   @unique
  /// Груб отпечатък на устройството, за да е разпознаваемо в списъка.
  userAgent    String?
  ip           String?
  ultimoUso    DateTime @default(now())
  scadenza     DateTime
  revocataAt   DateTime?
  createdAt    DateTime @default(now())

  utente User @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, revocataAt])
  @@index([scadenza])
  @@map("sessioni_attive")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Монотонен ред на вписване. `createdAt` НЕ става за подредба на веригата:
  /// две операции в една и съща милисекунда се сортират произволно и проверката
  /// би обявила счупена верига там, където няма такава.
  seq       BigInt   @unique @default(autoincrement())
  azione    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, STATE_CHANGE, IMPORT
  entita    String
  entitaId  String?
  dettagli  Json?
  ip        String?
  userAgent String?
  hmac      String // криптографски подпис на редицата
  /// Подписът на ПРЕДХОДНИЯ ред — веригата, която лови ИЗТРИВАНЕ на ред.
  hmacPrecedente String?
  versioneFirma Int   @default(3) // 1 = ред на вмъкване · 2 = сортирани ключове · 3 = + верига
  utenteId  String?  @db.Uuid
  /// Фирмата, чиито данни е засегнала операцията. Без нея регистърът не може
  /// да се филтрира и администраторът на една фирма чете одита на друга.
  tenantId  String?  @db.Uuid
  createdAt DateTime @default(now())

  utente User?   @relation(fields: [utenteId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([entita, entitaId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ─── Анагрифики ─────────────────────────────────────────────────────────────

model Impianto {
  id                String        @id @default(uuid()) @db.Uuid
  matricola         String
  marca             String
  modello           String
  anno              Int?
  portata           Int? // kg
  fermate           Int?
  stato             StatoImpianto @default(ATTIVO)
  indirizzo         String?
  piano             String?
  dataInstallazione DateTime?
  ultimaRevisione   DateTime?
  prossimaRevisione DateTime? // генерира автоматичните известия
  condominioId      String?       @db.Uuid
  amministratoreId  String?       @db.Uuid
  note              String?
  attivo            Boolean       @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  condominio     Condominio?           @relation(fields: [condominioId], references: [id])
  amministratore Amministratore?       @relation(fields: [amministratoreId], references: [id])
  media          ImpiantoMedia[]
  scadenze       ScadenzaImpianto[]
  assegnazioni   AssegnazioneTecnico[]
  preventivi     Preventivo[]
  ordiniLavoro   OrdineLavoro[]

  @@index([tenantId])
  @@unique([tenantId, matricola])
  contratti  ContrattoImpianto[]

  @@map("impianti")
}

model ImpiantoMedia {
  id         String   @id @default(uuid()) @db.Uuid
  impiantoId String   @db.Uuid
  tipo       String // foto, video, documento
  url        String
  nome       String?
  tenantId  String?   @db.Uuid // изолация по фирма
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  impianto Impianto @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("impianti_media")
}

// Законови срокове; трите флага пазят от повторно известяване.
model ScadenzaImpianto {
  id           String   @id @default(uuid()) @db.Uuid
  impiantoId   String   @db.Uuid
  tipo         String // revisione, certificazione, manutenzione
  dataScadenza DateTime
  notificato90 Boolean  @default(false)
  notificato60 Boolean  @default(false)
  notificato30 Boolean  @default(false)
  completata   Boolean  @default(false)
  note         String?
  tenantId  String?   @db.Uuid // изолация по фирма
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  impianto Impianto @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@index([dataScadenza])
  @@index([tenantId])
  @@map("scadenze_impianti")
}

model AssegnazioneTecnico {
  id           String    @id @default(uuid()) @db.Uuid
  impiantoId   String    @db.Uuid
  dipendenteId String    @db.Uuid
  dataInizio   DateTime  @default(now())
  dataFine     DateTime?
  attiva       Boolean   @default(true)
  note         String?
  tenantId  String?   @db.Uuid // изолация по фирма
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  impianto   Impianto   @relation(fields: [impiantoId], references: [id], onDelete: Cascade)
  dipendente Dipendente @relation(fields: [dipendenteId], references: [id])

  @@index([tenantId])
  @@map("assegnazioni_tecnici")
}

model Condominio {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String
  indirizzo        String
  citta            String
  cap              String?
  provincia        String?
  codiceFiscale    String?
  unitaImmobiliari Int?
  amministratoreId String?  @db.Uuid
  note             String?
  attivo           Boolean  @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  amministratore Amministratore? @relation(fields: [amministratoreId], references: [id])
  impianti       Impianto[]

  @@index([tenantId])
  contratti  Contratto[]

  @@map("condomini")
}

// Договорна и фискална контрагентска страна — данните влизат в XML фактурата.
model Amministratore {
  id             String             @id @default(uuid()) @db.Uuid
  tipo           TipoAmministratore @default(PERSONA_FISICA)
  nome           String
  cognome        String?
  ragioneSociale String?
  partitaIva     String?
  codiceFiscale  String?
  pec            String?
  /// Codice destinatario НА КЛИЕНТА (7 знака за частни, 6 за PA). Без него и
  /// без PEC фактурата няма къде да бъде доставена: `0000000` праща документа
  /// в „кутията" на получателя в Agenzia delle Entrate, не при него.
  codiceSdi      String?
  email          String?
  telefono       String?
  indirizzo      String?
  citta          String?
  cap            String?
  /// Част от фискалния адрес: иска се и на DDT, и в XML-а за SDI.
  provincia      String?
  note           String?
  attivo         Boolean            @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  condomini  Condominio[]
  impianti   Impianto[]
  preventivi Preventivo[]
  fatture    Fattura[]

  @@index([tenantId])
  contratti  Contratto[]

  @@map("amministratori")
}

model Dipendente {
  id               String         @id @default(uuid()) @db.Uuid
  nome             String
  cognome          String
  tipo             TipoDipendente @default(TECNICO)
  codiceFiscale    String?
  dataAssunzione   DateTime?
  /// Цена на ЧАС за фирмата (заплата + осигуровки), без ДДС. Без нея отчетът за
  /// рентабилност не брои труда като разход и договорът изглежда по-печеливш,
  /// отколкото е.
  costoOrario      Decimal?       @db.Decimal(10, 2)
  patente          String?
  specializzazioni String[]       @default([])
  email            String?
  telefono         String?
  note             String?
  attivo           Boolean        @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  automezzo    Automezzo?
  assegnazioni AssegnazioneTecnico[]
  ordiniLavoro OrdineLavoro[]

  @@index([tenantId])
  rapportini Rapportino[]

  @@map("dipendenti")
}

// Фирмен автопарк — трите дати определят цветния статус в списъка.
model Automezzo {
  id                   String    @id @default(uuid()) @db.Uuid
  targa                String
  marca                String
  modello              String
  chilometraggio       Int       @default(0)
  scadenzaRevisione    DateTime?
  scadenzaAssicurazione DateTime?
  scadenzaTagliando    DateTime?
  stato                String    @default("verde") // verde, giallo, rosso
  conducenteId         String?   @unique @db.Uuid
  note                 String?
  attivo               Boolean   @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  conducente Dipendente? @relation(fields: [conducenteId], references: [id])

  @@index([tenantId])
  @@unique([tenantId, targa])
  @@map("automezzi")
}

model Cottimista {
  id             String         @id @default(uuid()) @db.Uuid
  ragioneSociale String
  tipo           TipoCottimista @default(DITTA_INDIVIDUALE)
  partitaIva     String?
  email          String?
  telefono       String?
  indirizzo      String?
  note           String?
  attivo         Boolean        @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  squadre      Squadra[]
  ordiniLavoro OrdineLavoro[]

  @@index([tenantId])
  @@map("cottimisti")
}

model Squadra {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  cottimistiId String   @db.Uuid
  capocantiere String?
  membri       String[] @default([])
  attiva       Boolean  @default(true)
  note         String?
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cottimista   Cottimista     @relation(fields: [cottimistiId], references: [id])
  ordiniLavoro OrdineLavoro[]

  @@index([tenantId])
  @@map("squadre")
}

// ─── Магазин ────────────────────────────────────────────────────────────────

model ArticoloMagazzino {
  id             String        @id @default(uuid()) @db.Uuid
  codice         String
  barcode        String?
  nome           String
  descrizione    String        @default("")
  tipo           TipoMagazzino @default(COMPONENTI)
  categoria      String?
  ubicazione     String?
  quantita       Int           @default(0) // движи се САМО чрез движения
  sogliaMinima   Int           @default(0)
  prezzoAcquisto Decimal?      @db.Decimal(12, 2)
  prezzoVendita  Decimal?      @db.Decimal(12, 2)
  marginePerc    Decimal?      @db.Decimal(7, 2)
  aliquotaIva    Decimal       @default(22) @db.Decimal(5, 2)
  note           String?
  attivo         Boolean       @default(true)
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  movimenti      MovimentoMagazzino[]
  vociPreventivo VocePreventivo[]

  @@index([tenantId])
  @@unique([tenantId, codice])
  @@map("articoli_magazzino")
}

// Хронологичен регистър — quantita никога не се пипа директно.
model MovimentoMagazzino {
  id         String        @id @default(uuid()) @db.Uuid
  articoloId String        @db.Uuid
  tipo       TipoMovimento
  quantita   Int
  nota       String?
  ddtId      String?       @db.Uuid
  /// Ордина, за който е излязъл материалът. Без тази връзка вложеното не може
  /// да се отнесе към договор или импиант и отчетът брои само труда.
  ordineLavoroId String?    @db.Uuid
  tenantId  String?   @db.Uuid // изолация по фирма
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  articolo ArticoloMagazzino @relation(fields: [articoloId], references: [id])
  ddt      Ddt?              @relation(fields: [ddtId], references: [id])
  ordineLavoro OrdineLavoro? @relation(fields: [ordineLavoroId], references: [id])

  @@index([tenantId])
  @@map("movimenti_magazzino")
}

// ─── Активен цикъл ──────────────────────────────────────────────────────────

model Preventivo {
  id               String          @id @default(uuid()) @db.Uuid
  numero           String
  stato            StatoPreventivo @default(BOZZA)
  oggetto          String
  descrizione      String?
  totaleNetto      Decimal         @default(0) @db.Decimal(12, 2) // преизчислява се от редовете
  totaleIva        Decimal         @default(0) @db.Decimal(12, 2)
  totaleLordo      Decimal         @default(0) @db.Decimal(12, 2)
  validitaGiorni   Int             @default(30)
  impiantoId       String?         @db.Uuid
  amministratoreId String?         @db.Uuid
  utenteId         String?         @db.Uuid
  note             String?
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  impianto       Impianto?        @relation(fields: [impiantoId], references: [id])
  amministratore Amministratore?  @relation(fields: [amministratoreId], references: [id])
  utente         User?            @relation(fields: [utenteId], references: [id])
  voci           VocePreventivo[]
  ordiniLavoro   OrdineLavoro[]

  @@index([tenantId])
  @@unique([tenantId, numero])
  @@map("preventivi")
}

model VocePreventivo {
  id             String   @id @default(uuid()) @db.Uuid
  preventivoId   String   @db.Uuid
  articoloId     String?  @db.Uuid
  descrizione    String
  quantita       Decimal  @default(1) @db.Decimal(12, 2)
  prezzoUnitario Decimal  @default(0) @db.Decimal(12, 2)
  aliquotaIva    Decimal  @default(22) @db.Decimal(5, 2)
  /// „Natura" по кодировката на SDI (N1…N7). ЗАДЪЛЖИТЕЛНА, когато ставката е 0:
  /// без нея SDI не може да различи освободена доставка от забравена ставка.
  naturaIva      String?
  totale         Decimal  @default(0) @db.Decimal(12, 2)
  ordine         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preventivo Preventivo         @relation(fields: [preventivoId], references: [id], onDelete: Cascade)
  articolo   ArticoloMagazzino? @relation(fields: [articoloId], references: [id])

  @@map("voci_preventivo")
}

// Работата за изпълнение. Статусът минава само по позволените преходи.
/// Договор за поддръжка: canone, обхванати импианти, периодичност на
/// посещенията и на фактурирането, срок и автоматично подновяване.
///
/// От него се раждат ДВЕ неща, и двете автоматично:
///   • ордини за периодичните посещения (`prossimaVisita`),
///   • фактури за canone-то (`prossimaFattura`).
/// Двете дати са „водачът" на автоматизма: местят се напред само след успешно
/// раждане, така че спрян cron наваксва, вместо да прескача периоди.
model Contratto {
  id                String         @id @default(uuid()) @db.Uuid
  numero            String
  stato             StatoContratto @default(BOZZA)
  oggetto           String
  /// Такса за периода на фактуриране, БЕЗ ДДС.
  canone            Decimal        @default(0) @db.Decimal(12, 2)
  aliquotaIva       Decimal        @default(22) @db.Decimal(5, 2)
  periodicitaVisite Periodicita    @default(SEMESTRALE)
  periodicitaFatturazione Periodicita @default(TRIMESTRALE)
  dataInizio        DateTime
  dataFine          DateTime
  /// Мълчаливо подновяване: при изтичане срокът се продължава с още толкова.
  rinnovoAutomatico Boolean        @default(true)
  /// Срок за предизвестие при отказ (месеци) — за напомнянето преди подновяване.
  preavvisoMesi     Int            @default(3)
  amministratoreId  String?        @db.Uuid
  condominioId      String?        @db.Uuid
  /// Кога автоматизмът трябва да роди следващия ордин / следващата фактура.
  prossimaVisita    DateTime?
  prossimaFattura   DateTime?
  note              String?
  tenantId          String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  amministratore Amministratore?    @relation(fields: [amministratoreId], references: [id])
  condominio     Condominio?        @relation(fields: [condominioId], references: [id])
  impianti       ContrattoImpianto[]
  ordini         OrdineLavoro[]
  fatture        Fattura[]

  @@index([tenantId])
  @@index([stato, prossimaVisita])
  @@index([stato, prossimaFattura])
  @@unique([tenantId, numero])
  @@map("contratti")
}

/// Кои импианти покрива договорът. Отделна таблица, защото един договор
/// обикновено покрива няколко импианта на един и същ кондоминиум, а един
/// импиант може да смени договора си във времето.
model ContrattoImpianto {
  id          String   @id @default(uuid()) @db.Uuid
  contrattoId String   @db.Uuid
  impiantoId  String   @db.Uuid
  createdAt   DateTime @default(now())

  contratto Contratto @relation(fields: [contrattoId], references: [id], onDelete: Cascade)
  impianto  Impianto  @relation(fields: [impiantoId], references: [id], onDelete: Cascade)

  @@unique([contrattoId, impiantoId])
  @@index([impiantoId])
  @@map("contratti_impianti")
}

model OrdineLavoro {
  id             String         @id @default(uuid()) @db.Uuid
  numero         String
  stato          StatoOrdine    @default(BOZZA)
  priorita       PrioritaOrdine @default(ORDINARIA)
  oggetto        String
  descrizione    String?
  noteInterne    String? // никога не се печатат
  noteCommittente String?
  /// Платено на котимиста / външен изпълнител за този ордин, без ДДС.
  costoEsterno   Decimal?       @db.Decimal(12, 2)
  dataInizio     DateTime?
  dataFine       DateTime?
  impiantoId     String?        @db.Uuid
  preventivoId   String?        @db.Uuid
  /// Попълва се, когато ордина е роден от периодичното посещение по договор.
  contrattoId    String?        @db.Uuid
  tecnicoId      String?        @db.Uuid
  cottimistiId   String?        @db.Uuid
  squadraId      String?        @db.Uuid
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  impianto   Impianto?     @relation(fields: [impiantoId], references: [id])
  preventivo Preventivo?   @relation(fields: [preventivoId], references: [id])
  contratto  Contratto?    @relation(fields: [contrattoId], references: [id])
  tecnico    Dipendente?   @relation(fields: [tecnicoId], references: [id])
  cottimista Cottimista?   @relation(fields: [cottimistiId], references: [id])
  squadra    Squadra?      @relation(fields: [squadraId], references: [id])
  storico     StoricoStato[]
  movimenti   MovimentoMagazzino[]
  fatture     Fattura[]
  ddt         Ddt[]
  rapportini  Rapportino[]

  @@index([tenantId])
  @@unique([tenantId, numero])
  @@map("ordini_lavoro")
}

/// Отчет за намесата (rapportino di intervento), подписан на място.
///
/// Това е документът, който техникът попълва при клиента и администраторът на
/// кондоминиума подписва. Днес този лист се пише на хартия и се преписва в
/// офиса — с всичко, което се губи по пътя: часове, вложени материали, кой
/// какво е приел.
///
/// Подписът се пази като PNG (data URL). Не е квалифициран електронен подпис
/// по eIDAS и не претендира да е такъв — той е доказателство за приемане на
/// работата, каквото е и подписът върху хартиения лист.
model Rapportino {
  id              String          @id @default(uuid()) @db.Uuid
  numero          String
  ordineLavoroId  String          @db.Uuid
  tecnicoId       String?         @db.Uuid
  dataOra         DateTime        @default(now())
  /// Отработени часове, с четвъртинки (1.25 = час и петнайсет).
  oreLavoro       Decimal         @default(0) @db.Decimal(6, 2)
  descrizione     String
  esito           EsitoIntervento @default(RISOLTO)
  /// Вложени материали като свободен текст; движението по склада е отделно и
  /// остава единственият източник на истината за наличността.
  materiali       String?
  noteInterne     String?
  /// PNG (data URL) на подписа. Празно = още неподписан.
  firmaCliente    String?
  firmatarioNome  String?
  firmatarioRuolo String?
  firmatoAt       DateTime?
  tenantId        String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  ordineLavoro OrdineLavoro @relation(fields: [ordineLavoroId], references: [id], onDelete: Cascade)
  tecnico      Dipendente?  @relation(fields: [tecnicoId], references: [id])

  @@index([tenantId])
  @@index([ordineLavoroId])
  @@unique([tenantId, numero])
  @@map("rapportini")
}

// Пише се автоматично при всяка смяна на статус.
model StoricoStato {
  id              String       @id @default(uuid()) @db.Uuid
  ordineLavoroId  String       @db.Uuid
  statoPrecedente StatoOrdine?
  statoNuovo      StatoOrdine
  nota            String?
  utente          String
  createdAt       DateTime     @default(now())

  ordineLavoro OrdineLavoro @relation(fields: [ordineLavoroId], references: [id], onDelete: Cascade)

  @@map("storico_stati")
}

// ─── Документална област ────────────────────────────────────────────────────

model Fattura {
  id               String       @id @default(uuid()) @db.Uuid
  numero           String
  tipo             TipoFattura  @default(EMESSA)
  stato            StatoFattura @default(BOZZA)
  data             DateTime     @default(now())
  dataScadenza     DateTime?
  oggetto          String?
  totaleNetto      Decimal      @default(0) @db.Decimal(12, 2)
  totaleIva        Decimal      @default(0) @db.Decimal(12, 2)
  totaleLordo      Decimal      @default(0) @db.Decimal(12, 2)
  amministratoreId String?      @db.Uuid
  ordineLavoroId   String?      @db.Uuid
  /// Попълва се, когато фактурата е за canone по договор.
  contrattoId      String?      @db.Uuid
  utenteId         String?      @db.Uuid
  note             String?
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  amministratore Amministratore? @relation(fields: [amministratoreId], references: [id])
  ordineLavoro   OrdineLavoro?   @relation(fields: [ordineLavoroId], references: [id])
  contratto      Contratto?      @relation(fields: [contrattoId], references: [id])
  utente         User?           @relation(fields: [utenteId], references: [id])
  voci           VoceFattura[]

  @@index([tenantId])
  @@unique([tenantId, numero])
  @@map("fatture")
}

model VoceFattura {
  id             String   @id @default(uuid()) @db.Uuid
  fatturaId      String   @db.Uuid
  descrizione    String
  quantita       Decimal  @default(1) @db.Decimal(12, 2)
  prezzoUnitario Decimal  @default(0) @db.Decimal(12, 2)
  aliquotaIva    Decimal  @default(22) @db.Decimal(5, 2)
  /// „Natura" по кодировката на SDI (N1…N7). ЗАДЪЛЖИТЕЛНА, когато ставката е 0:
  /// без нея SDI не може да различи освободена доставка от забравена ставка.
  naturaIva      String?
  totale         Decimal  @default(0) @db.Decimal(12, 2)
  ordine         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fattura Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  @@map("voci_fattura")
}

// Транспортни документи по D.P.R. 472/1996.
model Ddt {
  id               String   @id @default(uuid()) @db.Uuid
  numero           String
  data             DateTime @default(now())
  causale          String?
  destinatario     String?
  indirizzoConsegna String?
  vettore          String?
  ordineLavoroId   String?  @db.Uuid
  note             String?
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ordineLavoro OrdineLavoro?        @relation(fields: [ordineLavoroId], references: [id])
  righe        RigaDdt[]
  movimenti    MovimentoMagazzino[]

  @@index([tenantId])
  @@unique([tenantId, numero])
  @@map("ddt")
}

model RigaDdt {
  id          String   @id @default(uuid()) @db.Uuid
  ddtId       String   @db.Uuid
  descrizione String
  quantita    Decimal  @default(1) @db.Decimal(12, 2)
  um          String?
  peso        Decimal? @db.Decimal(10, 2)
  ordine      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ddt Ddt @relation(fields: [ddtId], references: [id], onDelete: Cascade)

  @@map("righe_ddt")
}

model Documento {
  id        String        @id @default(uuid()) @db.Uuid
  tipo      TipoDocumento @default(ALTRO)
  titolo    String
  contenuto String?
  fileUrl   String?
  utenteId  String?       @db.Uuid
  note      String?
  tenantId  String?   @db.Uuid // изолация по фирма (мулти-инсталация)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  utente User? @relation(fields: [utenteId], references: [id])

  @@index([tenantId])
  @@map("documenti")
}

// ─── Наблюдаемост на автоматизмите ──────────────────────────────────────────

// Всяко пускане на автоматизъм оставя следа. Без нея спрян cron/рестартирала
// машина означава пропуснат законов срок, за който никой не разбира.
model AutomatismoRun {
  id          String    @id @default(uuid()) @db.Uuid
  nome        String // scadenze | retention
  iniziatoAt  DateTime  @default(now())
  terminatoAt DateTime?
  esito       String    @default("IN_CORSO") // IN_CORSO | OK | ERRORE
  durataMs    Int?
  dettagli    Json? // агрегатни броячи, никога лични данни
  errore      String? // тип + код, без съобщение
  createdAt   DateTime  @default(now())

  @@index([nome, iniziatoAt])
  @@map("automatismi_run")
}

// ─── Публично API и webhooks ────────────────────────────────────────────────

/// Ключ за достъп на ВЪНШНА система (счетоводен софтуер, портал на клиента).
///
/// Пази се само SHA-256 отпечатък: ключът се показва ВЕДНЪЖ при създаване и не
/// може да бъде възстановен. Компрометирана база тогава не дава достъп до API-то,
/// а изгубен ключ се сменя, вместо да се търси.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  /// Кратък видим префикс — за разпознаване в списъка без да се пази ключът.
  prefisso   String    @unique
  chiaveHash String    @unique
  etichetta  String
  /// Правата на ключа. Празно значи НИЩО, не „всичко" — затворено по подразбиране.
  ambiti     String[]  @default([])
  ultimoUso  DateTime?
  scadenza   DateTime?
  revocataAt DateTime?
  tenantId   String?   @db.Uuid
  creataDaId String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@map("api_keys")
}

/// Абонамент за събития. Външната система получава известие, вместо да пита.
model Webhook {
  id         String    @id @default(uuid()) @db.Uuid
  url        String
  /// Тайна за подписа на доставката. Виждала се е само при създаване.
  segreto    String
  /// Кои събития. Празно = никакви (затворено по подразбиране).
  eventi     String[]  @default([])
  attivo     Boolean   @default(true)
  /// Поредни неуспехи; след тавана абонаментът се спира сам.
  fallimenti Int       @default(0)
  tenantId   String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  consegne WebhookConsegna[]

  @@index([tenantId])
  @@map("webhooks")
}

/// Опашката на доставките. Отделна таблица, защото доставката се ПОВТАРЯ:
/// получателят може да е недостъпен, а събитието не бива да се губи.
model WebhookConsegna {
  id            String    @id @default(uuid()) @db.Uuid
  webhookId     String    @db.Uuid
  evento        String
  /// Тялото се замразява при пораждането: препращане на „текущото състояние"
  /// би пратило по-късна стойност и получателят би видял събитие, което не се е
  /// случило така.
  corpo         Json
  stato         String    @default("IN_ATTESA") // IN_ATTESA | CONSEGNATO | FALLITO
  tentativi     Int       @default(0)
  prossimoTentativo DateTime @default(now())
  ultimoErrore  String?
  rispostaStato Int?
  consegnatoAt  DateTime?
  tenantId      String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([stato, prossimoTentativo])
  @@index([tenantId])
  @@map("webhook_consegne")
}
