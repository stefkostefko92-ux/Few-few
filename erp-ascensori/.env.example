# ERP Ascensori Enterprise — конфигурация (тайните НИКОГА в репото; на сървъра, mode 600)
# PostgreSQL 16
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp_ascensori"

# Подпис на JWT сесиите (мин. 32 знака, генерирай случайно: openssl rand -hex 32)
SESSION_SECRET=""

# Ключ за HMAC-SHA256 подписа на audit_log (различен от SESSION_SECRET!)
AUDIT_HMAC_KEY=""

# Живот на токените
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
