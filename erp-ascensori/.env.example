# ERP Ascensori Enterprise — конфигурация.
#
# Тайните НИКОГА не влизат в репото и в деплойния архив: живеят само на сървъра,
# в `.env` с mode 600. Генерирай ги с `bash scripts/setup-env.sh`.

# ── База ────────────────────────────────────────────────────────────────────
# Пулът е ЯВЕН: без него Prisma отваря по една връзка на процес и при рестарт
# под товар Postgres отказва нови (P1001), докато старите изтекат.
DATABASE_URL="postgresql://erp:CAMBIAMI@db:5432/erp_ascensori?connection_limit=10&pool_timeout=10&connect_timeout=5"

# Ползват се само от docker-compose (създаването на базата).
POSTGRES_USER="erp"
POSTGRES_PASSWORD="CAMBIAMI"
POSTGRES_DB="erp_ascensori"

# ── Тайни (мин. 32 знака, РАЗЛИЧНИ една от друга) ───────────────────────────
# openssl rand -hex 32
#
# Смяната на SESSION_SECRET сваля всички сесии — безобидно.
# Смяната на AUDIT_HMAC_KEY прави ЦЕЛИЯ досегашен одит непроверим. Ключът се
# бекъпва заедно с базата и се пази поне колкото най-стария одитен ред (10 г.).
SESSION_SECRET=""
AUDIT_HMAC_KEY=""

# ── Мрежа ───────────────────────────────────────────────────────────────────
# Брой ДОВЕРЕНИ прокси-стъпки пред приложението: 1 при един Nginx, 2 зад
# Cloudflare. При 0 хедърът X-Forwarded-For се игнорира изцяло — тогава всички
# анонимни делят едно ведро и ограничението по IP на практика не работи.
TRUSTED_PROXY_HOPS=1

# Порт на хоста, на който Compose публикува приложението (само за 127.0.0.1).
APP_PORT=3050

# ── Сесии ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Наблюдаемост ────────────────────────────────────────────────────────────
# Без токен /api/readyz връща само „готов/не". С хедъра `x-health-token` дава
# подробната диагностика — тя не е за пред публиката.
HEALTH_TOKEN=""

# След колко часа без успешно пускане на автоматизма /api/healthz/automatismi
# връща 503. 26 = 24 ч каданс + 2 ч резерв.
AUTOMATISMI_SOGLIA_ORE=26

# ── Ограничения на заявките (по подразбиране са разумни) ────────────────────
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_REFRESH=60
# RATE_LIMIT_WINDOW_MS=900000

# ── Бекъп ───────────────────────────────────────────────────────────────────
# Публичен ключ на age; частният стои ИЗВЪН този сървър. Празно = без криптиране
# (само за тестова инсталация).
BACKUP_AGE_RECIPIENT=""
