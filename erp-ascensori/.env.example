# ERP Ascensori Enterprise — конфигурация.
#
# Тайните НИКОГА не влизат в репото и в деплойния архив: живеят само на сървъра,
# в `.env` с mode 600. Генерирай ги с `bash scripts/setup-env.sh`.

# ── База ────────────────────────────────────────────────────────────────────
# Пулът е ЯВЕН: без него Prisma отваря по една връзка на процес и при рестарт
# под товар Postgres отказва нови (P1001), докато старите изтекат.
DATABASE_URL="postgresql://erp:CAMBIAMI@db:5432/erp_ascensori?connection_limit=10&pool_timeout=10&connect_timeout=5"

# Ползват се само от docker-compose (създаването на базата).
POSTGRES_USER="erp"
POSTGRES_PASSWORD="CAMBIAMI"
POSTGRES_DB="erp_ascensori"

# ── Тайни (мин. 32 знака, РАЗЛИЧНИ една от друга) ───────────────────────────
# openssl rand -hex 32
#
# Смяната на SESSION_SECRET сваля всички сесии — безобидно.
# Смяната на AUDIT_HMAC_KEY прави ЦЕЛИЯ досегашен одит непроверим. Ключът се
# бекъпва заедно с базата и се пази поне колкото най-стария одитен ред (10 г.).
SESSION_SECRET=""
AUDIT_HMAC_KEY=""

# Предишният ключ на одита — само за ПРОВЕРКА на вече подписаните редове.
# Попълва се САМО при ротация: слагаш стария тук, новия в AUDIT_HMAC_KEY, и
# регистърът остава проверим. Маха се, след като старите редове изтекат по срок.
AUDIT_HMAC_KEY_PRECEDENTE=""

# ── Мрежа ───────────────────────────────────────────────────────────────────
# Брой ДОВЕРЕНИ прокси-стъпки пред приложението: 1 при един Nginx, 2 зад
# Cloudflare. При 0 хедърът X-Forwarded-For се игнорира изцяло — тогава всички
# анонимни делят едно ведро и ограничението по IP на практика не работи.
TRUSTED_PROXY_HOPS=1

# Порт на хоста, на който Compose публикува приложението (само за 127.0.0.1).
APP_PORT=3050

# ── Сесии ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Наблюдаемост ────────────────────────────────────────────────────────────
# Без токен /api/readyz връща само „готов/не". С хедъра `x-health-token` дава
# подробната диагностика — тя не е за пред публиката.
HEALTH_TOKEN=""

# След колко часа без успешно пускане на автоматизма /api/healthz/automatismi
# връща 503. 26 = 24 ч каданс + 2 ч резерв.
AUTOMATISMI_SOGLIA_ORE=26

# ── Ограничения на заявките (по подразбиране са разумни) ────────────────────
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_REFRESH=60
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_CSP=120      # доклади за нарушена CSP на час от адрес

# ── Content-Security-Policy ─────────────────────────────────────────────────
# Политиката е ВКЛЮЧЕНА по подразбиране и се налага. Тази ключалка я превключва
# в режим „само наблюдавай": браузърът докладва, но НЕ блокира.
#
# Кога се ползва: при инсталация с ваша добавка (фирмен скрипт, вграден
# инструмент за поддръжка), за да се види какво би се счупило, ПРЕДИ да се
# счупи. Броячът `erp_csp_violazioni_totale` в /api/metrics показва какво е
# сработило и по коя директива. Оставено така завинаги, това е политика,
# която не пази нищо — върнете го на 0, щом броячът се успокои.
# CSP_REPORT_ONLY=1

# ── Бекъп ───────────────────────────────────────────────────────────────────
# Публичен ключ на age; частният стои ИЗВЪН този сървър. Празно = без криптиране
# (само за тестова инсталация).
BACKUP_AGE_RECIPIENT=""

# Публичният адрес на инсталацията, БЕЗ наклонена черта накрая.
# Ползва се за QR етикетите на импиантите: те се печатат и лепят веднъж, а
# сгрешена стойност значи четиристотин стикера, водещи наникъде.
# Не се извежда от заявката — хедърът `Host` се подправя.
APP_URL=https://erp.azienda.it

# Парола на bootstrap потребителя `postgres`. Приложението НЕ го ползва — с него
# се създава само приложната роля при първото вдигане. Причината за разделянето:
# суперпотребителят заобикаля Row-Level Security безусловно, а Postgres отказва
# да понижи именно bootstrap-а. Виж deploy/postgres-init/.
POSTGRES_BOOTSTRAP_PASSWORD=

# ── Асистент AI: попълване на форма от документ (ИЗКЛЮЧЕН по подразбиране) ──
#
# ВНИМАНИЕ, ПРЕДИ ДА ГО ВКЛЮЧИШ. Функцията праща КАЧЕНИЯ ДОКУМЕНТ на трета
# страна. В тези документи има имена, данъчни номера и адреси — лични данни.
# Тоест доставчикът става обработващ по чл. 28 ОРЗД и това иска:
#
#   • сключен договор за обработка (DPA) с доставчика;
#   • разкриване в информацията към клиентите — продуктът си го показва сам на
#     страницата „Diritti dell'interessato“, но информативата на ФИРМАТА е нейна
#     отговорност;
#   • преценка къде се обработват данните. За клиент, който иска обработка в ЕС,
#     посочи регионален endpoint през AI_BASE_URL или остави функцията изключена.
#
# Празно AI_PROVIDER = изключено. Приложението работи напълно без нея.
# Коментарите са на СВОЙ ред: `--env-file` на Node не реже инлайн коментар след
# `=` така, както го прави Compose — стойността тогава става „off | gemini“.
# off | gemini | anthropic | openai
AI_PROVIDER=
# ключът живее САМО тук, mode 600; никога в репото
AI_API_KEY=
# по подразбиране — мултимодален модел на доставчика
AI_MODEL=
# за регионален endpoint или прокси
AI_BASE_URL=
# името, което вижда потребителят
AI_FORNITORE_ETICHETTA=
# прочитания на час на потребител — всяко струва пари
RATE_LIMIT_AI=60

# ── Известия за срокове по е-поща ───────────────────────────────────────────
# ИЗКЛЮЧЕНО, докато SMTP_HOST и SMTP_MITTENTE не са зададени. Празни = опашката
# се пълни и НЕ се губи; просто нищо не тръгва (и екранът „Integrazioni“ го
# казва). Получателите се задават В ПРИЛОЖЕНИЕТО, за всяка фирма поотделно
# („Dati aziendali“ → E-mail per gli avvisi), защото са данни на клиента, не
# конфигурация на машината.
#
# Връзката ВИНАГИ е шифрована: на 465 неявен TLS, на 587 задължителен STARTTLS.
# Сървър, който не предлага STARTTLS, се отказва — паролата на пощенската кутия
# по открита връзка е паролата на цялата фирма.
SMTP_HOST=
# 587 (STARTTLS) или 465 (неявен TLS)
SMTP_PORTA=587
# по подразбиране се извежда от порта; „diretto“ форсира неявен TLS
SMTP_TLS=
# потребител и парола НА ПРИЛОЖЕНИЕТО (app password), не личната парола
SMTP_UTENTE=
SMTP_PASSWORD=
# адресът, който получателят вижда като подател — трябва да е на същия домейн
SMTP_MITTENTE=
# името до адреса
SMTP_NOME=ERP Ascensori
# колко известия праща един пуск на автоматизма
NOTIFICHE_LOTTO=50

# ── Подаване към SDI ────────────────────────────────────────────────────────
# ИЗКЛЮЧЕНО по подразбиране: продукт, който сам започва да подава фактури,
# защото някой е попълнил променлива, издава документи без да е питан.
# manuale (сваляне на файла) | pec | intermediario
SDI_CANALE=manuale
# при `pec`: адресът на SDI. За ПЪРВО подаване е sdi01@pec.fatturapa.it;
# след първия отговор SDI пише от друг адрес и следващите писма отиват на НЕГО.
SDI_PEC_DESTINATARIO=
# при `intermediario`: базовият адрес. Задължително HTTPS и публичен —
# резолвният адрес се проверява отново при самото свързване.
SDI_INTERMEDIARIO_URL=
# колко подавания на час на потребител
RATE_LIMIT_SDI=120

# ── Календар ────────────────────────────────────────────────────────────────
# Колко посещения на ден са разумни за един техник; над това денят се маркира
# като претоварен. `0` изключва проверката. В ПОСЕЩЕНИЯ, не в часове: часовете
# се научават от рапортино-то СЛЕД намесата, тоест сутринта не съществуват.
CAPACITA_INTERVENTI_TECNICO=6

# ── Прикачени файлове ───────────────────────────────────────────────────────
# Коренът на хранилището. ИЗВЪН публичната папка нарочно. В Compose стойността
# се задава там (`/var/lib/erp-ascensori/allegati`) и се монтира като том —
# тук е за пускане без Docker.
STORAGE_DIR=./.storage
