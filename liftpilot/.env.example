# On the server: /opt/few-few/shared/liftpilot/.env (mode 600). deploy/deploy.sh creates it with random values on the
# first deploy. Never commit a real .env.
POSTGRES_PASSWORD=CHANGE_ME_letters_and_digits_only
AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
APP_PORT=4330
PUBLIC_BASE_URL=https://liftpilot.carbonstealth.eu
# search engines only after the owner approves the public release
ALLOW_INDEXING=false
# who may register a company: invite (the beta: only the addresses the platform administrator invites from /app/admin,
# «Inviti alla beta», each with its link) or open (anyone; the invitations still work)
REGISTRATION_MODE=invite
LOG_LEVEL=info
# first start only: the platform administrator (deploy.sh empties ADMIN_PASSWORD once the application is healthy)
ADMIN_EMAIL=admin@carbonstealth.eu
ADMIN_PASSWORD=
ADMIN_NAME=Carbon Stealth VCC
ADMIN_COMPANY=Carbon Stealth VCC
# e-mail for registration and forgotten password: Brevo's SMTP relay (port 2525, STARTTLS); without SMTP_HOST both
# stay closed. Values with special characters in single quotes (Docker Compose reads them literally).
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM='LiftPilot <noreply@carbonstealth.eu>'
# the subscription (Stripe, src/lib/billing.ts): the secret key (sk_live_… restricted to what the app uses), the secret
# of the webhook https://<domain>/api/billing/webhook (events: checkout.session.completed, customer.subscription.created,
# .updated, .deleted, .paused, .resumed), the recurring monthly Price of the owner (price_…) and the Product the packs of
# slots are sold as (prod_…; their amounts are the pack's share of the monthly price). Without all four, billing is off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRODUCT_SEATS=
# Stripe Tax on the subscription (needs the tax settings of the Stripe account)
STRIPE_AUTOMATIC_TAX=false
# days of trial from a company's first sign-in with billing on (at least 14: the terms promise them)
BILLING_TRIAL_DAYS=14
# the first day of paid use (YYYY-MM-DD, from 00:00 UTC): the day stated in the owners' e-mail sent at least 30 days
# before (docs/terms-changes.md, 1a). Before it, or without it, billing stays off (the free beta) whatever the four
# values above; a test setup with Stripe's test keys sets a day already past
BILLING_START=
# the automatic reading of the survey sketches (round 50): Claude on Google Cloud Vertex AI, EU only (VERTEX_REGION eu
# — the multi-region Opus needs — or a europe-* region; anything else stops the start). Off while VERTEX_PROJECT_ID is
# empty or the service account's key is not in /opt/few-few/shared/liftpilot/vertex/service-account.json (owned by the
# container's user, uid 1000, mode 600). Never put the key itself in this file. Before turning it on in production:
# the 30-day e-mail to every Titolare, Google's Cloud Data Processing Addendum accepted, Vertex request-response logging
# off (docs/terms-changes.md §3, DEPLOY.md)
VERTEX_PROJECT_ID=
VERTEX_REGION=eu
SKETCH_MODEL=claude-opus-5-5
# not for the application: the nightly copy of the database (deploy/backup.sh, /usr/local/sbin/liftpilot-backup) pings
# this address after every copy made — a heartbeat monitor (e.g. healthchecks.io, Uptime Kuma «push») that hears no ping
# for a day raises the alarm; empty: no ping. A failed copy is written to the system log (journalctl -t liftpilot-backup)
LIFTPILOT_BACKUP_HEARTBEAT_URL=
