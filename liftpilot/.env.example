# On the server: /opt/few-few/shared/liftpilot/.env (mode 600). deploy/deploy.sh creates it with random values on the
# first deploy. Never commit a real .env.
POSTGRES_PASSWORD=CHANGE_ME_letters_and_digits_only
AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
APP_PORT=4320
PUBLIC_BASE_URL=https://liftpilot.carbonstealth.eu
# search engines only after the owner approves the public release
ALLOW_INDEXING=false
LOG_LEVEL=info
# first start only: the platform administrator (deploy.sh empties ADMIN_PASSWORD once the application is healthy)
ADMIN_EMAIL=admin@carbonstealth.eu
ADMIN_PASSWORD=
ADMIN_NAME=Carbon Stealth VCC
ADMIN_COMPANY=Carbon Stealth VCC
# e-mail for registration and forgotten password: Brevo's SMTP relay (port 2525, STARTTLS); without SMTP_HOST both
# stay closed. Values with special characters in single quotes (Docker Compose reads them literally).
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM='LiftPilot <noreply@carbonstealth.eu>'
