# Пример — истинските стойности са само на сървъра (mode 600). Генериране:
#   openssl rand -hex 24      → POSTGRES_PASSWORD
#   openssl rand -hex 32      → JWT_SECRET, INBOUND_PATH, INBOUND_TOKEN
#   openssl rand -base64 32   → TOTP_KEY, DATA_KEY
# Смяната на DATA_KEY прави записаните писма нечетими — не го сменяй без план.
POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_KEY=
DATA_KEY=
APP_ORIGIN=https://otgovorko.carbonstealth.eu
HTTP_PORT=4380
# Webhook-ът на Brevo: https://<хост>/inbound/brevo/<INBOUND_PATH>, auth bearer = INBOUND_TOKEN.
INBOUND_PATH=
INBOUND_TOKEN=
# Vertex AI само в ЕС (eu или регион от EU_REGIONS). Празен проект → без чернови (всичко чака човек).
VERTEX_PROJECT_ID=
VERTEX_REGION=eu
DRAFT_MODEL=claude-sonnet-5-5
# Пътят до JSON на service account (mode 600); празно → ADC на машината.
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_LINK_DOMAINS=carbonstealth.eu
RETENTION_DAYS=180
