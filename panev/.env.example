# ============================================================
#  PANEV ASCENSORI — variabili d'ambiente
#  Локална разработка:  cp .env.example .env   (в panev/)
#  Продукция (VPS):     /etc/panev/panev.env   (mode 600, panev:panev)
#                       → systemd EnvironmentFile, виж DEPLOY.md
#  ТАЙНИТЕ НИКОГА не влизат в git/архива.
# ============================================================

# ── ЗАДЪЛЖИТЕЛНИ В ПРОДУКЦИЯ ────────────────────────────────
# (1) NODE_ENV — включва prod режима: кеш заглавия, HSTS, строгата
#     проверка на JWT_SECRET.
NODE_ENV=production

# (2) PORT — приложението слуша САМО на 127.0.0.1:$PORT, зад nginx.
#     4102 е портът, конфигуриран в deploy/nginx/panev.conf и в autodeploy.sh.
PORT=4102

# (3) BASE_URL — каноничният домейн, БЕЗ www. Целият генериран сайт
#     (canonical, hreflang, sitemap.xml, JSON-LD) е на non-www; nginx прави
#     301 от www.panevascensori.it насам. НЕ слагай www тук.
BASE_URL=https://panevascensori.it

# (4) JWT_SECRET — подписва админ сесиите. Минимум 32 знака, иначе
#     приложението СЕ СПИРА в продукция (lib/auth.js). Генерирай с:
#       node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE-ME-64-random-bytes-see-comment-above
JWT_EXPIRES=4h

# ── ЗАДЪЛЖИТЕЛНИ ЗА ФОРМАТА ЗА КОНТАКТ (имейл) ──────────────
# Без SMTP_PASS формата продължава да РАБОТИ и записва запитването в базата
# (видимо в /admin/messaggi), но НЕ тръгва имейл — нито към фирмата, нито
# потвърждение към клиента. За продукция това на практика е задължително.
# `secure` се извежда от порта: 465 → SMTPS (Aruba), друг порт → STARTTLS.
# (SMTP_SECURE НЕ се чете от кода — не го задавай, само обърква.)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@panevascensori.it
SMTP_PASS=CHANGE-ME-aruba-mailbox-password
MAIL_FROM="Panev Ascensori <info@panevascensori.it>"
MAIL_TO_ADMIN=info@panevascensori.it

# ── ПО ЖЕЛАНИЕ ───────────────────────────────────────────────
# База (SQLite). Празно = ./data/panev.db спрямо кода. На VPS-а data/ е
# ЕДИНСТВЕНАТА записваема директория (systemd ReadWritePaths) и преживява
# деплой — не я мести без да обновиш и unit-а.
# DB_PATH=/opt/panev/data/panev.db

# Първоначален админ (ползва се САМО при първия сийд — scripts/seed.js).
# Празна парола = генерира се случайна и се показва ВЕДНЪЖ в лога
# (`journalctl -u panev` / изхода на autodeploy). Смени я при първо влизане.
ADMIN_EMAIL=info@panevascensori.it
ADMIN_PASSWORD=

# ── ИЗКЛЮЧЕНИ ПЛАЩАНИЯ (kill-switch) ────────────────────────
# Сайтът е B2B витрина: поръчка по имейл, без количка и без онлайн плащане.
# Stripe кодът е спрян — /api/create-checkout-session връща 503, докато
# PAYMENTS_ENABLED != true. НЕ включвай това без правен преглед (условия за
# продажба, право на отказ, фактуриране).
# PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
