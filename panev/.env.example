# ============================================================
#  PANEV ASCENSORI — Variabili d'ambiente (v2.0)
#  Copia questo file in .env e compila con i tuoi valori reali
# ============================================================

# ── Server ───────────────────────────────────────────────────
# Produzione su VPS: NODE_ENV=production
NODE_ENV=production
PORT=4102
BASE_URL=https://www.panevascensori.it

# ── JWT secret (OBBLIGATORIO in produzione) ──────────────────
# Genera con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE-ME-64-random-bytes-see-comment-above
JWT_EXPIRES=4h

# ── Database (SQLite) ─────────────────────────────────────────
# Se non impostato, default è ./data/panev.db
# DB_PATH=/var/lib/panev/panev.db

# ── Admin iniziale (usato solo al primo seed) ─────────────────
ADMIN_EMAIL=info@panevascensori.it
ADMIN_PASSWORD=Panev2024!

# ── Stripe (https://dashboard.stripe.com/apikeys) ────────────
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret: in produzione ottenuto dal dashboard Stripe (Endpoints)
# In sviluppo con Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Email SMTP (Aruba hosting) ───────────────────────────────
# La password è quella della casella email info@panevascensori.it
# Senza SMTP_PASS, gli email non verranno inviati ma il form salverà in DB
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@panevascensori.it
SMTP_PASS=CHANGE-ME-aruba-mailbox-password
MAIL_FROM="Panev Ascensori <info@panevascensori.it>"
MAIL_TO_ADMIN=info@panevascensori.it
