# Staffe — variabili d'ambiente.
# I valori reali vivono SOLO sul server (permessi 600), mai nel repository
# né nell'archivio di deploy.

# PostgreSQL (UE).
DATABASE_URL="postgresql://staffe:CAMBIAMI@localhost:5432/staffe?schema=public"

# Firma dei token di sessione. Almeno 32 caratteri casuali.
# Generare con:  openssl rand -base64 48
AUTH_SECRET="cambiami-con-almeno-32-caratteri-casuali"

# Cartella degli allegati (disegni, PDF, CAD, foto). Fuori dal repository.
UPLOAD_DIR="./uploads"

# Utente amministratore creato dal seed (solo primo avvio).
SEED_ADMIN_EMAIL="admin@staffe.local"
SEED_ADMIN_PASSWORD="cambiami-al-primo-accesso"

# Notifiche via e-mail (facoltative: se assenti, restano solo in applicazione).
SMTP_URL=""
NOTIFICHE_MITTENTE="staffe@carbonstealth.eu"
