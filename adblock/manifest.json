      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      },
      {
        "id": "removeparam",
        "enabled": true,
        "path": "rules/removeparam.json"
      },
      {
        "id": "urlhaus",
        "enabled": false,
