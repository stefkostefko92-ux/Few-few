# adblock.carbonstealth.eu — static host for Supreme AdBlock.
# Serves the live filter file, the privacy policy and the landing page.
# Caddy gets a TLS cert automatically. Drop this block into the server's Caddyfile
# (or `import` it) and point the DNS A/AAAA record for the subdomain at the VPS.
#
# No `log` directive on purpose: Caddy then keeps NO access logs for this site —
# the privacy policy (server/privacy.html) promises exactly that. Do not add one.

adblock.carbonstealth.eu {
	root * /var/www/adblock
	encode zstd gzip

	# Security headers. No script-src/style-src in the CSP: the page uses one
	# inline style and one inline script and loads nothing from third parties;
	# what matters here is no framing (clickjacking), no <base> hijack, no plugins,
	# no form posts.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'"
		Permissions-Policy "browsing-topics=(), interest-cohort=(), camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Filter file + signature: short cache so updates propagate within ~an hour.
	@filters path /filters.json /filters.json.sig
	header @filters {
		Cache-Control "public, max-age=3600"
		Access-Control-Allow-Origin "*"
	}
	@filtersjson path /filters.json
	header @filtersjson Content-Type application/json

	# The exact texts of the bundled filter lists (THIRD_PARTY_NOTICES.txt): named by their SHA-256,
	# so a file never changes — long cache; served as a gzip download, never decompressed.
	@sources path /sources/*
	header @sources Content-Type application/gzip
	header @sources Cache-Control "public, max-age=31536000, immutable"

	# Images change only with a release; index.html asks for them with ?v=<content hash>
	# (tools/landing_assets.mjs), so a new image is a new URL.
	@assets path *.webp *.png
	header @assets Cache-Control "public, max-age=604800"

	# Pages: the browser always revalidates (a 304 by ETag is cheap), never shows a stale release.
	@pages not path *.webp *.png /filters.json /filters.json.sig /sources/*
	header @pages Cache-Control "no-cache"

	# Pretty URLs for the pages (Web Store Privacy Policy URL is /privacy, Support URL is /support).
	# A new page = a path here + in nginx.conf + in deploy/autodeploy.sh (gated by tests/site.test.mjs).
	@pretty path /privacy /support /youtube-ad-blocker /cookie-banner-blocker /bye /status /accessibility /for-it-admins /ublock-origin-alternative /press /how-we-measure /test
	rewrite @pretty {path}.html

	# Language pages (tools/site_lang.mjs → /<lang>/index.html): file_server serves the folder's
	# index.html and redirects /bg to /bg/ (the canonical address) by itself.
	@langs path /bg /de /it /es /fr /pt-br
	redir @langs {path}/ 301

	file_server
}
