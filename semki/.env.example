# Semki Bot — пример. Истинският .env е на сървъра (/opt/few-few/shared/semki/.env, mode 600);
# прави го deploy/setup-env.sh. Никога не се комитва.

# Адресът на дашборда (без / накрая). Redirect URI в Discord Developer Portal = PUBLIC_BASE_URL/auth/callback
PUBLIC_BASE_URL=https://vps2.carbonstealth.eu

# openssl rand -hex 32 — и двете
POSTGRES_PASSWORD=
SESSION_SECRET=

# Discord Developer Portal → твоето приложение
# Bot → Reset Token
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Сървърът (Developer Mode → десен клик върху сървъра → Copy Server ID)
DISCORD_GUILD_ID=

# По избор
# HTTP_PORT=4340
# LOG_LEVEL=info
# ALERT_TICK_SECONDS=60

# Само за локална разработка (npm run dev) — в Docker се сглобява от POSTGRES_PASSWORD
# DATABASE_URL=postgresql://semki:ПАРОЛА@127.0.0.1:5432/semki
