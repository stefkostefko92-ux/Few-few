<%- include('partials/head') %>
<h1>Известия</h1>

<section class="card">
  <h2>Как работи</h2>
  <p class="small">Всяко правило тагва избраната роля в избрания канал, когато партида стигне прага — <strong>веднъж за партида</strong>. „Праг в %“ пингва при ≤ X%, „Оставащо време“ — когато до 0% останат X часа. Партиди, които вече са под прага при въвеждането, не се пингват. Часовият прозорец е в <a href="/settings">Настройки</a>.</p>
  <% if (channels.length === 0 || roles.length === 0) { %>
  <p class="flash err">Ботът още не вижда каналите и ролите на сървъра — презареди след малко.</p>
  <% } %>
</section>

<section class="card">
  <h2>Ново правило</h2>
  <form method="post" action="/alerts" class="grid">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Вид известие
      <select name="kind" required>
        <option value="PERCENT">Праг в % (при ≤ X%)</option>
        <option value="HOURS_LEFT">Оставащо време (X часа до 0%)</option>
      </select>
    </label>
    <label>Праг (X)
      <input type="text" name="threshold" inputmode="decimal" pattern="[0-9]+([.,][0-9]+)?" placeholder="напр. 20" required>
    </label>
    <label>Семки
      <select name="seedTypeKey">
        <option value="">Всички видове</option>
        <% types.forEach(function (t) { %><option value="<%= t.key %>"><%= t.label %></option><% }) %>
      </select>
    </label>
    <label>Канал
      <select name="channelId" required>
        <% channels.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %><%= c.usable ? '' : ' (ботът няма права)' %></option><% }) %>
      </select>
    </label>
    <label>Роля за тагване
      <select name="roleId" required>
        <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.name %><%= r.usable ? '' : ' (не се тагва)' %></option><% }) %>
      </select>
    </label>
    <label class="check"><input type="checkbox" name="enabled" value="on" checked> Включено</label>
    <button type="submit" class="btn">Добави правило</button>
  </form>
</section>

<section class="card">
  <h2>Правила <small><%= rules.length %></small></h2>
  <% if (rules.length === 0) { %>
  <p class="muted">Още няма правила — без тях ботът не тагва никого.</p>
  <% } else { %>
  <ul class="rules">
    <% rules.forEach(function (r) { %>
    <li class="rule<%= r.enabled ? '' : ' off' %>">
      <div class="b-main">
        <strong><%= r.thresholdText %></strong>
        <span><%= r.seedText %></span>
        <span class="<%= r.channelUsable ? '' : 'warn-text' %>"><%= r.channelName %></span>
        <span class="<%= r.roleUsable ? '' : 'warn-text' %>"><%= r.roleName %></span>
        <% if (!r.enabled) { %><span class="tag">изключено</span><% } %>
      </div>
      <% if (r.channelKnown && !r.channelUsable) { %><p class="warn-text small">Ботът няма View Channel и Send Messages в този канал — известията не тръгват.</p><% } %>
      <% if (r.roleKnown && !r.roleUsable) { %><p class="warn-text small">Ролята не може да бъде тагната: включи „Allow anyone to @mention this role“ или дай на бота Mention Everyone — дотогава известията чакат.</p><% } %>
      <details>
        <summary>Редакция</summary>
        <form method="post" action="/alerts/<%= r.id %>" class="grid">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Вид известие
            <select name="kind" required>
              <option value="PERCENT" <%= r.kind === 'PERCENT' ? 'selected' : '' %>>Праг в %</option>
              <option value="HOURS_LEFT" <%= r.kind === 'HOURS_LEFT' ? 'selected' : '' %>>Оставащо време (часа)</option>
            </select>
          </label>
          <label>Праг (X)
            <input type="text" name="threshold" inputmode="decimal" pattern="[0-9]+([.,][0-9]+)?" value="<%= r.thresholdInput %>" required>
          </label>
          <label>Семки
            <select name="seedTypeKey">
              <option value="">Всички видове</option>
              <% types.forEach(function (t) { %><option value="<%= t.key %>" <%= r.seedTypeKey === t.key ? 'selected' : '' %>><%= t.label %></option><% }) %>
            </select>
          </label>
          <label>Канал
            <select name="channelId" required>
              <% channels.forEach(function (c) { %><option value="<%= c.id %>" <%= r.channelId === c.id ? 'selected' : '' %>><%= c.name %><%= c.usable ? '' : ' (ботът няма права)' %></option><% }) %>
            </select>
          </label>
          <label>Роля за тагване
            <select name="roleId" required>
              <% roles.forEach(function (x) { %><option value="<%= x.id %>" <%= r.roleId === x.id ? 'selected' : '' %>><%= x.name %><%= x.usable ? '' : ' (не се тагва)' %></option><% }) %>
            </select>
          </label>
          <label class="check"><input type="checkbox" name="enabled" value="on" <%= r.enabled ? 'checked' : '' %>> Включено</label>
          <button type="submit" class="btn">Запази</button>
        </form>
        <div class="row">
          <form method="post" action="/alerts/<%= r.id %>/test" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn ghost">Пробно съобщение (без таг)</button>
          </form>
          <form method="post" action="/alerts/<%= r.id %>/delete" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn danger">Изтрий</button>
          </form>
        </div>
      </details>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('partials/foot') %>
