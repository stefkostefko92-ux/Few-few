<!doctype html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · Semki Bot</title>
  <meta name="description" content="Semki Bot — трайността на семките във FiveM сървъра и известията за изтичане в Discord.">
  <meta name="keywords" content="Carbon Stealth, Semki Bot, FiveM, Discord бот, семки, известия за изтичане">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0b0f0d">
  <link rel="icon" href="<%= asset('favicon.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= asset('apple-touch-icon.png') %>">
  <link rel="preload" href="/fonts/sofia-sans-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('fonts.css') %>">
  <link rel="stylesheet" href="<%= asset('base.css') %>">
  <link rel="stylesheet" href="<%= asset('ui.css') %>">
  <link rel="stylesheet" href="<%= asset('marks.css') %>">
  <% if (typeof pageCss !== 'undefined') { pageCss.forEach(function (name) { %><link rel="stylesheet" href="<%= asset(name) %>">
  <% }) } %><script src="<%= asset('confirm.js') %>" defer></script>
  <% if (typeof pageJs !== 'undefined') { %><script type="module" src="<%= asset(pageJs) %>"></script><% } %>
</head>
<body>
  <header class="top">
    <div class="top-in">
      <a class="brand" href="/"><img src="<%= asset('favicon.png') %>" alt="" width="28" height="28"> Semki</a>
      <% if (user) { %>
      <nav class="nav" aria-label="Основна навигация">
        <a href="/" <%- active === 'dashboard' ? 'aria-current="page"' : '' %>>Дашборд</a>
        <a href="/batches" <%- active === 'batches' ? 'aria-current="page"' : '' %>>Партиди</a>
        <a href="/alerts" <%- active === 'alerts' ? 'aria-current="page"' : '' %>>Известия</a>
        <a href="/settings" <%- active === 'settings' ? 'aria-current="page"' : '' %>>Настройки</a>
      </nav>
      <div class="me">
        <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" width="30" height="30"><% } %>
        <span class="who"><%= user.name %></span>
        <form method="post" action="/auth/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="link">Изход</button>
        </form>
      </div>
      <% } %>
    </div>
  </header>
  <main>
    <% if (flash) { %><p class="flash <%= flash.t %>" role="status"><%= flash.m %></p><% } %>
