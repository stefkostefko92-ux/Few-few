<!doctype html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Semki Bot</title>
  <meta name="description" content="Semki Bot — трайността на семките във FiveM сървъра и известията за изтичане в Discord.">
  <meta name="keywords" content="Carbon Stealth, Semki Bot, FiveM, Discord бот, семки, известия за изтичане">
  <meta name="robots" content="noindex, nofollow">
  <% if (typeof refreshSeconds !== 'undefined') { %><meta http-equiv="refresh" content="<%= refreshSeconds %>"><% } %>
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="<%= asset('favicon.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= asset('apple-touch-icon.png') %>">
  <link rel="stylesheet" href="<%= asset('style.css') %>">
  <% if (typeof pageCss !== 'undefined') { pageCss.forEach(function (name) { %><link rel="stylesheet" href="<%= asset(name) %>"><% }) } %>
  <script src="<%= asset('confirm.js') %>" defer></script>
</head>
<body>
  <header class="top">
    <a class="brand" href="/"><img src="<%= asset('favicon.png') %>" alt="" width="24" height="24"> Semki Bot</a>
    <% if (user) { %>
    <nav aria-label="Основна навигация">
      <a href="/dashboard" class="<%= active === 'dashboard' ? 'on' : '' %>">Дашборд</a>
      <a href="/" class="<%= active === 'batches' ? 'on' : '' %>">Семки</a>
      <a href="/alerts" class="<%= active === 'alerts' ? 'on' : '' %>">Известия</a>
      <a href="/settings" class="<%= active === 'settings' ? 'on' : '' %>">Настройки</a>
    </nav>
    <div class="me">
      <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" width="28" height="28"><% } %>
      <span><%= user.name %></span>
      <form method="post" action="/auth/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="link">Изход</button>
      </form>
    </div>
    <% } %>
  </header>
  <main>
    <% if (flash) { %><p class="flash <%= flash.t %>" role="status"><%= flash.m %></p><% } %>
