# ─────────────────────────────────────────────────────────────────────────────
#  ФК „Миньор“ Бобов дол — примерни променливи на средата
#  Копирайте този файл като `.env` и попълнете истинските стойности.
#  НИКОГА не качвайте реалния `.env` в Git.
# ─────────────────────────────────────────────────────────────────────────────

# --- База данни (PostgreSQL) ---
DATABASE_URL="postgresql://minyor:minyor@localhost:5432/minyor?schema=public"
POSTGRES_USER="minyor"
POSTGRES_PASSWORD=""
POSTGRES_DB="minyor"

# --- Автентикация на администрацията ---
# Дълъг случаен низ (поне 32 знака). Генерирайте напр. с: openssl rand -base64 48
AUTH_SECRET="ПРОМЕНИ_МЕ_дълъг_случаен_низ_поне_32_знака"

# Първоначален администратор (създава се при `npm run db:seed`).
ADMIN_EMAIL="admin@carbonstealth.eu"
ADMIN_PASSWORD="СМЕНИ_МЕ_силна_парола_мин_10"
ADMIN_NAME="Администратор"

# --- Публичен адрес на сайта ---
NEXT_PUBLIC_SITE_URL="https://minyor.carbonstealth.eu"

# --- Автоматична синхронизация (програма, резултати, класиране от bgclubs.eu) ---
# Таен токен, с който cron извиква /api/sync. Генерирайте: openssl rand -hex 24
SYNC_TOKEN=""

# --- Имейл за формата за контакти (по избор) ---
# Ако не е зададен SMTP, съобщенията се пазят само в базата (админ → Съобщения).
CLUB_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@carbonstealth.eu"

# --- Анонимна статистика (по избор, без бисквитки) ---
# Оставете празно, за да не се зарежда нищо външно.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC=""

# --- Потвърждаване на собствеността пред търсачки (по избор) ---
SEO_GOOGLE_VERIFICATION=""
SEO_BING_VERIFICATION=""

# --- Връзки в социалните мрежи (по избор) ---
FACEBOOK_URL=""
