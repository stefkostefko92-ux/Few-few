# ─── Среда ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Публичен адрес на сайта (без завършваща наклонена черта).
# Използва се за canonical URL, sitemap, Open Graph и структурирани данни.
SITE_URL=https://bg.sgbbg.com

# ─── Сигурност ───────────────────────────────────────────
# Дълъг случаен низ. Генерирайте с: openssl rand -hex 32
SESSION_SECRET=changeme_generate_a_long_random_secret

# Доверявай се на първия прокси (Nginx). 1 = да.
TRUST_PROXY=1

# ─── Първоначален администратор ──────────────────────────
# Използват се само при `npm run setup`, ако няма потребители.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sgbbg.com
ADMIN_PASSWORD=ChangeMe_Strong_Password_123!
