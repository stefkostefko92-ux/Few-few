<header class="site-header" id="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__tag">Национално представителна организация на хората с увреден слух</span>
      <nav class="topbar__links" aria-label="Бързи връзки">
        <a href="/kontakti">Контакти</a>
        <% if (site.facebook) { %><a href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a><% } %>
        <% if (site.youtube) { %><a href="<%= site.youtube %>" target="_blank" rel="noopener" aria-label="YouTube">YouTube</a><% } %>
      </nav>
    </div>
  </div>

  <div class="masthead">
    <div class="container masthead__inner">
      <a class="brand" href="/" aria-label="<%= site.name %> — начало">
        <img class="brand__logo" src="/img/logo.svg" width="56" height="56" alt="" aria-hidden="true">
        <span class="brand__text">
          <span class="brand__name"><%= site.name %></span>
          <span class="brand__sub"><%= site.short %> · вестник „<%= site.newspaperName %>“</span>
        </span>
      </a>

      <form class="masthead__search" action="/tarsene" method="get" role="search">
        <label class="visually-hidden" for="q">Търсене</label>
        <input type="search" id="q" name="q" placeholder="Търсене в новините…" autocomplete="off">
        <button type="submit" aria-label="Търси">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
      </form>

      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="primary-nav" id="primary-nav" aria-label="Основна навигация">
    <div class="container">
      <ul class="primary-nav__list">
        <li><a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Начало</a></li>
        <li><a href="/novini" class="<%= currentPath.startsWith('/novini') ? 'is-active' : '' %>">Новини</a></li>
        <% menuTree.forEach(function(cat){ %>
          <li class="<%= cat.children && cat.children.length ? 'has-children' : '' %>">
            <a href="/category/<%= cat.slug %>" class="<%= currentPath === '/category/' + cat.slug ? 'is-active' : '' %>"><%= cat.name %><% if (cat.children && cat.children.length) { %> <span class="caret" aria-hidden="true">▾</span><% } %></a>
            <% if (cat.children && cat.children.length) { %>
              <ul class="submenu">
                <% cat.children.forEach(function(ch){ %>
                  <li><a href="/category/<%= ch.slug %>"><%= ch.name %></a></li>
                <% }); %>
              </ul>
            <% } %>
          </li>
        <% }); %>
        <li><a href="/vestnik" class="cta-link <%= currentPath.startsWith('/vestnik') ? 'is-active' : '' %>">Вестник „<%= site.newspaperName %>“</a></li>
        <li><a href="/kontakti" class="<%= currentPath === '/kontakti' ? 'is-active' : '' %>">Контакти</a></li>
      </ul>
    </div>
  </nav>
</header>
