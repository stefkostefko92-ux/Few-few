# АСО — realtime (Socket.IO game server) image. Multi-stage, non-root (S17).
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/game-core/package.json packages/game-core/
COPY packages/db/package.json packages/db/
COPY apps/realtime/package.json apps/realtime/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @aso/db generate \
  && pnpm --filter @aso/shared build \
  && pnpm --filter @aso/game-core build \
  && pnpm --filter @aso/db build \
  && pnpm --filter @aso/realtime build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/realtime
USER node

EXPOSE 4501
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.REALTIME_PORT||4501)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
