# АСО production env — справка за $DEPLOY_DIR/.env (по подр. /root/aso/.env, права 600).
# Обикновено НЕ се пише на ръка: infra/autodeploy.sh го генерира при първо пускане
# с истински тайни (openssl rand). Тук е само списъкът какво има и какво значи.

# ── Host ports (127.0.0.1; 8080 е зает от Pterodactyl Wings) ──
# autodeploy.sh записва същите портове в nginx при първото инсталиране.
API_HOST_PORT=4500
RT_HOST_PORT=4501
WEB_HOST_PORT=4502
MK_HOST_PORT=8090

# ── Database / secrets ──
POSTGRES_USER=aso
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aso
JWT_SECRET=CHANGE_ME_32_HEX
JWT_REFRESH_SECRET=CHANGE_ME_32_HEX
INTERNAL_API_SECRET=CHANGE_ME_24_HEX

# ── Public URLs — the live domain behind the host reverse proxy (TLS) ──
# Never a raw server IP: it changes when the VPS is replaced (the old one here
# outlived its server), and a CORS origin on plain http is not one to trust.
CORS_ORIGINS=https://gaming.carbonstealth.eu
PUBLIC_WEB_URL=https://gaming.carbonstealth.eu
PUBLIC_API_URL=https://gaming.carbonstealth.eu
WEB_BASE_PATH=/app
# Празно = бисквитките за вход важат само за gaming.carbonstealth.eu. НЕ слагай
# основния домейн — тогава отиват и до всички останали поддомейни.
COOKIE_DOMAIN=
BOOTSTRAP_OWNER_EMAIL=admin@carbonstealth.eu

# ── Имейл (потвърждение/нова парола). Празен SMTP_HOST => писмата само се логват ──
SMTP_HOST=
# 587 + SMTP_SECURE=false (STARTTLS) или 465 + SMTP_SECURE=true (TLS от началото).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=АСО <no-reply@gaming.carbonstealth.eu>

# ── Stripe (Фаза 2; празно = магазинът показва „отваря скоро“) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true САМО след като в Stripe Dashboard има адрес на Общите условия.
STRIPE_TOS_CONFIGURED=false
# true САМО след активиран Stripe Tax + регистрация за ДДС/OSS (цените са с включен ДДС).
STRIPE_AUTOMATIC_TAX=false
