# АСО — play app (Vite SPA). Builds the static bundle (served under /app/ in
# prod, base set in vite.config), then serves it with a tiny non-root nginx.
# Same-origin /api and /socket.io are routed by the edge nginx (aso.conf), so
# this image is pure static — no runtime config.
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
# game-core: web's dev showcase (src/dev) imports the engines, and tsc
# typechecks those files — the workspace link + build must exist here too.
COPY packages/game-core/package.json packages/game-core/
COPY apps/web/package.json apps/web/
# Install with dev deps (vite/tsc) — do NOT set NODE_ENV=production here.
RUN pnpm install --frozen-lockfile
COPY . .
# NODE_ENV=production only for the build step → vite base becomes /app/.
RUN pnpm --filter @aso/shared build && pnpm --filter @aso/game-core build \
  && NODE_ENV=production pnpm --filter @aso/web build

# ---- static server ----
FROM nginx:1.27-alpine AS runner
# The SPA is built with base /app/, so its assets resolve under /app/.
COPY --from=build /app/apps/web/dist /usr/share/nginx/html/app
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf
EXPOSE 4502
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:4502/app/ >/dev/null 2>&1 || exit 1
