# АСО — marketing SSG. Builds the Next.js static export, then serves it with a
# tiny non-root nginx (the public, crawlable layer, §15).
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY apps/marketing/package.json apps/marketing/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @aso/shared build && pnpm --filter @aso/marketing build

# ---- static server ----
FROM nginx:1.27-alpine AS runner
COPY --from=build /app/apps/marketing/out /usr/share/nginx/html
COPY infra/nginx/marketing.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/ >/dev/null 2>&1 || exit 1
