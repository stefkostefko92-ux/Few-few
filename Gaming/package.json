{
  "name": "aso",
  "version": "0.0.0",
  "private": true,
  "description": "АСО — premium browser gaming portal (Carbon Stealth VCC)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aso/db generate",
    "db:migrate": "pnpm --filter @aso/db migrate:deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "ws@<8.21.0": "^8.21.0",
      "postcss@<8.5.10": "^8.5.10",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite": "^6.4.3"
    }
  }
}