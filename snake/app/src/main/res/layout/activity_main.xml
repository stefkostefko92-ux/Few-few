<?xml version="1.0" encoding="utf-8"?>
<!-- Заглавен екран: заглавие, рекорд, избор на ниво и бутон „Играй“.
     Използва реални Android View-та (не Canvas) заради достъпност (TalkBack). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lcd_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/lcd_pixel"
        android:textSize="56sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/title_tagline"
        android:textColor="@color/lcd_pixel"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/highScoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="@color/lcd_pixel"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/levelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/lcd_pixel"
        android:textSize="20sp" />

    <!-- Избор на начално ниво 1..9. SeekBar е достъпен за TalkBack. -->
    <SeekBar
        android:id="@+id/levelSeek"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:max="8"
        android:progress="0"
        android:contentDescription="@string/level_label" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minWidth="200dp"
        android:minHeight="56dp"
        android:text="@string/play"
        android:textSize="22sp" />
</LinearLayout>
