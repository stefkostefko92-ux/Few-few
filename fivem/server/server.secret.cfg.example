# ============================================================================
#  ПРИМЕР за тайните. Копирай като server.secret.cfg НА СЪРВЪРА (chmod 600),
#  попълни реалните стойности и разкоментирай `exec server.secret.cfg` в server.cfg.
#  ТОЗИ ФАЙЛ (.example) НЕ съдържа тайни. Реалният server.secret.cfg е git-игнориран.
# ============================================================================

# Лицензен ключ от https://keymaster.fivem.net
sv_licenseKey "СМЕНИ_МЕ"

# Връзка към MySQL/MariaDB (oxmysql формат)
set mysql_connection_string "mysql://balkan:СМЕНИ_МЕ@localhost/balkan?charset=utf8mb4"

# Steam Web API ключ (по избор, за steam identifier-и) — https://steamcommunity.com/dev/apikey
set steam_webApiKey "СМЕНИ_МЕ"

# RCON — задай СИЛНА парола или остави празно, за да е изключен
rcon_password "СМЕНИ_МЕ_ИЛИ_ПРАЗНО"

# Първи супер-админ (или управлявай през txAdmin)
# add_ace group.admin command allow
# add_principal identifier.fivem:0000000 group.admin
