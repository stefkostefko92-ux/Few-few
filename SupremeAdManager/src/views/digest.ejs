<%- include('_head') %>
<h1><%- icon('chart-column') %> <%= t('dig.title') %></h1>
<p class="hint"><%= t('dig.intro') %></p>

<section class="stats">
  <% for (const m of digest.metrics) { %>
  <div class="stat">
    <span class="label"><%= t('dig.m.' + m.key) %></span>
    <span class="value"><%= m.current %></span>
    <% if (m.changePct != null) { %>
    <span class="badge <%= m.changePct >= 0 ? 's-active' : 's-error' %>"><%= t('dig.vsLastWeek', { pct: (m.changePct > 0 ? '+' : '') + m.changePct }) %></span>
    <% } else { %>
    <span class="hint"><%= t('dig.noBase') %></span>
    <% } %>
  </div>
  <% } %>
</section>

<section class="card">
  <h2><%= t('dig.moneyTitle') %></h2>
  <% if (!digest.perCampaign.length) { %>
    <p class="hint"><%= t('dig.noSpend') %></p>
  <% } else { %>
  <% const maxSpend = Math.max(...digest.perCampaign.map((c) => c.spend), 0.0001); %>
  <table>
    <thead><tr><th><%= t('opt.thCampaign') %></th><th><%= t('dig.thSpend7') %></th><th><%= t('dig.thConversions') %></th><th>ROAS</th></tr></thead>
    <tbody>
      <% for (const c of digest.perCampaign) { %>
      <tr>
        <td><a href="/campaigns/<%= c.id %>"><%= c.name %></a></td>
        <td class="with-meter">
          <span class="meter-num"><%= c.spend.toFixed(2) %></span>
          <%- include('_meter', { pct: (c.spend / maxSpend) * 100, isMini: true }) %>
        </td>
        <td><%= c.conversions.toFixed(1) %></td>
        <td><%= c.roas != null ? c.roas.toFixed(2) : '—' %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="card">
  <h2><%= t('dig.changesTitle') %></h2>
  <% if (!digest.changes.length) { %>
    <p class="hint"><%= t('dig.noChanges') %></p>
  <% } else { %>
  <ul class="feed">
    <% for (const ch of digest.changes) { %>
    <li>
      <time><%= ch.at %></time> <strong><%= ch.actor %></strong> · <%= ch.action %>
      <% if (ch.campaign_id) { %> · <a href="/campaigns/<%= ch.campaign_id %>"><%= t('dig.campaignRef', { id: ch.campaign_id }) %></a><% } %>
      <% const d = JSON.parse(ch.detail_json || '{}'); %>
      <% if (d.from != null && d.to != null) { %> (<%= d.from %> → <%= d.to %>)<% } %>
      <% if (d.metric) { %> (<%= d.metric %><% if (d.direction) { %>: <%= d.direction %><% } %>)<% } %>
    </li>
    <% } %>
  </ul>
  <% } %>
</section>
<%- include('_foot') %>
