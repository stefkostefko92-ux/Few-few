<%- include('_head') %>
<h1><%= campaign.name %></h1>
<p>
  <span class="badge s-<%= campaign.status %>"><%= campaign.status %></span>
  · <%= campaign.platform === 'google' ? 'Google' : 'Meta' %> · <%= campaign.objective %>
  · <%= campaign.daily_budget.toFixed(2) %> <%= campaign.currency %>/ден
  <% if (campaign.external_id) { %> · външен ID: <code><%= campaign.external_id %></code><% } %>
</p>
<% const policy = campaign.policy_json ? JSON.parse(campaign.policy_json) : null; %>
<% if (policy && policy.status === 'ISSUES') { %>
<p class="error"><%- icon('bell') %> Проблем с доставката/одобрението: <%= policy.issues.join(' · ') %> <span class="hint">(проверено <%= policy.checked_at %>)</span></p>
<% } %>
<% if (campaign.last_error) { %><p class="error">Последна грешка: <%= campaign.last_error %></p><% } %>

<section class="actions">
  <% if (campaign.status === 'draft') { %>
  <form method="post" action="/campaigns/<%= campaign.id %>/publish" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="primary"><%- icon('upload') %> Публикувай (ПАУЗИРАНА)</button>
  </form>
  <% } %>
  <% if (['published','paused'].includes(campaign.status)) { %>
  <form method="post" action="/campaigns/<%= campaign.id %>/status" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="to" value="active">
    <button class="primary"><%- icon('play') %> Активирай (започва да харчи!)</button>
  </form>
  <% } %>
  <% if (campaign.status === 'active') { %>
  <form method="post" action="/campaigns/<%= campaign.id %>/status" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="to" value="paused">
    <button class="warn"><%- icon('pause') %> Паузирай</button>
  </form>
  <% } %>
  <% if (campaign.status !== 'archived') { %>
  <form method="post" action="/campaigns/<%= campaign.id %>/status" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="to" value="archived">
    <button class="ghost danger"><%- icon('archive') %> Архивирай</button>
  </form>
  <% } %>
</section>

<section class="stats">
  <div class="stat"><span class="label">Разход (7д)</span><span class="value"><%= agg.spend.toFixed(2) %></span></div>
  <div class="stat"><span class="label">CPA</span><span class="value"><%= agg.cpa ? agg.cpa.toFixed(2) : '—' %></span></div>
  <div class="stat"><span class="label">ROAS</span><span class="value"><%= agg.roas ? agg.roas.toFixed(2) : '—' %></span></div>
  <div class="stat"><span class="label">CTR</span><span class="value"><%= agg.ctr ? (agg.ctr * 100).toFixed(2) + '%' : '—' %></span></div>
  <div class="stat"><span class="label">Честота</span><span class="value"><%= agg.frequency ? agg.frequency.toFixed(2) : '—' %></span></div>
</section>

<% if (anomalies.length || overdelivery.length || forecast) { %>
<section class="card">
  <h2>Сигнали от интелигентния слой</h2>
  <% for (const a of anomalies) { %>
  <p class="<%= a.direction === 'срив' ? 'alert' : 'hint' %>">
    <%- icon(a.direction === 'скок' ? 'trending-up' : 'trending-down') %>
    Аномалия вчера: <strong><%= a.metric %></strong> — <%= a.direction %> до <%= a.value %>
    при типично <%= a.baseline %> за този ден от седмицата (z=<%= a.z %>).
  </p>
  <% } %>
  <% if (overdelivery.length) { %>
  <p class="hint"><%- icon('bell') %> Свръхдоставка (разход > 2× дневния бюджет):
    <% for (const o of overdelivery) { %><%= o.date %> (<%= o.spend.toFixed(2) %>) <% } %>—
    легално за платформите, но следи седмичната сума.</p>
  <% } %>
  <% if (forecast) { %>
  <p class="hint"><%- icon('chart-column') %> Прогноза за следващите 7 дни:
    <strong><%= forecast.total.toFixed(2) %> <%= campaign.currency %></strong>
    (бюджетът за 7 дни е <%= (campaign.daily_budget * 7).toFixed(2) %>).</p>
  <% } %>
</section>
<% } %>

<section class="card">
  <h2>Последните 14 дни</h2>
  <%- include('_chart', {
    series: [
      { label: 'Разход', values: series.map((d) => ({ date: d.date, value: d.spend })) },
      { label: 'Конверсии', values: series.map((d) => ({ date: d.date, value: d.conversions })), cls: 'alt' },
    ],
  }) %>
</section>

<section class="card">
  <h2>Метрики по дни</h2>
  <table>
    <thead><tr><th>Дата</th><th>Импресии</th><th>Кликове</th><th>Разход</th><th>Конверсии</th><th>Стойност</th><th>Честота</th></tr></thead>
    <tbody>
      <% for (const m of metrics) { %>
      <tr><td><%= m.date %></td><td><%= m.impressions %></td><td><%= m.clicks %></td><td><%= m.spend.toFixed(2) %></td><td><%= m.conversions %></td><td><%= m.conversion_value.toFixed(2) %></td><td><%= m.frequency ?? '—' %></td></tr>
      <% } %>
      <% if (!metrics.length) { %><tr><td colspan="7">Няма метрики още — публикувай, активирай и синхронизирай.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Правила за тази кампания</h2>
  <ul>
    <% for (const r of rules) { %>
    <li><strong><%= r.name %></strong>: <%= r.metric %> <%= r.operator %> <%= r.threshold %> (<%= r.lookback_days %>д, мин. разход <%= r.min_spend %>) → <%= r.action %><%= r.action_value ? ' ' + r.action_value + '%' : '' %> · cooldown <%= r.cooldown_hours %>ч <span class="dot <%= r.enabled ? 'on' : 'off' %>"></span></li>
    <% } %>
    <% if (!rules.length) { %><li>Няма правила — <a href="/rules">добави</a>.</li><% } %>
  </ul>
</section>

<section class="card">
  <h2>Одитна следа</h2>
  <ul class="feed">
    <% for (const a of auditRows) { %>
    <li><time><%= a.at %></time> <strong><%= a.actor %></strong> · <%= a.action %><% if (a.dry_run) { %> <%- icon('flask-conical') %><% } %></li>
    <% } %>
  </ul>
</section>
<%- include('_foot') %>
