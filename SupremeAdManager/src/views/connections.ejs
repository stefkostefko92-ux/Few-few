<%- include('_head') %>
<h1><%= t('conn.title') %></h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<section class="card">
  <table>
    <thead><tr><th><%= t('conn.thPlatform') %></th><th><%= t('conn.thName') %></th><th><%= t('conn.thAccount') %></th><th><%= t('conn.thCurrency') %></th><th><%= t('conn.thStatus') %></th><th></th></tr></thead>
    <tbody>
      <% for (const c of connections) { %>
      <tr>
        <td><%= c.platform === 'google' ? 'Google Ads' : 'Meta' %></td>
        <td><%= c.label %></td>
        <td><code><%= c.external_account_id %></code></td>
        <td><%= c.currency %></td>
        <td><span class="badge s-<%= c.status %>"><%= c.status %></span></td>
        <td>
          <form method="post" action="/connections/<%= c.id %>/revoke" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="ghost danger"><%= t('conn.revoke') %></button>
          </form>
        </td>
      </tr>
      <% } %>
      <% if (!connections.length) { %><tr><td colspan="6"><%= t('conn.empty') %></td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2><%= t('conn.newTitle') %></h2>
  <form method="post" action="/connections" class="grid2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('conn.platform') %>
      <select name="platform" required>
        <option value="google"><%= t('conn.google') %></option>
        <option value="meta"><%= t('conn.meta') %></option>
      </select>
    </label>
    <label><%= t('conn.label') %> <input name="label" required placeholder="<%= t('conn.labelPh') %>"></label>
    <label><%= t('conn.accountId') %> <input name="account_id" required placeholder="1234567890 / act_123…"></label>
    <label><%= t('conn.currency') %> <input name="currency" value="EUR" maxlength="3"></label>
    <label class="span2"><%= t('conn.token') %>
      <input name="token" type="password" placeholder="<%= t('conn.tokenPh') %>">
    </label>
    <button class="primary span2"><%= t('conn.save') %></button>
  </form>
  <p class="hint"><%= t('conn.howTo') %></p>
</section>
<%- include('_foot') %>
