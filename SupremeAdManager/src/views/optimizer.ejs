<%- include('_head') %>
<h1><%- icon('trending-up') %> <%= t('opt.title') %></h1>
<p class="hint"><%= t('opt.intro') %></p>

<% if (pacing) { %>
<section class="card">
  <h2><%= t('opt.pacingTitle') %></h2>
  <div class="stats">
    <div class="stat"><span class="label"><%= t('opt.monthlyBudget') %></span><span class="value"><%= pacing.monthlyBudget.toFixed(2) %></span></div>
    <div class="stat"><span class="label"><%= t('opt.spent') %></span><span class="value"><%= pacing.spent.toFixed(2) %></span></div>
    <div class="stat"><span class="label"><%= t('opt.targetToDate') %></span><span class="value"><%= pacing.targetToDate.toFixed(2) %></span></div>
    <div class="stat"><span class="label"><%= t('opt.dailyTarget') %></span><span class="value"><%= pacing.dailyTargetRemaining.toFixed(2) %></span></div>
  </div>
  <% if (pacing.over) { %>
    <p class="alert"><%- icon('trending-up') %> <%= t('opt.pacingOver', { dev: pacing.deviationPct }) %></p>
  <% } else if (pacing.under) { %>
    <p class="hint"><%- icon('trending-down') %> <%= t('opt.pacingUnder', { dev: Math.abs(pacing.deviationPct), days: pacing.remainingDays }) %></p>
  <% } else { %>
    <p class="hint"><%- icon('check') %> <%= t('opt.pacingOk', { dev: pacing.deviationPct }) %></p>
  <% } %>
</section>
<% } else { %>
<section class="card">
  <h2><%= t('opt.pacingTitle') %></h2>
  <p class="hint"><%= t('opt.pacingOff') %></p>
</section>
<% } %>

<section class="card">
  <h2><%= t('opt.recoTitle') %></h2>
  <% if (!recommendations.rows.length) { %>
    <p class="hint"><%= t(recommendations.reasonKey || 'opt.noData') %>
      <% if (recommendations.skipped.length) { %><br><%= t('opt.skipped') %> <% for (const s of recommendations.skipped) { %><%= s.name %> (<%= t(s.reasonKey) %>) <% } %><% } %>
    </p>
  <% } else { %>
  <p class="hint"><%= t('opt.poolLine', { pool: recommendations.pool.toFixed(2), draws: recommendations.draws, days: recommendations.lookbackDays }) %></p>
  <table>
    <thead><tr><th><%= t('opt.thCampaign') %></th><th><%= t('opt.thWinProb') %></th><th><%= t('opt.thRoas30') %></th><th><%= t('opt.thCurrent') %></th><th><%= t('opt.thReco') %></th><th>Δ</th><th></th></tr></thead>
    <tbody>
      <% for (const r of recommendations.rows) { %>
      <tr>
        <td><a href="/campaigns/<%= r.id %>"><%= r.name %></a></td>
        <td><%= r.winProb %>%</td>
        <td><%= r.roas != null ? r.roas.toFixed(2) : '—' %></td>
        <td><%= r.current.toFixed(2) %> <%= r.currency %></td>
        <td><strong><%= r.recommended.toFixed(2) %></strong> <%= r.currency %></td>
        <td class="<%= r.deltaPct > 0 ? 'up' : r.deltaPct < 0 ? 'down' : '' %>"><%= r.deltaPct > 0 ? '+' : '' %><%= r.deltaPct %>%</td>
        <td>
          <% if (Math.abs(r.recommended - r.current) >= 0.01) { %>
          <form method="post" action="/campaigns/<%= r.id %>/budget" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="new_budget" value="<%= r.recommended %>">
            <button class="ghost" title="<%= t('opt.applyTitle') %>"><%- icon('check') %> <%= t('opt.apply') %></button>
          </form>
          <% } else { %><span class="hint"><%= t('opt.optimal') %></span><% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% if (recommendations.skipped.length) { %>
    <p class="hint"><%= t('opt.outOfModel') %> <% for (const s of recommendations.skipped) { %><%= s.name %> (<%= t(s.reasonKey) %>) <% } %></p>
  <% } %>
  <% } %>
</section>

<section class="card">
  <h2><%= t('opt.forecastTitle') %></h2>
  <% if (!forecasts.length) { %>
    <p class="hint"><%= t('opt.forecastEmpty') %></p>
  <% } else { %>
  <table>
    <thead><tr><th><%= t('opt.thCampaign') %></th><th><%= t('opt.thForecast7') %></th><th><%= t('opt.thBudget7') %></th><th><%= t('opt.thDiff') %></th></tr></thead>
    <tbody>
      <% for (const f of forecasts) { %>
      <% const weekBudget = f.daily_budget * 7; const diff = f.forecast.total - weekBudget; %>
      <tr>
        <td><a href="/campaigns/<%= f.id %>"><%= f.name %></a></td>
        <td><%= f.forecast.total.toFixed(2) %> <%= f.currency %></td>
        <td><%= weekBudget.toFixed(2) %></td>
        <td class="<%= diff > 0 ? 'up' : 'down' %>"><%= diff > 0 ? '+' : '' %><%= diff.toFixed(2) %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <p class="hint"><%= t('opt.forecastNote') %></p>
  <% } %>
</section>
<%- include('_foot') %>
