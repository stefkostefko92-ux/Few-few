<!doctype html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Supreme AdManager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand"><%- icon('megaphone') %> Supreme <span class="brand-sub">AdManager</span></div>
  <% if (typeof hideNav === 'undefined') { %>
  <nav>
    <a href="/"><%- icon('gauge') %> Дашборд</a>
    <a href="/campaigns/new"><%- icon('plus') %> Нова кампания</a>
    <a href="/optimizer"><%- icon('trending-up') %> Оптимизатор</a>
    <a href="/digest"><%- icon('chart-column') %> Дайджест</a>
    <a href="/rules"><%- icon('bell') %> Правила</a>
    <a href="/connections"><%- icon('link-2') %> Връзки</a>
    <a href="/audit"><%- icon('file-clock') %> Одит</a>
  </nav>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="ghost"><%- icon('log-out') %> Изход</button>
  </form>
  <% } %>
</header>
<% if (dryRun && typeof hideNav === 'undefined') { %>
<div class="banner"><%- icon('flask-conical') %> DRY-RUN режим — няма конфигурирани API креденшъли. Всичко се симулира локално; нито стотинка не се харчи.</div>
<% } %>
<main>
