<!doctype html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Supreme AdManager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand"><%- icon('megaphone') %> Supreme <span class="brand-sub">AdManager</span></div>
  <% if (typeof hideNav === 'undefined') { %>
  <% const nav = [
    ['/', 'gauge', 'nav.dashboard'],
    ['/campaigns/new', 'plus', 'nav.newCampaign'],
    ['/optimizer', 'trending-up', 'nav.optimizer'],
    ['/digest', 'chart-column', 'nav.digest'],
    ['/rules', 'bell', 'nav.rules'],
    ['/connections', 'link-2', 'nav.connections'],
    ['/audit', 'file-clock', 'nav.audit'],
  ]; %>
  <nav>
    <% for (const [href, ic, key] of nav) { %>
    <% const active = href === '/' ? path === '/' : path.startsWith(href); %>
    <a href="<%= href %>" class="<%= active ? 'active' : '' %>" <%- active ? 'aria-current="page"' : '' %>><%- icon(ic) %> <%= t(key) %></a>
    <% } %>
  </nav>
  <nav class="langs" aria-label="Language">
    <% for (const l of locales) { %>
    <a href="?lang=<%= l %>" class="<%= l === locale ? 'active' : '' %>" hreflang="<%= l %>"><%= localeNames[l] %></a>
    <% } %>
  </nav>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="ghost"><%- icon('log-out') %> <%= t('nav.logout') %></button>
  </form>
  <% } %>
</header>
<% if (dryRun && typeof hideNav === 'undefined') { %>
<div class="banner"><%- icon('flask-conical') %> <%= t('banner.dryRun') %></div>
<% } %>
<main>
