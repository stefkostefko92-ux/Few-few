<%- include('_head') %>
<h1><%= t('rules.title') %></h1>
<p class="hint"><%= t('rules.intro') %></p>

<section class="card">
  <table>
    <thead><tr><th><%= t('rules.thRule') %></th><th><%= t('rules.thScope') %></th><th><%= t('rules.thCondition') %></th><th><%= t('rules.thAction') %></th><th>Cooldown</th><th><%= t('rules.thLast') %></th><th></th></tr></thead>
    <tbody>
      <% for (const r of rules) { %>
      <tr>
        <td><span class="dot <%= r.enabled ? 'on' : 'off' %>"></span> <%= r.name %></td>
        <td><%= r.campaign_name || t('common.allCampaigns') %></td>
        <td><code><%= r.metric %> <%= r.operator %> <%= r.threshold %></code> (<%= r.lookback_days %><%= t('common.days') %>, <%= t('rules.min') %> <%= r.min_spend %>)</td>
        <td><%= r.action %><%= r.action_value ? ' ' + r.action_value + '%' : '' %></td>
        <td><%= r.cooldown_hours %><%= t('common.hours') %></td>
        <td><%= r.last_fired_at || '—' %></td>
        <td>
          <form method="post" action="/rules/<%= r.id %>/toggle" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost"><%= r.enabled ? t('rules.stop') : t('rules.start') %></button></form>
          <form method="post" action="/rules/<%= r.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost danger"><%= t('rules.delete') %></button></form>
        </td>
      </tr>
      <% } %>
      <% if (!rules.length) { %><tr><td colspan="7"><%= t('rules.empty') %></td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2><%= t('rules.newTitle') %></h2>
  <form method="post" action="/rules" class="grid2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= t('rules.name') %> <input name="name" required placeholder="<%= t('rules.namePh') %>"></label>
    <label><%= t('rules.campaign') %>
      <select name="campaign_id">
        <option value=""><%= t('rules.allCampaigns') %></option>
        <% for (const c of campaigns) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
      </select>
    </label>
    <label><%= t('rules.metric') %>
      <select name="metric">
        <option value="cpa"><%= t('rules.mCpa') %></option>
        <option value="roas"><%= t('rules.mRoas') %></option>
        <option value="ctr">CTR</option>
        <option value="ctr_drop_pct"><%= t('rules.mCtrDrop') %></option>
        <option value="frequency"><%= t('rules.mFrequency') %></option>
        <option value="spend_today"><%= t('rules.mSpendToday') %></option>
        <option value="conversions"><%= t('rules.mConversions') %></option>
      </select>
    </label>
    <label><%= t('rules.condition') %>
      <select name="operator"><option>&gt;</option><option>&lt;</option><option>&gt;=</option><option>&lt;=</option></select>
    </label>
    <label><%= t('rules.threshold') %> <input name="threshold" type="number" step="0.01" required></label>
    <label><%= t('rules.lookback') %> <input name="lookback_days" type="number" value="7" min="1" max="30"></label>
    <label><%= t('rules.minSpend') %> <input name="min_spend" type="number" step="0.01" value="100"></label>
    <label><%= t('rules.action') %>
      <select name="action">
        <option value="pause"><%= t('rules.aPause') %></option>
        <option value="scale_budget"><%= t('rules.aScale') %></option>
        <option value="shrink_budget"><%= t('rules.aShrink') %></option>
        <option value="notify"><%= t('rules.aNotify') %></option>
        <%# 'activate' умишлено ЛИПСВА — кампания активира само човек (желязно правило) %>
      </select>
    </label>
    <label><%= t('rules.actionValue') %> <input name="action_value" type="number" step="1" max="20" placeholder="<%= t('rules.upTo20') %>"></label>
    <label><%= t('rules.cooldown') %> <input name="cooldown_hours" type="number" value="24" min="1"></label>
    <button class="primary span2"><%= t('rules.submit') %></button>
  </form>
</section>

<section class="card">
  <h2><%= t('rules.recoTitle') %></h2>
  <ul>
    <li><%= t('rules.reco1') %></li>
    <li><%= t('rules.reco2') %></li>
    <li><%= t('rules.reco3') %></li>
    <li><%= t('rules.reco4') %></li>
  </ul>
</section>
<%- include('_foot') %>
