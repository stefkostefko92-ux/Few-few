<%- include('_head') %>
<h1>Правила за автоматизация</h1>
<p class="hint">Правило = метрика + условие + действие. Пали се само при достатъчно данни (мин. разход), има cooldown, а бюджетните промени са ограничени до ±20% на стъпка и минават през предпазителите.</p>

<section class="card">
  <table>
    <thead><tr><th>Правило</th><th>Обхват</th><th>Условие</th><th>Действие</th><th>Cooldown</th><th>Последно</th><th></th></tr></thead>
    <tbody>
      <% for (const r of rules) { %>
      <tr>
        <td><span class="dot <%= r.enabled ? 'on' : 'off' %>"></span> <%= r.name %></td>
        <td><%= r.campaign_name || 'всички кампании' %></td>
        <td><code><%= r.metric %> <%= r.operator %> <%= r.threshold %></code> (<%= r.lookback_days %>д, мин. <%= r.min_spend %>)</td>
        <td><%= r.action %><%= r.action_value ? ' ' + r.action_value + '%' : '' %></td>
        <td><%= r.cooldown_hours %>ч</td>
        <td><%= r.last_fired_at || '—' %></td>
        <td>
          <form method="post" action="/rules/<%= r.id %>/toggle" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost"><%= r.enabled ? 'Спри' : 'Пусни' %></button></form>
          <form method="post" action="/rules/<%= r.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ghost danger">Изтрий</button></form>
        </td>
      </tr>
      <% } %>
      <% if (!rules.length) { %><tr><td colspan="7">Няма правила още.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Ново правило</h2>
  <form method="post" action="/rules" class="grid2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Име <input name="name" required placeholder="напр. Пауза при изгорял CPA"></label>
    <label>Кампания
      <select name="campaign_id">
        <option value="">Всички кампании</option>
        <% for (const c of campaigns) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
      </select>
    </label>
    <label>Метрика
      <select name="metric">
        <option value="cpa">CPA (цена на конверсия)</option>
        <option value="roas">ROAS (възвръщаемост)</option>
        <option value="ctr">CTR</option>
        <option value="ctr_drop_pct">CTR спад % спрямо предишния прозорец (fatigue)</option>
        <option value="frequency">Честота (fatigue)</option>
        <option value="spend_today">Разход днес</option>
        <option value="conversions">Конверсии</option>
      </select>
    </label>
    <label>Условие
      <select name="operator"><option>&gt;</option><option>&lt;</option><option>&gt;=</option><option>&lt;=</option></select>
    </label>
    <label>Праг <input name="threshold" type="number" step="0.01" required></label>
    <label>Прозорец (дни) <input name="lookback_days" type="number" value="7" min="1" max="30"></label>
    <label>Мин. разход преди действие <input name="min_spend" type="number" step="0.01" value="100"></label>
    <label>Действие
      <select name="action">
        <option value="pause">Паузирай</option>
        <option value="scale_budget">Увеличи бюджета (%)</option>
        <option value="shrink_budget">Намали бюджета (%)</option>
        <option value="notify">Само отбележи (одит)</option>
        <%# 'activate' умишлено ЛИПСВА — кампания активира само човек (желязно правило) %>
      </select>
    </label>
    <label>Стойност на действието (%) <input name="action_value" type="number" step="1" max="20" placeholder="до 20"></label>
    <label>Cooldown (часове) <input name="cooldown_hours" type="number" value="24" min="1"></label>
    <button class="primary span2">Създай правило</button>
  </form>
</section>

<section class="card">
  <h2>Препоръчани прагове (от проучването, 2026)</h2>
  <ul>
    <li><strong>Пауза при изгорял CPA</strong>: CPA &gt; 2× целевия, 7 дни, мин. разход 100 — не действай без 20+ конверсии/статистическа маса.</li>
    <li><strong>Скалиране на печеливша</strong>: ROAS &gt; целевия 3+ последователни дни → +20% бюджет (повече рестартира learning phase).</li>
    <li><strong>Умора на креатива</strong>: честота &gt; 3.5 или CTR −20% спрямо 7-дневната средна → ротирай креатива.</li>
    <li><strong>Дневен спирачен праг</strong>: разход днес &gt; 1.5× дневния бюджет → пауза (платформите могат да превишат дневния бюджет до 2×).</li>
  </ul>
</section>
<%- include('_foot') %>
