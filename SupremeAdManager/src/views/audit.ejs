<%- include('_head') %>
<h1><%= t('audit.title') %></h1>
<p class="hint"><%= t('audit.intro') %></p>
<section class="card">
  <table>
    <thead><tr><th><%= t('audit.thWhen') %></th><th><%= t('audit.thWho') %></th><th><%= t('audit.thAction') %></th><th><%= t('audit.thCampaign') %></th><th><%= t('audit.thDetails') %></th></tr></thead>
    <tbody>
      <% for (const r of rows) { %>
      <tr>
        <td><time><%= r.at %></time></td>
        <td><%= r.actor %></td>
        <td><%= r.action %><% if (r.dry_run) { %> <%- icon('flask-conical') %><% } %></td>
        <td><%= r.campaign_id || '—' %></td>
        <td><code class="small"><%= r.detail_json %></code></td>
      </tr>
      <% } %>
      <% if (!rows.length) { %><tr><td colspan="5"><%= t('audit.empty') %></td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('_foot') %>
