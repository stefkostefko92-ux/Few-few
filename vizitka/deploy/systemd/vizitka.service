[Unit]
Description=Vizitka — винаги актуалната дигитална визитка
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vizitka
Group=vizitka
WorkingDirectory=/opt/vizitka
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

# Конфигурация (с права 600, собственост vizitka:vizitka).
EnvironmentFile=/etc/vizitka/vizitka.env

# --- Sandboxing / hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Единствено data/ е записваем (SQLite + WAL + качените снимки).
ReadWritePaths=/opt/vizitka/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
