<!doctype html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · Vizitka` : 'Vizitka — винаги актуалната ти визитка' %></title>
  <% const meta = typeof pageMeta !== 'undefined' && pageMeta ? pageMeta : null; %>
  <meta name="description" content="<%= meta?.description || 'Създай професионален профил (личен или фирмен), получи QR код и споделяй визитка, която винаги е актуална.' %>">
  <% if (meta) { %>
  <meta property="og:type" content="profile">
  <meta property="og:title" content="<%= title %> · Vizitka">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.url %>">
  <% if (meta.image) { %><meta property="og:image" content="<%= meta.image %>"><% } %>
  <% } %>
  <% if (/^\/(dashboard|login|register)/.test(currentPath)) { %><meta name="robots" content="noindex"><% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="nav">
  <a class="brand" href="/">Vizitka<span class="brand-dot">.</span></a>
  <nav>
    <% if (user) { %>
      <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Моята визитка</a>
      <form method="post" action="/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="link-btn">Изход</button>
      </form>
    <% } else { %>
      <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>">Вход</a>
      <a href="/register" class="btn btn-small">Създай визитка</a>
    <% } %>
  </nav>
</header>
<main>
