# Vizitka — примерна конфигурация (копирай като .env или systemd EnvironmentFile, mode 600)

# Порт на приложението
PORT=3100

# production включва secure cookies, HSTS redirect и кеширане на статиката
NODE_ENV=production

# Публичен HTTPS адрес — влиза в QR кода и vCard файла
PUBLIC_BASE_URL=https://vizitka-bg.com

# Директория за SQLite базата и качените снимки (по подразбиране ./data)
# DATA_DIR=/var/lib/vizitka

# SMTP за писма (нулиране на паролата). Без SMTP_HOST писмата само се логват (dev).
# MAIL_FROM=Vizitka <no-reply@vizitka-bg.com>
# SMTP_HOST=smtp.example.eu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Админ достъп до /admin (рекламни банери) — запетая-разделени имейли. Тези акаунти
# се маркират като админ при старт; други не могат да се самопровъзгласят.
# ADMIN_EMAILS=stefan.kostadinov16@gmail.com

# IndexNow — автоматично уведомяване на Bing (и др.) при публикуване/промяна на
# визитка. 32-знаков hex ключ; сервира се на /<ключ>.txt за доказване на собствеността.
# Генерирай: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Без ключ функцията е изключена (Google така или иначе чете sitemap-а).
# INDEXNOW_KEY=

# Мастилко — безплатното ателие в браузъра, където потребителят сам оформя и си
# разпечатва визитката. Визитката препраща данните натам за автоматично попълване.
MASTILKO_URL=https://mastilko-bg.com
# Споделена тайна, която подписва handoff токена (задължителна в продукция).
# Генерирай: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PRINT_API_SECRET=

# ── Портфейли: Apple Wallet + Google Wallet ──────────────────────────────────
# Всяко от двете се активира само когато нужните тайни са зададени (иначе бутоните
# са скрити). Тайните са ФАЙЛОВЕ с права 600, извън репото. Виж deploy/DEPLOY.md.

# Apple Wallet (.pkpass) — изисква Apple Developer акаунт + Pass Type ID сертификат.
# APPLE_TEAM_ID=ABCDE12345
# APPLE_PASS_TYPE_ID=pass.eu.carbonstealth.vizitka
# APPLE_PASS_CERT=/etc/vizitka/apple/signerCert.pem
# APPLE_PASS_KEY=/etc/vizitka/apple/signerKey.pem
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_CERT=/etc/vizitka/apple/wwdr.pem
# Auto-update (пуш при промяна на визитката) — APNs .p8 ключ (по желание):
# APPLE_APNS_KEY=/etc/vizitka/apple/AuthKey.p8
# APPLE_APNS_KEY_ID=XXXXXXXXXX

# Google Wallet — изисква Google Cloud проект + Wallet API + service account.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SA_KEY=/etc/vizitka/google/service-account.json
# GOOGLE_WALLET_CLASS_ID=  # по подразбиране <issuerId>.vizitka_generic
