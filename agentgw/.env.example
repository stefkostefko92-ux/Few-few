# Агентски шлюз — пример за средата. Истинският файл е /etc/agentgw/agentgw.env (mode 600,
# собственик agentgw), никога в репото. Всички стойности се попълват на сървъра.

NODE_ENV=production
HOST=127.0.0.1
PORT=3070
TRUST_PROXY=1

# PostgreSQL (собствена ЕС база)
DATABASE_URL=

# Поне 32 случайни знака: openssl rand -hex 32. Смяната му обезсилва ВСИЧКИ ключове.
KEY_PEPPER=

# Google Vertex AI — САМО ЕС. „eu“ = мулти-регионалната ЕС крайна точка (нужна за Opus 5 / Sonnet 5).
VERTEX_PROJECT_ID=
VERTEX_REGION=eu
# Път до JSON на service account (mode 600, собственик agentgw). Празно → ADC на машината.
GOOGLE_APPLICATION_CREDENTIALS=

# Модели (голи Vertex ID-та, без префикс)
MODEL_OPUS=claude-opus-5
MODEL_SONNET=claude-sonnet-5
# Усилие за разговор: low | medium | high (постоянно — смяната инвалидира prompt кеша)
CHAT_EFFORT=low
MAX_OUTPUT_TOKENS=4096

# Тавани на входа
MAX_MESSAGES=20
MAX_MESSAGE_CHARS=4000
MAX_TOTAL_CHARS=24000
AUTH_FAIL_PER_MIN=30

# Разход: +10% за регионална/мулти-регионална крайна точка на Vertex
PRICE_MULTIPLIER=1.1
# Под 120 s таймаута на Nginx
UPSTREAM_TIMEOUT_MS=90000
