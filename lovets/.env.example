# Пример — истинските стойности са само на сървъра (mode 600). Генериране:
#   openssl rand -hex 24      → POSTGRES_PASSWORD
#   openssl rand -hex 32      → LOVETS_PEPPER, JWT_SECRET
#   openssl rand -base64 32   → TOTP_KEY, LOVETS_UNSUB_KEY
# Смяна на LOVETS_PEPPER обезсилва всички отпечатъци (регистри, „не ме търсете“, съгласия) — не го сменяй.
POSTGRES_PASSWORD=
LOVETS_PEPPER=
JWT_SECRET=
TOTP_KEY=
APP_ORIGIN=https://lovets.carbonstealth.eu
HTTP_PORT=4360
# Черновата на първия имейл (фаза 4а). Без двете долни стойности черновите са изключени (fail-closed).
# LOVETS_UNSUB_KEY шифрова връзките за отписване — смяната му обезсилва връзките в вече пратени писма.
LOVETS_UNSUB_KEY=
# Публичното пълно известие за проучването на клиенти (чл. 14 ОРЗД) — https, без параметри.
LOVETS_NOTICE_URL=
# LOVETS_PUBLIC_URL=https://lovets.carbonstealth.eu   # по подразбиране APP_ORIGIN
# LOVETS_RETENTION_MONTHS=6                           # 1–12; SPEC инв. 10
