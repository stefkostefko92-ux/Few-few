    "banner.budget.limit": {
      "comment": "Лимитът на iOS — допълва двата броя по-горе.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS пази най-много %lld известия наведнъж."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS keeps at most %lld notifications at once."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS conserva al massimo %lld notifiche alla volta."
          }
        }
      }
    },
    "banner.budget.reduced": {
      "comment": "Броят напомняния, сведени до едно известие.",
      "localizations": {
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld напомняне е насрочено само за най-близкия си час."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld напомняния са насрочени само за най-близкия си час."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reminder is scheduled only for its next time."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reminders are scheduled only for their next time."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld promemoria è programmato solo per il suo prossimo orario."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld promemoria sono programmati solo per il loro prossimo orario."
                }
              }
            }
          }
        }
      }
    },
    "banner.budget.skipped": {
      "localizations": {
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld чака ред и ще се насрочи при следващото отваряне на приложението."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld чакат ред и ще се насрочат при следващото отваряне на приложението."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld is waiting its turn and will be scheduled next time you open the app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld are waiting their turn and will be scheduled next time you open the app."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld è in attesa del suo turno e verrà programmato alla prossima apertura dell’app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sono in attesa del loro turno e verranno programmati alla prossima apertura dell’app."
                }
              }
            }
          }
        }
      }
    },
    "banner.permission.body": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записките се пазят, но телефонът няма да те подсети. Включи ги от Настройки → Каракочев → Известия."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reminders are saved, but the phone will not alert you. Turn them on in Settings → Karakochev → Notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria vengono salvati, ma il telefono non ti avviserà. Attiva le notifiche da Impostazioni → Karakochev → Notifiche."
          }
        }
      }
    },
    "banner.permission.title": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са изключени"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate"
          }
        }
      }
    },
    "banner.saveError": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяната не се запази. Опитай отново."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was not saved. Try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non è stata salvata. Riprova."
          }
        }
      }
    },
    "banner.saveError.dismiss": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбрах"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho capito"
          }
        }
      }
    },
    "banner.temporaryStore.body": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записките на телефона не се четат в момента. Досегашните известия остават насрочени и нищо не е изтрито, но новото тук няма да се запази. Затвори и пусни приложението пак."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved reminders cannot be read right now. Existing notifications stay scheduled and nothing was deleted, but anything you add here will not be kept. Quit and open the app again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria salvati sul telefono al momento non sono leggibili. Le notifiche già programmate restano attive e non è stato eliminato nulla, ma quello che aggiungi qui non verrà conservato. Chiudi e riapri l’app."
          }
        }
      }
    },
    "banner.temporaryStore.title": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи с временна база"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running on a temporary store"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio temporaneo in uso"
          }
        }
      }
    },
    "date.later": {
