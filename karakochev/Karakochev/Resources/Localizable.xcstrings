    "editor.title.placeholder": {
      "comment": "Примерна записка в празното поле.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: платѝ тока"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: pay the electricity bill"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per esempio: paga la bolletta della luce"
          }
        }
      }
