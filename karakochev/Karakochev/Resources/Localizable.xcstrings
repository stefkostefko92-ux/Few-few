    "editor.when": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ден и час"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day and time"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorno e ora"
          }
        }
      }
    },
    "export.confirm.message": {
      "comment": "Текст на предупреждението преди износ — казва какво излиза от телефона.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изнесеният файл съдържа всичките ти записки като обикновен текст — всеки, който го отвори, ги чете. Запишеш ли го в iCloud Drive или споделена папка, данните излизат от телефона."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported file contains all your reminders as plain text — anyone who opens it can read them. If you save it to iCloud Drive or a shared folder, the data leaves your phone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file esportato contiene tutti i tuoi promemoria in chiaro: chiunque lo apra può leggerli. Se lo salvi in iCloud Drive o in una cartella condivisa, i dati escono dal telefono."
          }
        }
      }
    },
    "export.confirm.title": {
      "comment": "Заглавие на предупреждението преди износ.",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлът не е шифрован"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is not encrypted"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non è crittografato"
          }
        }
      }
    },
    "export.failed": {
      "comment": "Записът на архива се провали (не е свързано с внасяне).",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
