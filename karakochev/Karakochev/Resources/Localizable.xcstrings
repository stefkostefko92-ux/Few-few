    },
    "banner.budget.reduced" : {
      "comment" : "%1$lld напомняния, %2$lld е лимитът на iOS (64).",
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld напомняния са насрочени само за най-близкия си час — iOS пази най-много %2$lld известия наведнъж." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld reminders are scheduled only for their next time — iOS keeps at most %2$lld notifications at once." } }
      }
    },
    "banner.budget.skipped" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "%lld чакат ред и ще се насрочат при следващото отваряне на приложението." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld are waiting their turn and will be scheduled next time you open the app." } }
      }
    },
    "banner.permission.body" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Записките се пазят, но телефонът няма да те подсети. Включи ги от Настройки → Каракочев → Известия." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your reminders are saved, but the phone will not alert you. Turn them on in Settings → Karakochev → Notifications." } }
      }
    },
    "banner.permission.title" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Известията са изключени" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off" } }
      }
    },
    "banner.saveError" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Промяната не се запази. Опитай отново." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The change was not saved. Try again." } }
      }
    },
    "banner.saveError.dismiss" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Разбрах" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Got it" } }
      }
    },
    "banner.temporaryStore.body" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Записките на телефона не се четат в момента. Досегашните известия остават насрочени и нищо не е изтрито, но новото тук няма да се запази. Затвори и пусни приложението пак." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your saved reminders cannot be read right now. Existing notifications stay scheduled and nothing was deleted, but anything you add here will not be kept. Quit and open the app again." } }
      }
    },
    "banner.temporaryStore.title" : {
      "localizations" : {
        "bg" : { "stringUnit" : { "state" : "translated", "value" : "Работи с временна база" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Running on a temporary store" } }
      }
    },
    "date.later" : {
