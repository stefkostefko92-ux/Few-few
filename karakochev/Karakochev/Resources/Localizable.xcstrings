    "editor.important.footer": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Важните известия се доставят и при включен „Фокус“, ако си разрешил това на приложението."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important reminders are delivered even during Focus, if you allowed the app to do that."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche importanti vengono recapitate anche con «Full Immersion» attivo, se hai dato il permesso all’app."
          }
        }
      }
    },
