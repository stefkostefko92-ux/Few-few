    "list.empty.body": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши какво да не забравиш и избери кога да те подсетя."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down what you must not forget and pick when to be reminded."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa non devi dimenticare e scegli quando ricordartelo."
          }
        }
      }
    },
    "list.empty.title": {
