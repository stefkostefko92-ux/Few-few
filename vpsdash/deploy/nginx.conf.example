# Nginx reverse proxy за VPS Dashboard — TLS + SSE + (по избор) втори слой Basic-auth.
# Панелът слуша само на 127.0.0.1:7700. Този vhost го публикува на домейн с HTTPS.
#
# 1) Смени server_name с твоя домейн (напр. vps1.carbonstealth.eu) — на ДВЕТЕ
#    места (блока на 80 и блока на 443). Забравеният втори е най-честата причина
#    certbot да каже „Could not find a virtual host".
# 2) Пусни: certbot --nginx -d vps1.carbonstealth.eu
#    Преди боен опит: същата команда с --dry-run (staging, НЕ гори лимита от
#    5 провалени валидации на час — след него не издава дори при верен DNS).
# 3) (препоръчително) Basic-auth пред панела:
#      apt-get install -y apache2-utils
#      htpasswd -c /etc/nginx/vps-dashboard.htpasswd admin
#    и разкоментирай двата auth_basic реда долу.
#
# ВАЖНО: в config.json сложи "trustProxy": true — така кукито става Secure и
# rate-limit-ът на входа брои реалния клиентски IP (X-Forwarded-For), не 127.0.0.1.

server {
    listen 80;
    server_name vps1.carbonstealth.eu;

    # ACME проверката се сервира ИЗРИЧНО и ПРЕДИ всичко останало. `^~` бие всеки
    # префиксен location, значи нито редиректът долу, нито `proxy_pass` към мъртъв
    # панел (502/503) могат да я изядат. Без този блок валидацията зависи от това
    # кой location случайно е хванал заявката — а Let's Encrypt вижда само че е
    # получил нещо, което не е challenge файлът, и отказва.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;          # ако има allow/deny по-горе — тук не важи
        auth_basic off;     # Basic-auth пред ACME пътя = провалена валидация
    }

    location / { return 301 https://$host$request_uri; }
}

# Нужно за WebSocket (десктопът). Стои в `http` контекста, не в `server` —
# сложи го в /etc/nginx/conf.d/upgrade.conf, ако този файл е include-нат вътре в
# server блок.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name vps1.carbonstealth.eu;

    # certbot попълва ssl_certificate / ssl_certificate_key при --nginx.

    # Втори слой защита (по избор) — разкоментирай след htpasswd:
    # auth_basic "Carbon Stealth VPS";
    # auth_basic_user_file /etc/nginx/vps-dashboard.htpasswd;

    # Подновяването минава пак през порт 80, но ако някога мине през 443 —
    # същият изричен блок, за да не го хване auth_basic отгоре.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        auth_basic off;
    }

    # Хедъри за сигурност. X-Frame-Options / X-Content-Type-Options /
    # Referrer-Policy / CSP панелът си ги слага сам (server.js) — тук е само
    # HSTS, който изисква TLS и затова е работа на прокси слоя.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # БЕЗ този ред качването на архив от браузъра НЕ РАБОТИ: подразбирането на
    # Nginx е 1 MB, а панелът рекламира 3 GB и праща файла с един POST. Отговорът
    # е 413 от Nginx, преди заявката изобщо да стигне до панела.
    client_max_body_size 3g;
    client_body_timeout 300s;
    send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:7700;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket. Панелът сам по себе си НЕ ползва WS (потоците му са SSE) —
        # това е за незадължителния десктоп, чийто VNC е WebSocket от първата до
        # последната заявка. Без тези два реда рамката се зарежда и остава черна.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # SSE (метрики/логове/задачи на живо): без буфериране, без таймаут.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        # Симетрично на read: качването на 3 GB архив трае повече от 60 секунди.
        proxy_send_timeout 24h;
        chunked_transfer_encoding on;
        # Стрийм направо към панела. Без това Nginx първо записва целите 3 GB на
        # диска (удвоено място), лентата за напредък в браузъра скача на 100% и
        # увисва, докато Nginx препраща наум.
        proxy_request_buffering off;
    }
}
