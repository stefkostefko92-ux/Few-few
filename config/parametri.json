{
  "schema_version": "2.0",
  "impianto": {
    "descrizione": "Ascensore geared (argano 2V/VVVF) oppure idraulico, 4-6 pers, 4-6 fermate",
    "controller": "PLC S7-1200 / Codesys come Modbus RTU SLAVE - gearless ESCLUSO",
    "modbus": { "ruolo_plc": "slave", "baud": 19200, "parity": "E", "data_bits": 8, "stop_bits": 1, "slave_id": 1 },
    "mappa_registri": "Holding Register 0-based. Param scrivibili 0..27 (NS 0..15, SR 20..27); sola lettura 40..57. Vedi docs/07-parametri-plc-modbus.md e plc/src/FB_ParametriModbus.st"
  },
  "categorie": {
    "NS": { "label": "Non-safety", "wifi_write": true, "require_key": false, "role": "operator" },
    "SR": { "label": "Safety-relevant", "wifi_write": true, "require_key": true, "role": "admin" },
    "SC": { "label": "Safety-critical", "wifi_write": false, "require_key": true, "role": "admin" },
    "RO": { "label": "Read-only telemetry", "wifi_write": false, "require_key": false, "role": "operator" }
  },
  "parametri": [
    { "id": "acc_rate",        "label": "Accelerazione",            "reg": 0,  "scale": 100, "min": 0.3,  "max": 1.2,  "def": 0.7,  "unit": "m/s2",  "cat": "NS" },
    { "id": "dec_rate",        "label": "Decelerazione",            "reg": 1,  "scale": 100, "min": 0.3,  "max": 1.2,  "def": 0.7,  "unit": "m/s2",  "cat": "NS" },
    { "id": "jerk",            "label": "Jerk (comfort)",           "reg": 2,  "scale": 100, "min": 0.5,  "max": 2.5,  "def": 1.3,  "unit": "m/s3",  "cat": "NS" },
    { "id": "creep_speed",     "label": "Velocita livellamento",    "reg": 3,  "scale": 1000,"min": 0.02, "max": 0.10, "def": 0.05, "unit": "m/s",   "cat": "NS" },
    { "id": "door_open_time",  "label": "Tempo porte aperte",       "reg": 4,  "scale": 1,   "min": 2,    "max": 20,   "def": 5,    "unit": "s",     "cat": "NS" },
    { "id": "door_hold_dwell", "label": "Attesa richiusura",        "reg": 5,  "scale": 1,   "min": 1,    "max": 10,   "def": 3,    "unit": "s",     "cat": "NS" },
    { "id": "door_nudging",    "label": "Richiusura forzata",       "reg": 6,  "scale": 1,   "min": 0,    "max": 1,    "def": 1,    "unit": "bool",  "cat": "NS" },
    { "id": "fan_light_off",   "label": "Spegnimento luce/ventola", "reg": 7,  "scale": 1,   "min": 30,   "max": 600,  "def": 120,  "unit": "s",     "cat": "NS" },
    { "id": "parking_floor",   "label": "Piano di parcheggio",      "reg": 8,  "scale": 1,   "min": 0,    "max": 5,    "def": 0,    "unit": "piano", "cat": "NS" },
    { "id": "parking_delay",   "label": "Ritardo ritorno parcheggio","reg": 9, "scale": 1,   "min": 10,   "max": 600,  "def": 60,   "unit": "s",     "cat": "NS" },
    { "id": "call_priority",   "label": "Logica chiamate",          "reg": 10, "scale": 1,   "min": 0,    "max": 2,    "def": 1,    "unit": "enum",  "cat": "NS" },
    { "id": "arrival_gong",    "label": "Gong di arrivo",           "reg": 11, "scale": 1,   "min": 0,    "max": 1,    "def": 1,    "unit": "bool",  "cat": "NS" },
    { "id": "vip_floor",       "label": "Piano prioritario VIP",    "reg": 12, "scale": 1,   "min": 0,    "max": 5,    "def": 0,    "unit": "piano", "cat": "NS" },
    { "id": "star_delta_time", "label": "Tempo avviamento Y/D (idraulico)","reg": 13,"scale": 100,"min": 0.5,  "max": 3.0,  "def": 1.5,  "unit": "s",     "cat": "NS" },
    { "id": "descent_valve_delay","label": "Ritardo valvola discesa (idr.)","reg": 14,"scale": 100,"min": 0.0,"max": 2.0,"def": 0.5,"unit": "s","cat": "NS" },
    { "id": "high_speed_ratio","label": "Rapporto alta velocita (geared 2V)","reg": 15,"scale": 100,"min": 0.5,"max": 1.0,"def": 1.0,"unit": "p.u.","cat": "NS" },

    { "id": "releveling_enable","label": "Rilivellamento porte aperte","reg": 20,"scale": 1,  "min": 0,    "max": 1,    "def": 1,    "unit": "bool",  "cat": "SR" },
    { "id": "door_zone_window","label": "Finestra zona porta",      "reg": 21, "scale": 1,   "min": 10,   "max": 80,   "def": 35,   "unit": "mm",    "cat": "SR" },
    { "id": "inspection_speed","label": "Velocita ispezione",       "reg": 22, "scale": 100, "min": 0.10, "max": 0.63, "def": 0.30, "unit": "m/s",   "cat": "SR" },
    { "id": "relevel_speed",   "label": "Velocita rilivellamento",  "reg": 23, "scale": 1000,"min": 0.02, "max": 0.30, "def": 0.05, "unit": "m/s",   "cat": "SR" },
    { "id": "aro_speed",       "label": "Velocita riporto ARO",     "reg": 24, "scale": 100, "min": 0.05, "max": 0.30, "def": 0.10, "unit": "m/s",   "cat": "SR" },
    { "id": "motor_overcurrent","label": "Soglia sovracorrente",    "reg": 25, "scale": 1,   "min": 100,  "max": 200,  "def": 150,  "unit": "%In",   "cat": "SR" },
    { "id": "brake_release_delay","label": "Ritardo serraggio freno (geared)","reg": 26,"scale": 1000,"min": 0.20,"max": 0.80,"def": 0.40,"unit": "s","cat": "SR" },
    { "id": "oil_temp_max",    "label": "Soglia max temp olio (idraulico)","reg": 27,"scale": 1, "min": 50,   "max": 80,   "def": 70,   "unit": "degC",  "cat": "SR" },

    { "id": "rated_speed",     "label": "Velocita nominale",        "reg": 40, "scale": 100, "unit": "m/s",   "cat": "SC" },
    { "id": "overspeed_trip",  "label": "Soglia limitatore",        "reg": 41, "scale": 100, "unit": "m/s",   "cat": "SC" },
    { "id": "ucm_enable",      "label": "Funzione UCM (A3)",        "reg": 42, "scale": 1,   "unit": "bool",  "cat": "SC" },
    { "id": "safety_chain_state","label": "Stato catena sicurezza", "reg": 43, "scale": 1,   "unit": "bitmask","cat": "SC" },
    { "id": "brake_feedback",  "label": "Feedback freno",           "reg": 44, "scale": 1,   "unit": "bitmask","cat": "SC" },

    { "id": "car_position",    "label": "Posizione cabina",         "reg": 50, "scale": 1,   "unit": "mm",    "cat": "RO" },
    { "id": "car_speed",       "label": "Velocita istantanea",      "reg": 51, "scale": 100, "unit": "m/s",   "cat": "RO" },
    { "id": "motor_current",   "label": "Corrente motore",          "reg": 52, "scale": 10,  "unit": "A",     "cat": "RO" },
    { "id": "dcbus_voltage",   "label": "Tensione bus DC",          "reg": 53, "scale": 1,   "unit": "V",     "cat": "RO" },
    { "id": "trip_counter",    "label": "Contatore corse",          "reg": 54, "scale": 1,   "unit": "n",     "cat": "RO" },
    { "id": "fault_code",      "label": "Codice guasto attivo",     "reg": 55, "scale": 1,   "unit": "enum",  "cat": "RO" },
    { "id": "oil_temperature", "label": "Temperatura olio (idraulico)","reg": 56,"scale": 1, "unit": "degC",  "cat": "RO" },
    { "id": "line_pressure",   "label": "Pressione impianto (idraulico)","reg": 57,"scale": 10,"unit": "bar",  "cat": "RO" }
  ]
}
