{
  "id": "probe-seo",
  "agent": "seo",
  "kind": "probe",
  "task": "Защо тази страница не се показва в търсачките и AI отговорите? Входът е в tools/agents/evals/fixtures/probe-seo.md (измислен вход за проверка).",
  "expect": [
    {
      "any": [
        "noindex"
      ],
      "label": "noindex на страница, която трябва да се класира"
    },
    {
      "any": [
        "canonical",
        "каноничн"
      ],
      "label": "canonical сочи друг URL"
    },
    {
      "any": [
        "hreflang",
        "x-default"
      ],
      "label": "hreflang без самореференция / x-default"
    },
    {
      "any": [
        "mainEntity",
        "HowTo",
        "празна схема",
        "празен FAQPage"
      ],
      "label": "празен/грешен JSON-LD"
    },
    {
      "any": [
        "отговор отпред",
        "answer-first",
        "заровен",
        "не отпред",
        "в началото",
        "първия параграф"
      ],
      "label": "отговорът е заровен"
    },
    {
      "none": [
        "гарантирам първо място",
        "гарантирано класиране"
      ],
      "label": "капан: обещано класиране"
    }
  ]
}
