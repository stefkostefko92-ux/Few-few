// „За Дупница" — схема на данните. База: PostgreSQL. ORM: Prisma.
//
// Бележка: MVP страниците засега рендерират от типизирани данни в src/data/*.
// Тази схема е основата за следващата фаза — администрация (CRUD) и редактиране
// на съдържанието от база данни, по модела на проекта „За Бобов дол".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ServiceCategory {
  EMERGENCY // Спешни
  HEALTH // Здраве
  UTILITY // Ток, вода, отпадъци
  TRANSPORT // Транспорт
  ADMIN // Администрация
  OTHER // Друго
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(EDITOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  action    String // CREATE | UPDATE | DELETE | LOGIN
  entity    String // Service | Pharmacy | User
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// Важна услуга / телефон в указателя.
model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  category    ServiceCategory @default(OTHER)
  description String          @default("")
  address     String          @default("")
  website     String          @default("")
  hours       String          @default("")
  // Телефоните се пазят като JSON: [{ number, label?, verified }].
  phones      Json?
  sources     String[]
  order       Int             @default(0)
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, category])
}

// Аптека (вкл. денонощна). Дежурният график за Дупница не е публичен онлайн,
// затова моделът пази потвърдените денонощни аптеки и бележки.
model Pharmacy {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  is24h     Boolean  @default(false)
  address   String   @default("")
  phone     String   @default("")
  note      String   @default("")
  verified  Boolean  @default(false)
  sources   String[]
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Прости настройки на сайта (ключ-стойност), редактируеми от админ панела.
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

enum ComplaintStatus {
  NEW
  FORWARDED
  RESOLVED
  REJECTED
}

// Сигнал/оплакване от жител, което се препраща към общината/институция.
model Complaint {
  id          String          @id @default(cuid())
  refCode     String          @unique
  name        String          @default("")
  email       String          @default("")
  phone       String          @default("")
  category    String          @default("Общи")
  subject     String
  message     String
  location    String          @default("")
  status      ComplaintStatus @default(NEW)
  adminNote   String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}

// Съобщения от формата за контакт (към проекта, не към общината).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  subject   String   @default("")
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([handled, createdAt])
}

enum DumpStatus {
  NEW
  CONFIRMED
  FORWARDED
  CLEANED
  REJECTED
}

// Сигнали за нерегламентирани (незаконни) сметища от граждани.
model DumpReport {
  id            String     @id @default(cuid())
  slug          String     @unique
  location      String
  description   String     @default("")
  reporterName  String     @default("")
  reporterPhone String     @default("")
  status        DumpStatus @default(NEW)
  adminNote     String     @default("")
  published     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([published, status])
}

enum ListingType {
  OFFER
  WANTED
  JOB
  REALESTATE
  FREE
  OTHER
}

// Безплатни местни обяви — минават през одобрение.
model Listing {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  description  String      @default("")
  type         ListingType @default(OFFER)
  category     String      @default("Общи")
  price        String      @default("")
  contactName  String      @default("")
  contactPhone String      @default("")
  contactEmail String      @default("")
  published    Boolean     @default(false)
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, type])
}

enum BusinessCategory {
  SHOP
  FOOD
  SERVICE
  CRAFT
  HEALTH
  OTHER
}

// Каталог на местния бизнес.
model Business {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    BusinessCategory @default(OTHER)
  description String           @default("")
  address     String           @default("")
  phone       String           @default("")
  website     String           @default("")
  facebook    String           @default("")
  hours       String           @default("")
  featured    Boolean          @default(false)
  order       Int              @default(0)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([published, category])
}

// Събития в Дупница.
model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @default("")
  location    String    @default("")
  startAt     DateTime
  endAt       DateTime?
  organizer   String    @default("")
  url         String    @default("")
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, startAt])
}

// Новини / актуални съобщения.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     String    @default("")
  source      String    @default("")
  sourceUrl   String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
