# Копирайте този файл като .env и попълнете стойностите.

# Връзка към PostgreSQL (нужна само за Prisma/админ фазата; MVP работи без нея).
DATABASE_URL="postgresql://user:password@localhost:5432/zadupnitsa?schema=public"

# Публичен адрес на сайта (за canonical/SEO/sitemap). Без крайна наклонена черта.
NEXT_PUBLIC_SITE_URL="https://zadupnitsa.eu"

# По избор: анонимна статистика през Plausible (без бисквитки). Оставете празно,
# за да не се зарежда нищо външно.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="zadupnitsa.eu"
