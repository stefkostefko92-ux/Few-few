# Копирайте този файл като .env и попълнете стойностите.

# Връзка към PostgreSQL (нужна само за Prisma/админ фазата; MVP работи без нея).
DATABASE_URL="postgresql://user:password@localhost:5432/zadupnitsa?schema=public"

# Публичен адрес на сайта (за canonical/SEO/sitemap). Без крайна наклонена черта.
NEXT_PUBLIC_SITE_URL="https://zadupnitsa.eu"

# По избор: анонимна статистика през Plausible (без бисквитки). Оставете празно,
# за да не се зарежда нищо външно.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="zadupnitsa.eu"

# Администрация (вход в /admin). ADMIN_EMAIL/ADMIN_PASSWORD се ползват само от
# скрипта за първоначално създаване на админ (seed); самият вход чете потребители от базата.
ADMIN_EMAIL="admin@zadupnitsa.eu"
ADMIN_PASSWORD=""
# Таен ключ за подписване на сесиите (JWT, HS256). ЗАДЪЛЖИТЕЛЕН в продукция — кодът
# хвърля грешка, ако липсва, е под 32 знака или е примерната стойност.
# Генерирай: openssl rand -base64 48
AUTH_SECRET=""

# Чат помощник (по избор). Без ANTHROPIC_API_KEY чатът показва любезно
# съобщение и насочва към търсачката. Моделът по подразбиране е бърз и евтин.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5"
