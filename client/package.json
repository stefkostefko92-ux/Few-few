{
  "name": "@kagura/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KAGURA SPIN — TypeScript client SDK (zero-dependency, isomorphic)",
  "engines": {
    "node": ">=22"
  },
