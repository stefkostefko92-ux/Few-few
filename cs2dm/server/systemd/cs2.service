[Unit]
Description=CS2 сървър „CarbonStealth.eu | Dust2 DM“ (cs2dm)
Documentation=https://github.com/stefkostefko92-ux/Few-few/tree/main/cs2dm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cs2
Group=cs2
EnvironmentFile=/etc/cs2/cs2.env
WorkingDirectory=/opt/cs2/server/game
# Без GSLT сървърът не се листва — по-добре да не тръгне, отколкото да върви „невидим“.
# „$$“ = shell-ът чете променливата от средата; иначе systemd би вписал токена в командния ред.
ExecStartPre=/bin/sh -c 'test -n "$$CS2_GSLT" || { echo "CS2_GSLT липсва в /etc/cs2/cs2.env" >&2; exit 1; }'
# Винаги през cs2.sh (задава LD_LIBRARY_PATH) — Valve не препоръчва директно бинарника.
ExecStart=/opt/cs2/server/game/cs2.sh -dedicated -console -ip ${CS2_IP} -port ${CS2_PORT} -maxplayers ${CS2_MAXPLAYERS} +game_type 1 +game_mode 2 +mapgroup mg_de_dust2 +map de_dust2 +sv_setsteamaccount ${CS2_GSLT}
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
LimitNOFILE=65535

# Споделен VPS: играта има приоритет пред уеб продуктите при натоварване.
# Закрепване към ядра (AllowedCPUs=) — чак след измерване, в drop-in файл.
CPUWeight=1000
Nice=-5

# Втвърдяване. БЕЗ MemoryDenyWriteExecute — .NET JIT на CounterStrikeSharp (фаза 2) пише
# изпълнима памет.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/cs2
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
