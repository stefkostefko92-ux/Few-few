# /etc/cs2/cs2.env — тайни и настройки на cs2dm. Права root:root 0600. НИКОГА в репото.
#
# GSLT (Game Server Login Token): steamcommunity.com/dev/managegameservers → App ID 730.
# Създава се от СЛУЖЕБНИЯ Steam акаунт на фирмата (със собствен телефон) — при бан на токена
# банът е перманентен за акаунта и за всеки акаунт със същия телефон.
CS2_GSLT=

# 0.0.0.0 = всички адреси на машината; при отделен IPv4 само за играта — сложи него.
CS2_IP=0.0.0.0
CS2_PORT=27015
CS2_MAXPLAYERS=20

# SteamID64 на собственика (17 цифри, започва с 7656119…) → админ @css/root в играта (фаза 2).
# Не е тайна; виж го на steamid.io или в адреса на профила си.
CS2_OWNER_STEAMID64=

# ── Плъгинът CarbonStealth (install-plugins.sh) ─────────────────────────────────────────────────
# База на приложението (Postgres в Docker, само на 127.0.0.1). Npgsql низ; паролата е тайна.
CS2DM_DB_CONNECTION=Host=127.0.0.1;Port=5442;Database=cs2dm;Username=cs2dm;Password=
# Redis на приложението (мостът към сайта). abortConnect=false = свързва се сам наново.
CS2DM_REDIS_CONNECTION=127.0.0.1:6392,password=,abortConnect=false
# Общ HMAC ключ със сайта (същата стойност и в неговия env): openssl rand -hex 32. Под 32 знака = мостът е изключен.
CS2DM_BRIDGE_KEY=
CS2DM_SITE_URL=cs2.carbonstealth.eu
# Запазени места: при повече хора от това число влизат само VIP и екипът (0 = изключено).
CS2DM_PUBLIC_SLOTS=0
# Реклама в чата (carbonstealth.eu · adblock.carbonstealth.eu · сайта) на всеки N секунди; 0 = без.
CS2DM_ADVERT_SECONDS=240

# ── Банери-картинки (по желание; виж cs2dm/addon/README.md) ──────────────────────────────────────
# Workshop ID на addon-а с картинките → MultiAddonManager (install-mods.sh). Празно = само текстови банери.
CS2_WORKSHOP_ADDONS=
# Ключ=модел за !banner add <ключ>, разделени със запетая.
CS2DM_BANNER_MODELS=
