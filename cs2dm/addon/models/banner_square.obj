# cs2dm — плоскост за банер 128×128 единици. Лице към +X, център в (0,0,0), Z нагоре.
# Плъгинът я завърта с yaw = посоката на нормалата на стената (BannerPlacement.OnWall).
o banner_square
v 0 -64 -64
v 0 64 -64
v 0 64 64
v 0 -64 64
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 1 0 0
usemtl banner
f 1/1/1 2/2/1 3/3/1 4/4/1
