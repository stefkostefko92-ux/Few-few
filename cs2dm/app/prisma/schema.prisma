// cs2dm — единственият източник на истина за схемата на PostgreSQL.
// Миграциите се правят САМО оттук (`prisma migrate`); C# плъгинът пише в същите таблици с
// изричен SQL по имената от @map/@@map — промяна на име тук = промяна и в
// plugins/CarbonStealth/Data/*.cs (договорът е в cs2dm/CONTRACT.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 7 нива (стандартът на Carbon Stealth). Числото на нивото е в CONTRACT.md.
enum Role {
  PLAYER
  VIP
  HELPER
  MODERATOR
  ADMIN
  HEADADMIN
  OWNER
}

enum PunishmentType {
  BAN
  MUTE
  GAG
  SILENCE
  WARN
  KICK
}

/// Публичната категория в банлиста — свободният текст на причината НЕ е публичен.
enum PunishmentCategory {
  CHEATING
  TOXICITY
  EXPLOIT
  SPAM
  IMPERSONATION
  OTHER
}

enum Source {
  GAME
  WEB
  DISCORD
  SYSTEM
}

enum CaseStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum VipRequestStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  REJECTED
  CANCELLED
}

/// Вид на събитие по график (CONTRACT §12): XP уикенд, специален DM режим или общностно събитие.
enum EventKind {
  XP_BOOST
  MODE
  COMMUNITY
}

model Player {
  steamId                String    @id @map("steam_id") @db.VarChar(17)
  name                   String    @db.VarChar(64)
  role                   Role      @default(PLAYER)
  lang                   String    @default("en") @db.VarChar(5)
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  playtimeSec            Int       @default(0) @map("playtime_sec")
  /// Steam профилът (аватар) се тегли САМО след вход в сайта — Steam Web API ToU.
  avatarUrl              String?   @map("avatar_url") @db.VarChar(255)
  webLoginAt             DateTime? @map("web_login_at") @db.Timestamptz(3)
  discordId              String?   @unique @map("discord_id") @db.VarChar(20)
  linkedAt               DateTime? @map("linked_at") @db.Timestamptz(3)
  /// TOTP за панела (роля ≥ HELPER): шифрован с ключа на приложението, никога в чист вид.
  totpSecretEnc          String?   @map("totp_secret_enc")
  totpEnabledAt          DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Последно приетата TOTP стъпка (RFC 6238) — прихванат код не минава втори път. Само за панела.
  totpLastStep           Int?      @map("totp_last_step")
  /// Право на възражение (чл. 21 GDPR): скрит от публичните класации.
  hiddenFromLeaderboards Boolean   @default(false) @map("hidden_from_leaderboards")
  /// Епохата на статистиките (CONTRACT §3): панелът я вдига при всяка ръчна редакция; плъгинът я
  /// чете и праща с всяка партида — партида със стара епоха не пипа редактираните стойности.
  statsEpoch             Int       @default(0) @map("stats_epoch")

  sessions      Session[]
  stats         PlayerSeasonStats[]
  weaponStats   WeaponSeasonStats[]
  punishments   Punishment[]        @relation("target")
  vipGrants     VipGrant[]
  vipRequests   VipRequest[]
  webSessions   WebSession[]
  recoveryCodes WebRecoveryCode[]
  matches       MatchPlayer[]
  badges        PlayerBadge[]
  duelWins      Duel[]              @relation("duelWinner")
  duelLosses    Duel[]              @relation("duelLoser")

  @@index([lastSeenAt])
  @@index([role])
  @@map("players")
}

/// Влизания в сървъра. IP е за сигурност/банове — пази се 30 дни (задача за чистене), никога публично.
model Session {
  id             BigInt    @id @default(autoincrement())
  steamId        String    @map("steam_id") @db.VarChar(17)
  ip             String?   @db.Inet
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(3)
  player         Player    @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@index([steamId, connectedAt])
  @@index([connectedAt])
  @@map("sessions")
}

/// Сезон 0 = „за всички времена“ (сее се от миграцията). Активният сезон е с endsAt = null и id > 0.
model Season {
  id       Int       @id
  name     String    @db.VarChar(64)
  startsAt DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  stats       PlayerSeasonStats[]
  weaponStats WeaponSeasonStats[]

  @@map("seasons")
}

/// Агрегати, които плъгинът увеличава на партиди (UPSERT +=). Два реда на играч: сезон 0 и текущият.
model PlayerSeasonStats {
  steamId         String   @map("steam_id") @db.VarChar(17)
  seasonId        Int      @map("season_id")
  kills           Int      @default(0)
  deaths          Int      @default(0)
  headshots       Int      @default(0)
  assists         Int      @default(0)
  damage          Int      @default(0)
  shotsFired      Int      @default(0) @map("shots_fired")
  shotsHit        Int      @default(0) @map("shots_hit")
  bestStreak      Int      @default(0) @map("best_streak")
  bountiesClaimed Int      @default(0) @map("bounties_claimed")
  revenges        Int      @default(0)
  xp              BigInt   @default(0)
  playtimeSec     Int      @default(0) @map("playtime_sec")
  /// Епохата, с която е писан редът (CONTRACT §3) — партида с по-стара не го пипа.
  statsEpoch      Int      @default(0) @map("stats_epoch")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  player          Player   @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
  season          Season   @relation(fields: [seasonId], references: [id])

  @@id([steamId, seasonId])
  @@index([seasonId, xp(sort: Desc)])
  @@index([seasonId, kills(sort: Desc)])
  @@map("player_season_stats")
}

/// По оръжие — за weapon mastery (сезон 0) и сезонни класации по оръжие.
model WeaponSeasonStats {
  steamId    String @map("steam_id") @db.VarChar(17)
  seasonId   Int    @map("season_id")
  weapon     String @db.VarChar(32)
  kills      Int    @default(0)
  headshots  Int    @default(0)
  /// Епохата, с която е писан редът (CONTRACT §3).
  statsEpoch Int    @default(0) @map("stats_epoch")
  player     Player @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
  season     Season @relation(fields: [seasonId], references: [id])

  @@id([steamId, seasonId, weapon])
  @@index([seasonId, weapon, kills(sort: Desc)])
  @@map("weapon_season_stats")
}

/// Сурови убийства (heatmap-и, „убийство на деня“). Пазят се 90 дни (задача за чистене).
/// Координатите са световни (Source units); превръщането в пиксели е в CONTRACT.md.
model Kill {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now()) @db.Timestamptz(3)
  seasonId      Int      @map("season_id")
  mode          String   @db.VarChar(32)
  attackerId    String?  @map("attacker_id") @db.VarChar(17)
  victimId      String   @map("victim_id") @db.VarChar(17)
  weapon        String   @db.VarChar(32)
  headshot      Boolean  @default(false)
  wallbang      Boolean  @default(false)
  noscope       Boolean  @default(false)
  throughSmoke  Boolean  @default(false) @map("through_smoke")
  attackerBlind Boolean  @default(false) @map("attacker_blind")
  distance      Float    @db.Real
  ax            Float    @db.Real
  ay            Float    @db.Real
  az            Float    @db.Real
  vx            Float    @db.Real
  vy            Float    @db.Real
  vz            Float    @db.Real

  @@index([at])
  @@index([attackerId, at])
  @@index([victimId, at])
  @@map("kills")
}

/// Наказания. Активен бан: type = BAN, revokedAt = null, expiresAt = null или в бъдещето.
/// Публичният банлист показва САМО: steamId, targetName, category, createdAt, expiresAt.
model Punishment {
  id           Int                @id @default(autoincrement())
  type         PunishmentType
  steamId      String             @map("steam_id") @db.VarChar(17)
  targetName   String             @map("target_name") @db.VarChar(64)
  category     PunishmentCategory @default(OTHER)
  /// Вътрешна причина — само за админи, никога публично.
  reason       String             @db.VarChar(255)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime?          @map("expires_at") @db.Timestamptz(3)
  actorSteamId String?            @map("actor_steam_id") @db.VarChar(17)
  source       Source
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?            @map("revoked_by") @db.VarChar(17)
  revokeReason String?            @map("revoke_reason") @db.VarChar(255)
  target       Player             @relation("target", fields: [steamId], references: [steamId], onDelete: Cascade)
  appeals      Appeal[]

  @@index([steamId, type, revokedAt])
  @@index([type, createdAt(sort: Desc)])
  @@map("punishments")
}

/// Обжалване (DSA чл. 17/20 по дух): формуляр на сайта, решение с обосновка.
model Appeal {
  id           Int        @id @default(autoincrement())
  punishmentId Int        @map("punishment_id")
  steamId      String     @map("steam_id") @db.VarChar(17)
  message      String     @db.VarChar(2000)
  contact      String?    @db.VarChar(255)
  status       CaseStatus @default(OPEN)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  handledAt    DateTime?  @map("handled_at") @db.Timestamptz(3)
  handledBy    String?    @map("handled_by") @db.VarChar(17)
  decisionNote String?    @map("decision_note") @db.VarChar(1000)
  punishment   Punishment @relation(fields: [punishmentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("appeals")
}

model Report {
  id              Int        @id @default(autoincrement())
  reporterSteamId String?    @map("reporter_steam_id") @db.VarChar(17)
  targetSteamId   String     @map("target_steam_id") @db.VarChar(17)
  targetName      String     @map("target_name") @db.VarChar(64)
  reason          String     @db.VarChar(500)
  source          Source
  status          CaseStatus @default(OPEN)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  handledAt       DateTime?  @map("handled_at") @db.Timestamptz(3)
  handledBy       String?    @map("handled_by") @db.VarChar(17)
  note            String?    @db.VarChar(500)

  @@index([status, createdAt])
  @@index([targetSteamId])
  @@map("reports")
}

/// Нивата на VIP се управляват от панела — нула цени в кода. Перковете са само козметика.
model VipTier {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(32)
  name       String       @db.VarChar(64)
  /// Цена с ДДС в евроцентове (цели числа, никога float).
  priceCents Int          @map("price_cents")
  periodDays Int          @map("period_days")
  active     Boolean      @default(true)
  sortOrder  Int          @default(0) @map("sort_order")
  grants     VipGrant[]
  requests   VipRequest[]

  @@map("vip_tiers")
}

/// Активен VIP: revokedAt = null и startsAt <= сега < endsAt. Без автоматично подновяване.
model VipGrant {
  id            Int         @id @default(autoincrement())
  steamId       String      @map("steam_id") @db.VarChar(17)
  tierId        Int         @map("tier_id")
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  amountCents   Int?        @map("amount_cents")
  paymentMethod String?     @map("payment_method") @db.VarChar(32)
  invoiceNo     String?     @map("invoice_no") @db.VarChar(32)
  requestId     Int?        @unique @map("request_id")
  grantedBy     String      @map("granted_by") @db.VarChar(17)
  note          String?     @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  player        Player      @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
  tier          VipTier     @relation(fields: [tierId], references: [id])
  request       VipRequest? @relation(fields: [requestId], references: [id])

  @@index([steamId, endsAt])
  @@map("vip_grants")
}

/// Заявка от сайта. Данните за фактура са лични данни — срок по ЗСч, никога публично/в логове.
model VipRequest {
  id                    Int              @id @default(autoincrement())
  steamId               String           @map("steam_id") @db.VarChar(17)
  tierId                Int              @map("tier_id")
  periods               Int              @default(1)
  billingName           String           @map("billing_name") @db.VarChar(128)
  billingAddress        String           @map("billing_address") @db.VarChar(255)
  billingTaxId          String?          @map("billing_tax_id") @db.VarChar(32)
  email                 String           @db.VarChar(255)
  immediateStartConsent Boolean          @map("immediate_start_consent")
  termsVersion          String           @map("terms_version") @db.VarChar(16)
  status                VipRequestStatus @default(PENDING)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  handledAt             DateTime?        @map("handled_at") @db.Timestamptz(3)
  handledBy             String?          @map("handled_by") @db.VarChar(17)
  player                Player           @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
  tier                  VipTier          @relation(fields: [tierId], references: [id])
  grant                 VipGrant?

  @@index([status, createdAt])
  @@map("vip_requests")
}

/// Одит-верига: hash = sha256(prev_hash || съдържание) се смята от тригер в базата (миграцията),
/// за да е верига и при няколко писача (плъгин, сайт, бот).
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now()) @db.Timestamptz(3)
  actorSteamId  String?  @map("actor_steam_id") @db.VarChar(17)
  action        String   @db.VarChar(64)
  targetSteamId String?  @map("target_steam_id") @db.VarChar(17)
  details       Json     @default("{}")
  source        Source
  prevHash      String?  @map("prev_hash") @db.Char(64)
  hash          String?  @db.Char(64)

  @@index([at])
  @@index([targetSteamId])
  @@map("audit_log")
}

/// Текстови банери в картата (point_worldtext), поставени от админ в играта с „!banner add <ключ>“.
/// Ключът сочи стил и текст от конфигурацията на плъгина (Banners). Ъглите са в градуси.
model MapBanner {
  id        Int      @id @default(autoincrement())
  map       String   @db.VarChar(64)
  bannerKey String   @map("banner_key") @db.VarChar(32)
  x         Float    @db.Real
  y         Float    @db.Real
  z         Float    @db.Real
  pitch     Float    @db.Real
  yaw       Float    @db.Real
  roll      Float    @db.Real
  createdBy String?  @map("created_by") @db.VarChar(17)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([map])
  @@map("map_banners")
}

/// Сесия в уеб панела (CONTRACT.md §10). Бисквитката носи токена, тук е САМО неговият sha256.
/// `role` е ролята при входа: разминаване с players.role (смяна от панела, играта или бота) прекратява
/// сесията. Без IP и User-Agent — не са нужни за целта (минимизация по GDPR).
model WebSession {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  steamId     String   @map("steam_id") @db.VarChar(17)
  role        Role
  csrfToken   String   @map("csrf_token") @db.VarChar(64)
  /// false — входът със Steam е минал, TOTP още не (сесията живее най-много 10 минути).
  mfaPassed   Boolean  @default(false) @map("mfa_passed")
  mfaFailures Int      @default(0) @map("mfa_failures")
  lang        String   @default("bg") @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  player      Player   @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@index([steamId])
  @@index([expiresAt])
  @@map("web_sessions")
}

/// Резервни кодове за TOTP: само HMAC-SHA256 с ключ, изведен от APP_ENC_KEY — никога в чист вид.
model WebRecoveryCode {
  id        Int       @id @default(autoincrement())
  steamId   String    @map("steam_id") @db.VarChar(17)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  player    Player    @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@unique([steamId, codeHash])
  @@map("web_recovery_codes")
}

/// Живите настройки на сървъра (CONTRACT.md §11): ключ от затворен списък → JSON стойност.
/// Пишат ги панелът (`/admin/settings`) и WASD менюто в играта (патрони, ботове); C# плъгинът ги чете
/// при старт, на 60 s и при `settings.reload`. Липсващ или невалиден ред → важи конфигът на плъгина.
model ServerSetting {
  key       String   @id @db.VarChar(32)
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// SteamID64 на последния писач (панел или игра); null = системата.
  updatedBy String?  @map("updated_by") @db.VarChar(17)

  @@map("server_settings")
}

/// Събитие по график (CONTRACT §12). Пише го панелът (ADMIN+, /admin/events); плъгинът го проверява на
/// 30 s: при старт — обява на езика на играча, DM режим (ако има) и множител на XP = max(настройка, събитие);
/// при край — обява и връщане. Без застъпване (EXCLUDE в миграцията + проверка в панела). Отменено = cancelled_at.
model ScheduledEvent {
  id           Int       @id @default(autoincrement())
  kind         EventKind
  titleBg      String    @map("title_bg") @db.VarChar(80)
  titleEn      String    @map("title_en") @db.VarChar(80)
  titleIt      String    @map("title_it") @db.VarChar(80)
  startsAt     DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime  @map("ends_at") @db.Timestamptz(3)
  /// 1.0…3.0 със стъпка 0.1 (CHECK в миграцията); плъгинът го ползва в десети (§3).
  xpMultiplier Decimal   @default(1.0) @map("xp_multiplier") @db.Decimal(2, 1)
  /// Custom режим на DM плъгина (Deathmatch.json, „Custom Modes“) или null = без смяна.
  dmModeId     Int?      @map("dm_mode_id")
  createdBy    String    @map("created_by") @db.VarChar(17)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy  String?   @map("cancelled_by") @db.VarChar(17)
  matches      Match[]

  @@index([startsAt])
  @@index([endsAt])
  @@map("events")
}

/// Мач = една карта до смяната ѝ (mp_timelimit 30 + mp_match_end_changelevel). Пише го C# плъгинът в края на
/// мача (CONTRACT §13) — само хора срещу хора, както статистиките. Пази се 90 дни (§7), после работникът го трие.
model Match {
  id           Int             @id @default(autoincrement())
  map          String          @db.VarChar(64)
  mode         String          @db.VarChar(32)
  seasonId     Int             @map("season_id")
  /// Събитието, което течеше в края на мача (§12), ако има.
  eventId      Int?            @map("event_id")
  /// Ефективният множител на XP в края на мача (§3) — 1.0…3.0.
  xpMultiplier Decimal         @default(1.0) @map("xp_multiplier") @db.Decimal(2, 1)
  startedAt    DateTime        @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime        @map("ended_at") @db.Timestamptz(3)
  /// Убийствата между хора в мача и броят играчи с поне едно убийство или смърт.
  kills        Int             @default(0)
  players      Int             @default(0)
  event        ScheduledEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  rows         MatchPlayer[]

  @@index([endedAt])
  @@map("matches")
}

/// Ред на играч в мач: място (убийства ↓, смърти ↑, в главата ↓), числата и най-силното оръжие.
model MatchPlayer {
  matchId         Int     @map("match_id")
  steamId         String  @map("steam_id") @db.VarChar(17)
  name            String  @db.VarChar(64)
  place           Int
  kills           Int     @default(0)
  deaths          Int     @default(0)
  headshots       Int     @default(0)
  bestStreak      Int     @default(0) @map("best_streak")
  bountiesClaimed Int     @default(0) @map("bounties_claimed")
  /// XP, спечелено в мача (с множителя).
  xp              Int     @default(0)
  topWeapon       String? @map("top_weapon") @db.VarChar(32)
  topWeaponKills  Int     @default(0) @map("top_weapon_kills")
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player          Player  @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@id([matchId, steamId])
  @@index([steamId])
  @@map("match_players")
}

/// „Горещата зона“ (CONTRACT §15): точките, които HEADADMIN+ задава в играта с `!zone add`. Без FK към
/// автора — като `map_banners`: одитът пази кой, зоната остава и след изтриване на автора.
model MapZone {
  id        Int      @id @default(autoincrement())
  map       String   @db.VarChar(64)
  name      String   @db.VarChar(24)
  x         Float    @db.Real
  y         Float    @db.Real
  z         Float    @db.Real
  /// Радиус в единици на играта (100–800); височината е ±160 от центъра.
  radius    Int
  createdBy String?  @map("created_by") @db.VarChar(17)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([map])
  @@map("map_zones")
}

/// Значките на играча (CONTRACT §15) — „Крал на зоната“ (`zone_king`). Пазят се, докато играчът съществува.
model PlayerBadge {
  id       BigInt   @id @default(autoincrement())
  steamId  String   @map("steam_id") @db.VarChar(17)
  kind     String   @db.VarChar(32)
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)
  /// `{map, zone, kills}` за `zone_king` — само числа и имена на зони, никакви лични данни.
  details  Json     @default("{}")
  player   Player   @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@index([steamId, earnedAt])
  @@map("player_badges")
}

/// Дуелите в FFA (CONTRACT §15): до 5 убийства един срещу друг или 3 минути. При равенство (`draw`) редът
/// на двамата е произволен. Срок 90 дни (§7).
model Duel {
  id          Int      @id @default(autoincrement())
  winnerId    String   @map("winner_id") @db.VarChar(17)
  loserId     String   @map("loser_id") @db.VarChar(17)
  winnerScore Int      @map("winner_score")
  loserScore  Int      @map("loser_score")
  draw        Boolean  @default(false)
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  winner      Player   @relation("duelWinner", fields: [winnerId], references: [steamId], onDelete: Cascade)
  loser       Player   @relation("duelLoser", fields: [loserId], references: [steamId], onDelete: Cascade)

  @@index([winnerId])
  @@index([loserId])
  @@index([endedAt])
  @@map("duels")
}
