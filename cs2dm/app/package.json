{
  "name": "cs2dm-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CarbonStealth.eu | Dust2 DM — публичният сайт на CS2 сървъра: статус на живо, класация, профили на играчи, банлист, VIP и правни страници.",
  "license": "UNLICENSED",
  "author": "Carbon Stealth VCC",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefkostefko92-ux/Few-few.git",
    "directory": "cs2dm/app"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "Carbon Stealth",
    "CS2",
    "Counter-Strike 2",
    "Dust2",
    "Deathmatch",
    "CS2 класация"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "bullmq": "^5.81.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
