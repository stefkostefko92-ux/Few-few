<%- include('partials/head') %>
<%- include('partials/page-hero', { title: t('matches.h1'), lead: t('matches.lead'), here: t('nav.matches') }) %>
<div class="wrap page-content">
  <% if (rows.length === 0) { %>
  <div class="empty-state"><p><%= t('matches.empty') %></p></div>
  <% } else { %>
  <%- include('partials/match-list', { rows }) %>
  <% } %>
  <p class="links-row spaced-top"><a href="<%= nav.leaderboard %>"><%= t('matches.toLeaderboard') %></a></p>
</div>
<%- include('partials/foot') %>
