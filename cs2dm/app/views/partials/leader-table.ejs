<div class="table-wrap">
  <table class="board">
    <caption class="sr-only"><%= caption %></caption>
    <thead>
      <tr>
        <th scope="col" class="c-rank"><%= t('table.rank') %></th>
        <th scope="col" class="c-name"><%= t('table.player') %></th>
        <th scope="col" class="c-num"><%= t('table.level') %></th>
        <% columns.forEach((col) => { %><th scope="col" class="c-num<%= col.optional ? ' opt' : '' %>"<% if (col.sorted) { %> aria-sort="descending"<% } %>><% if (col.href) { %><a href="<%= col.href %>" title="<%= t('leaderboard.sortBy', { sort: t('leaderboard.sort.' + col.sortKey) }) %>"><%= col.label %></a><% } else { %><%= col.label %><% } %></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((row) => { %><tr<% if (row.rank <= 3) { %> class="podium podium-<%= row.rank %>"<% } %>>
        <td class="c-rank"><%= row.rank %></td>
        <th scope="row" class="c-name"><a href="<%= playerHref(row.steamId) %>"><%= row.name %></a></th>
        <td class="c-num c-level"><%= row.level %></td>
        <% columns.forEach((col) => { %><td class="c-num<%= col.optional ? ' opt' : '' %><%= col.sorted ? ' is-sorted' : '' %>"><%= col.value(row) %></td>
        <% }) %>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
