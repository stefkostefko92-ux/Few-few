<%- include('partials/head') %>
<%
  const lines = (key) => t.list(key);
  const heading = (key) => lines(key).map((line, i, all) => i === all.length - 1 && all.length > 1 ? `<em>${escape(line)}</em>` : escape(line)).join('<br>');
  function escape(text) { return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  const seasonName = season ? seasonLabel(season) : t('season.allTime');
  const showTop = top !== null;
  const showBans = Array.isArray(bans) && bans.length > 0;
  const liveMode = live.known && live.online ? live.mode : null;
  const kicker = lines('home.cover.kicker');
  const coverTitle = lines('home.cover.title');
%>
<section class="cover" aria-labelledby="cover-title">
  <div class="cover-copy">
    <p class="cover-kicker"><%= kicker[0] %> <span aria-hidden="true">/</span> <%= kicker[1] %></p>
    <h1 id="cover-title"><span class="sr-only"><%= t('home.titleHost') %> | <%= t('home.titleName') %> — </span><span><%= coverTitle[0] %></span> <em><%= coverTitle[1] %></em></h1>
    <p class="cover-lead"><%= t('home.cover.lead') %></p>
    <div class="cover-actions">
      <a class="button" href="<%= server.connectUrl %>"><%= t('home.hero.play') %> <span aria-hidden="true">↗</span></a>
      <% if (discordUrl) { %><a class="button button-ghost" href="<%= discordUrl %>" target="_blank" rel="noopener"><%= t('home.hero.discord') %></a><% } %>
      <a class="under-link" href="#format"><%= t('home.cover.format') %> <span aria-hidden="true">↓</span></a>
    </div>
    <div class="connect-line">
      <span id="console-label"><%= t('home.cover.connect') %></span>
      <code id="connect-cmd" aria-describedby="console-label"><%= server.command %></code>
      <button type="button" class="copy" data-copy-target="connect-cmd" data-copied="<%= t('home.join.copied') %>" data-failed="<%= t('home.join.copyFailed') %>" hidden><%= t('home.join.copy') %></button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

    <section class="status <%= live.known && live.online ? 'is-live' : 'is-unknown' %>" aria-label="<%= t('home.status.label') %>">
      <p class="status-head"><span class="pulse" aria-hidden="true"></span><%= !live.known ? t('home.status.unknown') : live.online ? t('home.status.live') : t('home.status.offline') %></p>
      <% if (live.known && live.online) { %>
      <dl class="status-grid">
        <div><dt><%= t('home.status.players') %></dt><dd><%= live.humans %><small>/<%= live.maxPlayers %></small></dd></div>
        <div><dt><%= t('home.status.map') %></dt><dd><%= live.map %></dd></div>
        <div><dt><%= t('home.status.mode') %></dt><dd><%= live.mode || '—' %></dd></div>
      </dl>
      <% if (live.maxPlayers > 0) { %><progress class="slots" max="<%= live.maxPlayers %>" value="<%= live.humans %>" aria-hidden="true"><%= live.humans %>/<%= live.maxPlayers %></progress><% } %>
      <% if (live.humans === 0) { %><p class="status-hint"><%= t('home.status.empty') %></p><% } %>
      <p class="status-time"><%= t('home.status.updated', { time: fmt.dateTime(live.updatedAt) }) %></p>
      <% } else if (live.known) { %>
      <p class="status-hint"><%= t('home.status.offlineHint') %></p>
      <p class="status-time"><%= t('home.status.updated', { time: fmt.dateTime(live.updatedAt) }) %></p>
      <% } else { %>
      <p class="status-hint"><%= t('home.status.unknownHint') %></p>
      <% } %>
    </section>
  </div>
  <figure class="cover-art">
    <img src="<%= asset('img/dust2-720.webp') %>" srcset="<%= asset('img/dust2-720.webp') %> 720w, <%= asset('img/dust2-1080.webp') %> 1080w" sizes="(max-width: 940px) 100vw, 50vw" width="1080" height="810" alt="<%= t('home.cover.artAlt') %>" fetchpriority="high" decoding="async">
    <figcaption><span><%= t('home.cover.artCaption') %></span><span>Carbon Stealth</span></figcaption>
  </figure>
</section>

<%- include('partials/events', { events }) %>

<section class="brief" id="format" aria-labelledby="brief-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= t('home.brief.eyebrow') %></p>
      <h2 id="brief-title"><%- lines('home.brief.title').map(escape).join('<br>') %></h2>
      <p class="split-lead"><%= t('home.brief.text') %></p>
    </div>
    <dl class="ruled spec-list">
      <% ['map', 'mode', 'respawn', 'protect', 'awp', 'ammo'].forEach((id) => { %><div><dt><%= t('home.brief.spec.' + id + '.dt') %></dt><dd><%= t('home.brief.spec.' + id + '.dd') %> <small><%= t('home.brief.spec.' + id + '.note') %></small></dd></div>
      <% }) %>
    </dl>
  </div>
</section>

<section class="mid-story" aria-labelledby="mid-title">
  <figure class="mid-art">
    <img src="<%= asset('img/mid-doors-560.webp') %>" srcset="<%= asset('img/mid-doors-560.webp') %> 560w, <%= asset('img/mid-doors-840.webp') %> 840w" sizes="(max-width: 760px) 100vw, 52vw" width="840" height="1050" alt="<%= t('home.mid.alt') %>" loading="lazy" decoding="async">
    <figcaption><span><%= t('home.mid.caption') %></span></figcaption>
  </figure>
  <div class="mid-copy">
    <p class="eyebrow"><%= t('home.mid.eyebrow') %></p>
    <h2 id="mid-title"><%- lines('home.mid.title').map(escape).join('<br>') %></h2>
    <p><%= t('home.mid.text') %></p>
    <a class="under-link under-link-light" href="<%= nav.rules %>"><%= t('home.mid.link') %> <span aria-hidden="true">↗</span></a>
  </div>
</section>

<section class="rotation" aria-labelledby="rotation-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= t('home.rotation.eyebrow') %></p>
      <h2 id="rotation-title"><%- heading('home.rotation.title') %></h2>
      <p class="split-lead"><%= t('home.rotation.text') %></p>
    </div>
    <ul class="ruled mode-list" aria-label="<%= t('home.status.mode') %>">
      <% modes.forEach((mode) => { const current = liveMode === mode; %><li<% if (current) { %> class="is-current"<% } %>><strong><%= mode %><% if (current) { %> <span class="now-tag"><%= t('home.rotation.now') %></span><% } %></strong><span><%= t('home.rotation.modes.' + mode.replace(/ /g, '')) %></span></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="rank-feature" aria-labelledby="rank-title">
  <div class="wrap">
    <div class="split">
      <div>
        <p class="eyebrow"><%= t('home.rank.eyebrow') %></p>
        <h2 id="rank-title"><%- lines('home.rank.title').map(escape).join('<br>') %></h2>
      </div>
      <div class="rank-copy">
        <p><%= t('home.rank.text') %></p>
        <a class="button button-light" href="<%= nav.leaderboard %>"><%= t('home.top.all') %> <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <% if (showTop) { %>
    <div class="board-block">
      <div class="board-head"><h3 id="top-title"><%= t('home.top.title', { season: seasonName }) %></h3></div>
      <% if (top.length === 0) { %>
      <div class="invite">
        <h3><%= t('home.top.inviteTitle') %></h3>
        <p><%= t('home.top.inviteText') %></p>
        <a class="under-link under-link-light" href="<%= nav.leaderboard %>#how-title"><%= t('home.top.inviteLink') %></a>
      </div>
      <% } else { %>
      <ol class="top-list">
        <% top.forEach((row, index) => { %><li>
          <span class="top-rank" aria-label="<%= t('table.rank') %> <%= index + 1 %>"><%= index + 1 %></span>
          <%- include('partials/level', { level: row.level }) %>
          <a class="top-name" href="<%= playerHref(row.steamId) %>"><%= row.name %></a>
          <span class="top-xp"><b><%= fmt.int(row.xp) %></b> <%= t('table.xp') %></span>
          <span class="top-kd"><%= fmt.kd(row.kills, row.deaths) %> <%= t('table.kd') %></span>
        </li>
        <% }) %>
      </ol>
      <% } %>
    </div>
    <% } %>

    <div class="mastery-strip">
      <h3><%= t('home.rank.masteryTitle') %></h3>
      <p><%= t('home.rank.masteryText') %></p>
      <ol class="tiers"><% masteryTiers.forEach((tier) => { %><li class="tier tier-<%= tier.id %>"><span class="tier-gem" aria-hidden="true"></span><span class="tier-name"><%= t('player.mastery.tiers.' + tier.id) %></span><span class="tier-kills"><%= fmt.int(tier.kills) %></span></li><% }) %></ol>
    </div>
  </div>
</section>

<% if (matches.length > 0) { %>
<section class="band" aria-labelledby="matches-title">
  <div class="wrap">
    <div class="band-head">
      <h2 id="matches-title"><%= t('home.matches.title') %></h2>
      <a class="under-link" href="<%= nav.matches %>"><%= t('home.matches.all') %> <span aria-hidden="true">↗</span></a>
    </div>
    <%- include('partials/match-list', { rows: matches }) %>
  </div>
</section>
<% } %>

<% if (showBans) { %>
<section class="band band-paper-dark" aria-labelledby="bans-title">
  <div class="wrap">
    <div class="band-head">
      <h2 id="bans-title"><%= t('home.bans.title') %></h2>
      <a class="under-link" href="<%= nav.bans %>"><%= t('home.bans.all') %> <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="ban-strip">
      <% bans.forEach((ban) => { %><li>
        <span class="ban-name"><%= ban.targetName %></span>
        <span class="cat cat-<%= ban.category.toLowerCase() %>"><%= t('bans.categories.' + ban.category) %></span>
        <time class="ban-when" datetime="<%= fmt.iso(ban.createdAt) %>"><%= fmt.date(ban.createdAt) %></time>
        <span class="ban-until<%= ban.expiresAt ? '' : ' is-permanent' %>"><%= ban.expiresAt ? t('home.bans.until', { date: fmt.date(ban.expiresAt) }) : t('common.permanent') %></span>
      </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="points" aria-labelledby="points-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= t('home.points.eyebrow') %></p>
      <h2 id="points-title"><%- lines('home.points.title').map(escape).join('<br>') %></h2>
      <p class="split-lead"><%= t('home.points.text') %></p>
    </div>
    <div>
      <ul class="ruled xp-list" aria-label="<%= t('leaderboard.how.title') %>">
        <% xpRewards.forEach((reward) => { %><li><strong>+<%= reward.xp %></strong><span><%= t('leaderboard.how.rewards.' + reward.id) %></span></li>
        <% }) %><li><strong>+<%= bounty.perKill %>–<%= bounty.cap %></strong><span><%= t('leaderboard.how.bountyRow') %></span></li>
      </ul>
      <div class="xp-notes">
        <p><%= t('leaderboard.how.bounty', { min: bounty.minStreak, cap: bounty.cap }) %></p>
        <p><%= t('leaderboard.how.level') %></p>
      </div>
    </div>
  </div>
</section>

<section class="band band-paper-dark arena" aria-labelledby="arena-title">
  <div class="wrap">
    <div class="band-head">
      <h2 id="arena-title"><%= t('home.arena.title') %></h2>
      <a class="under-link" href="<%= nav.leaderboard %>#how-title"><%= t('home.arena.how') %> <span aria-hidden="true">↗</span></a>
    </div>
    <p class="arena-lead"><%= t('home.arena.lead') %></p>
    <ol class="arena-list">
      <li><p class="arena-tag">01 · <%= t('home.arena.hotZone.tag') %></p><h3><%= t('home.arena.hotZone.title') %></h3><p><%= t('home.arena.hotZone.text', { minutes: arena.hotZone.activeMinutes, king: arena.hotZone.kingMinKills }) %></p><strong class="arena-value">×<%= arena.hotZone.multiplier %> XP</strong></li>
      <li><p class="arena-tag">02 · <%= t('home.arena.mostWanted.tag') %></p><h3><%= t('home.arena.mostWanted.title') %></h3><p><%= t('home.arena.mostWanted.text', { min: arena.mostWanted.minKills }) %></p><strong class="arena-value">+<%= arena.mostWanted.xp %> XP</strong></li>
      <li><p class="arena-tag">03 · <%= t('home.arena.duel.tag') %></p><h3><%= t('home.arena.duel.title') %></h3><p><%= t('home.arena.duel.text', { target: arena.duel.target, minutes: arena.duel.minutes }) %></p><strong class="arena-value">+<%= arena.duel.winXp %> XP</strong></li>
    </ol>
  </div>
</section>

<section class="commands" aria-labelledby="commands-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= t('home.commands.eyebrow') %></p>
      <h2 id="commands-title"><%- lines('home.commands.title').map(escape).join('<br>') %></h2>
    </div>
    <ul class="ruled command-list" aria-label="<%= t('home.commands.label') %>">
      <% ['gun', 'rank', 'duel', 'report', 'lang'].forEach((id) => { %><li><code id="cmd-<%= id %>">!<%= id %></code><span><%= t('home.commands.' + id) %></span><button type="button" class="copy" data-copy-target="cmd-<%= id %>" data-copied="<%= t('home.join.copied') %>" data-failed="<%= t('home.join.copyFailed') %>" hidden><%= t('home.join.copy') %></button></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="vip-stripe" aria-labelledby="vip-title">
  <div class="wrap vip-stripe-inner">
    <div><p class="eyebrow"><%= t('home.vipStripe.eyebrow') %></p><h2 id="vip-title"><%= t('home.vipStripe.title') %></h2></div>
    <p><%= t('home.vipStripe.text') %></p>
    <a class="under-link" href="<%= nav.vip %>"><%= t('home.vipStripe.link') %> <span aria-hidden="true">↗</span></a>
  </div>
</section>

<section class="faq-band" aria-labelledby="faq-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow"><%= t('home.faqHead.eyebrow') %></p>
      <h2 id="faq-title"><%- lines('home.faqHead.title').map(escape).join('<br>') %></h2>
    </div>
    <div class="faq-list">
      <% faq.forEach((id, index) => { %><details name="faq"<% if (index === 0) { %> open<% } %>>
        <summary><h3><%= t('home.faq.' + id + '.q', faqParams) %></h3></summary>
        <p><%= t('home.faq.' + id + '.a', faqParams) %></p>
      </details>
      <% }) %>
    </div>
  </div>
</section>

<section class="last-call" aria-labelledby="cta-title">
  <div class="wrap last-call-inner">
    <div>
      <p class="eyebrow"><%= server.address %></p>
      <h2 id="cta-title"><%- lines('home.last.title').map(escape).join('<br>') %></h2>
      <p><%= t('home.cta.text') %></p>
    </div>
    <div class="last-actions">
      <a class="button button-light" href="<%= server.connectUrl %>"><%= t('home.hero.play') %> <span aria-hidden="true">↗</span></a>
      <% if (discordUrl) { %><a class="button button-ghost" href="<%= discordUrl %>" target="_blank" rel="noopener"><%= t('home.hero.discord') %></a><% } %>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
