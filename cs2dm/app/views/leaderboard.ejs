<%- include('partials/head') %>
<%- include('partials/page-hero', { title: t('leaderboard.h1'), lead: t('leaderboard.lead'), here: t('nav.leaderboard') }) %>
<div class="wrap page-content">
  <div class="content-grid">
    <section class="panel" aria-labelledby="board-title">
      <div class="panel-head">
        <p class="panel-title" id="board-title"><%= t.plural('leaderboard.total', result.total) %></p>
        <a class="under-link" href="<%= nav.matches %>"><%= t('leaderboard.matchesLink') %> <span aria-hidden="true">↗</span></a>
      </div>
      <form class="filters" method="get" action="<%= nav.leaderboard %>">
        <div class="field">
          <label for="f-season"><%= t('leaderboard.form.season') %></label>
          <select id="f-season" name="season">
            <% seasons.forEach((s) => { %><option value="<%= s.id %>"<% if (s.id === season.id) { %> selected<% } %>><%= seasonLabel(s) %><% if (s.id === currentSeasonId && s.id !== 0) { %> (<%= t('season.current') %>)<% } %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="f-sort"><%= t('leaderboard.form.sort') %></label>
          <select id="f-sort" name="sort">
            <% sorts.forEach((key) => { %><option value="<%= key %>"<% if (key === sort) { %> selected<% } %>><%= t('leaderboard.sort.' + key) %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="button button-dark button-small"><%= t('leaderboard.form.show') %></button>
      </form>
      <% if (sort === 'kd' || sort === 'hs') { %><p class="panel-note"><%= t('leaderboard.ratioNote', { min: minKills }) %></p><% } %>

      <% if (result.rows.length === 0) { %>
      <div class="empty-state">
        <h2><%= t('leaderboard.inviteTitle') %></h2>
        <p><%= t('leaderboard.empty') %></p>
        <a class="button button-small" href="<%= server.connectUrl %>"><%= t('home.hero.play') %> <span aria-hidden="true">↗</span></a>
      </div>
      <% } else { %>
      <%
        const columns = [
          { label: t('table.xp'), sortKey: 'xp', sorted: sort === 'xp', href: sortHref('xp'), value: (row) => fmt.int(row.xp) },
          { label: t('table.kills'), sortKey: 'kills', sorted: sort === 'kills', href: sortHref('kills'), value: (row) => fmt.int(row.kills) },
          { label: t('table.deaths'), sortKey: 'kills', optional: true, value: (row) => fmt.int(row.deaths) },
          { label: t('table.kd'), sortKey: 'kd', sorted: sort === 'kd', href: sortHref('kd'), value: (row) => fmt.kd(row.kills, row.deaths) },
          { label: t('table.hs'), sortKey: 'hs', sorted: sort === 'hs', href: sortHref('hs'), value: (row) => fmt.percent(row.headshots, row.kills) },
        ];
      %>
      <%- include('partials/leader-table', { rows: result.rows, columns, caption: t('table.caption', { season: seasonLabel(season), sort: t('leaderboard.sort.' + sort) }) }) %>
      <%- include('partials/pager', { page: result.page, pages: result.pages, href: pageHref }) %>
      <% } %>
    </section>
    <aside>
      <div class="card">
        <p class="eyebrow"><%= t('home.rank.eyebrow') %></p>
        <h2><%= t('home.top.inviteLink') %></h2>
        <p><%= t('home.rank.text') %></p>
        <a class="button button-small" href="<%= server.connectUrl %>"><%= t('home.hero.play') %> <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>

  <section class="card content-narrow spaced" aria-labelledby="how-title">
    <p class="eyebrow">XP</p>
    <h2 id="how-title"><%= t('leaderboard.how.title') %></h2>
    <p><%= t('leaderboard.how.lead') %></p>
    <div class="table-wrap">
      <table class="data-table xp-table">
        <thead><tr><th scope="col"><%= t('leaderboard.how.event') %></th><th scope="col" class="c-num"><%= t('leaderboard.how.xp') %></th></tr></thead>
        <tbody>
          <% xpRewards.forEach((reward) => { %><tr><th scope="row"><%= t('leaderboard.how.rewards.' + reward.id) %></th><td class="c-num">+<%= reward.xp %></td></tr>
          <% }) %><tr><th scope="row"><%= t('leaderboard.how.bountyRow') %></th><td class="c-num"><%= t('leaderboard.how.bountyValue') %></td></tr>
          <tr><th scope="row"><%= t('leaderboard.how.arena.hotZoneRow') %></th><td class="c-num">×<%= arena.hotZone.multiplier %></td></tr>
          <tr><th scope="row"><%= t('leaderboard.how.arena.mostWantedRow') %></th><td class="c-num">+<%= arena.mostWanted.xp %></td></tr>
          <tr><th scope="row"><%= t('leaderboard.how.arena.duelRow') %></th><td class="c-num">+<%= arena.duel.winXp %></td></tr>
          <tr><th scope="row"><%= t('leaderboard.how.arena.missionsRow') %></th><td class="c-num">+<%= arena.missions.xp.join(' / +') %></td></tr>
        </tbody>
      </table>
    </div>
    <div class="notice">
      <p><%= t('leaderboard.how.level') %></p>
      <p><%= t('leaderboard.how.bounty', { min: bounty.minStreak, cap: bounty.cap }) %></p>
      <p><%= t('leaderboard.how.revenge') %></p>
      <p><%= t('leaderboard.how.arena.hotZone', { multiplier: arena.hotZone.multiplier, minutes: arena.hotZone.activeMinutes, king: arena.hotZone.kingMinKills }) %></p>
      <p><%= t('leaderboard.how.arena.mostWanted', { min: arena.mostWanted.minKills, xp: arena.mostWanted.xp }) %></p>
      <p><%= t('leaderboard.how.arena.duel', { target: arena.duel.target, minutes: arena.duel.minutes, invite: arena.duel.inviteSeconds, cooldown: arena.duel.cooldownMinutes, xp: arena.duel.winXp }) %></p>
      <p><%= t('leaderboard.how.arena.missions', { tz: displayTz, easy: arena.missions.xp[0], medium: arena.missions.xp[1], hard: arena.missions.xp[2], days: arena.missions.streakDays, badge: t('player.honors.kinds.mission_streak') }) %></p>
    </div>
  </section>
</div>
<%- include('partials/foot') %>
