<%- include('partials/head') %>
<%# Липсващите фирмени данни идват от .env (COMPANY_*, CONTACT_EMAIL) — не се измислят в кода. %>
<%- include('partials/page-hero', { title: t('imprint.h1'), lead: t('imprint.lead'), here: t('nav.imprint') }) %>
<div class="wrap page-content">
  <section class="card content-narrow" aria-label="<%= t('imprint.h1') %>">
    <dl class="stat-list">
      <% company.forEach((field) => { %><div>
        <dt><%= t('imprint.fields.' + field.id) %></dt>
        <dd><% if (field.value) { %><% if (field.id === 'email') { %><a href="mailto:<%= field.value %>"><%= field.value %></a><% } else { %><%= field.value %><% } %><% } else { %><span class="unset"><%= t('imprint.notSet', { env: field.env }) %></span><% } %></dd>
      </div>
      <% }) %><div>
        <dt><%= t('imprint.fields.web') %></dt>
        <dd><a href="https://carbonstealth.eu" target="_blank" rel="noopener">carbonstealth.eu</a></dd>
      </div>
    </dl>
    <p><%= t('imprint.responsible') %></p>
    <p><%= t('imprint.trademark') %></p>
    <p class="links-row"><a href="<%= nav.privacy %>"><%= t('nav.privacy') %></a> <a href="<%= nav.contact %>"><%= t('nav.contact') %></a></p>
  </section>
</div>
<%- include('partials/foot') %>
