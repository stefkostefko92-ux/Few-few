<%# Полетата на събитие (създаване и редакция). values = текущото събитие или стойности по подразбиране. %>
<div class="a-field">
  <label for="<%= prefix %>-kind"><%= t('admin.events.kind') %></label>
  <select id="<%= prefix %>-kind" name="kind">
    <% kinds.forEach((kind) => { %><option value="<%= kind %>"<% if (kind === values.kind) { %> selected<% } %>><%= t('admin.events.kinds.' + kind) %></option>
    <% }) %>
  </select>
</div>
<% ['Bg', 'En', 'It'].forEach((lang) => { %>
<div class="a-field is-wide">
  <label for="<%= prefix %>-title<%= lang %>"><%= t('admin.events.title' + lang) %></label>
  <input id="<%= prefix %>-title<%= lang %>" name="title<%= lang %>" type="text" maxlength="<%= titleMax %>" required autocomplete="off" lang="<%= lang.toLowerCase() %>" value="<%= values['title' + lang] || '' %>">
</div>
<% }) %>
<div class="a-field">
  <label for="<%= prefix %>-starts"><%= t('admin.events.startsAt') %></label>
  <input id="<%= prefix %>-starts" name="startsAt" type="datetime-local" required value="<%= values.startsInput %>">
</div>
<div class="a-field">
  <label for="<%= prefix %>-ends"><%= t('admin.events.endsAt') %></label>
  <input id="<%= prefix %>-ends" name="endsAt" type="datetime-local" required value="<%= values.endsInput %>">
</div>
<div class="a-field">
  <label for="<%= prefix %>-xp"><%= t('admin.events.multiplier') %></label>
  <input id="<%= prefix %>-xp" name="xpMultiplier" type="number" min="1" max="3" step="0.1" required value="<%= values.multiplier || '1.0' %>">
</div>
<div class="a-field">
  <label for="<%= prefix %>-mode"><%= t('admin.events.mode') %></label>
  <select id="<%= prefix %>-mode" name="dmModeId">
    <option value=""><%= t('admin.events.noMode') %></option>
    <% modes.forEach((mode) => { %><option value="<%= mode.id %>"<% if (mode.id === values.dmModeId) { %> selected<% } %>><%= mode.name %></option>
    <% }) %>
  </select>
</div>
