<%- include('partials/head') %>
<%# Чернова на правен текст: обща информация, не правен съвет — преглед от юрист преди пускане. %>
<div class="wrap page prose-page">
  <%- include('partials/crumbs', { here: t('nav.privacy') }) %>
  <header class="page-head">
    <h1><%= t('privacy.h1') %></h1>
    <p class="page-lead"><%= t('privacy.lead') %></p>
    <p class="updated"><%= t('common.updated', { date: fmt.date(new Date(updated + 'T12:00:00Z')) }) %></p>
  </header>
  <% sections.forEach((id) => { %>
  <% if (id === 'recipients' || id === 'steam') { %><!-- ПОТВЪРДИ: държава на хостинга --><% } %>
  <% if (id === 'retention') { %><!-- ПОТВЪРДИ: срок за счетоводните документи по ЗСч (счетоводител) --><% } %>
  <%- include('partials/section', { prefix: 'privacy.sections', id, params }) %>
  <% }) %>
  <p class="links-row"><a href="<%= nav.imprint %>"><%= t('nav.imprint') %></a> <a href="<%= nav.contact %>"><%= t('nav.contact') %></a></p>
</div>
<%- include('partials/foot') %>
