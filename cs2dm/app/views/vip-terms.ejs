<%- include('partials/head') %>
<%# Чернова на правен текст: обща информация, не правен съвет — преглед от юрист преди пускане. %>
<%- include('partials/page-hero', { title: t('vipTerms.h1'), lead: t('vipTerms.lead'), here: t('nav.vipTerms') }) %>
<div class="wrap page-content">
  <article class="legal-content">
    <p class="legal-date"><%= t('common.updated', { date: fmt.date(new Date(updated + 'T12:00:00Z')) }) %> · <%= t('vipTerms.version', { version }) %></p>
    <% sections.forEach((id) => { %>
    <%- include('partials/section', { prefix: 'vipTerms.sections', id, params }) %>
    <% }) %>
    <p class="links-row"><a href="<%= nav.vip %>"><%= t('nav.vip') %></a> <a href="<%= nav.imprint %>"><%= t('nav.imprint') %></a> <a href="<%= nav.contact %>"><%= t('nav.contact') %></a></p>
  </article>
</div>
<%- include('partials/foot') %>
