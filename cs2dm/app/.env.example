# cs2dm/app — примерни променливи. Реалните живеят САМО на сървъра (mode 600), никога в репото.
#
# ЕДИН файл, ДВА режима. `docker-compose.yml` чете този `.env` за интерполация и сам сглобява
# DATABASE_URL/REDIS_URL към услугите в мрежата на Compose — затова в продукция редовете от
# раздел „локална разработка“ НЕ важат. При `npm run dev` е обратното: важат точно те.

# ── Общо за двата режима ─────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://cs2.carbonstealth.eu
# Адресът за „Влез в сървъра“ (steam://connect/…) и командата за конзолата: хост:порт
SERVER_ADDRESS=dm.carbonstealth.eu:27015
# Часовата зона за показ на дати (базата пази UTC)
DISPLAY_TZ=Europe/Sofia

# Контакт (страниците „Контакт“, „Импресум“ и правните текстове). Празно → сайтът показва
# ясно маркирано „не е въведено“, вместо измислен адрес.
CONTACT_EMAIL=
# По избор: покана за Discord сървъра (само https://)
DISCORD_URL=

# Импресум — фирмените данни на Carbon Stealth VCC. Попълват се от собственика; празното се
# показва като „не е въведено (ИМЕ_НА_ПРОМЕНЛИВАТА)“.
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_EIK=
COMPANY_VAT=
COMPANY_REPRESENTATIVE=
COMPANY_PHONE=

# ── Само за продукция (docker compose) ───────────────────────────────────────
# Паролата на PostgreSQL: openssl rand -hex 32 (само hex — влиза некодирана в DATABASE_URL).
# Същата парола ползва и C# плъгинът на хоста (127.0.0.1:PG_PORT).
POSTGRES_PASSWORD=
# Паролата на Redis (requirepass): openssl rand -hex 32. Същата и в cs2.env на плъгина.
REDIS_PASSWORD=
# Портовете на хоста — всичките вързани САМО за 127.0.0.1.
HTTP_PORT=4350
PG_PORT=5442
REDIS_PORT=6392

# ── Само за локална разработка (npm run dev, без Compose) ────────────────────
NODE_ENV=development
PORT=4330
DATABASE_URL=postgresql://cs2dm:CHANGE_ME@127.0.0.1:5432/cs2dm
REDIS_URL=redis://127.0.0.1:6379/0
