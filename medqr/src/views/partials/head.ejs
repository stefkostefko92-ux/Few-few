<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'bg' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : t('og.image_alt') %></title>
  <meta name="description" content="<%= meta.description %>">
  <meta name="robots" content="<%= meta.robots %>">
  <meta name="googlebot" content="<%= meta.robots %>, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="author" content="<%= company.name %>">
  <meta name="publisher" content="<%= company.name %>">
  <meta name="rating" content="general">
  <link rel="canonical" href="<%= meta.canonical %>">
  <!-- Двуезичие (BG/EN): реципрочни, само-референтни hreflang алтернативи -->
  <link rel="alternate" hreflang="bg" href="<%= meta.urlClean %>">
  <link rel="alternate" hreflang="en" href="<%= meta.urlEn %>">
  <link rel="alternate" hreflang="x-default" href="<%= meta.urlClean %>">

  <!-- GEO: държава/регион на услугата -->
  <meta name="geo.region" content="<%= geo.region %>">
  <meta name="geo.placename" content="<%= lang === 'en' ? 'Bulgaria' : geo.placename %>">
  <meta name="geo.position" content="<%= geo.position %>">
  <meta name="ICBM" content="<%= geo.icbm %>">

  <!-- Open Graph -->
  <meta property="og:type" content="<%= meta.ogType %>">
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'bg_BG' %>">
  <meta property="og:locale:alternate" content="<%= lang === 'en' ? 'bg_BG' : 'en_US' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : site.name %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.canonical %>">
  <meta property="og:image" content="<%= meta.ogImage %>">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="698">
  <meta property="og:image:alt" content="<%= t('og.image_alt') %>">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : site.name %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <meta name="twitter:image" content="<%= meta.ogImage %>">
  <meta name="twitter:image:alt" content="<%= t('og.image_alt') %>">

  <meta name="theme-color" content="#eef1f5">
  <link rel="icon" href="/icon-192.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <link rel="preload" href="/fonts/inter-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>

  <script type="application/ld+json" nonce="<%= cspNonce %>">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= site.base %>/#organization",
        "name": "<%= company.name %>",
        "url": "<%= company.url %>",
        "logo": { "@type": "ImageObject", "url": "<%= site.base %>/icon-512.png" },
        "brand": { "@type": "Brand", "name": "MedQR" },
        "areaServed": { "@type": "Country", "name": "Bulgaria" },
        "vatID": "<%= company.vat %>",
        "taxID": "<%= company.uic %>",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "ul. Samuil 3",
          "addressLocality": "Bobov Dol",
          "postalCode": "2670",
          "addressCountry": "BG"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "<%= company.email %>",
          "telephone": "<%= company.phone %>",
          "availableLanguage": ["bg", "en"]
        },
        "knowsAbout": [
          "emergency medical information",
          "QR and NFC medical profiles",
          "accessibility for deaf and hard-of-hearing people"
        ],
        "sameAs": ["<%= company.url %>"]
      },
      {
        "@type": "WebSite",
        "@id": "<%= site.base %>/#website",
        "url": "<%= site.base %>/",
        "name": "MedQR",
        "description": "<%= meta.description %>",
        "inLanguage": "<%= lang %>",
        "publisher": { "@id": "<%= site.base %>/#organization" }
      }<% if (typeof medicalPage !== 'undefined' && medicalPage) { %>,
      {
        "@type": "MedicalWebPage",
        "@id": "<%= meta.canonical %>#webpage",
        "url": "<%= meta.canonical %>",
        "name": "<%= typeof title !== 'undefined' ? title : site.name %>",
        "inLanguage": "<%= lang %>",
        "about": { "@type": "MedicalCondition", "name": "Emergency medical information" },
        "audience": { "@type": "MedicalAudience", "audienceType": "Patient" },
        "lastReviewed": "<%= updated %>",
        "reviewedBy": { "@id": "<%= site.base %>/#organization" },
        "isPartOf": { "@id": "<%= site.base %>/#website" }
      }<% } %>
    ]
  }
  </script>
</head>
<body>
  <%- include('icons') %>
  <a class="skip-link" href="#main"><%= t('common.skip') %></a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="MedQR — начало">
      <img class="brand-logo" src="/logo.jpg"
           srcset="/logo-sm.jpg 640w, /logo.jpg 1280w" sizes="220px"
           width="1280" height="698" alt="MedQR — Спешен медицински профил">
    </a>
    <nav>
      <span class="lang-switch" aria-label="<%= t('lang.switch') %>">
        <a href="?lang=bg" class="<%= lang === 'bg' ? 'is-active' : '' %>" hreflang="bg"><%= t('lang.bg') %></a>
        <a href="?lang=en" class="<%= lang === 'en' ? 'is-active' : '' %>" hreflang="en"><%= t('lang.en') %></a>
      </span>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard"><%= t('nav.profile') %></a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="link-btn"><%= t('nav.logout') %></button>
        </form>
      <% } else { %>
        <a href="/login"><%= t('nav.login') %></a>
        <a href="/register" class="btn-small btn"><%= t('nav.register') %></a>
      <% } %>
    </nav>
  </header>
  <main id="main" class="container">
