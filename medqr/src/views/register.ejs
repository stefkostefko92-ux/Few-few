<%- include('partials/head', { title: 'Регистрация — MedQR', user: null }) %>

<section class="form-wrap">
  <h1>Регистрация</h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/register" class="stack">
    <label>Пълно име
      <input type="text" name="full_name" required autocomplete="name">
    </label>
    <label>Имейл
      <input type="email" name="email" value="<%= email %>" required autocomplete="email">
    </label>
    <label>Парола (минимум 8 символа)
      <input type="password" name="password" required minlength="8" autocomplete="new-password">
    </label>
    <button type="submit" class="btn">Създай профил</button>
  </form>
  <p>Вече имате профил? <a href="/login">Вход</a></p>
</section>

<%- include('partials/foot') %>
