# Копирайте в .env и попълнете за продукция.
PORT=3000

# В продукция задължително 'production' — включва HTTPS пренасочване, Secure бисквитки,
# HSTS и изисква ENCRYPTION_KEY.
NODE_ENV=production

# Публичен адрес, който се кодира в QR кода. В продукция ЗАДЪЛЖИТЕЛНО HTTPS.
PUBLIC_BASE_URL=https://example.com

# Ключ за криптиране на медицинските данни в покой (AES-256-GCM).
# 32 байта като 64 hex символа. Генерирайте с:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ПАЗЕТЕ ГО ТАЙНО и извън базата данни. Загубата му прави данните невъзстановими.
ENCRYPTION_KEY=

# Път до SQLite файла (по подразбиране data/medqr.sqlite).
# DB_PATH=/var/lib/medqr/medqr.sqlite
