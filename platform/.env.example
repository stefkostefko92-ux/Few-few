# --- База данни (PostgreSQL) ---
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"
POSTGRES_USER="platform"
POSTGRES_PASSWORD=""
POSTGRES_DB="platform"

# --- Публичен адрес на панела (без наклонена черта в края) ---
NEXT_PUBLIC_SITE_URL="https://platform.carbonstealth.eu"

# --- Сигурност на сесиите ---
# Задължително поне 32 знака. Генерирай напр.: openssl rand -base64 48
# (примерната стойност по-долу се отхвърля от приложението — сменете я.)
AUTH_SECRET="ПРОМЕНИ_МЕ_дълъг_случаен_низ_поне_32_знака"

# --- Криптиране на API ключовете на сайтовете (AES-256-GCM) ---
# 32 байта в hex (64 шестнайсетични знака). Генерирай:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Извън продукция се ползва dev ключ с предупреждение. Никога не комитвай реален ключ.
ENCRYPTION_KEY=""

# --- Първоначален собственик (използва се само при db:seed) ---
# Сийдът отказва създаване със слаба/примерна парола (мин. 10 знака).
OWNER_EMAIL="owner@carbonstealth.eu"
OWNER_PASSWORD="СМЕНИ_МЕ_силна_парола_мин_10"
OWNER_NAME="Собственик"

# --- Таен токен за график (cron) на здравните проверки ---
# Подавай го през заглавие Authorization: Bearer, не в URL-а (за да не влиза в логовете):
#   curl -X POST -H "Authorization: Bearer ТАЙНА" https://platform.carbonstealth.eu/api/cron/health
CRON_TOKEN=""
