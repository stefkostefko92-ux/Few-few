# Пуска здравната проверка на всеки 5 минути (мониторинг на свързаните сайтове).
# Смени OnCalendar според нуждата (напр. *:0/15 за на 15 мин).
[Unit]
Description=platform — таймер за здравна проверка

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=30
Unit=platform-cron-health.service

[Install]
WantedBy=timers.target
