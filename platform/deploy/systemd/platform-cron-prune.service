# Изчистване по давност на логове/заявки (POST /api/cron/prune) — GDPR чл. 5(1)(e).
# Задържането се управлява от *_RETENTION_DAYS в platform/.env (не тук).
# Инсталация — виж коментара в platform-cron-health.service (същият EnvironmentFile).
[Unit]
Description=platform — изчистване по давност (cron)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/platform/cron.env
ExecStart=/usr/bin/curl -fsS --max-time 120 -X POST \
  -H "Authorization: Bearer ${CRON_TOKEN}" \
  ${BASE_URL}/api/cron/prune

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
