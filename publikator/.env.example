# Публикатор — примерни променливи. Реалните живеят САМО на сървъра (mode 600).
NODE_ENV=production
PORT=4310
PUBLIC_BASE_URL=https://publikator.carbonstealth.eu
# Express trust proxy — зад Nginx на същата машина е loopback
TRUST_PROXY=loopback

# PostgreSQL (Prisma) и Redis (BullMQ + nonce склад за агентските подписи)
DATABASE_URL=postgresql://publikator:CHANGE_ME@127.0.0.1:5432/publikator
REDIS_URL=redis://127.0.0.1:6379/3

# Instagram Platform API (Instagram Login) — Meta App → Instagram → API setup
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://publikator.carbonstealth.eu/auth/instagram/callback
IG_GRAPH_VERSION=v24.0
IG_SCOPES=instagram_business_basic,instagram_business_content_publish

# 32 байта в hex (64 знака): openssl rand -hex 32 — криптира IG токени, TOTP тайни и агентски ключове в покой
TOKEN_ENC_KEY=

# Име на издателя в приложението за еднократни кодове
TOTP_ISSUER=Публикатор

# По избор — без него генерирането на чернови е изключено, публикуването и панелът работят
ANTHROPIC_API_KEY=

# Само за `npm run owner:create` (еднократно, от шела на сървъра — не ги оставяй във файла):
# OWNER_EMAIL=admin@carbonstealth.eu  OWNER_NAME="Собственик"  OWNER_PASSWORD='…по фирмения шаблон…'
