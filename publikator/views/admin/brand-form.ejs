<%- include('../partials/shell-start', { active: 'brands' }) %>
<div class="topbar">
  <div>
    <h1><%= title %></h1>
    <p class="sub">Каквото е тук, влиза в промпта на всяка чернова — и на автопилота, и на ръчното генериране.</p>
  </div>
  <a class="btn ghost" href="/admin/brands"><%- icon('brands') %> Всички брандове</a>
</div>
<% if (errors.length) { %><div class="flash error"><%- icon('status-failed') %><span><%= errors.join(' · ') %></span></div><% } %>

<form method="post" action="<%= brand && brand.id ? '/admin/brands/' + brand.id : '/admin/brands' %>" class="stack">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="panel">
    <h2><%- icon('brands') %> Кой е брандът</h2>
    <div class="stack">
      <label>Име<input name="name" required minlength="2" value="<%= brand ? brand.name : '' %>"></label>
      <div class="grid2">
        <label>Slug <span class="hint">малки латински букви, цифри, тире</span><input name="slug" required pattern="[a-z0-9-]{2,40}" value="<%= brand ? brand.slug : '' %>"></label>
        <label>Език <span class="hint">по BCP-47, напр. bg</span><input name="language" required value="<%= brand ? brand.language : 'bg' %>"></label>
      </div>
      <label>Сайт<input type="url" name="websiteUrl" value="<%= brand && brand.websiteUrl ? brand.websiteUrl : '' %>"></label>
      <label>Какво е продуктът <span class="hint">влиза в промпта</span><textarea name="summary" required minlength="10" rows="3"><%= brand ? brand.summary : '' %></textarea></label>
      <label>Тон на глас, забрани, задължителни формулировки<textarea name="voice" required minlength="5" rows="3"><%= brand ? brand.voice : '' %></textarea></label>
    </div>
  </section>

  <% const v = (k) => (plan && typeof plan[k] === 'string' ? plan[k] : ''); %>
  <% const cross = Array.isArray(plan && plan.crossPost) ? plan.crossPost : (plan && plan.crossPost ? [plan.crossPost] : []); %>

  <section class="panel">
    <h2><%- icon('autopilot') %> Управление на страницата</h2>
    <p class="sub mb-2">Включиш ли го, автопилотът всяка седмица допълва черновите до плана — от реални материали, с данните от Insights. Публикува само човек, след одобрение.</p>
    <div class="stack">
      <label class="check"><input type="checkbox" name="managed" <%= managed ? 'checked' : '' %>> <span>Под управление на агента (автопилот)</span></label>
      <div class="grid2">
        <label>Публикации на седмица <span class="hint">1–14</span><input type="number" name="postsPerWeek" min="1" max="14" value="<%= v('postsPerWeek') || '3' %>"></label>
        <label>Дял Reels <span class="hint">0–1</span><input type="number" name="reelsShare" min="0" max="1" step="0.1" value="<%= v('reelsShare') || '0.5' %>"></label>
      </div>
      <label>Тематични стълбове <span class="hint">по един на ред, 1–8; автопилотът ги редува</span><textarea name="pillars" rows="4" placeholder="Зад кулисите&#10;Съвет на седмицата&#10;Истории на клиенти"><%= v('pillars') %></textarea></label>
      <label>Часове за публикуване <span class="hint">HH:MM, със запетая</span><input name="postingTimes" value="<%= v('postingTimes') || '08:30, 20:00' %>"></label>
      <label>Цели <span class="hint">влизат в промпта</span><textarea name="goals" rows="2" maxlength="1000"><%= v('goals') %></textarea></label>
    </div>
  </section>

  <section class="panel">
    <h2><%- icon('search') %> Откриваемост и глас</h2>
    <div class="stack">
      <label>Ключови думи <span class="hint">със запетая, до 20; вплитат се в caption-а, не само в хаштаговете</span><input name="keywords" value="<%= v('keywords') %>"></label>
      <label>Хаштаг набори <span class="hint">по един набор на ред</span><textarea name="hashtagSets" rows="3" placeholder="#kangoojumps #дупница #фитнес&#10;#силовитренировки #женскистудио"><%= v('hashtagSets') %></textarea></label>
      <label>Призив за действие<input name="cta" maxlength="200" value="<%= v('cta') %>"></label>
      <label>Забранено <span class="hint">теми и формулировки, които никога не се пишат</span><textarea name="avoid" rows="2" maxlength="1000"><%= v('avoid') %></textarea></label>
      <fieldset>
        <legend>Варианти за други платформи</legend>
        <% ['facebook', 'tiktok', 'linkedin', 'x'].forEach((pl) => { %><label class="check"><input type="checkbox" name="crossPost" value="<%= pl %>" <%= cross.includes(pl) ? 'checked' : '' %>> <span><%= pl %></span></label><% }) %>
      </fieldset>
    </div>
  </section>

  <section class="panel">
    <h2><%- icon('image') %> Медийна библиотека</h2>
    <p class="sub mb-2">По един материал на ред: <span class="mono">URL | описание</span>, а за видео <span class="mono">REELS URL | описание | cover URL</span>. Автопилотът не измисля снимки — без материал няма чернова, а материалите се редуват (най-отдавна ползваният е пръв).</p>
    <label class="mono"><textarea name="assets" rows="7" class="mono" placeholder="https://cdn.example.com/trening-01.jpg | Група жени на Kangoo Jumps тренировка в студиото&#10;REELS https://cdn.example.com/skok.mp4 | 15 секунди скокове в забавен кадър | https://cdn.example.com/skok.jpg"><%= v('assets') %></textarea></label>
  </section>

  <div class="row"><button class="btn primary" type="submit"><%- icon('approve') %> Запази</button><a class="btn ghost" href="/admin/brands">Отказ</a></div>
</form>
<%- include('../partials/shell-end') %>
