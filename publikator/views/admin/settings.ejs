<%- include('../partials/shell-start', { active: 'settings' }) %>
<div class="topbar">
  <div>
    <h1>Настройки</h1>
    <p class="sub">Само факти без тайни — стойностите живеят на сървъра. Промяна значи нов деплой с нова среда.</p>
  </div>
</div>
<div class="grid2">
  <section class="panel"><h2><%- icon('instagram') %> Instagram Platform API</h2>
    <table><tbody>
      <tr><td class="muted">Версия на Graph API</td><td class="mono"><%= settings.graphVersion %></td></tr>
      <tr><td class="muted">Разрешения</td><td class="mono"><%= settings.scopes.join(' ') %></td></tr>
      <tr><td class="muted">Redirect URI</td><td class="mono"><%= settings.redirectUri %></td></tr>
      <tr><td class="muted">Meta App ID</td><td><% if (settings.appIdSet) { %><span class="chip good"><%- icon('status-approved', { class: 'ic-sm' }) %> зададен</span><% } else { %><span class="chip critical"><%- icon('severity-high', { class: 'ic-sm' }) %> липсва</span><% } %></td></tr>
    </tbody></table>
  </section>
  <section class="panel"><h2><%- icon('system') %> Система</h2>
    <table><tbody>
      <tr><td class="muted">Среда</td><td class="mono"><%= settings.environment %></td></tr>
      <tr><td class="muted">Публичен адрес</td><td class="mono"><%= settings.publicBaseUrl %></td></tr>
      <tr><td class="muted">Trust proxy</td><td class="mono"><%= settings.trustProxy %></td></tr>
      <tr><td class="muted">Генериране с модел</td><td><% if (settings.anthropicSet) { %><span class="chip good"><%- icon('sparkle', { class: 'ic-sm' }) %> включено</span><% } else { %><span class="chip"><%- icon('close', { class: 'ic-sm' }) %> изключено</span><% } %></td></tr>
      <tr><td class="muted">TOTP издател</td><td><%= settings.totpIssuer %></td></tr>
      <tr><td class="muted">Активни потребители</td><td class="num"><%= ui.num(stats.users) %></td></tr>
      <tr><td class="muted">Активни агентски ключове</td><td class="num"><%= ui.num(stats.keys) %></td></tr>
      <tr><td class="muted">Живи сесии</td><td class="num"><%= ui.num(stats.sessions) %></td></tr>
    </tbody></table>
  </section>
</div>
<%- include('../partials/shell-end') %>
