<%- include('../partials/shell-start', { active: 'posts' }) %>
<div class="topbar">
  <div class="title"><h1>Постове</h1><span class="chip"><%= ui.num(total) %></span></div>
  <% if (can('posts:create')) { %><a class="btn primary" href="/admin/posts/new"><%- icon('compose') %> Нова чернова</a><% } %>
</div>
<form method="get" action="/admin/posts" class="filters">
  <label>Състояние<select name="status"><option value="">всички</option><% statuses.forEach((s) => { %><option value="<%= s %>" <%= s === status ? 'selected' : '' %>><%= ui.postStatus(s).label %></option><% }) %></select></label>
  <label>Бранд<select name="brand"><option value="">всички</option><% brands.forEach((b) => { %><option value="<%= b.slug %>" <%= b.slug === brandSlug ? 'selected' : '' %>><%= b.name %></option><% }) %></select></label>
  <button class="btn" type="submit"><%- icon('filter') %> Филтрирай</button>
  <% if (status || brandSlug) { %><a class="btn ghost" href="/admin/posts"><%- icon('close') %> Изчисти</a><% } %>
</form>
<div class="table-wrap">
<table><thead><tr><th>Състояние</th><th>Бранд / акаунт</th><th>Вид</th><th>Публикация</th><th>Създал</th><th>Кога</th></tr></thead><tbody>
<% posts.forEach((p) => { %>
  <% const st = ui.postStatus(p.status); const kd = ui.kind(p.kind); const who = ui.creator(p); %>
  <tr>
    <td><span class="chip <%= st.tone %>"><%- icon(st.icon, { class: 'ic-sm' }) %> <%= st.label %></span></td>
    <td><%= p.brand.name %><span class="sub-line">@<%= p.account ? p.account.username : '—' %></span></td>
    <td><span class="chip"><%- icon(kd.icon, { class: 'ic-sm' }) %> <%= kd.label %></span><% if (p.aiAssisted) { %> <span class="chip accent"><%- icon('sparkle', { class: 'ic-sm' }) %> AI</span><% } %></td>
    <td><a href="/admin/posts/<%= p.id %>"><%= p.caption.slice(0, 70) %><%= p.caption.length > 70 ? '…' : '' %></a><% if (p.status === 'SCHEDULED' && p.scheduledAt) { %><span class="sub-line">за <%= ui.dateTime(p.scheduledAt) %></span><% } %></td>
    <td><span class="chip <%= who.tone %>"><%- icon(who.icon, { class: 'ic-sm' }) %> <%= who.label %></span></td>
    <td class="muted when"><%= ui.relative(p.createdAt) %></td>
  </tr>
<% }) %>
<% if (!posts.length) { %><tr><td colspan="6"><div class="empty"><%- icon('empty', { class: 'ic-xl' }) %><strong>Няма постове по този филтър</strong>Свали филтъра или направи нова чернова.</div></td></tr><% } %>
</tbody></table>
</div>
<% if (pages > 1) { %><div class="pager"><span class="muted">Страница</span><% for (let i = 1; i <= pages; i += 1) { %><a class="btn small <%= i === page ? 'primary' : 'ghost' %>" href="/admin/posts?status=<%= status %>&brand=<%= brandSlug %>&page=<%= i %>"><%= i %></a><% } %></div><% } %>
<%- include('../partials/shell-end') %>
