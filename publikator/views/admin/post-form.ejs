<%- include('../partials/shell-start', { active: 'new' }) %>
<div class="topbar">
  <div>
    <h1>Нова чернова</h1>
    <p class="sub">И двата пътя дават <strong>чернова</strong> — публикува се само след одобрение от човек.</p>
  </div>
  <a class="btn ghost" href="/admin/posts"><%- icon('posts') %> Всички постове</a>
</div>
<div class="grid2">
  <section class="panel">
    <h2><%- icon('edit') %> Ръчна чернова</h2>
    <form method="post" action="/admin/posts" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Бранд<select name="brandId" required><option value="">— избери —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></label>
      <label>Instagram акаунт<select name="accountId"><option value="">— по-късно —</option><% accounts.forEach((a) => { %><option value="<%= a.id %>">@<%= a.username %></option><% }) %></select></label>
      <label>Вид<select name="kind"><option value="IMAGE">Снимка</option><option value="REELS">Reel (видео)</option></select></label>
      <label>URL на медията <span class="hint">публичен HTTPS адрес</span><input type="url" name="mediaUrl" required pattern="https://.*"></label>
      <label>Cover URL <span class="hint">само за Reel</span><input type="url" name="coverUrl" pattern="https://.*"></label>
      <label>Тема / контекст за ревюъра<input name="topic" maxlength="500"></label>
      <label>Caption <span class="hint">кукичката е на първи ред</span><textarea name="caption" required maxlength="2200" rows="7"></textarea></label>
      <label>Хаштагове <span class="hint">с интервал или запетая</span><input name="hashtags" placeholder="#дупница #kangoojumps"></label>
      <label>Alt текст <span class="hint">какво реално се вижда</span><input name="altText" required></label>
      <button class="btn primary" type="submit"><%- icon('approve') %> Запази черновата</button>
    </form>
  </section>
  <section class="panel">
    <h2><%- icon('sparkle') %> Чернови от модел</h2>
    <% if (!generation) { %>
      <div class="empty"><%- icon('severity-high', { class: 'ic-xl' }) %><strong>Изключено</strong>На сървъра няма ANTHROPIC_API_KEY.</div>
    <% } else if (!can('posts:generate')) { %>
      <div class="empty"><%- icon('shield', { class: 'ic-xl' }) %><strong>Няма достъп</strong>Ролята ти не позволява генериране.</div>
    <% } else { %>
    <form method="post" action="/admin/posts/generate" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Бранд<select name="brandId" required><option value="">— избери —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></label>
      <label>Instagram акаунт<select name="accountId"><option value="">— по-късно —</option><% accounts.forEach((a) => { %><option value="<%= a.id %>">@<%= a.username %></option><% }) %></select></label>
      <label>Вид<select name="kind"><option value="IMAGE">Снимка</option><option value="REELS">Reel</option></select></label>
      <label>Тема<input name="topic" required minlength="3" maxlength="500"></label>
      <label>Материалът показва <span class="hint">по избор, но помага</span><input name="mediaDescription" maxlength="1000"></label>
      <label>URL на медията <span class="hint">публичен HTTPS адрес</span><input type="url" name="mediaUrl" required pattern="https://.*"></label>
      <label>Cover URL <span class="hint">само за Reel</span><input type="url" name="coverUrl" pattern="https://.*"></label>
      <label>Брой варианти<select name="count"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></label>
      <button class="btn" type="submit"><%- icon('sparkle') %> Генерирай чернови</button>
      <p class="sub">Планът на бранда и реалните числа от Insights влизат в промпта автоматично.</p>
    </form>
    <% } %>
  </section>
</div>
<%- include('../partials/shell-end') %>
