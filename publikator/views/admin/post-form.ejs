<%- include('../partials/shell-start', { active: 'new' }) %>
<h1>Нова чернова</h1>
<div class="grid2">
  <section class="card">
    <h2>Ръчна чернова</h2>
    <form method="post" action="/admin/posts" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Бранд<select name="brandId" required><option value="">— избери —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></label>
      <label>Instagram акаунт<select name="accountId"><option value="">— по-късно —</option><% accounts.forEach((a) => { %><option value="<%= a.id %>">@<%= a.username %></option><% }) %></select></label>
      <label>Вид<select name="kind"><option value="IMAGE">Снимка</option><option value="REELS">Reel (видео)</option></select></label>
      <label>URL на медията (публичен HTTPS)<input type="url" name="mediaUrl" required pattern="https://.*"></label>
      <label>Cover URL (само за Reel)<input type="url" name="coverUrl" pattern="https://.*"></label>
      <label>Тема / контекст за ревюъра<input name="topic" maxlength="500"></label>
      <label>Caption (кукичката на първи ред)<textarea name="caption" required maxlength="2200"></textarea></label>
      <label>Хаштагове (с интервал или запетая)<input name="hashtags" placeholder="#дупница #kangoojumps"></label>
      <label>Alt текст (какво се вижда)<input name="altText" required></label>
      <button class="btn primary" type="submit">Запази черновата</button>
    </form>
  </section>
  <section class="card">
    <h2>Чернови от модел</h2>
    <% if (!generation) { %><p class="muted">Изключено — на сървъра няма ANTHROPIC_API_KEY.</p><% } else if (!can('posts:generate')) { %><p class="muted">Ролята ти не позволява генериране.</p><% } else { %>
    <form method="post" action="/admin/posts/generate" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Бранд<select name="brandId" required><option value="">— избери —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></label>
      <label>Instagram акаунт<select name="accountId"><option value="">— по-късно —</option><% accounts.forEach((a) => { %><option value="<%= a.id %>">@<%= a.username %></option><% }) %></select></label>
      <label>Вид<select name="kind"><option value="IMAGE">Снимка</option><option value="REELS">Reel</option></select></label>
      <label>Тема<input name="topic" required minlength="3" maxlength="500"></label>
      <label>Материалът показва (по избор)<input name="mediaDescription" maxlength="1000"></label>
      <label>URL на медията (публичен HTTPS)<input type="url" name="mediaUrl" required pattern="https://.*"></label>
      <label>Cover URL (само за Reel)<input type="url" name="coverUrl" pattern="https://.*"></label>
      <label>Брой варианти<select name="count"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></label>
      <button class="btn" type="submit">Генерирай чернови</button>
    </form>
    <p class="muted">Резултатът са чернови за преглед — нищо не се публикува без одобрение от човек.</p>
    <% } %>
  </section>
</div>
<%- include('../partials/shell-end') %>
