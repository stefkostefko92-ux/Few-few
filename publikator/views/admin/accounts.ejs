<%- include('../partials/shell-start', { active: 'accounts' }) %>
<h1>Instagram акаунти</h1>
<p class="muted">Акаунтите се създават <strong>ръчно</strong> в Instagram и се превключват на професионални (Business/Creator); тук само се свързват през официалния OAuth. Meta забранява автоматизирано създаване на акаунти.</p>
<% if (can('accounts:manage')) { %>
<section class="card" style="margin-bottom:18px">
  <h2>Свържи акаунт към бранд</h2>
  <form method="post" action="/admin/accounts/connect" class="row">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="brandId" required style="max-width:320px"><option value="">— бранд —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %> (<%= b.slug %>)</option><% }) %></select>
    <button class="btn primary" type="submit">Към Instagram →</button>
  </form>
  <p class="muted">Ще те прати към Instagram да одобриш достъпа; обратният адрес приема само подписан state от този вход.</p>
</section>
<% } %>
<table><thead><tr><th>Акаунт</th><th>Бранд</th><th>Статус</th><th>Токен до</th><th>Квота (24ч)</th><th>Постове</th><th>Действия</th></tr></thead><tbody>
<% accounts.forEach((a) => { %>
  <tr>
    <td>@<%= a.username %><div class="muted mono"><%= a.igUserId %></div></td>
    <td><%= a.brand.name %></td>
    <td><span class="badge <%= a.status %>"><%= a.status %></span></td>
    <td><%= a.status === 'DISABLED' ? '—' : a.tokenExpiresAt.toLocaleDateString('bg-BG') %></td>
    <td><%= a.quotaTotal ? a.quotaUsed + ' / ' + a.quotaTotal : '—' %><% if (a.quotaCheckedAt) { %><div class="muted"><%= a.quotaCheckedAt.toLocaleString('bg-BG') %></div><% } %></td>
    <td><a href="/admin/posts?brand=<%= a.brand.slug %>"><%= a._count.posts %></a></td>
    <td class="row">
      <% if (a.status === 'ACTIVE') { %>
        <form method="post" action="/admin/accounts/<%= a.id %>/quota" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Квота</button></form>
        <% if (can('accounts:manage')) { %>
        <form method="post" action="/admin/accounts/<%= a.id %>/refresh-token" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Поднови токена</button></form>
        <form method="post" action="/admin/accounts/<%= a.id %>/disconnect" class="inline" data-confirm="Токенът ще бъде унищожен. Продължаваш ли?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger" type="submit">Спри</button></form>
        <% } %>
      <% } else { %><span class="muted">нужен нов OAuth</span><% } %>
    </td>
  </tr>
<% }) %>
<% if (!accounts.length) { %><tr><td colspan="7" class="muted">Няма свързани акаунти.</td></tr><% } %>
</tbody></table>
<%- include('../partials/shell-end') %>
