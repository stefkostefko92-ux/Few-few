<%- include('../partials/shell-start', { active: 'accounts' }) %>
<div class="topbar">
  <div>
    <h1>Instagram акаунти</h1>
    <p class="sub">Акаунтите се създават <strong>ръчно</strong> и се превключват на професионални (Business/Creator) — тук само се свързват през официалния OAuth. Meta забранява автоматизирано създаване.</p>
  </div>
</div>

<% if (can('accounts:manage')) { %>
<section class="panel">
  <h2><%- icon('instagram') %> Свържи акаунт към бранд</h2>
  <form method="post" action="/admin/accounts/connect" class="row">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="brandId" required class="field-lg"><option value="">— бранд —</option><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %> (<%= b.slug %>)</option><% }) %></select>
    <button class="btn primary" type="submit"><%- icon('external') %> Към Instagram</button>
  </form>
  <p class="sub">Ще те прати към Instagram да одобриш достъпа; обратният адрес приема само подписан state от този вход.</p>
</section>
<% } %>

<div class="table-wrap">
<table><thead><tr><th>Акаунт</th><th>Бранд</th><th>Състояние</th><th>Токен до</th><th>Публикации за 24 часа</th><th class="num">Постове</th><th>Действия</th></tr></thead><tbody>
<% accounts.forEach((a) => { %>
  <% const st = ui.accountStatus(a.status); const tone = ui.quotaTone(a.quotaUsed, a.quotaTotal); %>
  <tr>
    <td><strong>@<%= a.username %></strong><span class="sub-line mono"><%= a.igUserId %></span></td>
    <td><%= a.brand.name %></td>
    <td><span class="chip <%= st.tone %>"><%- icon(st.icon, { class: 'ic-sm' }) %> <%= st.label %></span></td>
    <td><%= a.status === 'DISABLED' ? '—' : ui.date(a.tokenExpiresAt) %><% if (a.status === 'ACTIVE') { %><span class="sub-line"><%= ui.relative(a.tokenExpiresAt) %></span><% } %></td>
    <td>
      <% if (a.quotaTotal) { %>
      <div class="meter">
        <div class="meter-track"><div class="meter-fill <%= tone %> p-<%= Math.round(Math.min(100, (a.quotaUsed / a.quotaTotal) * 100) / 5) * 5 %>"></div></div>
        <div class="meter-label"><%= a.quotaUsed %> / <%= a.quotaTotal %><%= a.quotaCheckedAt ? ' · ' + ui.relative(a.quotaCheckedAt) : '' %></div>
      </div>
      <% } else { %><span class="muted">непроверена</span><% } %>
    </td>
    <td class="num"><a href="/admin/posts?brand=<%= a.brand.slug %>"><%= a._count.posts %></a></td>
    <td class="row">
      <% if (a.status === 'ACTIVE') { %>
        <form method="post" action="/admin/accounts/<%= a.id %>/quota" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit"><%- icon('quota', { class: 'ic-sm' }) %> Квота</button></form>
        <% if (can('accounts:manage')) { %>
        <form method="post" action="/admin/accounts/<%= a.id %>/refresh-token" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit"><%- icon('refresh', { class: 'ic-sm' }) %> Токен</button></form>
        <form method="post" action="/admin/accounts/<%= a.id %>/disconnect" class="inline" data-confirm="Токенът ще бъде унищожен. Продължаваш ли?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn danger small" type="submit"><%- icon('status-disabled', { class: 'ic-sm' }) %> Спри</button></form>
        <% } %>
      <% } else { %><span class="muted">нужен нов OAuth</span><% } %>
    </td>
  </tr>
<% }) %>
<% if (!accounts.length) { %><tr><td colspan="7"><div class="empty"><%- icon('instagram', { class: 'ic-xl' }) %><strong>Няма свързани акаунти</strong>Избери бранд по-горе и мини през OAuth на Instagram.</div></td></tr><% } %>
</tbody></table>
</div>
<%- include('../partials/shell-end') %>
