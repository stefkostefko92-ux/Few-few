<%- include('../partials/shell-start', { active: 'brands' }) %>
<div class="topbar">
  <div>
    <div class="title">
      <h1>Представяне · <%= brand.name %></h1>
      <% if (brand.managed) { %><span class="chip good"><%- icon('autopilot', { class: 'ic-sm' }) %> Автопилот</span><% } else { %><span class="chip"><%- icon('human', { class: 'ic-sm' }) %> Ръчно</span><% } %>
    </div>
    <p class="sub">Числата идват от Instagram Insights след публикуване през Публикатор.</p>
  </div>
  <div class="row">
    <a class="btn ghost" href="/admin/brands"><%- icon('brands') %> Брандове</a>
    <% if (can('brands:manage')) { %><a class="btn ghost" href="/admin/brands/<%= brand.id %>/edit"><%- icon('edit') %> Планът</a><% } %>
  </div>
</div>

<div class="cards">
  <div class="card">
    <div class="l"><%- icon('status-published', { class: 'ic-sm' }) %> тази седмица спрямо плана</div>
    <div class="n"><%= ui.num(weekAlive) %><small> / <%= plan ? plan.postsPerWeek : '—' %></small></div>
  </div>
  <a class="card" href="/admin/posts?status=DRAFT&brand=<%= brand.slug %>">
    <div class="l"><%- icon('status-draft', { class: 'ic-sm' }) %> чернови за преглед</div>
    <div class="n"><%= ui.num(pendingDrafts) %></div>
  </a>
  <div class="card">
    <div class="l"><%- icon('image', { class: 'ic-sm' }) %> материала в библиотеката</div>
    <div class="n"><%= ui.num(plan ? plan.assets.length : 0) %></div>
  </div>
  <div class="card">
    <div class="l"><%- icon('metric-engaged', { class: 'ic-sm' }) %> публикации с метрики</div>
    <div class="n"><%= ui.num(performance.length) %></div>
  </div>
</div>

<section class="panel">
  <h2><%- icon('autopilot') %> Автопилот</h2>
  <% if (!brand.managed) { %>
    <p class="sub">Брандът е на ръчен режим. Включи „Под управление на агента“ в плана, за да допълва черновите всяка седмица.</p>
  <% } else if (!plan) { %>
    <div class="flash error"><%- icon('status-failed') %><span>Планът е непълен — редактирай бранда и попълни поне един тематичен стълб.</span></div>
  <% } else { %>
    <div class="stat-row mb-2">
      <span><b><%= plan.postsPerWeek %></b> публикации/седмица</span>
      <span>Reels <b><%= Math.round(plan.reelsShare * 100) %>%</b></span>
      <span>часове <b><%= plan.postingTimes.join(', ') %></b></span>
      <span>цикъл <b><%= brand.lastAutopilotAt ? ui.relative(brand.lastAutopilotAt) : 'още не е пускан' %></b></span>
    </div>
    <p class="sub mb-1">Стълбове: <%= plan.pillars.join(' · ') %></p>
    <% if (plan.keywords.length) { %><p class="sub">Ключови думи: <%= plan.keywords.join(', ') %></p><% } %>
    <% if (plan.crossPost.length) { %><p class="sub">Варианти за: <%= plan.crossPost.join(', ') %></p><% } %>
    <p class="sub">Автоматично всеки понеделник в 06:00.</p>
    <% if (!plan.assets.length) { %><div class="flash error mt-2"><%- icon('image') %><span>Библиотеката с материали е празна — автопилотът няма от какво да прави чернови.</span></div><% } %>
    <% if (!generation) { %><div class="flash error mt-2"><%- icon('severity-high') %><span>Липсва ANTHROPIC_API_KEY на сървъра — автопилотът не може да пише.</span></div><% } %>
    <% if (can('autopilot:run')) { %>
    <form method="post" action="/admin/brands/<%= brand.id %>/autopilot" class="inline block mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn primary" type="submit" <%= plan.assets.length && generation ? '' : 'disabled' %>><%- icon('play') %> Пусни цикъл сега</button></form>
    <% } %>
  <% } %>
</section>

<h2><%- icon('metric-reach') %> Акаунти — последните 30 дни</h2>
<% if (!accounts.length) { %>
  <div class="panel"><div class="empty"><%- icon('instagram', { class: 'ic-xl' }) %><strong>Няма свързан акаунт</strong>Свържи акаунт към бранда, за да тръгнат метриките.</div></div>
<% } %>
<% accounts.forEach((a) => { %>
  <section class="panel">
    <div class="row spread mb-1">
      <div class="title">
        <h3 class="m-0">@<%= a.account.username %></h3>
        <% const ast = ui.accountStatus(a.account.status); %>
        <span class="chip <%= ast.tone %>"><%- icon(ast.icon, { class: 'ic-sm' }) %> <%= ast.label %></span>
      </div>
      <% if (can('autopilot:run')) { %><form method="post" action="/admin/insights/sync" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit"><%- icon('refresh', { class: 'ic-sm' }) %> Синхронизирай</button></form><% } %>
    </div>

    <% if (!a.insightsScope) { %>
      <div class="flash error"><%- icon('key') %><span>Токенът е издаден без <span class="mono">instagram_business_manage_insights</span> — свържи акаунта отново от „Instagram акаунти“, за да тръгнат метриките.</span></div>
    <% } else if (!a.rows.length) { %>
      <div class="empty"><%- icon('clock', { class: 'ic-xl' }) %><strong>Още няма дневни снимки</strong>Синхронизират се всяка нощ в 04:30.</div>
    <% } else { %>
      <%
        const series = (key) => a.rows.map((r) => ({ value: r[key], label: ui.date(r.day) + ' · ' + ui.num(r[key]) }));
        const tiles = [
          { key: 'followerCount', label: 'последователи', icon: 'metric-followers' },
          { key: 'reach', label: 'обхват на ден', icon: 'metric-reach' },
          { key: 'views', label: 'прегледи на ден', icon: 'metric-views' },
          { key: 'engaged', label: 'ангажирани акаунти', icon: 'metric-engaged' },
        ];
      %>
      <div class="cards trend m-0">
        <% tiles.forEach((t) => { %>
          <% const s = spark(series(t.key)); const d = ui.delta(s.delta); %>
          <div class="card">
            <div class="l"><%- icon(t.icon, { class: 'ic-sm' }) %> <%= t.label %></div>
            <div class="n"><%= ui.num(s.last) %></div>
            <% if (d) { %><span class="delta <%= d.tone %>"><%- icon(d.icon, { class: 'ic-sm' }) %> <%= d.text %> за 30 дни</span><% } %>
            <%- s.svg %>
          </div>
        <% }) %>
      </div>
      <details>
        <summary><%- icon('chevron-down', { class: 'ic-sm' }) %> Всички <%= a.rows.length %> дни в таблица</summary>
        <div class="table-wrap mt-1">
        <table><thead><tr><th>Ден</th><th class="num">Обхват</th><th class="num">Прегледи</th><th class="num">Последователи</th><th class="num">Ангажирани</th></tr></thead><tbody>
        <% a.rows.forEach((r) => { %><tr><td class="when"><%= ui.date(r.day) %></td><td class="num"><%= ui.num(r.reach) %></td><td class="num"><%= ui.num(r.views) %></td><td class="num"><%= ui.num(r.followerCount) %></td><td class="num"><%= ui.num(r.engaged) %></td></tr><% }) %>
        </tbody></table></div>
      </details>
    <% } %>
  </section>
<% }) %>

<h2><%- icon('metric-engaged') %> Публикации по ангажираност</h2>
<% if (!performance.length) { %>
  <div class="panel"><div class="empty"><%- icon('empty', { class: 'ic-xl' }) %><strong>Няма публикувани постове с метрики</strong>Числата идват от Instagram Insights след публикуване през Публикатор.</div></div>
<% } else { %>
<div class="table-wrap">
<table><thead><tr><th>Вид</th><th>Публикация</th><th class="num">Обхват</th><th class="num">Прегледи</th><th class="num">Взаимодействия</th><th class="num">Ангажираност</th><th>Публикуван</th><th></th></tr></thead><tbody>
<% performance.forEach((p, index) => { %>
  <% const kd = ui.kind(p.kind); %>
  <tr>
    <td><span class="chip"><%- icon(kd.icon, { class: 'ic-sm' }) %> <%= kd.label %></span></td>
    <td><a href="/admin/posts/<%= p.id %>"><%= p.caption.slice(0, 64) %><%= p.caption.length > 64 ? '…' : '' %></a><% if (index === 0) { %><span class="sub-line">най-силната публикация</span><% } %></td>
    <td class="num"><%= ui.num(p.reach) %></td>
    <td class="num"><%= ui.num(p.views) %></td>
    <td class="num"><%= ui.num(p.interactions) %></td>
    <td class="num"><strong><%= p.engagementRate.toLocaleString('bg-BG') %>%</strong></td>
    <td class="muted when"><%= ui.date(p.publishedAt) %></td>
    <td><% if (p.permalink) { %><a class="btn ghost small" href="<%= p.permalink %>" target="_blank" rel="noopener noreferrer"><%- icon('external', { class: 'ic-sm' }) %> Instagram</a><% } %></td>
  </tr>
<% }) %></tbody></table>
</div>
<% } %>
<%- include('../partials/shell-end') %>
