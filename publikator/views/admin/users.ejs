<%- include('../partials/shell-start', { active: 'users' }) %>
<div class="topbar">
  <div>
    <h1>Потребители</h1>
    <p class="sub">Седем нива. Никой не управлява равен или по-висок от себе си.</p>
  </div>
</div>
<section class="panel">
  <h2><%- icon('users') %> Нов потребител</h2>
  <form method="post" action="/admin/users" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <label>Име<input name="name" required minlength="2"></label>
      <label>Имейл<input type="email" name="email" required></label>
      <label>Роля<select name="role" required><% roles.forEach((r) => { %><option value="<%= r %>"><%= roleLabel[r] %> (<%= r %>)</option><% }) %></select></label>
      <label>Начална парола (≥12, букви и цифри)<input type="password" name="password" required minlength="12" autocomplete="new-password"></label>
    </div>
    <button class="btn primary" type="submit"><%- icon('plus') %> Създай</button>
  </form>
</section>
<div class="table-wrap">
<table><thead><tr><th>Потребител</th><th>Роля</th><th>Състояние</th><th>2FA</th><th>Последен вход</th><th>Действия</th></tr></thead><tbody>
<% users.forEach((u) => { %>
  <tr>
    <td><strong><%= u.name %></strong><span class="sub-line"><%= u.email %></span></td>
    <td><% if (canManage(u.role) && u.id !== currentUser.id) { %>
      <form method="post" action="/admin/users/<%= u.id %>/role" class="row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="role" class="field-sm"><% roles.forEach((r) => { %><option value="<%= r %>" <%= r === u.role ? 'selected' : '' %>><%= roleLabel[r] %></option><% }) %></select><button class="btn ghost small" type="submit"><%- icon('approve', { class: 'ic-sm' }) %></button></form>
    <% } else { %><%= roleLabel[u.role] %><% } %></td>
    <td><% if (u.active) { %><span class="chip good"><%- icon('status-active', { class: 'ic-sm' }) %> Активен</span><% } else { %><span class="chip critical"><%- icon('status-disabled', { class: 'ic-sm' }) %> Спрян</span><% } %><% if (u.lockedUntil && u.lockedUntil > new Date()) { %> <span class="chip warn"><%- icon('clock', { class: 'ic-sm' }) %> Заключен</span><% } %><span class="sub-line"><%= u._count.sessions %> сесии</span></td>
    <td><% if (u.totpEnabledAt) { %><span class="chip good"><%- icon('shield', { class: 'ic-sm' }) %> Вкл.</span><% } else { %><span class="chip"><%- icon('close', { class: 'ic-sm' }) %> Изкл.</span><% } %></td>
    <td class="muted"><%= u.lastLoginAt ? ui.relative(u.lastLoginAt) : 'никога' %></td>
    <td class="row">
      <% if (canManage(u.role) && u.id !== currentUser.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small <%= u.active ? 'danger' : 'ghost' %>" type="submit"><%- icon(u.active ? 'status-disabled' : 'status-active', { class: 'ic-sm' }) %> <%= u.active ? 'Спри' : 'Активирай' %></button></form>
        <% if (u.totpEnabledAt) { %><form method="post" action="/admin/users/<%= u.id %>/reset-2fa" class="inline" data-confirm="Нулираш втория фактор на този потребител?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit"><%- icon('shield', { class: 'ic-sm' }) %> Нулирай 2FA</button></form><% } %>
        <form method="post" action="/admin/users/<%= u.id %>/reset-password" class="row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="password" name="password" placeholder="нова парола" minlength="12" required class="field-sm" autocomplete="new-password"><button class="btn ghost small" type="submit"><%- icon('key', { class: 'ic-sm' }) %> Смени</button></form>
      <% } else { %><span class="muted">—</span><% } %>
    </td>
  </tr>
<% }) %>
</tbody></table>
</div>
<%- include('../partials/shell-end') %>
