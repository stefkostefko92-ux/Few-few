<%- include('../partials/shell-start', { active: 'keys' }) %>
<div class="topbar">
  <div>
    <h1>Агентски ключове</h1>
    <p class="sub">Машинен достъп за нашите агенти. Заявките са <strong>HMAC-подписани</strong> (тайната не пътува), с времеви печат и nonce срещу повторение. Обхватът е структурно тесен: агентът може да чете и да <strong>създава чернови</strong> — одобрение, насрочване и публикуване за ключове не съществуват.</p>
  </div>
</div>

<% if (created) { %>
<div class="panel warn-edge">
  <h2><%- icon('key') %> Ключът „<%= created.name %>“ е създаден — тайната се показва само сега</h2>
  <div class="secret mono" id="agent-env">PUBLIKATOR_URL=<%= created.baseUrl %>
PUBLIKATOR_KEY_ID=<%= created.id %>
PUBLIKATOR_KEY_SECRET=<%= created.secret %></div>
  <div class="row mt-1"><button type="button" class="btn small" data-copy="#agent-env"><%- icon('copy', { class: 'ic-sm' }) %> Копирай в клипборда</button></div>
  <p class="sub">Сложи ги на сървъра на агента във файл с права 600 (напр. <span class="mono">/etc/publikator/agent.env</span>) и ги подай на <span class="mono">tools/social/publikator.mjs</span>. Никога в репо, чат или лог.</p>
</div>
<% } %>

<section class="panel">
  <h2><%- icon('plus') %> Нов ключ</h2>
  <form method="post" action="/admin/keys" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Име (кой агент)<input name="name" required minlength="2" placeholder="socialdjiyata"></label>
    <fieldset><legend>Обхват</legend>
      <% scopes.forEach((s) => { %><label class="check"><input type="checkbox" name="scopes" value="<%= s %>" <%= s.endsWith(':read') || s === 'drafts:write' ? 'checked' : '' %>> <span class="mono"><%= s %></span></label><% }) %>
    </fieldset>
    <label>Брандове (празно = всички)<select name="brandIds" multiple size="4"><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %> (<%= b.slug %>)</option><% }) %></select></label>
    <label>Разрешени IP адреси (празно = без ограничение; през интервал/запетая)<input name="allowedIps" placeholder="178.104.77.242"></label>
    <label>Изтича след дни (празно = без срок; препоръчително 90)<input type="number" name="expiresInDays" min="1" max="365" value="90"></label>
    <button class="btn primary" type="submit"><%- icon('key') %> Създай ключ</button>
  </form>
</section>

<div class="table-wrap">
<table><thead><tr><th>Име</th><th>ID</th><th>Обхват</th><th>Брандове</th><th>IP</th><th>Изтича</th><th>Последно ползван</th><th>Състояние</th><th></th></tr></thead><tbody>
<% keys.forEach((k) => { %>
  <tr>
    <td><%= k.name %><div class="muted">от <%= k.createdBy.email %></div></td>
    <td class="mono"><%= k.id %></td>
    <td class="mono"><%= k.scopes.join(' ') %></td>
    <td><%= k.brandIds.length ? k.brandIds.length : 'всички' %></td>
    <td class="mono"><%= k.allowedIps.length ? k.allowedIps.join(', ') : 'всички' %></td>
    <td class="when"><%= k.expiresAt ? ui.date(k.expiresAt) : 'без срок' %></td>
    <td class="muted"><%= k.lastUsedAt ? ui.relative(k.lastUsedAt) : 'никога' %><% if (k.lastUsedIp) { %><span class="sub-line mono"><%= k.lastUsedIp %></span><% } %></td>
    <td><% if (k.revokedAt) { %><span class="chip critical"><%- icon('status-disabled', { class: 'ic-sm' }) %> Отменен</span><% } else if (k.expiresAt && k.expiresAt < new Date()) { %><span class="chip critical"><%- icon('status-token-expired', { class: 'ic-sm' }) %> Изтекъл</span><% } else { %><span class="chip good"><%- icon('status-active', { class: 'ic-sm' }) %> Активен</span><% } %></td>
    <td><% if (!k.revokedAt) { %><form method="post" action="/admin/keys/<%= k.id %>/revoke" class="inline" data-confirm="Отменяш ключа? Агентът спира веднага."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn danger small" type="submit"><%- icon('reject', { class: 'ic-sm' }) %> Отмени</button></form><% } %></td>
  </tr>
<% }) %>
<% if (!keys.length) { %><tr><td colspan="9"><div class="empty"><%- icon('key', { class: 'ic-xl' }) %><strong>Няма ключове</strong>Създай ключ, за да пуснеш агент срещу панела.</div></td></tr><% } %>
</tbody></table>
</div>
<%- include('../partials/shell-end') %>
