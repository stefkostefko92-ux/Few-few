<%- include('../partials/shell-start', { active: 'keys' }) %>
<h1>Агентски ключове</h1>
<p class="muted">Машинен достъп за нашите агенти. Заявките са <strong>HMAC-подписани</strong> (тайната не пътува), с времеви печат и nonce срещу повторение. Обхватът е структурно тесен: агентът може да чете и да <strong>създава чернови</strong> — одобрение, насрочване и публикуване за ключове не съществуват.</p>

<% if (created) { %>
<div class="card" style="margin-bottom:18px;border-color:var(--warn)">
  <h2>Ключът „<%= created.name %>“ е създаден — тайната се показва само сега</h2>
  <div class="secret mono">PUBLIKATOR_URL=<%= created.baseUrl %>
PUBLIKATOR_KEY_ID=<%= created.id %>
PUBLIKATOR_KEY_SECRET=<%= created.secret %></div>
  <p class="muted">Сложи ги на сървъра на агента във файл с права 600 (напр. <span class="mono">/etc/publikator/agent.env</span>) и ги подай на <span class="mono">tools/social/publikator.mjs</span>. Никога в репо, чат или лог.</p>
</div>
<% } %>

<section class="card" style="margin-bottom:18px">
  <h2>Нов ключ</h2>
  <form method="post" action="/admin/keys" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Име (кой агент)<input name="name" required minlength="2" placeholder="socialdjiyata"></label>
    <fieldset class="row" style="border:none;padding:0"><legend class="muted" style="font-size:13px">Обхват</legend>
      <% scopes.forEach((s) => { %><label style="display:flex;gap:6px;align-items:center;color:var(--text)"><input type="checkbox" name="scopes" value="<%= s %>" style="width:auto" <%= s.endsWith(':read') || s === 'drafts:write' ? 'checked' : '' %>> <%= s %></label><% }) %>
    </fieldset>
    <label>Брандове (празно = всички)<select name="brandIds" multiple size="4"><% brands.forEach((b) => { %><option value="<%= b.id %>"><%= b.name %> (<%= b.slug %>)</option><% }) %></select></label>
    <label>Разрешени IP адреси (празно = без ограничение; през интервал/запетая)<input name="allowedIps" placeholder="178.104.77.242"></label>
    <label>Изтича след дни (празно = без срок; препоръчително 90)<input type="number" name="expiresInDays" min="1" max="365" value="90"></label>
    <button class="btn primary" type="submit">Създай ключ</button>
  </form>
</section>

<table><thead><tr><th>Име</th><th>ID</th><th>Обхват</th><th>Брандове</th><th>IP</th><th>Изтича</th><th>Последно ползван</th><th>Състояние</th><th></th></tr></thead><tbody>
<% keys.forEach((k) => { %>
  <tr>
    <td><%= k.name %><div class="muted">от <%= k.createdBy.email %></div></td>
    <td class="mono"><%= k.id %></td>
    <td class="mono"><%= k.scopes.join(' ') %></td>
    <td><%= k.brandIds.length ? k.brandIds.length : 'всички' %></td>
    <td class="mono"><%= k.allowedIps.length ? k.allowedIps.join(', ') : 'всички' %></td>
    <td><%= k.expiresAt ? k.expiresAt.toLocaleDateString('bg-BG') : 'без срок' %></td>
    <td class="muted"><%= k.lastUsedAt ? k.lastUsedAt.toLocaleString('bg-BG') + (k.lastUsedIp ? ' от ' + k.lastUsedIp : '') : 'никога' %></td>
    <td><% if (k.revokedAt) { %><span class="badge FAILED">отменен</span><% } else if (k.expiresAt && k.expiresAt < new Date()) { %><span class="badge FAILED">изтекъл</span><% } else { %><span class="badge ACTIVE">активен</span><% } %></td>
    <td><% if (!k.revokedAt) { %><form method="post" action="/admin/keys/<%= k.id %>/revoke" class="inline" data-confirm="Отменяш ключа? Агентът спира веднага."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger" type="submit">Отмени</button></form><% } %></td>
  </tr>
<% }) %>
<% if (!keys.length) { %><tr><td colspan="9" class="muted">Няма ключове.</td></tr><% } %>
</tbody></table>
<%- include('../partials/shell-end') %>
