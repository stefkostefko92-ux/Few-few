<%- include('head') %>
<div class="layout">
  <aside class="sidebar">
    <div class="brand"><%- icon('publikator', { class: 'ic-lg' }) %><span class="wordmark">Публи<span>катор</span></span></div>
    <nav class="nav">
      <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>"><%- icon('dashboard') %> Табло</a>
      <a href="/admin/posts" class="<%= active === 'posts' ? 'active' : '' %>"><%- icon('posts') %> Постове</a>
      <% if (can('posts:create')) { %><a href="/admin/posts/new" class="<%= active === 'new' ? 'active' : '' %>"><%- icon('compose') %> Нова чернова</a><% } %>
      <a href="/admin/brands" class="<%= active === 'brands' ? 'active' : '' %>"><%- icon('brands') %> Брандове</a>
      <a href="/admin/accounts" class="<%= active === 'accounts' ? 'active' : '' %>"><%- icon('instagram') %> Instagram акаунти</a>
      <% if (can('audit:view') || can('users:manage') || can('keys:manage') || can('settings:view')) { %><small>Управление</small><% } %>
      <% if (can('users:manage')) { %><a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>"><%- icon('users') %> Потребители</a><% } %>
      <% if (can('keys:manage')) { %><a href="/admin/keys" class="<%= active === 'keys' ? 'active' : '' %>"><%- icon('key') %> Агентски ключове</a><% } %>
      <% if (can('audit:view')) { %><a href="/admin/audit" class="<%= active === 'audit' ? 'active' : '' %>"><%- icon('audit') %> Одит</a><% } %>
      <% if (can('settings:view')) { %><a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>"><%- icon('settings') %> Настройки</a><% } %>
    </nav>
    <div class="who">
      <% if (currentUser) { %>
        <div class="name"><a href="/admin/profile"><%= currentUser.name %></a></div>
        <div><%= currentUser.email %></div>
        <div class="row spread">
          <span class="chip"><%- icon('shield', { class: 'ic-sm' }) %> <%= ui.roleLabel(currentRole) %></span>
          <form method="post" action="/admin/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit"><%- icon('logout', { class: 'ic-sm' }) %> Изход</button></form>
        </div>
      <% } %>
    </div>
  </aside>
  <main>
    <% if (flash) { %><div class="flash <%= flash.kind %>"><%- icon(flash.kind === 'ok' ? 'status-approved' : flash.kind === 'error' ? 'status-failed' : 'severity-info') %><span><%= flash.text %></span></div><% } %>
