// Публикатор — схема на данните. PostgreSQL, миграции през `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Бранд = един наш продукт/профил, за който произвеждаме съдържание.
model Brand {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  /// Кратко описание на продукта — влиза в промпта при генериране.
  summary    String
  /// Тон на глас, забрани, задължителни формулировки.
  voice      String
  /// BCP-47, напр. „bg“, „it“, „en“.
  language   String   @default("bg")
  websiteUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  accounts InstagramAccount[]
  posts    Post[]
}

/// Instagram професионален акаунт (Business/Creator), свързан през OAuth.
/// Акаунтът се СЪЗДАВА РЪЧНО от човек — Meta забранява автоматизирано създаване.
model InstagramAccount {
  id             String        @id @default(cuid())
  brandId        String
  brand          Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  igUserId       String        @unique
  username       String
  /// Дълготраен токен, криптиран в покой (AES-256-GCM).
  accessTokenEnc String
  tokenExpiresAt DateTime
  scopes         String
  status         AccountStatus @default(ACTIVE)
  quotaUsed      Int?
  quotaTotal     Int?
  quotaCheckedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  posts Post[]

  @@index([brandId])
  @@index([status, tokenExpiresAt])
}

enum AccountStatus {
  ACTIVE
  TOKEN_EXPIRED
  DISABLED
}

enum PostKind {
  IMAGE
  REELS
}

enum PostStatus {
  DRAFT
  REJECTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

/// Един пост през целия му път: чернова → одобрен от човек → насрочен → публикуван.
model Post {
  id        String            @id @default(cuid())
  brandId   String
  brand     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  accountId String?
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  kind     PostKind
  caption  String
  hashtags String[]
  /// Задължителен alt текст (EAA/WCAG + social SEO).
  altText  String
  mediaUrl String
  coverUrl String?

  status          PostStatus @default(DRAFT)
  /// true = черновата е писана от модел; пази се за одит и за етикетиране.
  aiAssisted      Boolean    @default(false)
  lintFindings    Json?
  /// Кой е създал черновата: HUMAN (user id) · AGENT (api key id) · SYSTEM.
  createdByType   String     @default("HUMAN")
  createdById     String?
  createdByLabel  String     @default("")
  /// Темата/заявката, по която е писана черновата (за контекст на ревюъра).
  topic           String?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  approvedBy  String?
  approvedAt  DateTime?
  scheduledAt DateTime?
  publishedAt DateTime?
  containerId String?
  igMediaId   String?
  permalink   String?
  lastError   String?
  attempts    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs PublishLog[]

  @@index([brandId])
  @@index([accountId])
  @@index([status, scheduledAt])
}

/// Одиторска следа: всяка стъпка към Instagram, успешна или не.
model PublishLog {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  step      String
  ok        Boolean
  detail    Json?
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

/// Седем нива, строго подредени. Числото е в `src/auth/rbac.ts`, тук само имената.
enum Role {
  OWNER
  ADMIN
  MANAGER
  REVIEWER
  EDITOR
  ANALYST
  VIEWER
}

/// Човек в панела. Паролата е Argon2id; TOTP е по избор, но веднъж включен — задължителен при вход.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(VIEWER)
  active        Boolean   @default(true)
  /// TOTP тайна (base32), криптирана в покой с TOKEN_ENC_KEY. null = без 2FA.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  apiKeys  ApiKey[]  @relation("createdKeys")

  @@index([role, active])
}

/// Сесия в базата (не JWT): отменима веднага, с плъзгащ и абсолютен таван.
model Session {
  id         String   @id @default(cuid())
  /// SHA-256 на тайната от бисквитката — самата тайна не се пази.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken  String
  /// true след успешен TOTP (или ако потребителят няма 2FA).
  mfaPassed  Boolean  @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Машинен клиент (нашият агент). Тайната не пътува — заявките са HMAC-подписани.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  /// Тайната за подписване, криптирана в покой (AES-256-GCM с TOKEN_ENC_KEY);
  /// показва се на човека веднъж при създаване. Теч на базата сам по себе си не дава подписване.
  secretEnc   String
  scopes      String[]
  /// Празно = всички брандове; иначе списък от Brand.id.
  brandIds    String[]
  /// Празно = без ограничение; иначе точни IP адреси.
  allowedIps  String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("createdKeys", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@index([revokedAt, expiresAt])
}

/// Одит с верига от хешове: промяна на стар запис чупи веригата надолу.
model AuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now())
  actorType  String
  actorId    String?
  actorLabel String
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  prevHash   String
  hash       String

  @@index([at])
  @@index([actorId])
  @@index([targetType, targetId])
}
