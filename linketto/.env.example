# Linketto — среда. Тайните живеят САМО на сървъра (mode 600), никога в репото.

# PostgreSQL
DATABASE_URL="postgresql://linketto:linketto@localhost:5432/linketto"

# Папка за качените снимки (аватари/фонове). На сървъра — ИЗВЪН release
# папката (напр. /var/lib/linketto), иначе се губят при деплой.
DATA_DIR="./data"

# Публичен базов URL (влиза в sitemap, redirect-а след плащане през Revolut)
PUBLIC_BASE_URL="http://localhost:3000"

# Кратък домейн за линковете на профилите (по избор), напр. "lnkt.to" →
# https://lnkt.to/<slug>. Нужни DNS + TLS + Nginx server_name (виж DEPLOY.md §2).
PROFILE_HOST=""

# Дневните cron-ове: седмичен отчет „езикова дупка“ (POST /api/cron/digest) и
# предплатените планове — висящи поръчки, изтичане, напомняния (POST
# /api/cron/plans) + подпис на линка за отписване. ≥24 знака:
# openssl rand -hex 32. Празно = изключено.
CRON_SECRET=""

# Revolut Business — Merchant API (плащане на плановете; docs/revolut-migration-spec.md).
# Ключът: Revolut Business → APIs → Merchant API → Production/Sandbox Secret key.
# REVOLUT_ENV="production" = merchant.revolut.com; всичко друго = sandbox.
REVOLUT_SECRET_KEY=""
REVOLUT_ENV="sandbox"
# Подписващата тайна на уебхука (създава се с POST /api/1.0/webhooks към
# <PUBLIC_BASE_URL>/api/revolut/webhook, събития ORDER_COMPLETED/ORDER_AUTHORISED/
# ORDER_FAILED/ORDER_CANCELLED). Без нея уебхукът връща 503 и само cron-ът урежда.
REVOLUT_WEBHOOK_SECRET=""

# Google Gemini — за „Преведи с AI“ и „Генерирай био“ (по избор; без ключ
# бутонът връща ясна грешка). Ключ: https://aistudio.google.com/apikey — за ЕС
# само на ПЛАТЕН акаунт (безплатният tier ползва входа за обучение).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# "1" само за ПЛАТЕН акаунт с DPA (условията на Gemini API за ЕИП). Без него
# всички AI функции са изключени — fail-closed (виж DEPLOY.md §2).
GEMINI_PAID_TIER=""

# Админ панел: имейли с достъп до /admin (запетая-разделени)
ADMIN_EMAILS=""

# Транзакционен имейл — Brevo (Sendinblue SAS, ЕС): напомняния за плана,
# потвърждения за бюлетин, седмичен отчет. Подателят трябва да е потвърден
# домейн в Brevo (SPF/DKIM). Без ключ — имейлите са изключени (no-op).
BREVO_API_KEY=""
EMAIL_FROM="Linketto <no-reply@linketto.carbonstealth.eu>"
