# Linketto — среда. Тайните живеят САМО на сървъра (mode 600), никога в репото.

# PostgreSQL
DATABASE_URL="postgresql://linketto:linketto@localhost:5432/linketto"

# Папка за качените снимки (аватари/фонове). На сървъра — ИЗВЪН release
# папката (напр. /var/lib/linketto), иначе се губят при деплой.
DATA_DIR="./data"

# Публичен базов URL (влиза в sitemap, Stripe redirect-и)
PUBLIC_BASE_URL="http://localhost:3000"

# Кратък домейн за линковете на профилите (по избор), напр. "lnkt.to" →
# https://lnkt.to/<slug>. Нужни DNS + TLS + Nginx server_name (виж DEPLOY.md §2).
PROFILE_HOST=""

# Седмичен отчет „езикова дупка“ (POST /api/cron/digest) + подпис на линка за
# отписване. ≥24 знака: openssl rand -hex 32. Празно = изключено.
CRON_SECRET=""

# Stripe — от свързания акаунт на Carbon Stealth VCC (dashboard.stripe.com)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID-та (Products → Prices в Stripe). Абонаментните планове имат
# отделен Price за всеки период (месец/3/6/12 мес — с отстъпка 0/10/15/20%).
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_QUARTERLY=""
STRIPE_PRICE_PRO_SEMIANNUAL=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_QUARTERLY=""
STRIPE_PRICE_BUSINESS_SEMIANNUAL=""
STRIPE_PRICE_BUSINESS_ANNUAL=""
# Founder е еднократно плащане (без период)
STRIPE_PRICE_FOUNDER=""

# Google Gemini — за „Преведи с AI“ и „Генерирай био“ (по избор; без ключ
# бутонът връща ясна грешка). Ключ: https://aistudio.google.com/apikey — за ЕС
# само на ПЛАТЕН акаунт (безплатният tier ползва входа за обучение).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# "1" само за ПЛАТЕН акаунт с DPA (условията на Gemini API за ЕИП). Без него
# всички AI функции са изключени — fail-closed (виж DEPLOY.md §2).
GEMINI_PAID_TIER=""

# Админ панел: имейли с достъп до /admin (запетая-разделени)
ADMIN_EMAILS=""

# Транзакционен имейл (доставка на купеното + разписка) — Resend
RESEND_API_KEY=""
EMAIL_FROM="Linketto <no-reply@linketto.carbonstealth.eu>"

# Stripe Tax (ДДС слой — виж TAX.md). Включи ("1") ЧАК СЛЕД КАТО:
# 1) Stripe Tax е активиран в Dashboard-а (Settings → Tax),
# 2) данъчните регистрации са въведени там (BG + OSS Union scheme),
# 3) env Price ID-тата на плановете са tax-inclusive.
# Без флага магазинът работи с ДДС = 0 (същите пътища на парите).
STRIPE_TAX_ENABLED=""
