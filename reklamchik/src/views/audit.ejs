<%- include('_head') %>
<h1>Одитна следа</h1>
<p class="hint">Всяко действие към платформа — човешко или автоматично — се записва. Това е доказателството за отчетност (GDPR чл. 5(2)) и дневникът на автоматизацията.</p>
<section class="card">
  <table>
    <thead><tr><th>Кога</th><th>Кой</th><th>Действие</th><th>Кампания</th><th>Детайли</th></tr></thead>
    <tbody>
      <% for (const r of rows) { %>
      <tr>
        <td><time><%= r.at %></time></td>
        <td><%= r.actor %></td>
        <td><%= r.action %><%= r.dry_run ? ' 🧪' : '' %></td>
        <td><%= r.campaign_id || '—' %></td>
        <td><code class="small"><%= r.detail_json %></code></td>
      </tr>
      <% } %>
      <% if (!rows.length) { %><tr><td colspan="5">Няма записи.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('_foot') %>
