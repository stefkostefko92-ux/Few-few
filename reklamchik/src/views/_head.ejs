<!doctype html>
<html lang="bg">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Рекламчика</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand">📣 Рекламчика</div>
  <% if (typeof hideNav === 'undefined') { %>
  <nav>
    <a href="/">Дашборд</a>
    <a href="/campaigns/new">Нова кампания</a>
    <a href="/rules">Правила</a>
    <a href="/connections">Връзки</a>
    <a href="/audit">Одит</a>
  </nav>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="ghost">Изход</button>
  </form>
  <% } %>
</header>
<% if (dryRun && typeof hideNav === 'undefined') { %>
<div class="banner">🧪 DRY-RUN режим — няма конфигурирани API креденшъли. Всичко се симулира локално; нито стотинка не се харчи.</div>
<% } %>
