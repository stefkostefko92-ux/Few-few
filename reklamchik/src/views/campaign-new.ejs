<%- include('_head') %>
<h1>Нова кампания</h1>
<p class="hint">Създава се като <strong>чернова</strong> → публикува се <strong>ПАУЗИРАНА</strong> в платформата → активираш я съзнателно. Таван на дневен бюджет: <%= guards.maxDailyBudget %> · общ таван: <%= guards.maxTotalDailyBudget %>.</p>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="post" action="/campaigns" class="card grid2">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label>Акаунт (връзка)
    <select name="connection_id" required>
      <% for (const c of connections) { %>
      <option value="<%= c.id %>"><%= c.platform === 'google' ? 'Google' : 'Meta' %> · <%= c.label %></option>
      <% } %>
    </select>
  </label>
  <label>Име на кампанията <input name="name" required placeholder="напр. Linketto · Search BG · юли"></label>

  <label>Цел (objective)
    <select name="objective" required>
      <optgroup label="Google">
        <option value="SEARCH">Search — търсене (висок intent)</option>
        <option value="PERFORMANCE_MAX">Performance Max — всички канали</option>
        <option value="DEMAND_GEN">Demand Gen — YouTube/Discover/Gmail</option>
        <option value="VIDEO">YouTube видео (през Demand Gen)</option>
        <option value="DISPLAY">Display — банери</option>
      </optgroup>
      <optgroup label="Meta (ODAX)">
        <option value="OUTCOME_SALES">Продажби</option>
        <option value="OUTCOME_LEADS">Лийдове</option>
        <option value="OUTCOME_TRAFFIC">Трафик</option>
        <option value="OUTCOME_ENGAGEMENT">Ангажираност</option>
        <option value="OUTCOME_AWARENESS">Разпознаваемост</option>
        <option value="OUTCOME_APP_PROMOTION">Промотиране на приложение</option>
      </optgroup>
    </select>
  </label>
  <label>Дневен бюджет <input name="daily_budget" type="number" step="0.01" min="1" required placeholder="10.00"></label>

  <label>Наддаване
    <select name="bidding">
      <option value="">Автоматично (Maximize Conversions)</option>
      <option value="tCPA">Целеви CPA</option>
      <option value="tROAS">Целеви ROAS</option>
      <option value="MAX_CLICKS">Максимум кликове</option>
    </select>
  </label>
  <label>Целева стойност (CPA/ROAS) <input name="bidding_target" type="number" step="0.01" placeholder="напр. 10 (CPA) или 3 (ROAS)"></label>

  <label>Целеви URL <input name="final_url" type="url" placeholder="https://…"></label>
  <label>Гео (ISO кодове, запетая) <input name="geo" value="BG"></label>

  <label>Мин. възраст (под 18 е забранено — DSA чл. 28) <input name="age_min" type="number" value="18" min="18" max="65"></label>
  <label>Макс. възраст <input name="age_max" type="number" min="18" max="65" placeholder="без лимит"></label>

  <fieldset class="span2">
    <legend>Meta placements (празно = Advantage+ автоматични — препоръчано)</legend>
    <label class="check"><input type="checkbox" name="placements" value="facebook"> Facebook</label>
    <label class="check"><input type="checkbox" name="placements" value="instagram"> Instagram</label>
    <label class="check"><input type="checkbox" name="placements" value="threads"> Threads (изисква Instagram)</label>
    <label class="check"><input type="checkbox" name="placements" value="messenger"> Messenger</label>
    <label class="check"><input type="checkbox" name="whatsapp"> 💬 Click-to-WhatsApp (изисква Page със свързан WhatsApp номер)</label>
  </fieldset>

  <label>Meta Page ID <input name="page_id" placeholder="за Meta кампании с креатив"></label>
  <label>Meta Pixel ID <input name="pixel_id" placeholder="за OUTCOME_SALES"></label>

  <label class="span2">Заглавие (headline) <input name="headline" maxlength="255" placeholder="видими ~40 знака"></label>
  <label class="span2">Основен текст <textarea name="primary_text" rows="3" maxlength="500" placeholder="видими ~125 знака преди „Виж повече“ — hook отпред!"></textarea></label>

  <label>DSA платец (payor) <input name="dsa_payor" placeholder="юридическо име — задължително за ЕС (Meta)"></label>
  <label>DSA бенефициент <input name="dsa_beneficiary" placeholder="празно = платецът"></label>

  <fieldset class="span2">
    <legend>Специални категории (Meta) — декларирай честно, иначе платформата отхвърля/банва</legend>
    <label class="check"><input type="checkbox" name="special_ad_categories" value="HOUSING"> Жилища</label>
    <label class="check"><input type="checkbox" name="special_ad_categories" value="EMPLOYMENT"> Работа</label>
    <label class="check"><input type="checkbox" name="special_ad_categories" value="CREDIT"> Кредити</label>
    <label class="check"><input type="checkbox" name="special_ad_categories" value="FINANCIAL_PRODUCTS_SERVICES"> Финансови продукти</label>
  </fieldset>

  <fieldset class="span2">
    <legend>Съответствие (задължително за публикуване)</legend>
    <label class="check"><input type="checkbox" name="consent_confirmed"> ✅ Сайтът има CMP + Consent Mode v2 / Meta consent сигнали за EEA трафик</label>
    <label class="check"><input type="checkbox" name="ai_generated_creative"> 🤖 Креативът е AI-генериран</label>
    <label class="check"><input type="checkbox" name="ai_disclosure_confirmed"> ✅ AI креативът носи разкриване + машинно-четима маркировка (AI Act чл. 50)</label>
    <label class="check"><input type="checkbox" name="add_recommended_rules" checked> 🛡️ Добави препоръчаните авто-правила (пауза при изгорял CPA, скалиране +20%, умора на креатива, дневен спирачен праг)</label>
  </fieldset>

  <button class="primary span2">Създай чернова</button>
</form>
<%- include('_foot') %>
