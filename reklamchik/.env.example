# Рекламчика — конфигурация на средата (копирай като .env на сървъра, mode 600; НИКОГА в репото)

NODE_ENV=production
PORT=3060
BASE_URL=https://reklamchik.carbonstealth.eu
DB_PATH=/opt/reklamchik/data/reklamchik.db

# 32 байта hex (генерирай: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
SESSION_SECRET=

ADMIN_EMAIL=
# node -e "console.log(require('bcryptjs').hashSync('паролата', 12))"
ADMIN_PASSWORD_HASH=

# Google Ads API (REST). Developer token се вади от production MCC → API Center.
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Marketing API (Graph API). Токенът на връзката е System User token (пази се в базата, криптиран).
META_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=

# Автоматизация
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30

# Твърди предпазители на бюджета (валутни единици)
GUARD_MAX_DAILY_BUDGET=500
GUARD_MAX_TOTAL_DAILY_BUDGET=1500
