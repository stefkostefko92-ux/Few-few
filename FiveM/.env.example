# FiveM Bulgaria — среда. Тайните живеят САМО на сървъра (mode 600), никога в репото.

# PostgreSQL
DATABASE_URL="postgresql://fivem:fivem@localhost:5432/fivem"

# Публичен базов URL (влиза в sitemap/canonical/JSON-LD)
PUBLIC_BASE_URL="http://localhost:3000"

# Админ панел / модерация на заявките: имейли с достъп (запетая-разделени)
ADMIN_EMAILS=""

# Пингване на сървърите (scripts/refresh-servers.ts, пуска се по cron).
# Таймаут за една заявка в милисекунди и максимален паралелизъм.
FIVEM_PING_TIMEOUT_MS="4000"
FIVEM_PING_CONCURRENCY="6"
