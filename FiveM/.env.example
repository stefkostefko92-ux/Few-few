# FiveM Bulgaria — среда. Тайните живеят САМО на сървъра (mode 600), никога в репото.

# PostgreSQL
DATABASE_URL="postgresql://fivem:fivem@localhost:5432/fivem"

# Публичен базов URL (влиза в sitemap/canonical/JSON-LD)
PUBLIC_BASE_URL="http://localhost:3000"

# Админ панел. Паролата НЕ се пази никъде — тук стои само scrypt хеш във вид
# „соль:хеш“. Генерира се с: npm run admin:hash -- "дълга парола"
ADMIN_PASSWORD_HASH=""
# Хедърът, от който се чете IP-то за тавана на опитите за вход. Чете се САМО
# този и по подразбиране е този, който нашият nginx презаписва. Смени го само
# ако пред nginx стои друго прокси, което наистина владее хедъра си.
TRUST_PROXY_IP_HEADER="x-real-ip"

# Стриймъри. Панелът показва дали са зададени, но НИКОГА не ги приема и не ги
# записва — тайна, минала през уеб форма, става крадима при пробив в базата.
# Всяка липсваща двойка просто пропуска платформата — cron-ът не пада.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
# По избор: спестява една заявка за търсене на категорията GTA V в Kick.
# Форматът на `language` в заявката към Kick НЕ е документиран (`bg` или
# `Bulgarian`?). Празно = кодът пробва и двата и логва кой е минал; закови го
# тук, щом веднъж е сверен — тогава заявката е една.
KICK_LANGUAGE=
# Категорията GTA V в Kick е id=8 („Grand Theft Auto V (GTA)“, сверено 09.08.2026).
# Кодът я намира и сам; това само спестява по една заявка на пробег.
KICK_CATEGORY_ID=""
YOUTUBE_API_KEY=""

# Транзакционен имейл (Resend). БЕЗ ключ нищо не се праща, а липсата се логва —
# но обещанията по чл. 16 и чл. 17 DSA остават неизпълнени, затова на живо е
# задължителен.
RESEND_API_KEY=""
EMAIL_FROM="FiveM BG <no-reply@fivembulgaria.carbonstealth.eu>"

# Пингване на сървърите (scripts/refresh-servers.ts, пуска се по cron).
# Таймаут за една заявка в милисекунди и максимален паралелизъм.
FIVEM_PING_TIMEOUT_MS="4000"
FIVEM_PING_CONCURRENCY="6"

# Docker Compose чете POSTGRES_PASSWORD оттук за контейнера на базата.
POSTGRES_PASSWORD=""
