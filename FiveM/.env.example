# FiveM Bulgaria — среда. Тайните живеят САМО на сървъра (mode 600), никога в репото.

# PostgreSQL
DATABASE_URL="postgresql://fivem:fivem@localhost:5432/fivem"

# Публичен базов URL (влиза в sitemap/canonical/JSON-LD)
PUBLIC_BASE_URL="http://localhost:3000"

# Админ панел. Паролата НЕ се пази никъде — тук стои само scrypt хеш във вид
# „соль:хеш“. Генерира се с: npm run admin:hash -- "дълга парола"
ADMIN_PASSWORD_HASH=""

# Стриймъри. Панелът показва дали са зададени, но НИКОГА не ги приема и не ги
# записва — тайна, минала през уеб форма, става крадима при пробив в базата.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# Пингване на сървърите (scripts/refresh-servers.ts, пуска се по cron).
# Таймаут за една заявка в милисекунди и максимален паралелизъм.
FIVEM_PING_TIMEOUT_MS="4000"
FIVEM_PING_CONCURRENCY="6"
