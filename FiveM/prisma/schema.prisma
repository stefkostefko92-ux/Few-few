// FiveM Bulgaria — схема на директорията.
// Правило: тук НЕ влизат лични данни на играчи. players.json на сървърите
// връща имена и identifiers (steam:/license:/discord:) — те не се четат, не се
// съхраняват и не се показват. Пазим само агрегираната бройка.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Framework {
  ESX
  QBCORE
  QBOX
  OX_CORE
  STANDALONE
  UNKNOWN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Как сървърът е попаднал в директорията. Различието не е козметично:
/// открит автоматично сървър НЕ е подаден от собственика си, затова носи
/// бележка и по-леки права (не може да се промотира, докато не бъде поет).
enum ServerSource {
  SUBMITTED
  DISCOVERED
}

/// Резултат от последния пинг. HIDDEN значи жив сървър с вдигнат
/// `sv_requestParanoia` (връща „Nope.“ вместо JSON) — НЕ е офлайн.
enum ProbeOutcome {
  ONLINE
  OFFLINE
  HIDDEN
  UNREACHABLE
}

/// Сървър в директорията. Създава се от заявка (PENDING) и става публичен
/// само след ръчно одобрение (APPROVED).
model Server {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  description String?

  /// „cfx.re/join/<code>“ кодът (без домейна). Основният идентификатор на
  /// сървъра — адресът се резолвира от него. При откритите сървъри това е
  /// `EndPoint` от списъка на Cfx.re.
  cfxJoinCode String? @unique

  source ServerSource @default(SUBMITTED)
  /// Версията на иконата от списъка на Cfx.re — без нея URL-ът на иконата не
  /// може да се построи.
  iconVersion Int?
  /// Кога сървърът последно е бил видян в публичния списък на Cfx.re.
  lastSeenInListAt DateTime?
  /// Резолвиран адрес „host:port“ (по подразбиране порт 30120). Може да е
  /// въведен ръчно, ако сървърът няма Cfx код.
  address     String?

  discordUrl String?
  websiteUrl String?
  bannerUrl  String?

  framework Framework @default(UNKNOWN)
  whitelist Boolean   @default(false)
  language  String    @default("bg")
  /// Свободни етикети: „heavy-rp“, „икономика“, „drift“, „нов“ …
  tags      String[]  @default([])

  status   ModerationStatus @default(PENDING)
  /// Платено/промотирано подреждане най-отгоре, докато не изтече.
  featuredUntil DateTime?

  // ── Жив статус (пише се само от scripts/refresh-servers.ts) ───────────────
  online     Boolean      @default(false)
  lastProbe  ProbeOutcome @default(OFFLINE)
  players    Int          @default(0)
  maxPlayers Int          @default(0)
  /// Последният момент, в който сървърът е отговорил успешно.
  lastOnlineAt DateTime?
  /// Последният опит за пингване (успешен или не).
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]
  snapshots ServerSnapshot[]

  @@index([status, online, players])
  @@index([status, featuredUntil])
}

/// Часова снимка на посещаемостта — за графиката „играчи през деня“.
/// Само числа, нула лични данни.
model ServerSnapshot {
  id       String   @id @default(cuid())
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  players  Int
  online   Boolean

  @@index([serverId, at])
}

/// Ревю от посетител. Влиза в модераторска опашка (PENDING) — публикува се
/// ръчно. Не пазим IP, user agent или каквото и да е проследяване.
model Review {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  rating     Int
  body       String?
  /// Свободен псевдоним, въведен от автора. Не е акаунт, не е верифициран.
  authorAlias String?

  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([serverId, status])
}

/// Заявка за листване/партньорство от собственик на сървър. Имейлът е
/// единствената лична данна тук — за връзка по повод заявката.
model Submission {
  id          String  @id @default(cuid())
  serverName  String
  cfxJoinCode String?
  address     String?
  discordUrl  String?
  contactEmail String
  note        String?

  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([status, createdAt])
}

/// Сигнал за незаконно съдържание по чл. 16 от Регламент (ЕС) 2022/2065 (DSA).
/// Четирите елемента по чл. 16(2) са задължителни полета — механизмът трябва
/// да ги УЛЕСНЯВА, не просто да приема свободен имейл.
model Report {
  id String @id @default(cuid())

  /// Точният адрес на съдържанието (чл. 16(2)(б)).
  targetUrl String
  /// Защо подателят смята съдържанието за незаконно (чл. 16(2)(а)).
  reason    String
  /// Име и имейл на подателя (чл. 16(2)(в)).
  reporterName  String
  reporterEmail String
  /// Декларация за добросъвестност и точност (чл. 16(2)(г)).
  goodFaith Boolean

  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  /// Кога е взето решение — от него тече уведомяването по чл. 16(5).
  handledAt DateTime?

  @@index([status, createdAt])
}

/// Сесия на администратора. В базата стои само SHA-256 на токена — открадната
/// база не дава валидна сесия. Ротира се при вход (session fixation).
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Брояч на опитите за вход ПО ПРИНЦИПАЛ. Глобалният таван не става за вход:
/// чужд човек изяжда опитите и заключва собственика, а в другата посока дава
/// 86 400 опита на ден. IP-то се пази само като хеш и само за сигурност
/// (чл. 6, ал. 1, б. „е“), 24 часа — обявено е в политиката.
model LoginAttempt {
  id       String   @id @default(cuid())
  ipHash   String
  at       DateTime @default(now())
  ok       Boolean  @default(false)

  @@index([ipHash, at])
}

/// Кой какво е решил. `featuredUntil` са пари, а модерацията по DSA е решение
/// с правни последици — и двете искат следа, която не се пише от самия UI.
model AuditLog {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  action String
  target String
  detail String?

  @@index([at])
}

/// Новини и туториали — SEO гръбнакът на сайта.
model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  body    String
  author  String @default("Екипът на FiveM Bulgaria")
  /// Езикът на текста. Без него sitemap-ът обявяваше един и същ български
  /// текст като отделна английска версия — тоест лъжеше търсачките.
  locale  String @default("bg")

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
