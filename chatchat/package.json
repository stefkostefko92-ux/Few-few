{
  "name": "chatchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatChat by Carbon Stealth — AI техническа поддръжка за табла за управление на асансьори: проверими диагнози с цитати от версионирана база знания, Safety Gate и ескалация към човек.",
  "license": "UNLICENSED",
  "author": "Carbon Stealth VCC",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefkostefko92-ux/Few-few.git",
    "directory": "chatchat"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "Carbon Stealth",
    "ChatChat",
    "assistenza-tecnica-ascensori",
    "quadri-di-manovra",
    "ai-technical-support",
    "rag-citations",
    "safety-gate"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "tenant:create": "node dist/cli/tenant.js tenant",
    "user:create": "node dist/cli/tenant.js user",
    "user:reset": "node dist/cli/tenant.js reset",
    "sso:off": "node dist/cli/sso.js",
    "retention": "node dist/cli/retention.js",
    "files:status": "node dist/cli/files.js status",
    "files:encrypt": "node dist/cli/files.js encrypt",
    "files:rekey": "node dist/cli/files.js rekey",
    "files:verify": "node dist/cli/files.js verify",
    "gate": "prisma generate && npm run lint && npm run typecheck && npm test && npm run build",
    "embed": "node dist/cli/embed.js",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@anthropic-ai/vertex-sdk": "^0.19.11",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "openid-client": "6.8.8",
    "pdfjs-dist": "6.3.289",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "jose": "6.2.12",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
