# ChatChat — образец на настройките. Истинският .env живее САМО на сървъра:
# /opt/few-few/shared/chatchat/.env (mode 600), никога в репото или в архива за деплой.
# Тайните се генерират на сървъра, всяка различна:
#   openssl rand -hex 32      → POSTGRES_PASSWORD, SESSION_PEPPER
#   openssl rand -base64 32   → ATTACHMENT_URL_KEY, MFA_ENC_KEY, FILES_KEK, INTEGRATION_KEK (deploy/deploy.sh
#                               ги ражда сам, ако липсват)
# Копие на .env пази и извън сървъра (password manager) — без MFA_ENC_KEY бекъпът не връща MFA, а без
# FILES_KEK прикачените файлове (и тези в бекъпите) не се отварят. НИКОГА заедно с бекъпите.
# В контейнера влиза само изброеното в docker-compose.yml (`environment:`).

# Адресът, на който хората отварят сайта (без / накрая) — по него се проверява Origin (CSRF).
PUBLIC_BASE_URL=https://chatchat.carbonstealth.eu

# База (Docker Compose я вдига сама; паролата е само тук). Влиза некодирана в DATABASE_URL —
# „/“, „?“, „#“, „@“ и „%“ я чупят, затова hex.
POSTGRES_PASSWORD=

# DATABASE_URL НЕ се задава тук: docker-compose.yml го сглобява от POSTGRES_PASSWORD
# (postgresql://chatchat:…@db:5432/chatchat). Само за локален `npm run dev` без Docker:
# DATABASE_URL=postgresql://chatchat:chatchat@127.0.0.1:5432/chatchat

# HMAC „подправка“ за хешовете на сесийните и QR токените — поне 32 знака. Смяната обезсилва
# всички активни сесии и QR токени. Не я сменяй без причина.
SESSION_PEPPER=

# --- Прикачени файлове и MFA (F2) — задължителни (compose отказва без тях) ---
# Подписът на краткотрайните адреси за сваляне на прикачен файл (openssl rand -base64 32).
# Смяната обезсилва вече издадените адреси — нищо повече.
ATTACHMENT_URL_KEY=
# Шифроването на MFA (TOTP) тайните в базата (openssl rand -base64 32). Смяната или загубата =
# всички MFA устройства се записват наново. Не я сменяй без причина.
MFA_ENC_KEY=
# Шифроване на файловете в покой (NFR-03): главният ключ (KEK, openssl rand -base64 32), който опакова
# отделния ключ на всеки файл. Различен от MFA_ENC_KEY. ЗАГУБА = прикачените файлове са загубени
# (и в бекъпите). Ротация (DEPLOY.md, т. 12): новият тук, старият във FILES_KEK_PREVIOUS → деплой →
# `files:rekey` → махни FILES_KEK_PREVIOUS (старият KEK пази офлайн, докато има бекъпи отпреди ротацията).
FILES_KEK=
# Стари KEK след ротация, разделени със запетая — само за четене до files:rekey.
# FILES_KEK_PREVIOUS=
# Стари нешифровани файлове (отпреди шифроването): allow — четат се; deny — отказ. deny, щом
# `files:status` покаже 0 нешифровани (deploy.sh пуска files:encrypt след всеки деплой).
# FILES_PLAINTEXT=allow
# FILES_ENCRYPTION=off — само за локална разработка/тестове; в продукция процесът не тръгва с него.
#
# Данните на базата в шифрован том (LUKS2): deploy/pgdata-encrypt.sh (root, DEPLOY.md т. 12) дописва тук
#   COMPOSE_FILE=docker-compose.yml:docker-compose.pgdata.yml
# — не го пиши и не го трий на ръка (без него compose би вдигнал базата върху стария некриптиран том).
# Антивирусът (ClamAV) и папката за файловете НЕ се задават тук: docker-compose.yml ги закова
# (CLAMAV_HOST=clamav, CLAMAV_PORT=3310, ATTACHMENTS_DIR=/data/attachments ← на хоста
# /opt/few-few/shared/chatchat/attachments, uid 1000, mode 700 — прави я deploy/deploy.sh).

# --- Семантично търсене (pgvector) — по избор; празно → само точното и пълнотекстовото търсене ---
# EMBEDDING_MODEL=
# EMBEDDING_REGION=

# --- AI: само Google Vertex AI в ЕС (никога директен Anthropic API) ---
# Празно → AI е изключен и /chat/messages връща 503 (без резервен доставчик).
VERTEX_PROJECT_ID=
# „eu“ (мулти-регион; Opus 5 / Sonnet 5 искат него) или „europe-…“. Друго — процесът не тръгва.
VERTEX_REGION=eu
# Път НА ХОСТА до JSON ключа на service account-а. Файлът: собственик uid 1000 (node в контейнера),
# mode 400 — `sudo install -o 1000 -g 1000 -m 400 ключ.json /opt/few-few/shared/chatchat/gcp-sa.json`.
# Монтира се само за четене; празно — без ключ.
GCP_SA_FILE=
# GOOGLE_APPLICATION_CREDENTIALS НЕ се задава тук: docker-compose.yml я слага сама
# (/run/secrets/gcp-sa.json), щом има GCP_SA_FILE.

# --- Прикачени файлове (снимки, логове, PDF за базата знания) ---
# Частната папка за файловете (папки 700, файлове 600; никога публична, никога в nginx root).
# Празно → прикачените файлове са изключени (маршрутите връщат 503 attachments_unavailable).
ATTACHMENTS_DIR=
# HMAC ключ за краткотрайните (5 мин.) подписани адреси за сваляне — поне 32 знака, РАЗЛИЧЕН от
# SESSION_PEPPER (`openssl rand -hex 32`). Задължителен, щом ATTACHMENTS_DIR е зададен.
# Смяната обезсилва само издадените в момента адреси.
ATTACHMENT_URL_KEY=
# Антивирус clamd (протокол INSTREAM през TCP). Празно → качването е изключено (503
# av_unavailable) — без проверка файл не се приема (fail-closed). Вече проверените се свалят.
# В clamd.conf: StreamMaxLength и MaxFileSize поне 60M (PDF до 50 MB), иначе големите файлове
# не се сканират докрай.
CLAMAV_HOST=
# CLAMAV_PORT=3310
# Краен срок за едно сканиране, в ms (1000–120000).
# CLAMAV_TIMEOUT_MS=30000

# --- Наблюдаемост и надеждност (F3: NFR-07, NFR-09) — по избор ---
# Метрики за Prometheus на 127.0.0.1:<METRICS_PORT>/metrics на ХОСТА (никога публично, nginx не го
# проксира). Празно → изключени. Аларми и runbook: deploy/monitoring/alerts.yml, docs/runbook.md.
# METRICS_PORT=9464
# Circuit breaker към Vertex: колко последователни провала го отварят и колко секунди стои отворен
# (през това време AI отговорът е бърз 503 ai_unavailable; после една проба).
# AI_BREAKER_FAILURES=5
# AI_BREAKER_COOLDOWN_SECONDS=30
#
# Стекът за мониторинг и аларми по имейл (docker-compose.monitoring.yml) — по избор. Включва се САМО с
# `sudo bash deploy/monitoring.sh` (той дописва файла в COMPOSE_FILE — списък, заедно с тома на базата).
# Кой получава алармите (няколко — със запетая, без интервали). Без него monitoring.sh отказва (изход 3).
# ALERT_EMAIL_TO=
# Подателят — проверен в Brevo домейн; празно → MAIL_FROM_EMAIL.
# ALERT_EMAIL_FROM=
# SMTP relay-ят (STARTTLS задължително). SMTP login/ключът НЕ са тук — файлове с тайни (400, uid 65534):
# /opt/few-few/shared/chatchat/monitoring/secrets/smtp-user и smtp-password (docs/runbook.md, „Включване“).
# ALERT_SMTP_SMARTHOST=smtp-relay.brevo.com:2525
# Портовете на ХОСТА (само 127.0.0.1; графиките — през SSH тунел):
# PROMETHEUS_PORT=4390
# ALERTMANAGER_PORT=4393
# Колко пази Prometheus (времето покрива 30-дневните SLO-та; размерът пази диска):
# PROMETHEUS_RETENTION_TIME=45d
# PROMETHEUS_RETENTION_SIZE=4GB

# --- По избор (стойностите са тези по подразбиране) ---
# Порт на хоста (само 127.0.0.1); при смяна — и в nginx конфига.
# HTTP_PORT=4330
# SESSION_TTL_HOURS=12
# LOG_LEVEL=info
# Информацията за поверителност (чл. 13/14 GDPR) на клиента — https://…; празно → без връзка.
# PRIVACY_POLICY_URL=
# Ретенция (npm run retention, дневно): отнети/изтекли сесии след N дни; затворени случаи
# (с тикета, съобщенията, хронологията и файловете) след N дни — само ако е зададено от
# администратора. Непривързаните файлове се трият след 24 ч., заразените/непроверените — след
# 7 дни; ретенцията иска същия ATTACHMENTS_DIR, иначе не трие редове с файлове.
# KPI (§16.1): папката с отчетите на оценъчния набор (npm run eval --out …). Празно → метриките,
# които искат експертна истина, са „изисква оценка“. В Docker иска монтиран том само за четене
# (docker-compose.yml още не го носи) — пътят е В контейнера.
# EVAL_REPORTS_DIR=
# RETENTION_SESSION_DAYS=30
# RETENTION_CASE_DAYS=
# Ретенция по класове (NFR-08/13). Празно = подразбирането. Съобщенията по вид разговор не се трият,
# докато администраторът на данните не зададе срок (дискусиите по случай следват случая):
# RETENTION_DIRECT_DAYS=
# RETENTION_GROUP_DAYS=
# RETENTION_CHANNEL_DAYS=
# Известия (90), присъствие — „последно видян“ (7), метаданни: приключени имейли, използвани/изтекли
# линкове за парола, следи на изтрити съобщения (90):
# RETENTION_NOTIFICATION_DAYS=90
# RETENTION_PRESENCE_DAYS=7
# RETENTION_METADATA_DAYS=90
# Одит (дни, мин. 365; по подразбиране 10 г.). Най-старото парче се трие с контролна точка (хешът на
# последното изтрито) — веригата остава проверима. По избор архив (JSONL, 600) преди триенето — иска
# записваем том в контейнера (docker-compose.yml още не го носи):
# RETENTION_AUDIT_DAYS=3650
# RETENTION_AUDIT_ARCHIVE_DIR=
# Непривързани файлове (часове) и заразени/непроверени (дни):
# RETENTION_ORPHAN_HOURS=24
# RETENTION_QUARANTINE_DAYS=7

# --- Интеграция с helpdesk (Zendesk, Jira Service Management, подписан webhook — FR-09, §14.4) ---
# Ключът (openssl rand -base64 32), с който се шифроват тайните на конектора в базата (API токени, HMAC
# ключове). Различен от MFA_ENC_KEY и FILES_KEK; deploy.sh го ражда сам. Празно → интеграцията е изключена.
# Загуба/смяна без INTEGRATION_KEK_PREVIOUS → токените на конектора се въвеждат наново в админ конзолата.
INTEGRATION_KEK=
# Стари ключове след ротация (запетаи) — само за четене; следващият запис на конектора шифрова с новия.
# INTEGRATION_KEK_PREVIOUS=
# През колко секунди изпращачът минава през outbox-а (0 = никога) · опити до dead-letter · таймаут на
# заявка (ms) · прозорец за печата на входящите известия (± s) · дни в дневника на доставките.
# INTEGRATION_SWEEP_SECONDS=15
# INTEGRATION_MAX_ATTEMPTS=10
# INTEGRATION_TIMEOUT_MS=10000
# INTEGRATION_INBOUND_TOLERANCE_SECONDS=300
# INTEGRATION_LOG_DAYS=90

# --- Имейл известия (Brevo, транзакционен HTTPS API — Hetzner блокира 25/465/587) — по избор ---
# Празен ключ → имейлите са изключени (известията в приложението остават, нищо не се трупа).
# Писмото НЕ носи текст на съобщения или лични данни — само „имате ново в X“ + връзка.
# BREVO_API_KEY=
# Подателят — проверен в Brevo домейн; задължителен, щом има ключ.
# MAIL_FROM_EMAIL=no-reply@carbonstealth.eu
# MAIL_FROM_NAME=ChatChat
# Колко чака писмото за ново съобщение (прочетено междувременно → не тръгва); спешното — веднага.
# EMAIL_DELAY_SECONDS=300
# Часът (местно време на човека) на дневния дайджест.
# EMAIL_DIGEST_HOUR=7
# Колко обратни проксита стоят отпред (nginx на хоста = 1).
# TRUST_PROXY=1
# AI_MODEL=claude-opus-5
# low | medium | high
# AI_EFFORT=medium
# AI_MAX_OUTPUT_TOKENS=8000
# AI_MAX_TOOL_ROUNDS=4
# Общ краен срок за един AI отговор, в ms (5000–115000). Под proxy_read_timeout на nginx (120 s).
# AI_TIMEOUT_MS=60000

# Семантично търсене (pgvector) — embeddings в същия ЕС регион (VERTEX_REGION). „off“ → само точно
# + пълнотекстово. Смяна на модела → `npm run embed` (векторите на различни модели не се смесват).
# EMBEDDING_MODEL=gemini-embedding-001
# Таван на една заявка за embedding в ms; въпросът го чака, затова е кратък (fail-open).
# EMBEDDING_TIMEOUT_MS=4000
# Фонов преглед за непокрити публикувани парчета, в секунди (0 = само при публикуване + CLI).
# EMBEDDING_SWEEP_SECONDS=600

# NODE_ENV, HOST и PORT са заковани в docker-compose.yml (production, 0.0.0.0 в контейнера, 4330).

# ═══ STAGING (DEPLOY.md, т. 15) ════════════════════════════════════════════════════════════════════
# Отделен файл: /opt/few-few/shared/chatchat-staging/.env (mode 600). deploy/staging.sh го ражда сам при
# първия пуск — СОБСТВЕНИ ключове (никога тези на продукцията: пазачът отказва деплоя при съвпадение).
# Освен ключовете по-горе (със свои стойности) носи и:
# COMPOSE_PROJECT_NAME=chatchat-staging      # заковано — голото `docker compose` от папката отива в staging
# CHATCHAT_SHARED=/opt/few-few/shared/chatchat-staging
# HTTP_PORT=4331                             # регистърът на портовете — deploy/README.md
# PUBLIC_BASE_URL=https://staging-chatchat.carbonstealth.eu
# Оценъчният набор след всеки деплой на staging (не влиза в контейнера на приложението):
# STAGING_EVAL_MODEL=fake                    # fake (детерминистичен, без разход) | real (Vertex в ЕС)
# STAGING_EVAL_SET=                          # път на хоста до реален набор (uid 1000, 400); празно → evals/sample.json
# BREVO_API_KEY в staging = истински имейли до потребителите на staging — по подразбиране празно.
