# ChatChat — образец на настройките. Истинският .env живее САМО на сървъра (mode 600),
# никога в репото или в архива за деплой. Тайните се генерират на сървъра:
#   openssl rand -hex 32   (по веднъж за POSTGRES_PASSWORD и SESSION_PEPPER — различни)
# В контейнера влиза само изброеното в docker-compose.yml (`environment:`).

# Адресът, на който хората отварят сайта (без / накрая) — по него се проверява Origin (CSRF).
PUBLIC_BASE_URL=https://chatchat.carbonstealth.eu

# База (Docker Compose я вдига сама; паролата е само тук). Влиза некодирана в DATABASE_URL —
# „/“, „?“, „#“, „@“ и „%“ я чупят, затова hex.
POSTGRES_PASSWORD=

# DATABASE_URL НЕ се задава тук: docker-compose.yml го сглобява от POSTGRES_PASSWORD
# (postgresql://chatchat:…@db:5432/chatchat). Само за локален `npm run dev` без Docker:
# DATABASE_URL=postgresql://chatchat:chatchat@127.0.0.1:5432/chatchat

# HMAC „подправка“ за хешовете на сесийните и QR токените — поне 32 знака. Смяната обезсилва
# всички активни сесии и QR токени. Не я сменяй без причина.
SESSION_PEPPER=

# --- AI: само Google Vertex AI в ЕС (никога директен Anthropic API) ---
# Празно → AI е изключен и /chat/messages връща 503 (без резервен доставчик).
VERTEX_PROJECT_ID=
# „eu“ (мулти-регион; Opus 5 / Sonnet 5 искат него) или „europe-…“. Друго — процесът не тръгва.
VERTEX_REGION=eu
# Път НА ХОСТА до JSON ключа на service account-а. Файлът: собственик uid 1000 (node в контейнера),
# mode 400 — `sudo install -o 1000 -g 1000 -m 400 ключ.json /opt/few-few/shared/chatchat/gcp-sa.json`.
# Монтира се само за четене; празно — без ключ.
GCP_SA_FILE=
# GOOGLE_APPLICATION_CREDENTIALS НЕ се задава тук: docker-compose.yml я слага сама
# (/run/secrets/gcp-sa.json), щом има GCP_SA_FILE.

# --- По избор (стойностите са тези по подразбиране) ---
# Порт на хоста (само 127.0.0.1); при смяна — и в nginx конфига.
# HTTP_PORT=4330
# SESSION_TTL_HOURS=12
# LOG_LEVEL=info
# Информацията за поверителност (чл. 13/14 GDPR) на клиента — https://…; празно → без връзка.
# PRIVACY_POLICY_URL=
# Ретенция (npm run retention, дневно): отнети/изтекли сесии след N дни; затворени случаи
# (с тикета, съобщенията и хронологията) след N дни — само ако е зададено от администратора.
# RETENTION_SESSION_DAYS=30
# RETENTION_CASE_DAYS=
# Колко обратни проксита стоят отпред (nginx на хоста = 1).
# TRUST_PROXY=1
# AI_MODEL=claude-opus-5
# low | medium | high
# AI_EFFORT=medium
# AI_MAX_OUTPUT_TOKENS=8000
# AI_MAX_TOOL_ROUNDS=4
# Общ краен срок за един AI отговор, в ms (5000–115000). Под proxy_read_timeout на nginx (120 s).
# AI_TIMEOUT_MS=60000

# NODE_ENV, HOST и PORT са заковани в docker-compose.yml (production, 0.0.0.0 в контейнера, 4330).
