// ChatChat — данни. Спецификация v1.1, §13 (модел на данните), §7.2 (задължителни метаданни),
// §11 (Safety Gate), §13.3 (версия на знанието). Всеки ред на клиентски данни носи tenantId —
// изолацията между клиенти е и в заявките, не само в UI (NFR-03, §15.1).
//
// Извън обхвата засега (по пътната карта §18): обаждания (§12.3, FR-21 — след MVP).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Достъп ─────────────────────────────────────────────────────────────────────────────────

/// Матрицата на достъп (§12.4). Ролите НЕ са строго йерархични — правата идват от src/auth/rbac.ts.
enum Role {
  PORTAL_TECHNICIAN // техник на клиент/портал: само своите случаи и публикуваните документи за портала
  INTERNAL_TECHNICIAN // вътрешен поддръжник: сервизните документи за своя периметър
  SUPPORT // техническа поддръжка: триаж, ескалация, тикети
  ENGINEERING // инженеринг: технически ревизии, бюлетини, вътрешни документи
  KNOWLEDGE_OWNER // отговорник за знанието: качване, преглед, публикуване, отписване
  TENANT_ADMIN // администратор на клиента: потребители, роли, срокове
  PLATFORM_ADMIN // администратор на платформата (Carbon Stealth)
}

enum AccountKind {
  INTERNAL
  PORTAL
}

/// Клиентът на платформата (производителят на таблата). Всичко живее под него.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  companies Company[]
  users     User[]
  products  Product[]
  devices   Device[]
  documents Document[]
  cases     Case[]

  // Записите на F2 сочат клиента си с външен ключ (Restrict): ред без съществуващ клиент няма.
  attachments          Attachment[]
  savedFilters         SavedFilter[]
  conversations        Conversation[]
  quickResponses       QuickResponse[]
  notifications        Notification[]
  // Работното пространство (FR-16/18, NFR-08/13): лични маркери, предпочитания, имейл outbox.
  messageMarks         MessageMark[]
  notificationSettings NotificationSettings[]
  emailOutbox          EmailOutbox[]

  // Работният поток на тикета и човешкото потвърждение (§11.2, FR-09, FR-19).
  stepPolicy     StepApprovalPolicy?
  stepApprovals  StepApproval[]
  stepExecutions CaseStepExecution[]
  ticketEvents   TicketEvent[]
  handoffs       CaseHandoff[]

  // Интеграцията с helpdesk (FR-09, §14.4): конекторът и outbox-ът на доставките.
  helpdeskIntegration HelpdeskIntegration?
  helpdeskDeliveries  HelpdeskDelivery[]
  // Единният вход (OIDC, §14.4, §15.1): доставчиците, домейните, връзките и започнатите входове.
  ssoConfigs          SsoConfig[]
  ssoDomains          SsoDomain[]
  externalIdentities  ExternalIdentity[]
  ssoLoginStates      SsoLoginState[]
  // Обратната връзка към знанието (FR-10, §11.3): опашката на отговорника за знанието.
  knowledgeProposals  KnowledgeProposal[]
  // Пакетното приемане на документи през опашката (§4.1, §7.3, NFR-06).
  ingestBatches       IngestBatch[]
  ingestItems         IngestItem[]
}

/// Фирма в рамките на клиента (монтажник, дистрибутор, сервиз) — разделя портала.
model Company {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users      User[]
  devices    Device[]
  cases      Case[]
  /// Доставчикът на фирмата (по избор) — за порталните ѝ потребители.
  ssoConfigs SsoConfig[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id                String      @id @default(cuid())
  tenantId          String
  companyId         String?
  /// Малки букви, без интервали — уникален в цялата платформа (входът е по имейл).
  email             String      @unique
  name              String
  role              Role
  kind              AccountKind
  passwordHash      String
  active            Boolean     @default(true)
  /// Срок на акаунта (§12.4) — след него входът е отказан.
  expiresAt         DateTime?
  locale            String      @default("it")
  lastLoginAt       DateTime?
  /// TOTP (RFC 6238) — тайната е шифрована с AES-256-GCM (ключът е само на сървъра).
  totpSecretEnc     String?
  totpEnabledAt     DateTime?
  passwordChangedAt DateTime?
  deactivatedAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions             Session[]
  passwordResets       PasswordReset[]
  memberships          ConversationMember[]
  presence             UserPresence?
  notifications        Notification[]
  savedFilters         SavedFilter[]
  messageMarks         MessageMark[]
  notificationSettings NotificationSettings?
  emailOutbox          EmailOutbox[]
  /// Връзката с идентичността при доставчика (OIDC) — създава се при първия единен вход.
  externalIdentity     ExternalIdentity?

  @@index([tenantId])
  @@index([companyId])
}

/// Сесия в базата (не JWT): отнема се веднага при изход, деактивиране или смяна на роля (AC-16).
model Session {
  id          String     @id @default(cuid())
  userId      String
  /// SHA-256 на токена от бисквитката — самият токен не се пази.
  tokenHash   String     @unique
  csrfToken   String
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime   @default(now())
  revokedAt   DateTime?
  /// Вторият фактор е минат (TOTP) — без него персоналът с включен TOTP не минава requireUser.
  mfaPassed   Boolean    @default(false)
  /// Как е започнала сесията: парола или единен вход (OIDC).
  authMethod  AuthMethod @default(PASSWORD)
  /// Вторият фактор е доказан от доставчика (`amr` съдържа `mfa`) и клиентът му се доверява.
  mfaViaIdp   Boolean    @default(false)
  /// Доставчикът на единния вход (само при authMethod = SSO) — за отнемане при смяна на политиката.
  ssoConfigId String?
  /// Сесия с парола в режим REQUIRED за акаунт, който още няма собствена връзка с доставчика:
  /// стига само до /auth/me, /auth/mfa/*, свързването и изхода (403 `sso_link_required`).
  ssoLinkOnly Boolean    @default(false)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoConfig SsoConfig?      @relation(fields: [ssoConfigId], references: [id], onDelete: SetNull)
  ssoStates SsoLoginState[]

  @@index([userId])
  @@index([expiresAt])
  @@index([ssoConfigId])
}

enum AuthMethod {
  PASSWORD
  SSO
}

// ─── Продукт ────────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  family      String
  model       String
  description String   @default("")
  createdAt   DateTime @default(now())

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revisions     ProductRevision[]
  applicability DocumentApplicability[]
  errors        ErrorCode[]

  @@unique([tenantId, model])
  @@index([tenantId, family])
}

/// Хардуерна ревизия с поддържания обхват на фърмуера (§13.1 product_revisions).
model ProductRevision {
  id         String  @id @default(cuid())
  productId  String
  hwRevision String
  fwMin      String
  /// null = без горна граница.
  fwMax      String?

  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  devices Device[]

  @@unique([productId, hwRevision])
  @@index([productId])
}

/// Физическото табло на обекта (§13.1 devices).
model Device {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String?
  serial            String
  productRevisionId String
  /// Инсталираният фърмуер — може да се различава от началото на обхвата на ревизията.
  firmware          String
  /// Опции/конфигурация (инвертор, брой спирки…) — само технически данни, без лични.
  options           Json     @default("{}")
  /// SHA-256 на токена в QR етикета (FR-13); самият токен не се пази.
  qrTokenHash       String?  @unique
  createdAt         DateTime @default(now())

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company       Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  revision      ProductRevision         @relation(fields: [productRevisionId], references: [id], onDelete: Restrict)
  cases         Case[]
  /// Документите, вързани САМО за това табло (уникалните му схеми — решение на собственика).
  documentRules DocumentApplicability[]

  @@unique([tenantId, serial])
  @@index([companyId])
  @@index([productRevisionId])
}

// ─── Знание ─────────────────────────────────────────────────────────────────────────────────

enum DocumentType {
  MANUAL
  SCHEMATIC
  ERROR_LIST
  FAQ
  BULLETIN
  PROCEDURE
  SOLVED_CASE
}

/// Работният поток Draft → Review → Published → Deprecated (§4.1). AI вижда САМО Published (§7.3).
enum KnowledgeStatus {
  DRAFT
  REVIEW
  PUBLISHED
  DEPRECATED
}

/// Кой може да вижда документа (§12.4): портал ⊂ вътрешни ⊂ инженеринг.
enum Audience {
  PORTAL
  INTERNAL
  ENGINEERING
}

/// Документите са НЕИЗМЕНИМИ и се пазят завинаги (решение на собственика): публикуван документ не
/// се редактира — само преходи на статуса. Нова ревизия не отписва старата; отписването е изрично
/// действие с причина и е обратимо (DEPRECATED → REVIEW → PUBLISHED). Ретенцията не ги трие.
model Document {
  id             String          @id @default(cuid())
  tenantId       String
  /// Стабилният код на документа (напр. „DOC-0042“, „LTX500-ELEC-042“) — един и същ през ревизиите.
  code           String
  title          String
  type           DocumentType
  language       String
  revision       String
  status         KnowledgeStatus @default(DRAFT)
  audience       Audience        @default(INTERNAL)
  safetyRelevant Boolean         @default(false)
  subsystem      String?
  sourceFilename String
  /// SHA-256 на оригиналния файл (§7.2, §17.3) — неизменим.
  checksum       String
  /// Валидност (§7.2 effective_from/to): извън [effectiveFrom, effectiveTo] документът е
  /// неприложим за отговорите, колкото и да е PUBLISHED. effectiveFrom е задължителен.
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  uploadedById   String
  /// Кой го е пратил за преглед (submit/възстановяване) — и той не публикува документ по безопасност.
  submittedById  String?
  reviewedById   String?
  approvedById   String?
  approvedAt     DateTime?
  publishedAt    DateTime?
  deprecatedAt   DateTime?
  supersedesId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supersedes      Document?               @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    Document[]              @relation("Supersedes")
  applicability   DocumentApplicability[]
  chunks          DocumentChunk[]
  errors          ErrorCode[]
  /// Предложенията (FR-10): черновата SOLVED_CASE и документът, с който е прието предложение.
  proposalDrafts  KnowledgeProposal[]     @relation("ProposalDraft")
  proposalResults KnowledgeProposal[]     @relation("ProposalResultDocument")
  ingestItems     IngestItem[]

  @@unique([tenantId, code, revision])
  @@index([tenantId, status])
  @@index([supersedesId])
}

/// Правило за съвместимост (§13.1 document_applicability): модел + по избор HW ревизия, обхват на
/// FW и КОНКРЕТНО табло. Фърмуерът е изричен: обхват ИЛИ `allFirmware` (не мълчалив null —
/// CHECK в миграцията 20261010110000). С `deviceId` правилото важи САМО за случай с това табло.
model DocumentApplicability {
  id          String  @id @default(cuid())
  documentId  String
  productId   String
  /// null = всички хардуерни ревизии на модела.
  hwRevision  String?
  fwMin       String?
  fwMax       String?
  /// Изрично „всички версии на фърмуера“ (тогава fwMin/fwMax са null).
  allFirmware Boolean @default(false)
  /// Само за това табло (уникална схема); null = за всички табла на модела.
  deviceId    String?
  /// Ограничение по опциите на таблото (FR-01): {"inverter": "VF-3"} — всяка двойка ключ/стойност
  /// трябва да е РАВНА на опцията в контекста на случая; {} = всички конфигурации. Съвпадението
  /// е само в `retrieval/applicability.ts` + `store/scope.ts` (несъвпадение → неприложим, не скрит).
  options     Json    @default("{}")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([productId])
  @@index([deviceId])
}

/// Индексът за търсене (§7.3): парче текст със страница и раздел — основата на всеки цитат.
model DocumentChunk {
  id             String                      @id @default(cuid())
  documentId     String
  ordinal        Int
  page           Int
  section        String?
  text           String
  /// Референции на компоненти, намерени в парчето (K1, X3, S12…) — точно съвпадение (§8.2).
  componentRefs  String[]
  /// Кодове за грешка, споменати в парчето — точно съвпадение (§8.2).
  errorCodes     String[]
  /// to_tsvector('simple', section || text) — попълва се от src/store/prisma.ts при запис.
  tsv            Unsupported("tsvector")?
  /// Семантичен вектор (pgvector, 768 измерения, косинус) — пише се само за PUBLISHED документи
  /// (src/store/embeddings.ts). HNSW индексът е в миграцията 20261009100000_semantic_embeddings.
  embedding      Unsupported("vector(768)")?
  /// С кой модел е смятан векторът („gemini-embedding-001@768“) — друг модел → преизчисляване.
  embeddingModel String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId, page])
  @@index([tsv], type: Gin)
  @@index([componentRefs], type: Gin)
  @@index([errorCodes], type: Gin)
  /// USING hnsw (embedding vector_cosine_ops) — Prisma не изразява hnsw; създава го миграцията.
  @@index([embedding], map: "DocumentChunk_embedding_hnsw_idx")
}

enum Severity {
  INFO
  WARNING
  FAULT
  CRITICAL
}

/// Класовете действия (§11.1). Редът е по риск — Safety Gate взима по-строгия от двата класа
/// (обявения от модела и откритият от речника).
enum ActionClass {
  INFORMATIVE
  DIAGNOSTIC
  CONFIGURATIVE
  SAFETY_RELEVANT
  DIRECT_COMMAND
}

/// Код за грешка (§13.1 errors) — версиониран като документите: един код може да значи
/// различно нещо в различен фърмуер (§16.3 „грешна версия, същото име“). Жизнен цикъл (FR-04):
/// DRAFT (редактируема) → REVIEW → PUBLISHED → DEPRECATED (с причина, обратимо); версиите се пазят.
model ErrorCode {
  id               String          @id @default(cuid())
  tenantId         String
  productId        String
  code             String
  title            String
  description      String
  subsystem        String?
  severity         Severity
  safetyRelevant   Boolean         @default(false)
  hwRevision       String?
  fwMin            String?
  fwMax            String?
  status           KnowledgeStatus @default(DRAFT)
  version          Int             @default(1)
  sourceDocumentId String?
  sourcePage       Int?
  /// Кой е подготвил ТАЗИ версия (създал, редактирал, пратил за преглед, възстановил) — никой от
  /// тях не публикува версия, свързана с безопасността (четири очи, FR-04 / §11.3).
  authorIds        String[]        @default([])
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceDocument Document?           @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  relations      ErrorRelation[]
  proposals      KnowledgeProposal[]

  @@index([tenantId, code])
  @@index([tenantId, status])
  @@index([productId, code])
  @@index([sourceDocumentId])
}

enum ErrorRelationKind {
  SYMPTOM
  CAUSE
  CHECK
  FIX
}

/// Диагностичното знание за кода (§13.1 error_relations): симптоми, причини, проверки, поправки.
model ErrorRelation {
  id               String            @id @default(cuid())
  errorId          String
  kind             ErrorRelationKind
  ordinal          Int
  text             String
  /// За CHECK: какво трябва да види техникът (§10.2 „Risultato atteso“).
  expected         String?
  actionClass      ActionClass       @default(INFORMATIVE)
  sourceDocumentId String?
  sourcePage       Int?

  error ErrorCode @relation(fields: [errorId], references: [id], onDelete: Cascade)

  @@index([errorId])
}

/// Кои документи (с ревизия и checksum) са били публикувани в момента на отговора (§13.3).
/// id = SHA-256 на подредения списък — същото знание дава същия снимков идентификатор.
model KnowledgeSnapshot {
  id        String   @id
  tenantId  String
  /// [{ id, code, revision, checksum }] + [{ errorId, version }]
  manifest  Json
  createdAt DateTime @default(now())

  messages CaseMessage[]

  @@index([tenantId])
}

// ─── Случаи ─────────────────────────────────────────────────────────────────────────────────

/// Моделът на състоянието на разговора (§12.4).
enum CaseStatus {
  OPEN
  AI_IN_PROGRESS
  WAITING_TECHNICIAN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
}

enum CaseOutcome {
  RESOLVED
  NOT_RESOLVED
  ESCALATED
}

model Case {
  id           String       @id @default(cuid())
  tenantId     String
  /// Човешкият номер, напр. „CASE-2026-004821“.
  number       String       @unique
  companyId    String?
  deviceId     String?
  /// Случай, отворен от портален акаунт: AI търси САМО в портални документи, който и да пита
  /// (AC-18 — портален разговор не излага вътрешни източници).
  portal       Boolean      @default(false)
  /// Техническият контекст (§10.1) — винаги видим и редактируем (FR-02); снимка при всяка промяна.
  context      Json
  status       CaseStatus   @default(OPEN)
  outcome      CaseOutcome?
  createdById  String
  assignedToId String?
  /// FR-19: техникът е предал случая на оператор — AI не отговаря на техника, докато операторът
  /// не го „върне към AI“ (персоналът с `case:assign` може да пита AI и тогава).
  aiPaused     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  closedAt     DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company        Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device         Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  messages       CaseMessage[]
  evidence       CaseEvidence[]
  timeline       CaseTimelineEvent[]
  ticket         Ticket?
  attachments    Attachment[]
  conversation   Conversation?
  stepApprovals  StepApproval[]
  stepExecutions CaseStepExecution[]
  handoffs       CaseHandoff[]
  proposals      KnowledgeProposal[]

  @@index([tenantId, status])
  @@index([companyId])
  @@index([deviceId])
  @@index([createdById])
}

enum MessageKind {
  HUMAN
  AI
  SYSTEM
}

model CaseMessage {
  id                  String                   @id @default(cuid())
  caseId              String
  kind                MessageKind
  authorId            String?
  body                String
  /// Структурираният диагностичен отговор (§14.3) — само за kind = AI, след Safety Gate.
  payload             Json?
  knowledgeSnapshotId String?
  /// Версията на промпта/правилата, дала отговора (NFR-04, AC-09).
  promptVersion       String?
  /// Идентификатор от клиента за идемпотентно изпращане (NFR-12): повтор не дублира съобщението.
  clientMessageId     String?
  /// Аудиториите, с които е търсено за този AI отговор. Читател без всички тях не вижда
  /// съдържанието (цитати от вътрешни/инженерни документи не изтичат към по-тесни роли).
  audiences           Audience[]               @default([])
  createdAt           DateTime                 @default(now())
  /// Търсене в историята (FR-16): to_tsvector('chatchat_search', body) — ГЕНЕРИРАНА колона
  /// (GENERATED ALWAYS … STORED в миграцията 20261010120000; Prisma го вижда като dbgenerated). Не се пише.
  tsv                 Unsupported("tsvector")? @default(dbgenerated("to_tsvector('chatchat_search'::regconfig, body)"))

  case              Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  knowledgeSnapshot KnowledgeSnapshot?  @relation(fields: [knowledgeSnapshotId], references: [id], onDelete: Restrict)
  evidence          CaseEvidence[]
  feedback          Feedback[]
  attachments       Attachment[]
  stepApprovals     StepApproval[]
  stepExecutions    CaseStepExecution[]
  proposals         KnowledgeProposal[]

  @@unique([caseId, clientMessageId])
  @@index([caseId, createdAt])
  @@index([knowledgeSnapshotId])
  @@index([tsv], type: Gin)
}

/// Проследимост (§13.1 case_evidence): кое парче/код е подкрепило кой отговор.
model CaseEvidence {
  id         String  @id @default(cuid())
  caseId     String
  messageId  String
  documentId String?
  chunkId    String?
  errorId    String?
  page       Int?
  quote      String?

  case    Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message CaseMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([messageId])
  @@index([documentId])
}

/// Единната хронология на случая (§13.1 case_timeline_events, AC-19).
model CaseTimelineEvent {
  id      String   @id @default(cuid())
  caseId  String
  type    String
  actorId String?
  payload Json     @default("{}")
  at      DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, at])
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  CLOSED
}

/// Опашката на тикета: поддръжка по подразбиране; „прехвърли към Engineering“ (FR-19) го мести.
enum TicketQueue {
  SUPPORT
  ENGINEERING
}

/// Ескалация (§13.1 tickets): CASE 0..1 TICKET. Обобщението се сглобява от сървъра (AC-08).
/// Машината на преходите е в src/services/tickets/flow.ts; всяка промяна минава през
/// `recordTicketEvent` (src/services/tickets/events.ts) в транзакцията на промяната.
model Ticket {
  id          String       @id @default(cuid())
  caseId      String       @unique
  number      String       @unique
  status      TicketStatus @default(OPEN)
  queue       TicketQueue  @default(SUPPORT)
  ownerId     String?
  reason      String
  summary     Json
  /// При затваряне (FR-09): първопричина, решение, свързани източници (текстът — с redactPii).
  resolution  Json?
  closedAt    DateTime?
  closedById  String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// Cascade: ретенцията изтрива затворения случай заедно с тикета (GDPR чл. 5(1)(e)).
  case               Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  events             TicketEvent[]
  infoRequests       TicketInfoRequest[]
  handoffs           CaseHandoff[]
  /// Външният запис в helpdesk-а (id/ключ) — services/integrations.
  helpdeskLink       HelpdeskLink?
  helpdeskDeliveries HelpdeskDelivery[]

  @@index([ownerId])
  @@index([status, queue, createdAt])
}

/// Откъде идва промяната по тикета: от ChatChat или от helpdesk-а (обратната синхронизация).
/// Промяна от helpdesk-а НЕ се връща към него (без ехо) — outbox-ът я пропуска.
enum TicketEventSource {
  APP
  EXTERNAL
}

/// Дневникът на промените по тикета — по един ред на промяна, в транзакцията ѝ. При включена
/// интеграция всеки ред от ChatChat ражда доставка в outbox-а към helpdesk (`HelpdeskDelivery`).
/// В payload — само идентификатори и кодове.
model TicketEvent {
  id         String            @id @default(cuid())
  tenantId   String
  ticketId   String
  caseId     String
  type       String
  actorId    String?
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  payload    Json              @default("{}")
  source     TicketEventSource @default(APP)
  at         DateTime          @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  helpdeskDelivery HelpdeskDelivery?

  @@index([ticketId, at])
  @@index([tenantId, at])
}

/// „Поискай още данни“ (FR-19): какво иска операторът; отговорът на техника го затваря.
model TicketInfoRequest {
  id                String    @id @default(cuid())
  ticketId          String
  /// Списък от низове (маскирани с redactPii) — техникът го вижда в случая.
  items             Json
  note              String?
  requestedById     String
  createdAt         DateTime  @default(now())
  answeredAt        DateTime?
  answeredMessageId String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Посоката на предаване по FR-19: техник → оператор, оператор → Engineering, оператор → AI.
enum HandoffDirection {
  TO_OPERATOR
  TO_ENGINEERING
  TO_AI
}

/// Предаване (FR-19, AC-14): носи резюмето в момента на предаването (контекст, източници, файлове,
/// изпълнени стъпки, разрешения) и причината — операторът не пита техника за нищо повторно.
model CaseHandoff {
  id         String           @id @default(cuid())
  tenantId   String
  caseId     String
  ticketId   String?
  direction  HandoffDirection
  /// Причината/съобщението — маскирано с redactPii.
  reason     String
  summary    Json?
  fromUserId String
  createdAt  DateTime         @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([ticketId])
  @@index([tenantId, createdAt])
}

// ─── Изпълнени стъпки и човешко потвърждение (§11.2 Human-in-the-loop) ────────────────────────

enum StepResult {
  OK
  KO
  NOT_POSSIBLE
}

/// Кой разрешава стъпка (§11.2): NONE — без разрешение; SELF — самият техник с изрично
/// потвърждение, че е прочел процедурата; SUPPORT / ENGINEERING — ДРУГ човек с тази роля.
enum ApprovalLevel {
  NONE
  SELF
  SUPPORT
  ENGINEERING
}

enum ApprovalStatus {
  PENDING
  GRANTED
  DENIED
  CANCELLED
}

/// Политиката на клиента. Без ред → разумният default от src/services/steps/policy.ts.
/// SAFETY_RELEVANT никога не е NONE; DIRECT_COMMAND не се изпълнява никога.
model StepApprovalPolicy {
  tenantId       String        @id
  safetyRelevant ApprovalLevel @default(SUPPORT)
  configurative  ApprovalLevel @default(NONE)
  /// Колко минути важи разрешението (смяната на обекта, не завинаги).
  ttlMinutes     Int           @default(480)
  updatedById    String?
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// Заявка/разрешение за стъпка (§11.2): КОЙ е разрешил, кога, за коя стъпка (хеш + източници).
model StepApproval {
  id             String         @id @default(cuid())
  tenantId       String
  caseId         String
  messageId      String
  step           Int
  /// SHA-256 на текста на стъпката (действие + очакван резултат) — разрешението е за ТОЗИ текст.
  stepHash       String
  actionClass    ActionClass
  gateVersion    String
  level          ApprovalLevel
  /// Източниците, които документират стъпката: [{ ref, documentId, documentCode, revision, page, chunkId, errorId }].
  sources        Json           @default("[]")
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  requestNote    String?
  /// SELF: техникът е потвърдил изрично, че е прочел документираната процедура.
  selfAttested   Boolean        @default(false)
  decidedById    String?
  /// Ролята на разрешилия в момента на решението — порталът вижда нея, не името.
  decidedRole    Role?
  decisionReason String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message    CaseMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  executions CaseStepExecution[]

  @@index([tenantId, status, createdAt])
  @@index([caseId])
  @@index([messageId, step])
  @@index([requestedById])
  @@index([decidedById])
}

/// Изпълнена стъпка от AI отговора (FR-09 „passi eseguiti“): резултат, бележка, кой и кога.
model CaseStepExecution {
  id          String      @id @default(cuid())
  tenantId    String
  caseId      String
  messageId   String
  step        Int
  stepHash    String
  actionClass ActionClass
  gateVersion String
  result      StepResult
  /// Бележката на техника — маскирана с redactPii; НЕ влиза в хронологията и одита.
  note        String?
  approvalId  String?
  authorId    String
  createdAt   DateTime    @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case     Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message  CaseMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  approval StepApproval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([messageId, step])
  @@index([approvalId])
  @@index([authorId])
  @@index([tenantId])
}

enum FeedbackRating {
  USEFUL
  NOT_USEFUL
  TECHNICAL_ERROR
}

model Feedback {
  id        String         @id @default(cuid())
  messageId String
  userId    String
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now())

  message   CaseMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  proposals KnowledgeProposal[]

  @@unique([messageId, userId])
}

// ─── Обратна връзка към знанието (FR-10, §11.3) ───────────────────────────────────────────────

/**
 * Откъде идва предложението за подобрение на знанието.
 */
enum ProposalSource {
  FEEDBACK // „Non utile“ / „Errore tecnico“ с коментар върху AI отговор
  SOLVED_CASE // персоналът предлага решен случай → ЧЕРНОВА документ SOLVED_CASE (§11.3 „richiede review“)
  CONFLICT // търсенето/Safety Gate е отчело конфликт между източници (§11.3 „flag per owner“)
}

/**
 * Опашката на KNOWLEDGE_OWNER: NEW → IN_REVIEW → ACCEPTED (с връзка) | REJECTED (с причина).
 */
enum ProposalStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  REJECTED
}

/**
 * Предложение за подобрение на знанието — ВЪТРЕШНО: вижда го само kb:manage, порталът никога.
 * Свободният текст (коментар, причина) е маскиран с `redactPii`; имена на хора в него няма.
 * Конфликтите са дедупликирани по `dedupeKey` (SHA-256 на вида, кода и източниците) —
 * повторението само увеличава `occurrences` (services/proposals/conflicts.ts).
 */
model KnowledgeProposal {
  id               String          @id @default(cuid())
  tenantId         String
  source           ProposalSource
  status           ProposalStatus  @default(NEW)
  /// Случаят/отговорът, от който идва (вътрешна връзка; ретенцията на случая я нулира).
  caseId           String?
  messageId        String?
  feedbackId       String?
  rating           FeedbackRating?
  /// Коментарът на техника или бележката на предложилия — маскирани (redactPii), до 1000 знака.
  comment          String?
  /// CONFLICT: подписът за дедупликация + какво противоречи на какво (само кодове/ревизии/id).
  dedupeKey        String?
  conflict         Json?
  occurrences      Int             @default(1)
  lastSeenAt       DateTime        @default(now())
  /// SOLVED_CASE: черновата, създадена през нормалния жизнен цикъл (DRAFT → REVIEW → PUBLISHED).
  draftDocumentId  String?
  /// ACCEPTED: с какво е прието — новият/поправеният документ или код за грешка.
  resultDocumentId String?
  resultErrorId    String?
  /// null = автоматично (конфликт, открит от системата).
  createdById      String?
  reviewerId       String?
  decidedById      String?
  decidedAt        DateTime?
  /// REJECTED: причината — маскирана (redactPii).
  rejectReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case           Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  message        CaseMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  feedback       Feedback?    @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  draftDocument  Document?    @relation("ProposalDraft", fields: [draftDocumentId], references: [id], onDelete: Restrict)
  resultDocument Document?    @relation("ProposalResultDocument", fields: [resultDocumentId], references: [id], onDelete: Restrict)
  resultError    ErrorCode?   @relation(fields: [resultErrorId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, source])
  @@index([tenantId, dedupeKey])
  @@index([caseId])
  @@index([messageId])
  @@index([feedbackId])
  @@index([draftDocumentId])
  @@index([resultDocumentId])
  @@index([resultErrorId])
}

/// Неизменим одит (§15.1, FR-12): верига hash = SHA-256(prevHash | at | action | tenant | actor | object | detail).
model AuditEvent {
  id         Int      @id @default(autoincrement())
  tenantId   String?
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  detail     Json?
  at         DateTime @default(now())
  prevHash   String
  hash       String   @unique

  @@index([tenantId, at])
  @@index([actorId])
}

// ─── Прикачени файлове (F2, FR-06, §13.1 message_attachments) ─────────────────────────────────

enum AttachmentKind {
  PHOTO // снимка от телефона: дисплей, табелка, платка, клемореди
  LOG // CSV / TXT / JSON от таблото
  DOCUMENT // PDF за приемане в базата знания (само KNOWLEDGE_OWNER)
}

/// Антивирус ПРЕДИ всичко друго (§7.3 т. 1): докато не е CLEAN, файлът не се показва и не стига до AI.
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

model Attachment {
  id                    String         @id @default(cuid())
  tenantId              String
  caseId                String?
  caseMessageId         String?
  /// Разговорът, за който е качен файлът (§12.1 „Allegati chat“) — достъпът е достъпът до разговора;
  /// докато не е привързан към съобщение, го вижда само качилият.
  conversationId        String?
  conversationMessageId String?
  uploadedById          String
  kind                  AttachmentKind
  /// MIME по съдържанието (магически байтове), не по името или заглавката на клиента.
  mime                  String
  sizeBytes             Int
  sha256                String
  /// Път в частното хранилище — никога публичен URL; сваляне само с подписан краткотраен адрес.
  objectKey             String         @unique
  /// Името от клиента, изчистено (без пътища и контролни знаци) — само за показване.
  originalName          String
  scanStatus            ScanStatus     @default(PENDING)
  scannedAt             DateTime?
  /// AI анализ на снимката (FR-06, §9.2): допълнително доказателство, не основно.
  analysis              Json?
  createdAt             DateTime       @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case?                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseMessage         CaseMessage?         @relation(fields: [caseMessageId], references: [id], onDelete: SetNull)
  conversation        Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationMessage ConversationMessage? @relation(fields: [conversationMessageId], references: [id], onDelete: Cascade)
  ingestItems         IngestItem[]

  @@index([tenantId])
  @@index([caseId])
  @@index([caseMessageId])
  @@index([conversationId])
  @@index([conversationMessageId])
  @@index([uploadedById])
}

// ─── Идентичност (FR-22/25, §12.4) ────────────────────────────────────────────────────────────

/// Нулиране на парола: еднократен линк, генериран от админа; паролата никога не се показва/праща.
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  /// HMAC на токена — самият токен е само в линка.
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Единен вход: OIDC / Microsoft Entra ID (§14.4, §15.1, §12.4) ────────────────────────────

enum SsoProvider {
  ENTRA // Microsoft Entra ID: издателят се извежда от tenant id (tid), проверява се и tid
  OIDC // общ OpenID Connect доставчик (Keycloak, Okta, Google Workspace…)
}

enum SsoMode {
  OPTIONAL // единният вход е по избор, паролата остава
  REQUIRED // паролата е отказана за обхвата (вътрешните на клиента / потребителите на фирмата)
}

/// Доставчикът на клиента (companyId = null → вътрешните) или на фирма (порталните ѝ потребители).
model SsoConfig {
  id              String      @id @default(cuid())
  tenantId        String
  companyId       String?
  /// „internal“ или id на фирмата — един доставчик на обхват (NULL в уникален индекс не пази).
  scopeKey        String
  provider        SsoProvider
  /// Името на бутона за общ OIDC („Accedi con …“); за Entra е „Microsoft“.
  displayName     String      @default("")
  /// Издателят (iss) точно както го връща discovery; за Entra — извеждан от entraTenantId.
  issuer          String
  /// Entra: GUID на директорията — iss и tid в токена трябва да са точно тях.
  entraTenantId   String?
  clientId        String
  /// AES-256-GCM със SSO_KEK, вързано към клиента и записа (services/sso/secret.ts) — никога в
  /// API, лог или одит.
  clientSecretEnc String
  secretUpdatedAt DateTime    @default(now())
  mode            SsoMode     @default(OPTIONAL)
  /// Доверява ли се клиентът на MFA при доставчика (`amr` съдържа `mfa`) вместо локалния TOTP.
  trustIdpMfa     Boolean     @default(false)
  /// Изход и при доставчика (RP-initiated logout) — по избор.
  idpLogout       Boolean     @default(false)
  enabled         Boolean     @default(false)
  /// Последният интерактивен „Тест на конфигурацията“ — нулира се при смяна на доставчика/клиента.
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  /// Само флагове и кодове (без лични данни и без токени).
  lastTestReport  Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  domains    SsoDomain[]
  identities ExternalIdentity[]
  states     SsoLoginState[]
  sessions   Session[]

  @@unique([tenantId, scopeKey])
  @@index([companyId])
}

/// Позволен имейл домейн на доставчика — уникален в платформата (по него входът намира доставчика).
model SsoDomain {
  id             String    @id @default(cuid())
  tenantId       String
  configId       String
  /// Малки букви, без „@“. Заявка — няколко доставчика могат да го заявят; доказва го само един.
  domain         String
  /// Случаен — от него (с SESSION_PEPPER) се извежда токенът на DNS TXT записа; самият токен не се пази.
  tokenNonce     String    @default(dbgenerated("gen_random_uuid()::text"))
  /// Доказана собственост (DNS TXT или операторът през CLI). Без нея домейнът не участва във входа.
  verifiedAt     DateTime?
  /// = domain, когато е доказан (иначе NULL) — уникален: доказаният домейн е само на един доставчик.
  verifiedDomain String?   @unique
  createdAt      DateTime  @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  config SsoConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, domain])
  @@index([tenantId])
  @@index([configId])
  @@index([domain])
}

enum SsoLinkMethod {
  EMAIL // първи вход по проверен имейл в доказан домейн (само акаунти без собствен фактор и под ранга на администратора)
  SELF // самият собственик от сесия с парола + TOTP („Свържи“)
}

/// Връзката на локален акаунт с идентичност при доставчика. Първият вход е по проверен имейл;
/// след него — само по (issuer, externalSubject). Акаунти не се създават от входа.
model ExternalIdentity {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String        @unique
  configId        String
  issuer          String
  /// Стабилният идентификатор: Entra — `oid`; общ OIDC — `sub`.
  externalSubject String
  /// Как е направена връзката — от нея зависи дали доставчикът замества локалния TOTP.
  linkMethod      SsoLinkMethod @default(EMAIL)
  createdAt       DateTime      @default(now())
  lastLoginAt     DateTime?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  config SsoConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([issuer, externalSubject])
  @@index([tenantId])
  @@index([configId])
}

/// Започнат вход (Authorization Code + PKCE): еднократен, 10 минути, вързан към браузъра. В базата
/// са само HMAC-ите на state и на бисквитката; nonce и code_verifier се извеждат от бисквитката.
model SsoLoginState {
  id          String    @id @default(cuid())
  tenantId    String
  configId    String
  stateHash   String    @unique
  bindingHash String
  /// login | test | link
  purpose     String
  /// Тестът: администраторът, който го е пуснал (за одита); свързването — собственикът на акаунта.
  actorId     String?
  /// Свързването: сесията (парола + TOTP), от която е започнато — връщането важи само докато е жива.
  sessionId   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  config  SsoConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  session Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([configId])
  @@index([sessionId])
  @@index([expiresAt])
}

enum SavedFilterScope {
  USERS
  CASES
  CONVERSATIONS
}

/// Запазени филтри (FR-23): лични или споделени в клиента; само по разрешени полета.
model SavedFilter {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  scope     SavedFilterScope
  name      String
  filter    Json
  shared    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope])
  @@index([userId])
}

// ─── Работно пространство (§12.3, FR-15…FR-20, §13.1) ────────────────────────────────────────

enum ConversationType {
  DIRECT // двама души
  GROUP // няколко души, без име
  CHANNEL // именуван канал на екип/семейство продукти
  CASE // разговорът на технически случай (1:1 с Case)
}

enum ConversationVisibility {
  PUBLIC // каналът се вижда от вътрешните хора на клиента
  PRIVATE // само членовете (Engineering, Urgenze — §12.3 по подразбиране)
}

model Conversation {
  id          String                 @id @default(cuid())
  tenantId    String
  type        ConversationType
  name        String?
  visibility  ConversationVisibility @default(PRIVATE)
  /// Разговор с портални участници: вътрешни канали/документи не изтичат в него (AC-18).
  portal      Boolean                @default(false)
  caseId      String?                @unique
  createdById String
  createdAt   DateTime               @default(now())
  archivedAt  DateTime?

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case        Case?                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    ConversationMessage[]
  attachments Attachment[]

  @@index([tenantId, type])
}

enum MemberRole {
  OWNER
  MEMBER
}

enum NotificationPref {
  ALL
  MENTIONS
  NONE
}

model ConversationMember {
  conversationId    String
  userId            String
  role              MemberRole       @default(MEMBER)
  joinedAt          DateTime         @default(now())
  /// Курсор за прочетено (FR-16, NFR-12) — непрочетените са след него.
  lastReadMessageId String?
  lastReadAt        DateTime?
  notificationPref  NotificationPref @default(ALL)
  /// „Предпочитани“ в лявата лента (FR-15).
  starred           Boolean          @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

enum ConversationMessageKind {
  HUMAN
  AI
  SYSTEM
}

model ConversationMessage {
  id              String                   @id @default(cuid())
  conversationId  String
  senderId        String?
  kind            ConversationMessageKind  @default(HUMAN)
  body            String
  replyToId       String?
  /// Идемпотентно изпращане (NFR-12).
  clientMessageId String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  /// Търсене в историята (FR-16): to_tsvector('chatchat_search', body) — ГЕНЕРИРАНА колона
  /// (GENERATED ALWAYS … STORED в миграцията 20261010120000); изтритото (body '') не се намира.
  tsv             Unsupported("tsvector")? @default(dbgenerated("to_tsvector('chatchat_search'::regconfig, body)"))

  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      ConversationMessage?  @relation("Thread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ConversationMessage[] @relation("Thread")
  reactions    MessageReaction[]
  attachments  Attachment[]
  marks        MessageMark[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@index([tsv], type: Gin)
}

/// Реакции (§13.1): незадължителни, никога доказателство.
model MessageReaction {
  messageId String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, reaction])
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

/// Присъствие (FR-18, §15): само за координация — не е доказателство за дежурство; кратка ретенция.
model UserPresence {
  userId       String         @id
  status       PresenceStatus @default(OFFLINE)
  lastSeenAt   DateTime       @default(now())
  /// false → другите виждат само ONLINE/OFFLINE без „последно видян“.
  showLastSeen Boolean        @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Бързи отговори (FR-20, AC-15): по роля/група, версионирани, редактируеми преди изпращане.
model QuickResponse {
  id          String          @id @default(cuid())
  tenantId    String
  shortcut    String
  locale      String
  title       String
  body        String
  roleScope   Role[]
  version     Int             @default(1)
  status      KnowledgeStatus @default(DRAFT)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, shortcut, locale, version])
  @@index([tenantId, status])
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// Известия (FR-18): дедупликация по (потребител, събитие, обект) в рамките на непрочетените.
model Notification {
  id          String              @id @default(cuid())
  tenantId    String
  userId      String
  eventType   String
  objectType  String
  objectId    String
  payload     Json                @default("{}")
  channel     NotificationChannel @default(IN_APP)
  createdAt   DateTime            @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailOutbox[]

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// ─── Лични маркери, предпочитания, имейл известия, ретенция (FR-16/18, NFR-08/12/13) ───────────

enum MessageMarkKind {
  TODO // „da fare“ (§12.1)
  STARRED // „aggiungi ai preferiti“ — любимо съобщение
}

/// Лични маркери на съобщение — вижда ги само човекът; достъпът до съобщението се проверява
/// при всяко четене (изгубен достъп до разговора = маркерът не се показва).
model MessageMark {
  messageId String
  userId    String
  kind      MessageMarkKind
  tenantId  String
  createdAt DateTime        @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([messageId, userId, kind])
  @@index([userId, kind, createdAt])
  @@index([tenantId])
}

enum EmailDigest {
  OFF
  DAILY
}

/// Личните предпочитания за известията (FR-18, §12.3 „digest email configurabili“). Няма ред →
/// подразбиранията. Предпочитанията по разговор са в ConversationMember.notificationPref.
model NotificationSettings {
  userId       String      @id
  tenantId     String
  emailEnabled Boolean     @default(true)
  digest       EmailDigest @default(OFF)
  /// Тихи часове в минути от полунощ (0…1439) по `timeZone`; null → без тихи часове.
  quietStart   Int?
  quietEnd     Int?
  /// IANA часова зона (Europe/Rome) — за тихите часове и часа на дайджеста.
  timeZone     String      @default("Europe/Rome")
  updatedAt    DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([digest])
}

enum EmailKind {
  MENTION
  MESSAGE
  CASE_ASSIGNED
  CASE_URGENT
  DIGEST
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Изходящите имейл известия (transactional outbox): редът се пише в транзакцията на известието,
/// фоновият процес го праща с повторни опити; `dedupeKey` пази от двойно писмо. В реда няма адрес,
/// текст или име — адресът се чете от User в момента на изпращане.
model EmailOutbox {
  id             String      @id @default(cuid())
  tenantId       String
  userId         String
  kind           EmailKind
  /// Известието, от което е писмото (дайджестът — без). Прочетено/изтрито известие → писмото отпада.
  notificationId String?
  dedupeKey      String      @unique
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  notBefore      DateTime    @default(now())
  /// Наемът на изпращача — изтекъл (срив по средата) → редът се взима отново.
  lockedUntil    DateTime?
  /// Само код (http_503, timeout…) — никога текст от доставчика (може да цитира адреса).
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, notBefore])
  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([notificationId])
}

// ─── Интеграция с helpdesk (FR-09, §14.4) ─────────────────────────────────────────────────────

enum HelpdeskKind {
  WEBHOOK // общ подписан webhook (HMAC-SHA256 с времеви печат)
  ZENDESK // Zendesk Tickets API
  JSM // Jira Service Management — Service Desk REST API (request + comment)
}

enum HelpdeskDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  SKIPPED
  /// Dead-letter: изчерпани опити или окончателна грешка. Спира следващите събития на тикета,
  /// докато администраторът не я пусне отново (подредбата по тикет не се нарушава).
  DEAD
}

/// Конекторът към helpdesk на клиента — най-много един на клиент. Тайните (токени, HMAC ключове)
/// са в `secrets`: AES-256-GCM с INTEGRATION_KEK, вързани към клиента; никога в API, одит или лог.
model HelpdeskIntegration {
  id        String       @id @default(cuid())
  tenantId  String       @unique
  kind      HelpdeskKind
  enabled   Boolean      @default(false)
  /// Неповерителната настройка по вида (адрес, поддомейн, service desk…) — zod при запис и четене.
  settings  Json         @default("{}")
  /// Шифрованите тайни (`v1.<id на ключа>.<base64>`) или null — services/integrations/secrets.ts.
  secrets   String?
  /// Идентификаторът във входящия адрес (128 случайни бита): не е тайна — входът се удостоверява с подписа.
  inboundId String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries HelpdeskDelivery[]
  links      HelpdeskLink[]
  receipts   HelpdeskInboundReceipt[]
}

/// Outbox към helpdesk-а: по един ред на `TicketEvent` от ChatChat, в транзакцията на промяната и
/// само при включена интеграция. `seq` подрежда по тикет — събитие N+1 не тръгва преди N.
model HelpdeskDelivery {
  id            String                 @id @default(cuid())
  tenantId      String
  integrationId String
  ticketId      String
  /// Събитието в дневника на тикета — едно събитие = една доставка (идемпотентност при запис).
  eventId       String                 @unique
  eventType     String
  seq           Int
  status        HelpdeskDeliveryStatus @default(PENDING)
  attempts      Int                    @default(0)
  notBefore     DateTime               @default(now())
  /// Наемът на изпращача — изтекъл (срив по средата) → редът се взима отново.
  lockedUntil   DateTime?
  /// Само код (http_503, timeout, ssrf_blocked…) — никога текст от отсрещната страна или тайна.
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  integration HelpdeskIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  ticket      Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event       TicketEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([ticketId, seq])
  @@index([status, notBefore])
  @@index([tenantId, createdAt])
  @@index([integrationId])
}

/// Връзката тикет ↔ записът в helpdesk-а (Zendesk id, JSM issueId/ключ, id от webhook получателя).
/// Смяна на вида/целта на конектора трие връзките — новият helpdesk получава тикета наново.
model HelpdeskLink {
  id            String   @id @default(cuid())
  ticketId      String   @unique
  integrationId String
  externalId    String
  /// Човешкият ключ (JSM „HELPDESK-1“), ако го има.
  externalKey   String?
  createdAt     DateTime @default(now())

  ticket      Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  integration HelpdeskIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([integrationId, externalKey])
}

/// Защита от повторение на входящите известия: отпечатък (SHA-256) на всяко прието известие.
/// Пази се малко над прозореца за времевия печат — по-старото и без това се отказва.
model HelpdeskInboundReceipt {
  id            String   @id @default(cuid())
  integrationId String
  nonce         String
  receivedAt    DateTime @default(now())

  integration HelpdeskIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, nonce])
  @@index([receivedAt])
}

/// Контролна точка на одитната верига (ретенция NFR-08): преди да се изтрият най-старите събития,
/// се пази хешът на последното изтрито — проверката на веригата продължава от него, без да се чупи.
model AuditCheckpoint {
  id            Int      @id @default(autoincrement())
  /// Последното изтрито събитие и неговият хеш — `prevHash` на първото оставащо.
  throughId     Int
  throughHash   String
  /// Котвата преди изтритото парче (GENESIS или предишната точка) — парчето е веригата между тях.
  fromHash      String
  count         Int
  firstAt       DateTime
  lastAt        DateTime
  /// SHA-256 на архива (JSONL), ако е записан (RETENTION_AUDIT_ARCHIVE_DIR).
  archiveSha256 String?
  createdAt     DateTime @default(now())

  @@index([throughId])
}

// ─── Приемане на документи през опашката (§4.1, §7.3, NFR-06) ────────────────────────────────

/// Състоянието на един файл в пакета: QUEUED → RUNNING (етап extract/ocr/index) → DONE | FAILED.
enum IngestStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Пакетно качване (§4.1 „importazione batch“): общите метаданни + по избор манифест по файл.
/// Документите влизат като DRAFT — пакетът е само проследяване; жизненият цикъл е на Document.
model IngestBatch {
  id               String   @id @default(cuid())
  tenantId         String
  /// Кой е качил (документите се записват с него като uploadedById) — без FK, като Document.
  createdById      String
  /// Общите метаданни (§7.2), валидирани при създаване; файлът може да ги допълни/замени.
  defaults         Json
  /// Редовете на манифеста (CSV/JSON) по изчистено име на файл — валидирани, без съдържание.
  manifest         Json?
  /// Импорт на кодове за грешка от XLSX шаблон → ЧЕРНОВИ кодове (минават през нормалния преглед).
  importErrorCodes Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  IngestItem[]

  @@index([tenantId, createdAt])
  @@index([createdById])
}

/// Един файл от пакета. Задачата в опашката носи САМО id-то му (никога съдържание); повторен опит
/// е идемпотентен — DONE/FAILED не се обработва наново, а документът и статусът DONE се записват в
/// една транзакция.
model IngestItem {
  id           String       @id @default(cuid())
  tenantId     String
  batchId      String
  /// CLEAN файлът от POST /admin/attachments (антивирусът е минал ПРЕДИ разбора). Ретенцията на
  /// файловете-сираци го трие → null, а задачата завършва с `ingest.err.sourceMissing`.
  attachmentId String?
  /// Името за показване (изчистеното от качването) — за списъка; документът го взима от файла.
  fileName     String
  /// Окончателните метаданни на файла (общи + манифест + изрични), валидирани при добавяне.
  meta         Json
  status       IngestStatus @default(QUEUED)
  /// Етапът при RUNNING: extract | ocr | index.
  stage        String?
  /// 0…100 — напредъкът на етапа (OCR по страници).
  progress     Int          @default(0)
  /// Разпознатият формат: pdf | docx | xlsx | image | log.
  format       String?
  /// Кодът на грешката (`ingest.err.*`, i18n) при FAILED — никога суровият текст на изключението.
  errorCode    String?
  /// Предупрежденията ([{ code, page? }]) — напр. страница без текст, таван на OCR.
  warnings     Json?
  documentId   String?
  chunks       Int?
  pages        Int?
  ocrPages     Int?
  /// Колко ЧЕРНОВИ кода за грешка са внесени от XLSX шаблона.
  errorCodes   Int?
  /// Колко пъти администраторът е пуснал повторно провален файл (новият id на задачата).
  retries      Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  finishedAt   DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch      IngestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  document   Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([batchId])
  @@index([attachmentId])
  @@index([documentId])
}
