<%- include('partials/head', { title: 'Карта за печат — MedQR', user: null }) %>

<section class="print-controls">
  <button type="button" data-print class="btn"><%- include('partials/icon', { name: 'printer' }) %> Печат</button>
  <a class="btn btn-ghost" href="/dashboard">Назад</a>
</section>

<div class="wallet-card">
  <div class="wc-left">
    <p class="wc-title">
      <span class="wc-cross" aria-hidden="true">+</span> СПЕШНА МЕДИЦИНСКА ИНФОРМАЦИЯ
    </p>
    <p class="wc-sub">EMERGENCY MEDICAL INFORMATION</p>
    <p class="wc-name"><%= profile.full_name %></p>
    <p class="wc-line"><strong>Кръвна група / Blood:</strong> <%= profile.blood_type || '—' %></p>
    <p class="wc-line"><strong>Алергии / Allergies:</strong> <%= profile.allergies || '—' %></p>
    <% if (profile.hearing_status && profile.hearing_status !== 'Без слухови проблеми') { %>
      <p class="wc-line"><%- include('partials/icon', { name: 'ear' }) %> <%= profile.hearing_status %></p>
    <% } %>
    <p class="wc-hint">Сканирайте за пълна информация · Scan for full details</p>
  </div>
  <div class="wc-right">
    <img src="<%= dataUrl %>" alt="QR код за спешна медицинска информация" class="wc-qr" />
    <p class="wc-scan">СКАНИРАЙ · SCAN</p>
  </div>
</div>

<%- include('partials/foot') %>
