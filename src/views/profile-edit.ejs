<%- include('partials/head', { title: 'Редакция на профил — MedQR', user }) %>

<h1>Редакция на медицински профил</h1>
<% if (typeof error !== 'undefined' && error) { %><p class="error" role="alert"><%= error %></p><% } %>

<form method="post" action="/profile/edit" class="stack form-wide">
  <%- include('partials/csrf') %>
  <fieldset>
    <legend>Самоличност</legend>
    <label>Пълно име *
      <input type="text" name="full_name" value="<%= profile.full_name || '' %>" required>
    </label>
    <label>Дата на раждане
      <input type="date" name="date_of_birth" value="<%= profile.date_of_birth || '' %>">
    </label>
    <label>Предпочитан език за комуникация
      <input type="text" name="preferred_language" value="<%= profile.preferred_language || '' %>" placeholder="напр. български">
    </label>
  </fieldset>

  <fieldset>
    <legend>Медицинска информация</legend>
    <label>Кръвна група
      <select name="blood_type">
        <% ['','0 Rh+','0 Rh-','A Rh+','A Rh-','B Rh+','B Rh-','AB Rh+','AB Rh-','Не знам'].forEach(b => { %>
          <option value="<%= b %>" <%= profile.blood_type === b ? 'selected' : '' %>><%= b || '— изберете —' %></option>
        <% }) %>
      </select>
    </label>
    <label>Алергии към лекарства
      <textarea name="allergies" rows="2" placeholder="напр. пеницилин, аспирин"><%= profile.allergies || '' %></textarea>
    </label>
    <label>Хронични заболявания / състояния
      <textarea name="chronic_conditions" rows="2" placeholder="напр. диабет тип 1, епилепсия, астма"><%= profile.chronic_conditions || '' %></textarea>
    </label>
    <label>Текущи медикаменти
      <textarea name="current_medications" rows="2" placeholder="напр. инсулин, антикоагуланти"><%= profile.current_medications || '' %></textarea>
    </label>
    <label>Друга важна информация
      <textarea name="additional_notes" rows="2" placeholder="напр. пейсмейкър, бременност, донор на органи"><%= profile.additional_notes || '' %></textarea>
    </label>
  </fieldset>

  <fieldset>
    <legend>Слух и комуникация</legend>
    <label>Слухов статус
      <select name="hearing_status">
        <% ['','Без слухови проблеми','Намален слух','Ползва слухов апарат','Кохлеарен имплант','Глух/а'].forEach(h => { %>
          <option value="<%= h %>" <%= profile.hearing_status === h ? 'selected' : '' %>><%= h || '— изберете —' %></option>
        <% }) %>
      </select>
    </label>
    <label>Мога ли да говоря
      <select name="can_speak">
        <% ['','Мога да говоря','Говоря ограничено','Не мога да говоря'].forEach(c => { %>
          <option value="<%= c %>" <%= profile.can_speak === c ? 'selected' : '' %>><%= c || '— изберете —' %></option>
        <% }) %>
      </select>
    </label>
    <label>Жестов език
      <select name="sign_language">
        <% ['','Български жестов език','Международен жестов език','Не ползвам жестов език'].forEach(s => { %>
          <option value="<%= s %>" <%= profile.sign_language === s ? 'selected' : '' %>><%= s || '— изберете —' %></option>
        <% }) %>
      </select>
    </label>
    <label>Предпочитан начин на комуникация
      <input type="text" name="communication_pref" value="<%= profile.communication_pref || '' %>" placeholder="напр. писмено, четене по устни, жестов език">
    </label>
  </fieldset>

  <fieldset>
    <legend>Спешен контакт</legend>
    <label>Име на близък
      <input type="text" name="emergency_contact_name" value="<%= profile.emergency_contact_name || '' %>">
    </label>
    <label>Телефон за връзка
      <input type="tel" name="emergency_contact_phone" value="<%= profile.emergency_contact_phone || '' %>" placeholder="+359...">
    </label>
    <label>Роднинска връзка
      <input type="text" name="emergency_contact_relation" value="<%= profile.emergency_contact_relation || '' %>" placeholder="напр. съпруг, дъщеря">
    </label>
    <label>Имейл на близък (за известия)
      <input type="email" name="emergency_contact_email" value="<%= profile.emergency_contact_email || '' %>" placeholder="name@example.com" autocomplete="off">
    </label>
    <label class="checkbox">
      <input type="checkbox" name="notify_on_scan" <%= profile.notify_on_scan ? 'checked' : '' %>>
      <span>Уведоми близкия по имейл, когато някой отвори спешния ми профил
        (без медицински данни в имейла).</span>
    </label>
  </fieldset>

  <div class="cta-row">
    <button type="submit" class="btn">Запази</button>
    <a class="btn btn-ghost" href="/dashboard">Откажи</a>
  </div>
</form>

<%- include('partials/foot') %>
