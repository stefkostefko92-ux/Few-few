<%- include('partials/head', { title: t('auth.forgot_title') + ' — MedQR', user: null }) %>

<section class="form-wrap">
  <h1><%= t('auth.forgot_title') %></h1>
  <% if (sent) { %>
    <p class="success" role="status"><%= t('auth.forgot_sent') %></p>
    <p><a href="/login"><%= t('auth.to_login') %></a></p>
  <% } else { %>
    <p><%= t('auth.forgot_intro') %></p>
    <form method="post" action="/forgot" class="stack">
      <%- include('partials/csrf') %>
      <label><%= t('auth.email') %>
        <input type="email" name="email" required autocomplete="email" autofocus>
      </label>
      <button type="submit" class="btn"><%= t('auth.send_link') %></button>
    </form>
    <p><a href="/login"><%= t('auth.back_login') %></a></p>
  <% } %>
</section>

<%- include('partials/foot') %>
