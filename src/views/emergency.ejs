<%- include('partials/head', { title: 'Спешна информация', user: null }) %>

<div class="emergency">
  <p class="emergency-banner"><%- include('partials/icon', { name: 'alert' }) %> СПЕШНА МЕДИЦИНСКА ИНФОРМАЦИЯ</p>
  <h1 class="big-name"><%= profile.full_name %></h1>

  <%
    const hearing = profile.hearing_status && profile.hearing_status !== 'Без слухови проблеми';
    const noSpeak = profile.can_speak === 'Не мога да говоря' || profile.can_speak === 'Говоря ограничено';
    const usesSign = profile.sign_language && profile.sign_language !== 'Не ползвам жестов език';
    const commNeeded = hearing || noSpeak || usesSign;
  %>
  <% if (commNeeded) { %>
    <div class="alert-comm" role="alert">
      <%- include('partials/icon', { name: 'ear', cls: 'icon-lg' }) %>
      <span>
        <strong>Това лице може да не чува и/или да не говори — общувайте писмено.</strong>
        <% if (hearing) { %> Слух: <%= profile.hearing_status %>.<% } %>
        <% if (profile.can_speak) { %> Говор: <%= profile.can_speak %>.<% } %>
        <% if (usesSign) { %> Жестов език: <%= profile.sign_language %>.<% } %>
        <% if (profile.communication_pref) { %> Предпочита: <strong><%= profile.communication_pref %></strong>.<% } %>
      </span>
    </div>

    <% if (profile.interpreter_contact) { %>
      <div class="interp-box">
        <%- include('partials/icon', { name: 'hand' }) %>
        <span>Жестов преводач / релейна услуга: <strong><%= profile.interpreter_contact %></strong></span>
      </div>
    <% } %>

    <button type="button" class="btn btn-comm" data-comm-open>
      <%- include('partials/icon', { name: 'message' }) %> Отвори общуване (за нечуващ/неговорещ човек)
    </button>

    <!-- Резерва без JavaScript: винаги има готови изречения за показване. -->
    <details class="comm-aid">
      <summary><%- include('partials/icon', { name: 'message' }) %> Готови изречения (работят и без интернет)</summary>
      <div class="phrases">
        <p>Тук съм, за да помогна. Ще пиша, за да общуваме.</p>
        <p>Боли ли ви някъде? Покажете къде.</p>
        <p>Приемате ли лекарства? Имате ли алергии?</p>
        <p>Да се обадя ли на ваш близък?</p>
        <p>Линейката идва. Останете спокойни.</p>
        <p>Може да пишете тук, за да ми отговорите.</p>
      </div>
    </details>

    <!-- Интерактивен помощник за двупосочно общуване (показва се с бутона горе). -->
    <div class="comm-overlay" id="comm-overlay" hidden role="dialog" aria-modal="true" aria-label="Помощник за общуване">
      <div class="comm-head">
        <strong><%- include('partials/icon', { name: 'message' }) %> Общуване</strong>
        <button type="button" class="comm-x" data-comm-close aria-label="Затвори">
          <%- include('partials/icon', { name: 'close' }) %>
        </button>
      </div>

      <div class="comm-stage" id="comm-stage" aria-live="polite" data-default="Докоснете изречение или напишете съобщение. Натиснете „Прочети на глас“, за да го озвучите.">
        Докоснете изречение или напишете съобщение. Натиснете „Прочети на глас“, за да го озвучите.
      </div>

      <div class="comm-body">
        <section class="comm-sec">
          <h3><%- include('partials/icon', { name: 'keyboard' }) %> Напишете — и прочетете на глас</h3>
          <textarea id="comm-type" rows="2" placeholder="Напишете тук. Това дава „глас“ на човек, който не може да говори."></textarea>
          <div class="comm-row">
            <button type="button" class="btn btn-say" data-say><%- include('partials/icon', { name: 'volume' }) %> Прочети на глас</button>
            <button type="button" class="btn btn-ghost" data-show>Покажи едро</button>
            <button type="button" class="btn btn-ghost" data-clear>Изчисти</button>
          </div>
        </section>

        <section class="comm-sec">
          <h3>Бързи отговори (от пациента)</h3>
          <div class="comm-cards">
            <button type="button" class="cc cc-yes" data-phrase="ДА">ДА</button>
            <button type="button" class="cc cc-no" data-phrase="НЕ">НЕ</button>
            <button type="button" class="cc" data-phrase="Не разбирам.">Не разбирам</button>
            <button type="button" class="cc" data-phrase="Боли ме.">Боли ме</button>
            <button type="button" class="cc" data-phrase="Имам нужда от лекарството си.">Нужно ми е лекарството</button>
            <button type="button" class="cc" data-phrase="Моля, обадете се на моя близък.">Обадете се на близкия ми</button>
            <button type="button" class="cc" data-phrase="Моля, извикайте жестов преводач.">Извикайте преводач</button>
            <button type="button" class="cc" data-phrase="Не чувам. Моля, пишете ми.">Не чувам — пишете</button>
          </div>
        </section>

        <section class="comm-sec">
          <h3>Въпроси (от екипа)</h3>
          <div class="comm-cards">
            <button type="button" class="cc" data-phrase="Тук съм, за да помогна. Ще пиша, за да общуваме.">Тук съм да помогна</button>
            <button type="button" class="cc" data-phrase="Боли ли ви някъде? Покажете къде.">Боли ли ви?</button>
            <button type="button" class="cc" data-phrase="Приемате ли лекарства? Имате ли алергии?">Лекарства? Алергии?</button>
            <button type="button" class="cc" data-phrase="Да се обадя ли на ваш близък?">Да звънна ли на близък?</button>
            <button type="button" class="cc" data-phrase="Линейката идва. Останете спокойни.">Линейката идва</button>
          </div>
        </section>

        <section class="comm-sec">
          <h3>Къде боли? Докоснете върху тялото</h3>
          <div class="bodymap">
            <svg viewBox="0 0 200 380" role="group" aria-label="Карта на тялото">
              <rect class="bm-neck" x="90" y="62" width="20" height="22" rx="6"/>
              <circle class="bm" cx="100" cy="38" r="30" data-phrase="Боли ме главата." role="button" tabindex="0" aria-label="Глава"/>
              <rect class="bm" x="60" y="80" width="80" height="72" rx="18" data-phrase="Боли ме в гърдите." role="button" tabindex="0" aria-label="Гърди"/>
              <rect class="bm" x="64" y="152" width="72" height="66" rx="16" data-phrase="Боли ме коремът." role="button" tabindex="0" aria-label="Корем"/>
              <rect class="bm" x="34" y="86" width="26" height="112" rx="13" data-phrase="Боли ме ръката." role="button" tabindex="0" aria-label="Лява ръка"/>
              <rect class="bm" x="140" y="86" width="26" height="112" rx="13" data-phrase="Боли ме ръката." role="button" tabindex="0" aria-label="Дясна ръка"/>
              <rect class="bm" x="70" y="220" width="28" height="134" rx="14" data-phrase="Боли ме кракът." role="button" tabindex="0" aria-label="Ляв крак"/>
              <rect class="bm" x="102" y="220" width="28" height="134" rx="14" data-phrase="Боли ме кракът." role="button" tabindex="0" aria-label="Десен крак"/>
            </svg>
          </div>
          <div class="comm-cards">
            <button type="button" class="cc" data-phrase="Боли ме гърбът.">Гръб</button>
            <button type="button" class="cc" data-phrase="Боли ме навсякъде.">Навсякъде</button>
          </div>
        </section>

        <section class="comm-sec">
          <h3>Колко силна е болката? (0–10)</h3>
          <div class="pain-scale">
            <% for (let n = 0; n <= 10; n++) { %>
              <button type="button" class="ps ps-<%= n <= 3 ? 'low' : (n <= 6 ? 'mid' : 'high') %>" data-phrase="Болка: <%= n %> от 10."><%= n %></button>
            <% } %>
          </div>
        </section>
      </div>
    </div>
  <% } %>

  <div class="emergency-grid">
    <div class="ebox blood">
      <span class="elabel">Кръвна група</span>
      <span class="evalue"><%= profile.blood_type || 'Неизвестна' %></span>
    </div>
    <div class="ebox allergy">
      <span class="elabel">Алергии към лекарства</span>
      <span class="evalue"><%= profile.allergies || 'Не са посочени' %></span>
    </div>
  </div>

  <dl class="emergency-list">
    <dt>Хронични заболявания</dt><dd><%= profile.chronic_conditions || '—' %></dd>
    <dt>Текущи медикаменти</dt><dd><%= profile.current_medications || '—' %></dd>
    <% if (profile.additional_notes) { %>
      <dt>Друга важна информация</dt><dd><%= profile.additional_notes %></dd>
    <% } %>
    <% if (profile.date_of_birth) { %>
      <dt>Дата на раждане</dt><dd><%= profile.date_of_birth %></dd>
    <% } %>
    <% if (profile.preferred_language) { %>
      <dt>Език</dt><dd><%= profile.preferred_language %></dd>
    <% } %>
  </dl>

  <% if (profile.emergency_contact_phone || profile.emergency_contact_name) { %>
    <div class="contact-box">
      <span class="elabel">Спешен контакт</span>
      <span class="evalue"><%= profile.emergency_contact_name || '' %>
        <% if (profile.emergency_contact_relation) { %>(<%= profile.emergency_contact_relation %>)<% } %>
      </span>
      <% if (profile.emergency_contact_phone) { %>
        <a class="call-btn" href="tel:<%= profile.emergency_contact_phone %>"><%- include('partials/icon', { name: 'phone' }) %> Обади се: <%= profile.emergency_contact_phone %></a>
      <% } %>
    </div>
  <% } %>

  <% if (typeof notifyActive !== 'undefined' && notifyActive) { %>
    <div class="notify-box">
      <p><%- include('partials/icon', { name: 'message' }) %> Близък контакт е автоматично уведомен, че този профил е отворен.</p>
      <button type="button" class="btn btn-locate" data-locate>
        <%- include('partials/icon', { name: 'phone' }) %> Сподели местоположението с близкия
      </button>
      <p class="muted small" id="locate-status" role="status"></p>
    </div>
  <% } %>

  <p class="muted small">Актуализирано: <%= profile.updated_at %>. Достъпът е регистриран.</p>
</div>

<%- include('partials/foot') %>
