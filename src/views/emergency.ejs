<%- include('partials/head', { title: 'Спешна информация', user: null }) %>

<div class="emergency">
  <p class="emergency-banner"><%- include('partials/icon', { name: 'alert' }) %> СПЕШНА МЕДИЦИНСКА ИНФОРМАЦИЯ</p>
  <h1 class="big-name"><%= profile.full_name %></h1>

  <%
    const hearing = profile.hearing_status && profile.hearing_status !== 'Без слухови проблеми';
    const noSpeak = profile.can_speak === 'Не мога да говоря' || profile.can_speak === 'Говоря ограничено';
    const usesSign = profile.sign_language && profile.sign_language !== 'Не ползвам жестов език';
    const commNeeded = hearing || noSpeak || usesSign;
  %>
  <% if (commNeeded) { %>
    <div class="alert-comm" role="alert">
      <%- include('partials/icon', { name: 'ear', cls: 'icon-lg' }) %>
      <span>
        <strong>Това лице може да не чува и/или да не говори — общувайте писмено.</strong>
        <% if (hearing) { %> Слух: <%= profile.hearing_status %>.<% } %>
        <% if (profile.can_speak) { %> Говор: <%= profile.can_speak %>.<% } %>
        <% if (usesSign) { %> Жестов език: <%= profile.sign_language %>.<% } %>
        <% if (profile.communication_pref) { %> Предпочита: <strong><%= profile.communication_pref %></strong>.<% } %>
      </span>
    </div>

    <details class="comm-aid" open>
      <summary><%- include('partials/icon', { name: 'message' }) %> Помощ за общуване — покажете тези изречения на екрана</summary>
      <div class="phrases">
        <p>Тук съм, за да помогна. Ще пиша, за да общуваме.</p>
        <p>Боли ли ви някъде? Покажете къде.</p>
        <p>Приемате ли лекарства? Имате ли алергии?</p>
        <p>Да се обадя ли на ваш близък?</p>
        <p>Линейката идва. Останете спокойни.</p>
        <p>Може да пишете тук, за да ми отговорите.</p>
      </div>
    </details>
  <% } %>

  <div class="emergency-grid">
    <div class="ebox blood">
      <span class="elabel">Кръвна група</span>
      <span class="evalue"><%= profile.blood_type || 'Неизвестна' %></span>
    </div>
    <div class="ebox allergy">
      <span class="elabel">Алергии към лекарства</span>
      <span class="evalue"><%= profile.allergies || 'Не са посочени' %></span>
    </div>
  </div>

  <dl class="emergency-list">
    <dt>Хронични заболявания</dt><dd><%= profile.chronic_conditions || '—' %></dd>
    <dt>Текущи медикаменти</dt><dd><%= profile.current_medications || '—' %></dd>
    <% if (profile.additional_notes) { %>
      <dt>Друга важна информация</dt><dd><%= profile.additional_notes %></dd>
    <% } %>
    <% if (profile.date_of_birth) { %>
      <dt>Дата на раждане</dt><dd><%= profile.date_of_birth %></dd>
    <% } %>
    <% if (profile.preferred_language) { %>
      <dt>Език</dt><dd><%= profile.preferred_language %></dd>
    <% } %>
  </dl>

  <% if (profile.emergency_contact_phone || profile.emergency_contact_name) { %>
    <div class="contact-box">
      <span class="elabel">Спешен контакт</span>
      <span class="evalue"><%= profile.emergency_contact_name || '' %>
        <% if (profile.emergency_contact_relation) { %>(<%= profile.emergency_contact_relation %>)<% } %>
      </span>
      <% if (profile.emergency_contact_phone) { %>
        <a class="call-btn" href="tel:<%= profile.emergency_contact_phone %>"><%- include('partials/icon', { name: 'phone' }) %> Обади се: <%= profile.emergency_contact_phone %></a>
      <% } %>
    </div>
  <% } %>

  <% if (typeof notifyActive !== 'undefined' && notifyActive) { %>
    <div class="notify-box">
      <p><%- include('partials/icon', { name: 'message' }) %> Близък контакт е автоматично уведомен, че този профил е отворен.</p>
      <button type="button" class="btn btn-locate" data-locate>
        <%- include('partials/icon', { name: 'phone' }) %> Сподели местоположението с близкия
      </button>
      <p class="muted small" id="locate-status" role="status"></p>
    </div>
  <% } %>

  <p class="muted small">Актуализирано: <%= profile.updated_at %>. Достъпът е регистриран.</p>
</div>

<%- include('partials/foot') %>
