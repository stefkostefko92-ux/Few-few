<!-- GDPR Cookie Banner — Eternal Touch -->
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-labelledby="cookie-title" aria-describedby="cookie-desc" hidden>
  <div class="cookie-inner">
    <div class="cookie-header">
      <h2 id="cookie-title" class="cookie-title"><%= t('cookies.banner.title') %></h2>
      <p id="cookie-desc" class="cookie-desc"><%= t('cookies.banner.body') %> <a href="/cookies"><%= t('cookies.banner.learnMore') %></a></p>
    </div>

    <div class="cookie-actions" id="cookie-actions-simple">
      <button type="button" class="cookie-btn cookie-btn-ghost" data-cookie-action="customize"><%= t('cookies.banner.customize') %></button>
      <button type="button" class="cookie-btn cookie-btn-secondary" data-cookie-action="reject"><%= t('cookies.banner.rejectAll') %></button>
      <button type="button" class="cookie-btn cookie-btn-primary" data-cookie-action="accept-all"><%= t('cookies.banner.acceptAll') %></button>
    </div>

    <div class="cookie-customize" id="cookie-customize" hidden>
      <ul class="cookie-categories">
        <li class="cookie-cat">
          <div class="cookie-cat-head">
            <label class="cookie-toggle disabled">
              <input type="checkbox" checked disabled>
              <span class="cookie-toggle-slider"></span>
            </label>
            <div>
              <strong><%= t('cookies.cat.necessary.title') %></strong>
              <span class="cookie-required"><%= t('cookies.cat.alwaysActive') %></span>
            </div>
          </div>
          <p class="cookie-cat-desc"><%= t('cookies.cat.necessary.desc') %></p>
        </li>
        <li class="cookie-cat">
          <div class="cookie-cat-head">
            <label class="cookie-toggle">
              <input type="checkbox" id="cat-analytics" data-cookie-cat="analytics">
              <span class="cookie-toggle-slider"></span>
            </label>
            <div>
              <strong><%= t('cookies.cat.analytics.title') %></strong>
            </div>
          </div>
          <p class="cookie-cat-desc"><%= t('cookies.cat.analytics.desc') %></p>
        </li>
        <li class="cookie-cat">
          <div class="cookie-cat-head">
            <label class="cookie-toggle">
              <input type="checkbox" id="cat-marketing" data-cookie-cat="marketing">
              <span class="cookie-toggle-slider"></span>
            </label>
            <div>
              <strong><%= t('cookies.cat.marketing.title') %></strong>
            </div>
          </div>
          <p class="cookie-cat-desc"><%= t('cookies.cat.marketing.desc') %></p>
        </li>
      </ul>
      <div class="cookie-actions">
        <button type="button" class="cookie-btn cookie-btn-ghost" data-cookie-action="back"><%= t('cookies.banner.back') %></button>
        <button type="button" class="cookie-btn cookie-btn-primary" data-cookie-action="save-selection"><%= t('cookies.banner.savePreferences') %></button>
      </div>
    </div>
  </div>
</div>
