# === Eternal Touch Environment ===
# Copy this file to .env and fill in real values before deployment.
# NEVER commit .env, and NEVER ship it inside a deploy archive — keep it only
# on the server (chmod 600). Secrets below must be unique per environment.

# Database
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Security secrets — MUST be ≥32 chars each; the app refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS

# Admin user (created on first boot via prisma seed).
# Generate a strong password (openssl rand -base64 18) and store it in a
# password manager — do NOT reuse a memorable/shared one.
ADMIN_EMAIL=info@eternaltouch.it
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Public site URL (used for canonical, sitemap, OG)
SITE_URL=https://eternaltouch.it

# Node env
NODE_ENV=production
PORT=4300

# Email (SMTP via Register.it). Required for contact-form notifications and the
# customer confirmation email. If SMTP_USER/SMTP_PASS are empty, messages are
# still saved to the DB but no email is sent.
SMTP_HOST=authsmtp.register.it
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@eternaltouch.it
SMTP_PASS=CHANGE_ME
SMTP_FROM=Eternal Touch <info@eternaltouch.it>
NOTIFY_TO=info@eternaltouch.it
# Only if the provider's SMTP presents a TLS cert for a DIFFERENT hostname
# (Register.it serves a *.securemail.pro cert on authsmtp.register.it). Set this
# to a name that IS in that cert to keep certificate validation on:
# SMTP_TLS_SERVERNAME=smtp.webnode.com
